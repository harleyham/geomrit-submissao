<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Artigos LIGEM</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: #0a0f1a; color: #e2e8f0; min-height: 100vh; }
    .topbar { background: rgba(15,23,42,0.8); border-bottom: 1px solid rgba(148,163,184,0.1); backdrop-filter: blur(20px); padding: 0 2rem; height: 64px; display: flex; align-items: center; position: sticky; top: 0; z-index: 100; }
    .topbar-inner { width: 100%; max-width: 1400px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
    .logo { font-size: 1.25rem; font-weight: 700; color: #e2e8f0; text-decoration: none; }
    .logo-icon { color: #60a5fa; }
    .topbar-nav { display: flex; gap: 0.25rem; align-items: center; }
    .topbar-nav a { color: #94a3b8; padding: 0.5rem 0.75rem; border-radius: 6px; text-decoration: none; font-size: 0.875rem; font-weight: 500; transition: all 0.15s; }
    .topbar-nav a:hover, .topbar-nav a.active { color: #e2e8f0; background: rgba(148,163,184,0.1); }
    .main-content { max-width: 1000px; margin: 0 auto; padding: 2rem; }
    .page-header { margin-bottom: 2rem; }
    .page-header h1 { font-size: 1.75rem; font-weight: 700; color: #f1f5f9; }
    .section { background: rgba(30,41,59,0.6); border: 1px solid rgba(148,163,184,0.1); border-radius: 12px; padding: 2rem; margin-bottom: 1.5rem; }
    .section-header { margin-bottom: 1.5rem; }
    .section-header h2 { font-size: 1.125rem; font-weight: 600; color: #f1f5f9; margin-bottom: 0.5rem; }
    .section-header p { color: #64748b; font-size: 0.875rem; }
    .form-group { margin-bottom: 1rem; }
    .form-group label { display: block; color: #94a3b8; font-size: 0.875rem; font-weight: 500; margin-bottom: 0.375rem; }
    .form-group input { width: 100%; padding: 0.625rem 1rem; border: 1px solid rgba(148,163,184,0.2); border-radius: 8px; background: rgba(15,23,42,0.5); color: #e2e8f0; font-size: 0.9375rem; font-family: 'Inter', sans-serif; }
    .form-group input:focus { outline: none; border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,0.15); }
    .password-field { position: relative; }
    .password-field input { padding-right: 3.25rem; }
    .toggle-password { position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%); background: transparent; border: none; color: #94a3b8; cursor: pointer; font-size: 1rem; }
    .form-actions { display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem; }
    .btn { display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.625rem 1.25rem; border-radius: 8px; font-size: 0.875rem; font-weight: 500; cursor: pointer; border: none; transition: all 0.15s; }
    .btn-primary { background: #3b82f6; color: white; }
    .btn-primary:hover { background: #2563eb; }
    .btn-danger { background: rgba(239,68,68,0.15); color: #f87171; border: 1px solid rgba(239,68,68,0.2); }
    .btn-danger:hover { background: rgba(239,68,68,0.25); }
    .btn-ghost { background: transparent; color: #94a3b8; border: 1px solid rgba(148,163,184,0.2); }
    .btn-ghost:hover { background: rgba(148,163,184,0.1); color: #e2e8f0; }
    .alert { padding: 0.875rem 1rem; border-radius: 8px; margin-bottom: 1.5rem; font-size: 0.875rem; }
    .alert-success { background: rgba(52,211,153,0.1); color: #34d399; border: 1px solid rgba(52,211,153,0.2); }
    .alert-error { background: rgba(248,113,113,0.1); color: #f87171; border: 1px solid rgba(248,113,113,0.2); }
    table { width: 100%; border-collapse: collapse; }
    th { text-align: left; padding: 0.75rem 1rem; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; background: rgba(15,23,42,0.3); }
    td { padding: 0.75rem 1rem; font-size: 0.875rem; color: #cbd5e1; border-top: 1px solid rgba(148,163,184,0.05); }
    .badge { display: inline-block; padding: 0.2rem 0.5rem; border-radius: 9999px; font-size: 0.7rem; font-weight: 600; }
    .badge-admin { background: rgba(167,139,250,0.15); color: #a78bfa; }
    .badge-reviewer { background: rgba(96,165,250,0.15); color: #60a5fa; }
    .badge-active { background: rgba(52,211,153,0.15); color: #34d399; }
    .badge-inactive { background: rgba(100,116,139,0.2); color: #94a3b8; }
    .toggle-switch { position: relative; display: inline-block; width: 44px; height: 24px; }
    .toggle-switch input { opacity: 0; width: 0; height: 0; }
    .toggle-slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background: rgba(100,116,139,0.4); border-radius: 24px; transition: 0.2s; }
    .toggle-slider:before { content: ""; position: absolute; height: 18px; width: 18px; left: 3px; bottom: 3px; background: white; border-radius: 50%; transition: 0.2s; }
    input:checked + .toggle-slider { background: #3b82f6; }
    input:checked + .toggle-slider:before { transform: translateX(20px); }
    footer { text-align: center; padding: 2rem; color: #475569; font-size: 0.75rem; }
    a { color: #60a5fa; text-decoration: none; }
    a:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="logo"><span class="logo-icon">◆</span> Artigos LIGEM</a>
      <nav class="topbar-nav">
        <a href="/admin">Dashboard</a>
        <a href="/admin/events">Eventos</a>
        <a href="/admin/users" class="active">Usuários</a>
        <% if (userEmail) { %><span style="padding:0.3rem 0.65rem; color:#cbd5e1; font-size:0.8125rem; border:1px solid rgba(148,163,184,0.18); border-radius:9999px; background:rgba(15,23,42,0.35);"><%= userEmail %></span><% } %>
        <form method="POST" action="/admin/logout" style="display:inline"><button type="submit" class="btn btn-ghost" style="padding:0.3rem 0.5rem; color: #f87171;">Sair</button></form>
      </nav>
    </div>
  </header>

  <main class="main-content">
    <div class="page-header">
      <h1>Configurações</h1>
    </div>

    <% if (success) { %>
    <div class="alert alert-success"><%= success %></div>
    <% } %>
    <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
    <% } %>

    <!-- Trocar senha do admin -->
    <div class="section">
      <div class="section-header">
        <h2>Trocar Senha</h2>
        <p>Altere a senha de acesso ao painel administrativo</p>
      </div>
      <form method="POST" action="/admin/users/change-password">
        <div class="form-group">
          <label for="current_password">Senha Atual *</label>
          <div class="password-field">
            <input type="password" id="current_password" name="current_password" required autocomplete="current-password">
            <button type="button" class="toggle-password" aria-label="Mostrar senha" data-target="current_password">👁</button>
          </div>
        </div>
        <div class="form-group">
          <label for="new_password">Nova Senha *</label>
          <div class="password-field">
            <input type="password" id="new_password" name="new_password" required minlength="6" autocomplete="new-password">
            <button type="button" class="toggle-password" aria-label="Mostrar senha" data-target="new_password">👁</button>
          </div>
        </div>
        <div class="form-group">
          <label for="confirm_password">Confirmar Nova Senha *</label>
          <div class="password-field">
            <input type="password" id="confirm_password" name="confirm_password" required minlength="6" autocomplete="new-password">
            <button type="button" class="toggle-password" aria-label="Mostrar senha" data-target="confirm_password">👁</button>
          </div>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Salvar Senha</button>
        </div>
      </form>
    </div>

    <!-- Usuários -->
    <div class="section">
      <div class="section-header">
        <h2>Gerenciar Usuários</h2>
        <p>Administre os usuários, seus perfis e permissões de acesso</p>
      </div>
      <table>
        <thead>
          <tr>
            <th>Nome</th>
            <th>E-mail</th>
            <th>Perfis</th>
            <th>Ativo</th>
            <th>Senha</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(user => { %>
          <tr>
            <td><strong style="color: #f1f5f9;"><%= user.name %></strong></td>
            <td><%= user.email %></td>
            <td>
              <% if (user.is_admin) { %><span class="badge badge-admin">Admin</span><% } %>
              <% if (user.is_reviewer) { %><span class="badge badge-reviewer">Revisor</span><% } %>
              <% if (!user.is_admin && !user.is_reviewer) { %><span class="badge badge-inactive">Público</span><% } %>
            </td>
            <td>
              <% if (user.is_public) { %>
                <span class="badge badge-active">Ativo</span>
              <% } else { %>
                <span class="badge badge-inactive">Inativo</span>
              <% } %>
            </td>
            <td>
              <% if (user.password_changed) { %>
                <span class="badge badge-active">Alterada</span>
              <% } else { %>
                <span class="badge badge-inactive">Primeiro acesso</span>
              <% } %>
            </td>
            <td>
              <form method="POST" action="/admin/users/<%= user.id %>/reset-password" style="display:inline">
                <input type="hidden" name="user_id" value="<%= user.id %>">
                <input type="hidden" name="default_reset" value="true">
                <button type="submit" class="btn btn-danger" onclick="return confirm('Resetar senha de <%= user.name %> para 123456?')">Resetar</button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- Permissões de usuários -->
    <div class="section">
      <div class="section-header">
        <h2>Permissões de Acesso</h2>
        <p>Defina os perfis de acesso para cada usuário</p>
      </div>
      <table>
        <thead>
          <tr>
            <th>Nome</th>
            <th>E-mail</th>
            <th>Admin</th>
            <th>Revisor</th>
            <th>Acesso</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(user => { %>
          <tr>
            <td><strong style="color: #f1f5f9;"><%= user.name %></strong></td>
            <td><%= user.email %></td>
            <td>
              <form id="config-toggle-admin-<%= user.id %>" method="POST" action="/admin/users/<%= user.id %>/toggle-admin" style="display:inline">
                <input type="hidden" name="is_admin" value="<%= user.is_admin ? 1 : 0 %>">
                <label class="toggle-switch">
                  <input type="checkbox" <%= user.is_admin ? 'checked' : '' %> onchange="submitToggle(this, 'config-toggle-admin-<%= user.id %>', 'is_admin')">
                  <span class="toggle-slider"></span>
                </label>
              </form>
            </td>
            <td>
              <form id="config-toggle-reviewer-<%= user.id %>" method="POST" action="/admin/users/<%= user.id %>/toggle-reviewer" style="display:inline">
                <input type="hidden" name="is_reviewer" value="<%= user.is_reviewer ? 1 : 0 %>">
                <label class="toggle-switch">
                  <input type="checkbox" <%= user.is_reviewer ? 'checked' : '' %> onchange="submitToggle(this, 'config-toggle-reviewer-<%= user.id %>', 'is_reviewer')">
                  <span class="toggle-slider"></span>
                </label>
              </form>
            </td>
            <td>
              <form id="config-toggle-public-<%= user.id %>" method="POST" action="/admin/users/<%= user.id %>/toggle-public" style="display:inline">
                <input type="hidden" name="is_public" value="<%= user.is_public ? 1 : 0 %>">
                <label class="toggle-switch">
                  <input type="checkbox" <%= user.is_public ? 'checked' : '' %> onchange="submitToggle(this, 'config-toggle-public-<%= user.id %>', 'is_public')">
                  <span class="toggle-slider"></span>
                </label>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </main>

  <footer>&copy; <%= year %> LIGEM.Redes</footer>

  <script>
    document.querySelectorAll('.toggle-password').forEach(function(button) {
      button.addEventListener('click', function() {
        var input = document.getElementById(button.getAttribute('data-target'));
        var showing = input.type === 'text';
        input.type = showing ? 'password' : 'text';
        button.textContent = showing ? '👁' : '🙈';
        button.setAttribute('aria-label', showing ? 'Mostrar senha' : 'Ocultar senha');
      });
    });

    function submitToggle(el, formId, inputName) {
      var form = document.getElementById(formId);
      var input = form.querySelector('input[name="' + inputName + '"]');
      input.value = el.checked ? '1' : '0';
      form.submit();
    }
  </script>
</body>
</html>
