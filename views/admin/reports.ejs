<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Artigos LIGEM</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: #0a0f1a; color: #e2e8f0; min-height: 100vh; }
    .topbar { background: rgba(15,23,42,0.8); border-bottom: 1px solid rgba(148,163,184,0.1); backdrop-filter: blur(20px); padding: 0 2rem; height: 64px; display: flex; align-items: center; position: sticky; top: 0; z-index: 100; }
    .topbar-inner { width: 100%; max-width: 1400px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
    .logo { font-size: 1.25rem; font-weight: 700; color: #e2e8f0; text-decoration: none; }
    .logo-icon { color: #60a5fa; }
    .topbar-nav { display: flex; gap: 0.25rem; align-items: center; }
    .topbar-nav a { color: #94a3b8; padding: 0.5rem 0.75rem; border-radius: 6px; text-decoration: none; font-size: 0.875rem; font-weight: 500; }
    .topbar-nav a:hover { color: #e2e8f0; background: rgba(148,163,184,0.1); }
    .main-content { max-width: 1400px; margin: 0 auto; padding: 2rem; }
    .page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem; }
    .page-header h1 { font-size: 1.75rem; font-weight: 700; color: #f1f5f9; }
    .section { background: rgba(30,41,59,0.6); border: 1px solid rgba(148,163,184,0.1); border-radius: 12px; padding: 2rem; margin-bottom: 1.5rem; }
    .section h2 { font-size: 1rem; font-weight: 600; color: #f1f5f9; margin-bottom: 1rem; }
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
    .stat-card { background: rgba(15,23,42,0.4); border: 1px solid rgba(148,163,184,0.1); border-radius: 8px; padding: 1.25rem; }
    .stat-number { font-size: 2rem; font-weight: 700; color: #60a5fa; }
    .stat-label { font-size: 0.75rem; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; margin-top: 0.25rem; }
    table { width: 100%; border-collapse: collapse; }
    th { text-align: left; padding: 0.75rem 1rem; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; background: rgba(15,23,42,0.3); }
    td { padding: 0.75rem 1rem; font-size: 0.875rem; color: #cbd5e1; border-top: 1px solid rgba(148,163,184,0.05); }
    .badge { display: inline-block; padding: 0.2rem 0.6rem; border-radius: 9999px; font-size: 0.7rem; font-weight: 600; }
    .badge-area { background: rgba(167,139,250,0.15); color: #a78bfa; }
    .btn { display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.5rem 1rem; border-radius: 8px; font-size: 0.8125rem; font-weight: 500; cursor: pointer; border: none; text-decoration: none; }
    .btn-ghost { background: transparent; color: #94a3b8; border: 1px solid rgba(148,163,184,0.2); }
    .btn-ghost:hover { background: rgba(148,163,184,0.1); color: #e2e8f0; }
    .btn-primary { background: #3b82f6; color: white; }
    a { color: #60a5fa; text-decoration: none; }
    footer { text-align: center; padding: 2rem; color: #475569; font-size: 0.75rem; }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="logo"><span class="logo-icon">◆</span> Artigos LIGEM</a>
      <nav class="topbar-nav">
        <a href="/admin">Dashboard</a>
        <a href="/admin/events">Eventos</a>
        <a href="/admin/reviewers">Revisores</a>
        <form method="POST" action="/admin/logout" style="display:inline"><button type="submit" class="btn btn-ghost btn-sm">Sair</button></form>
      </nav>
    </div>
  </header>

  <main class="main-content">
    <div class="page-header">
      <h1>Relatórios</h1>
    </div>

    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-number"><%= stats.totalArticles %></div>
        <div class="stat-label">Total Artigos</div>
      </div>
      <div class="stat-card">
        <div class="stat-number"><%= stats.totalEvents %></div>
        <div class="stat-label">Eventos</div>
      </div>
      <div class="stat-card">
        <div class="stat-number"><%= stats.totalReviewers %></div>
        <div class="stat-label">Revisores</div>
      </div>
      <div class="stat-card">
        <div class="stat-number"><%= stats.totalAssignments %></div>
        <div class="stat-label">Atribuições</div>
      </div>
    </div>

    <div class="section">
      <h2>Distribuição de Artigos por Revisor</h2>
      <table>
        <thead>
          <tr><th>Revisor</th><th>Área</th><th>Instituição</th><th>Artigos</th></tr>
        </thead>
        <tbody>
          <% assignments.forEach(a => { %>
          <tr>
            <td><%= a.reviewer_name %></td>
            <td><span class="badge badge-area"><%= a.reviewer_area %></span></td>
            <td><%= a.reviewer_institution || '-' %></td>
            <td><%= a.article_count %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="section">
      <h2>Artigos por Evento</h2>
      <table>
        <thead>
          <tr><th>Evento</th><th>Área</th><th>Data</th><th>Artigos</th><th>Aprovados</th><th>Rejeitados</th></tr>
        </thead>
        <tbody>
          <% articlesByEvent.forEach(e => { %>
          <tr>
            <td><a href="/admin/articles?eventId=<%= e.event_id %>"><%= e.event_name %></a></td>
            <td><span class="badge badge-area"><%= e.event_area %></span></td>
            <td><%= new Date(e.date_start).toLocaleDateString('pt-BR') %></td>
            <td><%= e.total %></td>
            <td><%= e.approved %></td>
            <td><%= e.rejected %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </main>

  <footer>&copy; <%= year %> LIGEM.Redes</footer>
</body>
</html>