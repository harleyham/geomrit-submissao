<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %></title>
  <link href="/lib/flatpickr/flatpickr.min.css" rel="stylesheet">
  <style>
    body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--text);margin:0}.topbar{background:var(--surface);border-bottom:1px solid var(--border);backdrop-filter:blur(20px);padding:0 2rem;height:64px;display:flex;align-items:center;position:sticky;top:0;z-index:100}.topbar-inner{width:100%;max-width:1400px;margin:0 auto;display:flex;align-items:center;justify-content:space-between}.logo{font-size:1.25rem;font-weight:700;color:var(--text);text-decoration:none}.logo-icon{color:var(--accent)}.topbar-nav{display:flex;gap:0.4rem;align-items:center;flex-wrap:wrap}.topbar-nav a{color:var(--text-muted);padding:0.5rem 0.75rem;border-radius:6px;text-decoration:none;font-size:0.875rem;font-weight:500;transition:all 0.15s}.topbar-nav a:hover{color:var(--text);background:var(--surface-hover)}.session-pill{padding:0.42rem 0.78rem;border:1px solid var(--border-strong);border-radius:999px;color:var(--text-muted);font-size:0.82rem}.btn-logout{background:transparent;color:var(--danger);border:1px solid var(--danger-border);font-family:inherit;cursor:pointer}.btn{display:inline-flex;align-items:center;justify-content:center;padding:0.625rem 1.25rem;border-radius:8px;font-size:0.875rem;font-weight:500;cursor:pointer;border:none;text-decoration:none}.btn-secondary{background:var(--surface-hover);color:var(--text);border:1px solid var(--border-strong);text-decoration:none;font-weight:500}.btn-secondary:hover{background:var(--surface-hover)}.main-content{max-width:1400px;margin:0 auto;padding:2rem}.hint{color:var(--text-faint);font-size:0.85rem}.alert{padding:0.9rem 1rem;border-radius:10px;font-size:0.9rem;margin-bottom:1rem}.alert.success{background:var(--success-subtle);border:1px solid var(--success-border);color:var(--success)}.alert.error{background:var(--danger-subtle);border:1px solid var(--danger-border);color:var(--danger)}.card{background:var(--surface-2);border-radius:10px;padding:16px;margin-bottom:16px}.card h2{font-size:1rem;margin:0 0 10px}.card form{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.card input,.card select{padding:0.5rem 0.75rem;background:var(--surface-input);color:var(--text);border:1px solid var(--border);border-radius:8px;font-size:0.875rem}.card input[type=number]{width:110px}.card textarea{padding:0.5rem 0.75rem;background:var(--surface-input);color:var(--text);border:1px solid var(--border);border-radius:8px;font-size:0.875rem;min-width:min(320px,100%);flex:1 1 100%}.session-description{max-width:420px;word-break:break-word}.card button{padding:0.5rem 1rem;background:var(--primary-hover);color:var(--on-primary);border:none;border-radius:8px;cursor:pointer;font-size:0.875rem}.card button.danger{background:transparent;color:var(--danger);border:1px solid var(--danger-border);padding:2px 8px;font-size:11px}table{width:100%;border-collapse:collapse}th{text-align:left;padding:0.7rem 0.9rem;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--text-faint);border-bottom:1px solid var(--border-strong)}td{padding:0.7rem 0.9rem;border-bottom:1px solid var(--border-strong);font-size:0.9rem}.empty{color:var(--text-faint);font-size:0.9rem}input[type=number]::-webkit-inner-spin-button,input[type=number]::-webkit-outer-spin-button{-webkit-appearance:none;margin:0}input[type=number]{-moz-appearance:textfield;appearance:textfield}
  </style>
  <%- include('../../partials/theme') %>
  <%- include('../../partials/mobile-fixes') %>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="logo"><span class="logo-icon">◆</span> Gerência de Eventos</a>
      <nav class="topbar-nav">
        <% const canManageSessions = (typeof canManage !== 'undefined') ? canManage : true; const isStaffView = (typeof isStaff !== 'undefined') && isStaff; const canEditSessions = canManageSessions || isStaffView; %>
        <% if (isAdmin) { %><a href="/admin">Dashboard</a><% } %>
        <a href="/admin/events">Eventos</a>
        <a href="/admin/events/<%= event.id %>/activities">Atividades</a>
        <% if (userEmail) { %><span class="session-pill"><%= userEmail %></span><% } %>
        <form method="POST" action="/admin/logout" style="display:inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-logout">Sair</button>
        </form>
      </nav>
    </div>
  </header>
  <main class="main-content">
    <p style="margin-bottom:8px"><a href="/admin/events/<%= event.id %>/activities" style="color:var(--link);text-decoration:none">← Voltar às atividades</a></p>
    <h1 style="font-size:1.5rem;margin:0 0 4px">Etapas — <%= activity.name %></h1>
    <p class="hint"><%= activityDateRange(activity) %><% if (Number(activity.workload_hours) > 0) { %> · Carga horária total da atividade: <strong style="color:var(--link)"><%= activity.workload_hours %>h</strong> (definida na atividade; as etapas não têm carga própria)<% } else { %> · A presença é registrada por etapa. A carga horária do certificado é a soma das cargas das etapas desta atividade (ou a carga da atividade, quando definida).<% } %></p>
    <% if (success) { %><p class="alert success"><%= success %></p><% } %>
    <% if (error) { %><p class="alert error"><%= error %></p><% } %>

    <% if (canManageSessions || (isStaffView && editingSession)) { %>
    <section class="card">
      <h2><%= editingSession ? 'Editar etapa' : 'Adicionar etapa' %></h2>
      <% const sessionForm = (typeof sessionDraft !== 'undefined' && sessionDraft) ? sessionDraft : (editingSession || {}); %>
      <form method="post" class="availability-form" data-availability-url="/admin/events/<%= event.id %>/rooms/availability" data-date-field="session_date" data-exclude-session="<%= editingSession ? editingSession.id : '' %>" action="<%= editingSession ? `/admin/events/${event.id}/activities/${activity.id}/sessions/${editingSession.id}` : `/admin/events/${event.id}/activities/${activity.id}/sessions` %>">
        <input name="name" required placeholder="Nome da etapa (ex.: Aula 1, Período da manhã)" value="<%= sessionForm.name || '' %>">
        <input name="session_date" type="text" class="datepicker" value="<%= sessionForm.session_date ? formatBRDate(sessionForm.session_date) : '' %>">
        <input name="time_start" type="time" title="Hora de início" value="<%= sessionForm.time_start || '' %>">
        <input name="time_end" type="time" title="Hora de término" value="<%= sessionForm.time_end || '' %>">
        <% if (eventRooms && eventRooms.length) { %>
          <select name="room_id" id="room-select" title="Sala da etapa">
            <option value="">— Sem sala —</option>
            <% eventRooms.forEach((room) => { %>
              <option value="<%= room.id %>" <%= sessionForm.room_allocation && sessionForm.room_allocation.room_id === room.id ? 'selected' : '' %>><%= room.name %></option>
            <% }) %>
          </select>
        <% } else { %>
          <a href="/admin/events/<%= event.id %>/rooms" style="color:var(--link);font-size:13px">Cadastre salas</a> para alocar salas às etapas.
        <% } %>
        <% const workloadLocked = Number(activity.workload_hours) > 0; %>
        <% if (workloadLocked) { %><input type="hidden" name="workload_hours" value="0"><% } %>
        <input name="workload_hours" type="number" step=".5" min="0" placeholder="Carga horária" value="<%= workloadLocked ? 0 : (sessionForm.workload_hours != null ? sessionForm.workload_hours : '') %>" <%= workloadLocked ? 'disabled' : '' %> title="<%= workloadLocked ? 'A carga horária desta atividade é definida na atividade (' + activity.workload_hours + 'h)' : 'Carga horária da etapa' %>">
        <input name="video_url" type="url" placeholder="Link da transmissão da etapa (opcional — se vazio, usa o vídeo da atividade)" value="<%= sessionForm.video_url || '' %>">
        <label style="font-size:13px;color:var(--text-muted)"><input type="checkbox" name="has_video" value="1" style="margin:0 6px 0 0" <%= sessionForm.has_video || sessionForm.video_url ? 'checked' : '' %>> Haverá transmissão de vídeo (mesmo que o link ainda não esteja disponível)</label>
        <textarea name="description" rows="3" maxlength="2000" placeholder="Descrição breve da etapa (opcional)"><%= sessionForm.description || '' %></textarea>
        <button type="submit"><%= editingSession ? 'Salvar etapa' : 'Adicionar etapa' %></button>
        <% if (editingSession) { %><a href="/admin/events/<%= event.id %>/activities/<%= activity.id %>/sessions" class="btn btn-secondary">Cancelar</a><% } %>
      </form>
    </section>
    <% } %>

    <section class="card">
      <h2>Etapas cadastradas (<%= sessions.length %>)</h2>
      <% if (!sessions.length) { %>
        <p class="empty">Nenhuma etapa cadastrada. A atividade funciona como uma única etapa (presença geral).</p>
      <% } else { %>
        <div class="table-scroll"><table>
          <thead>
            <tr><th style="width:40px">#</th><th>Nome</th><th>Data</th><th>Horário</th><th>Sala</th><th>Carga</th><th>Descrição</th><th>Transmissão</th><% if (canEditSessions) { %><th style="width:140px">Ações</th><% } %></tr>
          </thead>
          <tbody>
            <% sessions.forEach((session) => { %>
              <tr>
                <td><%= session.sequence_no %></td>
                <td><strong><%= session.name %></strong></td>
                <td><%= session.session_date ? formatBRDate(session.session_date) : 'A definir' %></td>
                <td><%= (session.time_start && session.time_end) ? String(session.time_start).slice(0,5) + '–' + String(session.time_end).slice(0,5) : '—' %></td>
                <td><%= session.room_allocation ? session.room_allocation.room_name : '—' %></td>
                <td><%= Number(session.workload_hours) > 0 ? session.workload_hours + 'h' : '—' %></td>
                <td class="session-description"><%= session.description ? session.description : '—' %></td>
                <td>
                  <% if (session.video_url) { %>
                    <a href="<%= session.video_url %>" target="_blank" rel="noopener noreferrer" style="color:var(--link);text-decoration:none">Vídeo</a>
                  <% } else if (session.has_video) { %>
                    <span style="color:var(--link)">Transmissão</span>
                  <% } else { %>
                    <span style="color:var(--text-faint)">—</span>
                  <% } %>
                </td>
                <% if (canEditSessions) { %><td>
                  <a href="/admin/events/<%= event.id %>/activities/<%= activity.id %>/sessions?edit_session_id=<%= session.id %>" style="color:var(--link);text-decoration:none">Editar</a>
                  <% if (canManageSessions) { %>
                  <form method="post" action="/admin/events/<%= event.id %>/activities/<%= activity.id %>/sessions/<%= session.id %>/delete" style="display:inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="danger" nonce="<%= cspNonce %>" onclick="return confirm('Remover esta etapa? As presenças marcadas nesta etapa serão removidas.')">Remover</button>
                   </form>
                   <% } %>
                 </td>
                <% } %>
              </tr>
            <% }) %>
          </tbody>
        </table></div>
      <% } %>
    </section>
  </main>
  <%- include("../../partials/csrf-inject") %>
  <script src="/lib/flatpickr/flatpickr.min.js" nonce="<%= cspNonce %>"></script>
  <script src="/lib/flatpickr/l10n/pt.js" nonce="<%= cspNonce %>"></script>
  <script src="/lib/flatpickr/init.js" nonce="<%= cspNonce %>"></script>
  <script nonce="<%= cspNonce %>">
    (function () {
      function isoOf(field) {
        if (!field) return '';
        var fp = field.flatpickrInstance || field._flatpickr;
        if (fp && fp.selectedDates && fp.selectedDates[0]) {
          var d = fp.selectedDates[0];
          return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
        }
        var val = (field.value || '').trim();
        var br = val.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
        if (br) return br[3] + '-' + br[2].padStart(2, '0') + '-' + br[1].padStart(2, '0');
        return /^\d{4}-\d{2}-\d{2}$/.test(val) ? val : '';
      }
      function setup(form) {
        var select = form.querySelector('select[name="room_id"]');
        if (!select || !form.dataset.availabilityUrl) return;
        var url = form.dataset.availabilityUrl;
        var excludeActivity = form.dataset.excludeActivity || '';
        var excludeSession = form.dataset.excludeSession || '';
        var dateField = form.querySelector('[name="' + (form.dataset.dateField || 'date_start') + '"]');
        var ts = form.querySelector('[name="time_start"]');
        var te = form.querySelector('[name="time_end"]');
        var templates = Array.prototype.slice.call(select.options).filter(function (o) { return o.value !== ''; });
        function rebuild(availableIds) {
          var keep = select.value;
          select.innerHTML = '';
          var blank = document.createElement('option');
          blank.value = ''; blank.textContent = '— Sem sala —';
          select.appendChild(blank);
          templates.forEach(function (o) {
            if (availableIds && !availableIds[o.value]) return;
            var opt = document.createElement('option');
            opt.value = o.value; opt.textContent = o.textContent;
            select.appendChild(opt);
          });
          if (keep && (!availableIds || availableIds[keep])) select.value = keep;
        }
        function refresh() {
          var date = isoOf(dateField), t1 = ts ? (ts.value || '') : '', t2 = te ? (te.value || '') : '';
          if (!date || !t1 || !t2) { rebuild(null); return; }
          var qs = '?date=' + encodeURIComponent(date) + '&timeStart=' + encodeURIComponent(t1) + '&timeEnd=' + encodeURIComponent(t2);
          if (excludeActivity) qs += '&activityId=' + encodeURIComponent(excludeActivity);
          if (excludeSession) qs += '&sessionId=' + encodeURIComponent(excludeSession);
          fetch(url + qs, { credentials: 'same-origin' })
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (list) {
              if (!Array.isArray(list)) { rebuild(null); return; }
              var ids = {}; list.forEach(function (room) { if (room.available) ids[String(room.id)] = true; });
              rebuild(ids);
            })
            .catch(function () { rebuild(null); });
        }
        [dateField, ts, te].forEach(function (el) { if (el) el.addEventListener('change', refresh); });
        refresh();
      }
      Array.prototype.forEach.call(document.querySelectorAll('form.availability-form'), setup);
    })();
  </script>
  </body>
</html>
