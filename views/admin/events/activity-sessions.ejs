<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %></title>
  <style>
    body{font-family:'Inter',sans-serif;background:#0a0f1a;color:#e2e8f0;margin:0}.topbar{background:rgba(15,23,42,0.8);border-bottom:1px solid rgba(148,163,184,0.1);backdrop-filter:blur(20px);padding:0 2rem;height:64px;display:flex;align-items:center;position:sticky;top:0;z-index:100}.topbar-inner{width:100%;max-width:1400px;margin:0 auto;display:flex;align-items:center;justify-content:space-between}.logo{font-size:1.25rem;font-weight:700;color:#e2e8f0;text-decoration:none}.logo-icon{color:#60a5fa}.topbar-nav{display:flex;gap:0.4rem;align-items:center;flex-wrap:wrap}.topbar-nav a{color:#94a3b8;padding:0.5rem 0.75rem;border-radius:6px;text-decoration:none;font-size:0.875rem;font-weight:500;transition:all 0.15s}.topbar-nav a:hover{color:#e2e8f0;background:rgba(148,163,184,0.1)}.session-pill{padding:0.42rem 0.78rem;border:1px solid rgba(148,163,184,0.18);border-radius:999px;color:#94a3b8;font-size:0.82rem}.btn-logout{background:transparent;color:#f87171;border:1px solid rgba(248,113,113,0.25);font-family:inherit;cursor:pointer}.btn{display:inline-flex;align-items:center;justify-content:center;padding:0.625rem 1.25rem;border-radius:8px;font-size:0.875rem;font-weight:500;cursor:pointer;border:none;text-decoration:none}.btn-secondary{background:rgba(148,163,184,0.12);color:#e2e8f0;border:1px solid rgba(148,163,184,0.18);text-decoration:none;font-weight:500}.btn-secondary:hover{background:rgba(148,163,184,0.2)}.main-content{max-width:1400px;margin:0 auto;padding:2rem}.hint{color:#64748b;font-size:0.85rem}.alert{padding:0.9rem 1rem;border-radius:10px;font-size:0.9rem;margin-bottom:1rem}.alert.success{background:rgba(34,197,94,0.1);border:1px solid rgba(74,222,128,0.22);color:#86efac}.alert.error{background:rgba(239,68,68,0.1);border:1px solid rgba(248,113,113,0.24);color:#fca5a5}.card{background:#1e293b;border-radius:10px;padding:16px;margin-bottom:16px}.card h2{font-size:1rem;margin:0 0 10px}.card form{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.card input,.card select{padding:0.5rem 0.75rem;background:#0f172a;color:#e2e8f0;border:1px solid #334155;border-radius:8px;font-size:0.875rem}.card input[type=number]{width:110px}.card button{padding:0.5rem 1rem;background:#2563eb;color:#fff;border:none;border-radius:8px;cursor:pointer;font-size:0.875rem}.card button.danger{background:transparent;color:#f87171;border:1px solid rgba(248,113,113,0.25);padding:2px 8px;font-size:11px}table{width:100%;border-collapse:collapse}th{text-align:left;padding:0.7rem 0.9rem;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.05em;color:#64748b;border-bottom:1px solid rgba(148,163,184,0.15)}td{padding:0.7rem 0.9rem;border-bottom:1px solid rgba(148,163,184,0.07);font-size:0.9rem}.empty{color:#64748b;font-size:0.9rem}
  </style>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="logo"><span class="logo-icon">◆</span> Artigos LIGEM</a>
      <nav class="topbar-nav">
        <a href="/admin">Dashboard</a>
        <a href="/admin/events">Eventos</a>
        <a href="/admin/events/<%= event.id %>/activities">Atividades</a>
        <% if (userEmail) { %><span class="session-pill"><%= userEmail %></span><% } %>
        <form method="POST" action="/admin/logout" style="display:inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-logout">Sair</button>
        </form>
      </nav>
    </div>
  </header>
  <main class="main-content">
    <p style="margin-bottom:8px"><a href="/admin/events/<%= event.id %>/activities" style="color:#93c5fd;text-decoration:none">← Voltar às atividades</a></p>
    <h1 style="font-size:1.5rem;margin:0 0 4px">Etapas — <%= activity.name %></h1>
    <p class="hint"><%= activityDateRange(activity) %> · A presença é registrada por etapa. A carga horária do certificado soma as cargas das etapas em que a pessoa esteve presente.</p>
    <% if (success) { %><p class="alert success"><%= success %></p><% } %>
    <% if (error) { %><p class="alert error"><%= error %></p><% } %>

    <section class="card">
      <h2><%= editingSession ? 'Editar etapa' : 'Adicionar etapa' %></h2>
      <form method="post" action="<%= editingSession ? `/admin/events/${event.id}/activities/${activity.id}/sessions/${editingSession.id}` : `/admin/events/${event.id}/activities/${activity.id}/sessions` %>">
        <input name="name" required placeholder="Nome da etapa (ex.: Aula 1, Período da manhã)" value="<%= editingSession ? editingSession.name : '' %>">
        <input name="session_date" type="date" value="<%= editingSession ? editingSession.session_date || '' : '' %>">
        <input name="workload_hours" type="number" step=".5" min="0" placeholder="Carga horária" value="<%= editingSession && editingSession.workload_hours ? editingSession.workload_hours : '' %>">
        <input name="video_url" type="url" placeholder="Link da transmissão da etapa (opcional — se vazio, usa o vídeo da atividade)" value="<%= editingSession ? editingSession.video_url || '' : '' %>">
        <label style="font-size:13px;color:#94a3b8"><input type="checkbox" name="has_video" value="1" style="margin:0 6px 0 0" <%= editingSession && (editingSession.has_video || editingSession.video_url) ? 'checked' : '' %>> Haverá transmissão de vídeo (mesmo que o link ainda não esteja disponível)</label>
        <button type="submit"><%= editingSession ? 'Salvar etapa' : 'Adicionar etapa' %></button>
        <% if (editingSession) { %><a href="/admin/events/<%= event.id %>/activities/<%= activity.id %>/sessions" class="btn-secondary">Cancelar</a><% } %>
      </form>
    </section>

    <section class="card">
      <h2>Etapas cadastradas (<%= sessions.length %>)</h2>
      <% if (!sessions.length) { %>
        <p class="empty">Nenhuma etapa cadastrada. A atividade funciona como uma única etapa (presença geral).</p>
      <% } else { %>
        <table>
          <thead>
            <tr><th style="width:40px">#</th><th>Nome</th><th>Data</th><th>Carga</th><th>Transmissão</th><th style="width:140px">Ações</th></tr>
          </thead>
          <tbody>
            <% sessions.forEach((session) => { %>
              <tr>
                <td><%= session.sequence_no %></td>
                <td><strong><%= session.name %></strong></td>
                <td><%= session.session_date ? formatBRDate(session.session_date) : 'A definir' %></td>
                <td><%= Number(session.workload_hours) > 0 ? session.workload_hours + 'h' : '—' %></td>
                <td>
                  <% if (session.video_url) { %>
                    <a href="<%= session.video_url %>" target="_blank" rel="noopener noreferrer" style="color:#93c5fd;text-decoration:none">Vídeo</a>
                  <% } else if (session.has_video) { %>
                    <span style="color:#93c5fd">Transmissão</span>
                  <% } else { %>
                    <span style="color:#64748b">—</span>
                  <% } %>
                </td>
                <td>
                  <a href="/admin/events/<%= event.id %>/activities/<%= activity.id %>/sessions?edit_session_id=<%= session.id %>" style="color:#93c5fd;text-decoration:none">Editar</a>
                  <form method="post" action="/admin/events/<%= event.id %>/activities/<%= activity.id %>/sessions/<%= session.id %>/delete" style="display:inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="danger" onclick="return confirm('Remover esta etapa? As presenças marcadas nesta etapa serão removidas.')">Remover</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </section>
  </main>
  <%- include("../../partials/csrf-inject") %>
  </body>
</html>
