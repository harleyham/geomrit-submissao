<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><title><%=title%></title><style>body{font-family:Arial;background:#0a0f1a;color:#e2e8f0;margin:0}.top,main{padding:22px 6%}.top{background:#0f172a}.top a,a{color:#93c5fd;margin-right:14px}.card{background:#1e293b;border-radius:10px;padding:18px;margin:16px 0}.activities{display:flex;gap:10px;flex-wrap:wrap}.activity{display:block;padding:12px;border:1px solid #475569;border-radius:8px;text-decoration:none;color:#e2e8f0}table{width:100%;border-collapse:collapse}td,th{padding:10px;border-bottom:1px solid #334155;text-align:left}button,input{padding:8px;background:#0f172a;color:#fff;border:1px solid #475569}button{background:#2563eb}.ok{color:#86efac}.no{color:#cbd5e1}</style></head><body><header class="top"><a href="/admin/dashboard">Dashboard</a><a href="/admin/events">Eventos</a><a href="/admin/events/<%=event.id%>/activities">Atividades</a></header><main><h1>Controle de presença — <%=event.name%></h1><section class="card"><h2>Presença por parte do evento</h2><p>Selecione uma atividade para marcar presença e calcular a elegibilidade do certificado correspondente.</p><div class="activities"><% if(!activities.length){%><span>Nenhuma atividade cadastrada.</span><%}%><%activities.forEach(a=>{%><a class="activity" href="/admin/events/<%=event.id%>/activities/<%=a.id%>/attendance"><strong><%=a.name%></strong><br><small><%=a.activity_date||'Data a definir'%> · <%=a.workload_hours%>h<br>Perfis: <%=a.eligible_roles%></small></a><%})%></div></section><section class="card"><h2>Resumo geral</h2><p><strong><%=summary.registered%></strong> pessoas vinculadas · <strong><%=summary.present%></strong> presentes · <strong><%=summary.absent%></strong> sem presença</p></section><section class="card"><h2>Presença geral do evento</h2><table><tr><th>Pessoa</th><th>Perfis</th><th>Situação</th><th></th></tr><%participants.forEach(p=>{%><tr><td><strong><%=p.name%></strong><br><small><%=p.email%></small></td><td><%=p.roles%></td><td class="<%=p.attendance_total?'ok':'no'%>"><%=p.attendance_total?'Presente':'Ausente'%></td><td><form method="post" action="/admin/events/<%=event.id%>/attendance/<%=p.user_id%>"><button name="action" value="<%=p.attendance_total?'mark_absent':'mark_present'%>"><%=p.attendance_total?'Remover':'Marcar presente'%></button></form></td></tr><%})%></table></section></main></body></html>
