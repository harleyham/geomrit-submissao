<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Gerência de Eventos</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--text);margin:0}
    .topbar { background: var(--surface-elevated); border-bottom: 1px solid var(--border-strong); backdrop-filter: blur(20px); padding: 0 2rem; height: 64px; display: flex; align-items: center; position: sticky; top: 0; z-index: 100; }
    .topbar-inner { width: 100%; max-width: 1400px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
    .logo { font-size: 1.25rem; font-weight: 700; color: var(--text); text-decoration: none; }
    .logo-icon { color: var(--accent); }
    .topbar-nav { display: flex; gap: 0.25rem; align-items: center; flex-wrap: wrap; }
    .topbar-nav a { color: var(--text-muted); padding: 0.5rem 0.75rem; border-radius: 6px; text-decoration: none; font-size: 0.875rem; font-weight: 500; }
    .topbar-nav a:hover { color: var(--text); background: var(--surface-hover); }
    .session-pill { padding: 0.42rem 0.78rem; border: 1px solid var(--border-strong); border-radius: 999px; color: var(--text-muted); font-size: 0.82rem; }
    .btn-logout { background: transparent; color: var(--danger); border: 1px solid var(--danger-border); font-family: inherit; cursor: pointer; }
    .main-content { max-width: 1400px; margin: 0 auto; padding: 2rem; }
    .page-header h1 { font-size: 1.5rem; font-weight: 700; color: var(--text-strong); margin-bottom: 0.35rem; }
    .page-header p { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 0.75rem; }
    .btn { display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.5rem 1rem; border-radius: 8px; font-size: 0.8125rem; font-weight: 600; cursor: pointer; border: none; text-decoration: none; }
    .btn-primary { background: var(--primary); color: var(--on-primary); }
    .btn-ghost { background: transparent; color: var(--text-muted); border: 1px solid var(--border-strong); }
    .btn-ghost:hover { background: var(--surface-hover); color: var(--text); }
    .btn-danger { background: var(--danger-subtle); color: var(--danger); border: 1px solid var(--danger-border); }
    .card { background: var(--surface-elevated); border: 1px solid var(--border-strong); border-radius: 12px; padding: 1.25rem 1.5rem; margin-bottom: 1.25rem; }
    .card h2 { font-size: 1rem; color: var(--text-strong); margin: 0 0 0.75rem; }
    .search-row { display: flex; gap: 0.6rem; flex-wrap: wrap; align-items: flex-end; }
    .search-row input[type="text"] { padding: 0.55rem 0.75rem; border-radius: 8px; border: 1px solid var(--border-strong); background: var(--surface-input); color: var(--text-strong); font-size: 0.875rem; min-width: 260px; }
    .search-row select { padding: 0.55rem 0.75rem; border-radius: 8px; border: 1px solid var(--border-strong); background: var(--surface-input); color: var(--text-strong); font-size: 0.875rem; }
    .people-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.75rem; }
    .person { display: flex; gap: 1rem; align-items: flex-start; padding: 0.85rem 1rem; border: 1px solid var(--border); border-radius: 10px; background: var(--surface-input); }
    .photo-circle { width: 56px; height: 56px; border-radius: 50%; overflow: hidden; background: var(--surface-hover); border: 2px solid var(--border-strong); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .photo-circle img { width: 100%; height: 100%; object-fit: cover; }
    .photo-circle .photo-initial { font-size: 1.15rem; font-weight: 700; color: var(--text-faint); }
    .person-body { flex: 1; min-width: 0; }
    .person-name { font-weight: 700; color: var(--text-strong); font-size: 0.95rem; }
    .person-sub { color: var(--text-muted); font-size: 0.78rem; margin-top: 0.15rem; }
    .person-bio { color: var(--text); font-size: 0.85rem; margin-top: 0.4rem; white-space: pre-line; }
    .badge { display: inline-block; padding: 0.15rem 0.55rem; border-radius: 999px; font-size: 0.68rem; font-weight: 700; background: var(--surface-selected); color: var(--link); }
    .badge-warn { background: var(--warn-subtle); color: var(--warn); }
    .person-footer { display: flex; gap: 0.4rem; align-items: center; margin-top: 0.5rem; flex-wrap: wrap; }
    .person-edit { margin-top: 0.6rem; border-top: 1px dashed var(--border); padding-top: 0.6rem; display: flex; flex-direction: column; gap: 0.4rem; }
    .person-edit summary { cursor: pointer; color: var(--link); font-size: 0.8rem; font-weight: 600; }
    .person-edit textarea { width: 100%; padding: 0.5rem 0.7rem; border-radius: 8px; border: 1px solid var(--border-strong); background: var(--surface-input); color: var(--text-strong); font-size: 0.82rem; font-family: inherit; resize: vertical; }
    .person-edit input[type="file"] { color: var(--text-muted); font-size: 0.78rem; max-width: 22rem; }
    .person-edit .edit-actions { display: flex; gap: 0.4rem; flex-wrap: wrap; align-items: center; }
    .person-edit .hint { color: var(--text-faint); font-size: 0.72rem; }
    .cand { display: flex; justify-content: space-between; gap: 0.75rem; flex-wrap: wrap; align-items: center; padding: 0.6rem 0.75rem; border: 1px solid var(--border); border-radius: 8px; margin-top: 0.5rem; }
    .cand-name { font-weight: 600; color: var(--text-strong); font-size: 0.875rem; }
    .cand-sub { color: var(--text-muted); font-size: 0.75rem; }
    .cand-form { display: flex; gap: 0.4rem; align-items: center; }
    .cand-form select { padding: 0.4rem 0.6rem; border-radius: 8px; border: 1px solid var(--border-strong); background: var(--surface-input); color: var(--text-strong); font-size: 0.8125rem; }
    .field { display: flex; flex-direction: column; gap: 0.25rem; margin-top: 0.5rem; }
    .field label { font-size: 0.75rem; font-weight: 600; color: var(--text-muted); }
    .field input[type="text"], .field input[type="email"], .field select { padding: 0.55rem 0.75rem; border-radius: 8px; border: 1px solid var(--border-strong); background: var(--surface-input); color: var(--text-strong); font-size: 0.875rem; max-width: 22rem; }
    .mode-pill { display: inline-flex; border: 1px solid var(--border-strong); border-radius: 999px; overflow: hidden; }
    .mode-pill button { background: transparent; border: none; color: var(--text-muted); font-family: inherit; font-size: 0.78rem; font-weight: 600; padding: 0.4rem 0.9rem; cursor: pointer; }
    .mode-pill button.active { background: var(--primary); color: var(--on-primary); }
    .selected-chip { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.35rem 0.7rem; border: 1px solid var(--border-strong); border-radius: 8px; font-size: 0.8rem; color: var(--text-strong); background: var(--surface-selected); }
    .selected-chip button { background: transparent; border: none; color: var(--danger); cursor: pointer; font-family: inherit; font-size: 0.85rem; padding: 0; }
    .filter-row { display: flex; gap: 0.6rem; flex-wrap: wrap; align-items: flex-end; }
    .empty { color: var(--text-faint); font-size: 0.875rem; padding: 1rem 0; }
    .alert { margin-bottom: 1rem; padding: 0.9rem 1rem; border-radius: 10px; font-size: 0.9rem; }
    .alert.success { background: var(--success-subtle); border: 1px solid var(--success-border); color: var(--success); }
    .alert.error { background: var(--danger-subtle); border: 1px solid var(--danger-border); color: var(--danger); }
    footer { text-align: center; padding: 2rem; color: var(--text-faint); font-size: 0.75rem; }
  </style>
  <%- include('../../partials/theme') %>
  <%- include('../../partials/mobile-fixes') %>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="logo"><span class="logo-icon">◆</span> Gerência de Eventos</a>
      <nav class="topbar-nav">
        <% if (isAdmin || isEventAdmin) { %><a href="/admin">Dashboard</a><% } %>
        <a href="/author" class="btn btn-secondary">Área do Participante</a>
        <a href="/admin/events" class="active">Eventos</a>
        <% if (isAdmin) { %><a href="/admin/users">Usuários</a><% } %>
        <% if (userEmail) { %><span class="session-pill"><%= userEmail %></span><% } %>
        <form method="POST" action="/admin/logout" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn-logout">Sair</button></form>
      </nav>
    </div>
  </header>

  <main class="main-content">
    <div class="page-header">
      <h1><%= activity ? activity.name : 'Palestrantes e Professores do evento' %></h1>
      <p><%= activity ? `Vínculos de professor/palestrante desta atividade · ${event.name}` : `${event.name}` %></p>
      <a href="/admin/events/<%= event.id %>/activities" class="btn btn-ghost">← Atividades</a>
    </div>

    <% if (success) { %><div class="alert success"><%= success %></div><% } %>
    <% if (error) { %><div class="alert error"><%= error %></div><% } %>

    <% if (typeof activity !== 'undefined' && activity) { %>
    <div class="card">
      <h2>Vincular pessoa (professor/palestrante)</h2>
      <form method="GET" class="search-row">
        <input type="text" name="q" value="<%= query %>" placeholder="Buscar por nome ou e-mail (mín. 2 letras)">
        <button type="submit" class="btn btn-ghost">Buscar</button>
      </form>
      <% if (query && query.length >= 2) { %>
        <% if (candidates.length === 0) { %>
          <div class="empty">Nenhum usuário aprovado encontrado para a busca <%= JSON.stringify(query) %>.</div>
        <% } %>
        <% candidates.forEach(function (c) { %>
          <div class="cand">
            <div>
              <div class="cand-name"><%= c.name %></div>
              <div class="cand-sub"><%= c.email %><% if (c.institution) { %> · <%= c.institution %><% } %><% if (!(c.photo_path && String(c.mini_bio || '').trim())) { %> · perfil incompleto<% } %></div>
            </div>
            <form method="POST" action="/admin/events/<%= event.id %>/activities/<%= activity.id %>/people" class="cand-form" nonce="<%= cspNonce %>">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="user_id" value="<%= c.id %>">
              <select name="role" required>
                <option value="speaker">Palestrante</option>
                <option value="teacher">Professor</option>
              </select>
              <button type="submit" class="btn btn-primary">Vincular</button>
            </form>
          </div>
        <% }) %>
      <% } %>
    </div>
    <% } %>

    <% if (typeof activity === 'undefined' || !activity) { %>
    <div class="card">
      <h2>Filtrar por atividade</h2>
      <form method="GET" class="filter-row">
        <input type="hidden" name="q" value="<%= query %>">
        <select name="activity" onchange="this.form.submit()">
          <option value="">Todas as atividades</option>
          <% (activities || []).forEach(function (a) { %>
            <option value="<%= a.id %>" <%= activityFilter === a.id ? 'selected' : '' %>><%= a.name %></option>
          <% }) %>
        </select>
        <button type="submit" class="btn btn-ghost">Filtrar</button>
      </form>
    </div>

    <div class="card" id="email-group-card">
      <h2>Vincular pessoa (professor/palestrante)</h2>
      <div class="mode-pill">
        <button type="button" id="mode-existing" class="active" onclick="switchPeopleMode('existing')">Conta existente</button>
        <button type="button" id="mode-new" onclick="switchPeopleMode('new')">Criar nova conta</button>
      </div>
      <form method="GET" class="search-row" id="people-search-form" style="margin-top:0.6rem">
        <input type="hidden" name="activity" value="<%= typeof activityFilter !== 'undefined' && activityFilter ? activityFilter : '' %>">
        <input type="text" name="q" value="<%= query %>" placeholder="Buscar conta por nome ou e-mail (mín. 2 letras)">
        <button type="submit" class="btn btn-ghost">Buscar</button>
      </form>
      <% if (query && query.length >= 2) { %>
        <% if (candidates.length === 0) { %>
          <div class="empty">Nenhum usuário aprovado encontrado para a busca <%= JSON.stringify(query) %>.</div>
        <% } %>
        <% candidates.forEach(function (c) { %>
          <div class="cand">
            <div>
              <div class="cand-name"><%= c.name %></div>
              <div class="cand-sub"><%= c.email %><% if (c.institution) { %> · <%= c.institution %><% } %><% if (!(c.photo_path && String(c.mini_bio || '').trim())) { %> · perfil incompleto<% } %></div>
            </div>
            <button type="button" class="btn btn-ghost" onclick='selectCandidate(<%- JSON.stringify({ id: c.id, name: c.name, email: c.email }) %>)'>Selecionar</button>
          </div>
        <% }) %>
      <% } %>
      <form method="POST" action="/admin/events/<%= event.id %>/people" id="people-link-form" style="margin-top:0.75rem" class="search-row">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="account_mode" id="account_mode" value="existing">
        <div id="existing-fields" class="field" style="margin-top:0.5rem">
          <label>Conta selecionada</label>
          <span id="selected-chip" class="empty">Use a busca acima e clique em Selecionar.</span>
          <input type="hidden" name="user_id" id="user_id" value="">
        </div>
        <div id="new-fields" class="field" style="display:none;margin-top:0.5rem">
          <label for="new-name">Nome da nova conta</label>
          <input type="text" id="new-name" name="name" value="" maxlength="200" autocomplete="off">
          <label for="new-email">E-mail da nova conta</label>
          <input type="email" id="new-email" name="email" value="" maxlength="200" autocomplete="off">
          <label for="new-institution">Instituição (opcional)</label>
          <input type="text" id="new-institution" name="institution" value="" maxlength="200" autocomplete="off">
        </div>
        <div class="field">
          <label for="link-activity">Atividade do evento</label>
          <select id="link-activity" name="activity_id" required>
            <option value="">Selecione a atividade</option>
            <% (activities || []).forEach(function (a) { %>
              <option value="<%= a.id %>" <%= activityFilter === a.id ? 'selected' : '' %>><%= a.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="field">
          <label for="link-role">Papel</label>
          <select id="link-role" name="role" required>
            <option value="speaker">Palestrante</option>
            <option value="teacher">Professor</option>
          </select>
        </div>
        <button type="submit" class="btn btn-primary">Vincular</button>
      </form>
      <div class="hint" style="margin-top:0.4rem;color:var(--text-faint);font-size:0.72rem">
        Ao criar uma conta, o e-mail inclui um link de uso único (72h) para a pessoa definir a própria senha. A inscrição no evento não é automática: use o botão "Inscrever no evento" na lista abaixo.
      </div>
    </div>
    <% } %>

    <div class="card">
      <h2>Vinculados ( <%= people.length %> )</h2>
      <% if (people.length === 0) { %>
        <div class="empty">Nenhum professor/palestrante vinculado<% if (typeof activity !== 'undefined' && activity) { %> a esta atividade<% } %> ainda.</div>
      <% } else { %>
        <ul class="people-list">
          <% people.forEach(function (p) { %>
            <li class="person">
              <div class="photo-circle">
                <% if (p.photo_path) { %><img src="/<%= p.photo_path %>" alt="Foto de <%= p.name %>"><% } else { %><span class="photo-initial"><%= (p.name.trim()[0] || '◆').toUpperCase() %></span><% } %>
              </div>
              <div class="person-body">
                <div class="person-name"><%= p.name %></div>
                <div class="person-sub"><%= p.roleLabel %><% if (p.institution) { %> · <%= p.institution %><% } %><% if (!activity && p.activity_name) { %> · <%= p.activity_name %><% } %></div>
                <% if (p.mini_bio) { %><div class="person-bio"><%= p.mini_bio %></div><% } %>
                <div class="person-footer">
                  <% if (!p.profileComplete) { %><span class="badge badge-warn">Perfil incompleto (foto/mini currículo)</span><% } else { %><span class="badge">Perfil completo</span><% } %>
                  <% if (typeof activity === 'undefined' || !activity) { %>
                    <% if (p.event_registered) { %><span class="badge">Inscrito no evento</span><% } else { %><span class="badge badge-warn">Não inscrito no evento</span><% } %>
                  <% } %>
                  <% if (typeof activity !== 'undefined' && activity) { %>
                    <form method="POST" action="/admin/events/<%= event.id %>/activities/<%= activity.id %>/people/<%= p.user_id %>/<%= p.role %>/delete" onsubmit="return confirm('Remover o vínculo de <%= JSON.stringify(p.name) %> (<%= p.roleLabel %>)?');" nonce="<%= cspNonce %>">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-danger">Remover</button>
                    </form>
                  <% } else if (p.activity_id) { %>
                    <form method="POST" action="/admin/events/<%= event.id %>/activities/<%= p.activity_id %>/people/<%= p.user_id %>/<%= p.role %>/delete" onsubmit="return confirm('Remover o vínculo de <%= JSON.stringify(p.name) %> (<%= p.roleLabel %>) em <%= JSON.stringify(p.activity_name) %>?');" nonce="<%= cspNonce %>">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-danger">Remover</button>
                    </form>
                    <% if (!p.event_registered) { %>
                      <form method="POST" action="/admin/events/<%= event.id %>/people/<%= p.user_id %>/register" onsubmit="return confirm('Inscrever <%= JSON.stringify(p.name) %> neste evento como Participante (ouvinte)?');" nonce="<%= cspNonce %>">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="activity_id" value="<%= p.activity_id %>">
                        <button type="submit" class="btn btn-ghost">Inscrever no evento</button>
                      </form>
                    <% } %>
                  <% } %>
                </div>
                <details class="person-edit">
                  <summary>Editar foto e mini currículo de <%= p.name %></summary>
                  <form method="POST" action="/admin/events/<%= event.id %>/people/<%= p.user_id %>/profile" enctype="multipart/form-data" nonce="<%= cspNonce %>">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="user_id" value="<%= p.user_id %>">
                    <% if (typeof activity !== 'undefined' && activity) { %><input type="hidden" name="activity_id" value="<%= activity.id %>"><% } %>
                    <label class="hint">Nova foto (PNG, JPG ou JPEG, até 5 MB; substitui a atual):</label>
                    <input type="file" name="photo" accept=".png,.jpg,.jpeg">
                    <label class="hint">Mini currículo (até 1000 caracteres):</label>
                    <textarea name="mini_bio" rows="3" maxlength="1000"><%= p.mini_bio || '' %></textarea>
                    <div class="edit-actions">
                      <button type="submit" class="btn btn-primary">Salvar perfil</button>
                    </div>
                  </form>
                  <% if (p.photo_path) { %>
                    <form method="POST" action="/admin/events/<%= event.id %>/people/<%= p.user_id %>/profile" onsubmit="return confirm('Remover a foto atual de <%= JSON.stringify(p.name) %>?');" nonce="<%= cspNonce %>">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="user_id" value="<%= p.user_id %>">
                      <input type="hidden" name="remove_photo" value="1">
                      <% if (typeof activity !== 'undefined' && activity) { %><input type="hidden" name="activity_id" value="<%= activity.id %>"><% } %>
                      <div class="edit-actions">
                        <button type="submit" class="btn btn-danger">Remover foto</button>
                      </div>
                    </form>
                  <% } %>
                </details>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  </main>

  <footer>&copy; <%= year %> LIGEM.Redes • <%= appVersion || '' %></footer>
  <script nonce="<%= cspNonce %>">
    function switchPeopleMode(mode) {
      document.getElementById('account_mode').value = mode;
      document.getElementById('mode-existing').classList.toggle('active', mode === 'existing');
      document.getElementById('mode-new').classList.toggle('active', mode === 'new');
      document.getElementById('existing-fields').style.display = mode === 'existing' ? 'flex' : 'none';
      document.getElementById('new-fields').style.display = mode === 'new' ? 'flex' : 'none';
      document.getElementById('people-search-form').style.display = mode === 'existing' ? 'flex' : 'none';
    }
    function selectCandidate(candidate) {
      document.getElementById('user_id').value = String(candidate.id);
      var chip = document.getElementById('selected-chip');
      chip.className = 'selected-chip';
      chip.innerHTML = '';
      var nameEl = document.createElement('strong');
      nameEl.textContent = candidate.name;
      var emailEl = document.createElement('span');
      emailEl.style.color = 'var(--text-muted)';
      emailEl.textContent = candidate.email;
      var clear = document.createElement('button');
      clear.type = 'button';
      clear.textContent = '×';
      clear.title = 'Remover selecão';
      clear.onclick = function () { clearCandidate(); };
      chip.appendChild(nameEl);
      chip.appendChild(emailEl);
      chip.appendChild(clear);
    }
    function clearCandidate() {
      document.getElementById('user_id').value = '';
      var chip = document.getElementById('selected-chip');
      chip.className = 'empty';
      chip.textContent = 'Use a busca acima e clique em Selecionar.';
    }
  </script>
</body>
</html>
