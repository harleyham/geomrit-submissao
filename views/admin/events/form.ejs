<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Gerência de Eventos</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="/lib/flatpickr/flatpickr.min.css" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: #0a0f1a; color: #e2e8f0; min-height: 100vh; }
    .topbar { background: rgba(15,23,42,0.8); border-bottom: 1px solid rgba(148,163,184,0.1); backdrop-filter: blur(20px); padding: 0 2rem; height: 64px; display: flex; align-items: center; position: sticky; top: 0; z-index: 100; }
    .topbar-inner { width: 100%; max-width: 1400px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
    .logo { font-size: 1.25rem; font-weight: 700; color: #e2e8f0; text-decoration: none; }
    .logo-icon { color: #60a5fa; }
    .topbar-nav { display: flex; gap: 0.25rem; align-items: center; }
    .topbar-nav a { color: #94a3b8; padding: 0.5rem 0.75rem; border-radius: 6px; text-decoration: none; font-size: 0.875rem; font-weight: 500; }
    .topbar-nav a:hover { color: #e2e8f0; background: rgba(148,163,184,0.1); }
    .main-content { max-width: 800px; margin: 0 auto; padding: 2rem; }
    .page-header { margin-bottom: 2rem; }
    .page-header h1 { font-size: 1.75rem; font-weight: 700; color: #f1f5f9; }
    .section { background: rgba(30,41,59,0.6); border: 1px solid rgba(148,163,184,0.1); border-radius: 12px; padding: 2rem; }
    .form-group { margin-bottom: 1.25rem; }
    .form-group label { display: block; color: #94a3b8; font-size: 0.875rem; font-weight: 500; margin-bottom: 0.5rem; }
    .form-group input, .form-group textarea, .form-group select { width: 100%; padding: 0.75rem 1rem; border: 1px solid rgba(148,163,184,0.2); border-radius: 8px; background: rgba(15,23,42,0.5); color: #e2e8f0; font-size: 0.9375rem; font-family: 'Inter', sans-serif; }
    .form-group input:focus, .form-group textarea:focus, .form-group select:focus { outline: none; border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,0.15); }
    .form-group textarea { min-height: 100px; resize: vertical; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .toggle-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 1.1rem; border: 1px solid rgba(148,163,184,0.14); border-radius: 12px; background: rgba(15,23,42,0.35); margin-bottom: 1.25rem; }
    .toggle-copy strong { display: block; color: #f1f5f9; font-size: 0.95rem; margin-bottom: 0.25rem; }
    .toggle-copy span { display: block; color: #94a3b8; font-size: 0.82rem; line-height: 1.5; }
    .switch { position: relative; display: inline-flex; width: 54px; height: 30px; flex-shrink: 0; }
    .switch input { opacity: 0; width: 0; height: 0; }
    .switch-slider { position: absolute; inset: 0; cursor: pointer; background: rgba(100,116,139,0.5); border-radius: 999px; transition: 0.2s; }
    .switch-slider:before { content: ""; position: absolute; height: 22px; width: 22px; left: 4px; top: 4px; background: #fff; border-radius: 50%; transition: 0.2s; }
    .switch input:checked + .switch-slider { background: #3b82f6; }
    .switch input:checked + .switch-slider:before { transform: translateX(24px); }
    .submission-settings.is-hidden { display: none; }
    .btn { display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.625rem 1.25rem; border-radius: 8px; font-size: 0.875rem; font-weight: 500; cursor: pointer; border: none; transition: all 0.15s; text-decoration: none; }
    .btn-primary { background: #3b82f6; color: white; }
    .btn-primary:hover { background: #2563eb; }
    .btn-danger { background: #dc2626; color: white; }
    .btn-danger:hover { background: #b91c1c; }
    .btn-ghost { background: transparent; color: #94a3b8; border: 1px solid rgba(148,163,184,0.2); }
    .btn-ghost:hover { background: rgba(148,163,184,0.1); color: #e2e8f0; }
    .session-pill { padding: 0.42rem 0.78rem; border: 1px solid rgba(148,163,184,0.18); border-radius: 999px; color: #e2e8f0; font-size: 0.82rem; }
    .btn-logout { background: transparent; color: #f87171; border: 1px solid rgba(248,113,113,0.25); font-family: inherit; cursor: pointer; }
    .btn-secondary { background: rgba(148,163,184,0.12); color: #e2e8f0; border: 1px solid rgba(148,163,184,0.18); text-decoration: none; }
    .btn-secondary:hover { background: rgba(148,163,184,0.2); }
    .form-actions { display: flex; gap: 0.75rem; justify-content: space-between; align-items: center; margin-top: 2rem; flex-wrap: wrap; }
    .form-actions-main { display: flex; gap: 0.75rem; justify-content: flex-end; flex-wrap: wrap; }
    .help-text { color: #64748b; font-size: 0.75rem; margin-top: 0.375rem; }
    .logo-preview { margin-top: 0.75rem; display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap; }
    .logo-preview[hidden] { display: none; }
    .logo-preview-image { max-height: 96px; max-width: 280px; object-fit: contain; background: #fff; border-radius: 8px; padding: 6px; }
    .logo-preview-name { color: #94a3b8; font-size: 0.8rem; overflow-wrap: anywhere; }
    .alert { margin-bottom: 1rem; padding: 0.9rem 1rem; border-radius: 10px; font-size: 0.9rem; }
    .alert-error { background: rgba(239,68,68,0.1); border: 1px solid rgba(248,113,113,0.25); color: #fca5a5; }
    .email-card { margin:1.5rem 0;padding:1.25rem;border:1px solid rgba(96,165,250,.2);border-radius:12px;background:rgba(30,64,175,.08); }
    .email-card h2 { font-size:1.05rem;margin-bottom:.35rem;color:#f8fafc; }
    footer { text-align: center; padding: 2rem; color: #475569; font-size: 0.75rem; }
  </style>
  <%- include('../../partials/mobile-fixes') %>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="logo"><span class="logo-icon">◆</span> Gerência de Eventos</a>
      <nav class="topbar-nav">
        <a href="/admin">Dashboard</a>
        <a href="/admin/events">Eventos</a>
        <a href="/admin/users">Usuários</a>
        <% if (userEmail) { %><span class="session-pill"><%= userEmail %></span><% } %>
        <form method="POST" action="/admin/logout" style="display:inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-logout">Sair</button>
        </form>
      </nav>
    </div>
  </header>

  <main class="main-content">
    <div class="page-header">
      <h1><%= event ? 'Editar Evento' : 'Novo Evento' %></h1>
    </div>

    <% if (event) { %>
      <form id="delete-event-form" method="POST" action="/admin/events/<%= event.id %>" nonce="<%= cspNonce %>" onsubmit="return confirm('Tem certeza que deseja apagar o evento <%= event.name %>? Esta ação não poderá ser desfeita.');">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="_method" value="DELETE">
      </form>
    <% } %>

    <form method="POST" enctype="multipart/form-data" action="<%= event ? '/admin/events/' + event.id : '/admin/events' %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="section">
        <% if (error) { %>
          <div class="alert alert-error"><%= error %></div>
        <% } %>
        <div class="form-group">
          <label for="name">Nome do Evento *</label>
          <input type="text" id="name" name="name" required value="<%= event ? event.name : '' %>">
        </div>
        <div class="form-group">
          <label for="logo">Logo do Evento</label>
          <input type="file" id="logo" name="logo" accept="image/png,image/jpeg,.png,.jpg,.jpeg">
          <div class="help-text">Imagem PNG ou JPEG com até 5 MB. Exibida na página de eventos, no crachá, nas listas de presença e nas folhas com QR Code.</div>
          <div id="logo-preview" class="logo-preview" <%= event && event.logo_path ? '' : 'hidden' %>>
            <img id="logo-preview-image" class="logo-preview-image" src="<%= event && event.logo_path ? '/uploads/event-logos/' + String(event.logo_path).split('/').pop() : '' %>" alt="Prévia do logo do evento">
            <div>
              <div id="logo-preview-name" class="logo-preview-name"><%= event && event.logo_original_name ? event.logo_original_name : '' %></div>
              <% if (event && event.logo_path) { %>
              <label style="display:flex;align-items:center;gap:0.5rem;color:#94a3b8;font-size:0.875rem;font-weight:500;cursor:pointer;margin:0;">
                <input type="checkbox" id="remove_logo" name="remove_logo" value="1" style="width:auto;"> Remover logo atual
              </label>
              <% } %>
            </div>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="short_name">Sigla</label>
            <input type="text" id="short_name" name="short_name" value="<%= event ? event.short_name : '' %>">
          </div>
          <div class="form-group">
            <label for="area">Áreas / Trilhas *</label>
            <textarea id="area" name="area" rows="3" required placeholder="Ex.: Inteligência Artificial, Educação, Engenharia de Software"><%= event ? event.area : '' %></textarea>
            <small style="display:block;margin-top:0.4rem;color:#94a3b8;">Informe uma ou mais áreas separadas por vírgula, ponto e vírgula ou quebra de linha.</small>
          </div>
        </div>
        <div class="form-group">
          <label for="url">URL do Evento</label>
          <input type="url" id="url" name="url" value="<%= event ? event.url : '' %>">
        </div>
        <div class="form-group">
          <label for="event_pdf">Conteúdo do evento em PDF</label>
          <input type="file" id="event_pdf" name="event_pdf" accept="application/pdf,.pdf">
          <div class="help-text">PDF de até 50 MB. Quando enviado, ficará disponível em uma página pública própria do evento.</div>
          <% if (event && event.content_pdf_path) { %>
            <div style="margin-top:0.75rem;display:flex;align-items:center;gap:1rem;flex-wrap:wrap;">
              <% if (event.status !== 'draft') { %>
                <a href="/evento/<%= event.id %>/conteudo" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">Visualizar conteúdo publicado</a>
              <% } else { %>
                <span style="color:#fbbf24;">O conteúdo ficará público quando o evento for publicado.</span>
              <% } %>
              <span style="color:#cbd5e1;"><%= event.content_pdf_original_name || 'PDF do evento' %></span>
              <label style="display:flex;align-items:center;gap:0.5rem;color:#94a3b8;font-size:0.875rem;font-weight:500;cursor:pointer;margin:0;">
                <input type="checkbox" id="remove_event_pdf" name="remove_event_pdf" value="1" style="width:auto;"> Remover PDF atual
              </label>
            </div>
          <% } %>
        </div>
        <div class="form-group">
          <label for="status">Status</label>
          <select id="status" name="status">
            <option value="draft" <%= !event || event.status === 'draft' ? 'selected' : '' %>>Rascunho</option>
            <option value="published" <%= event && event.status === 'published' ? 'selected' : '' %>>Publicado</option>
            <option value="encerrado" <%= event && event.status === 'encerrado' ? 'selected' : '' %>>Encerrado</option>
          </select>
          <small style="display:block;margin-top:0.4rem;color:#94a3b8;">Eventos encerrados saem da página inicial e não aceitam novas inscrições ou submissões, mas permanecem disponíveis para consulta por sua URL.</small>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="date_start">Data Início *</label>
            <input type="text" id="date_start" name="date_start" class="datepicker" required value="<%= event ? formatBRDate(event.date_start) : '' %>">
          </div>
          <div class="form-group">
            <label for="date_end">Data Fim</label>
            <input type="text" id="date_end" name="date_end" class="datepicker" value="<%= event ? formatBRDate(event.date_end) : '' %>">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="registration_start">Início Inscrições</label>
            <input type="text" id="registration_start" name="registration_start" class="datepicker" value="<%= event ? formatBRDate(event.registration_start) : '' %>">
          </div>
          <div class="form-group">
            <label for="registration_end">Fim Inscrições</label>
            <input type="text" id="registration_end" name="registration_end" class="datepicker" value="<%= event ? formatBRDate(event.registration_end) : '' %>">
          </div>
        </div>
        <div class="toggle-row">
          <div class="toggle-copy">
            <strong>Inscrições abertas ao público?</strong>
            <span>Ative para permitir que qualquer pessoa se inscreva no evento. Desative para que apenas a administração cadastre os participantes.</span>
          </div>
          <label class="switch" for="public_registration">
            <input type="checkbox" id="public_registration" name="public_registration" value="1" <%= !event || event.public_registration !== 0 ? 'checked' : '' %>>
            <span class="switch-slider"></span>
          </label>
        </div>
        <div class="form-group">
          <label for="registration_approval_mode">Confirmação das inscrições públicas</label>
          <select id="registration_approval_mode" name="registration_approval_mode">
            <option value="automatic" <%= !event || event.registration_approval_mode !== 'review' ? 'selected' : '' %>>Inscrição automática — confirma imediatamente</option>
            <option value="review" <%= event && event.registration_approval_mode === 'review' ? 'selected' : '' %>>Inscrição a ser analisada — administração aprova ou rejeita atividades</option>
          </select>
          <small style="display:block;margin-top:0.4rem;color:#94a3b8;">Na análise, a organização pode aprovar somente parte das atividades solicitadas.</small>
        </div>
        <div class="toggle-row">
          <div class="toggle-copy">
            <strong>Este evento terá submissão de artigos?</strong>
            <span>Ative para configurar as datas de submissão e análise das submissões.</span>
          </div>
          <label class="switch" for="has_article_submission">
            <input type="checkbox" id="has_article_submission" name="has_article_submission" value="1" <%= event && event.has_article_submission ? 'checked' : '' %>>
            <span class="switch-slider"></span>
          </label>
        </div>
        <div class="submission-settings <%= event && event.has_article_submission ? '' : 'is-hidden' %>" data-submission-settings>
          <div class="form-row">
            <div class="form-group">
              <label for="submission_start">Início Submissão</label>
              <input type="text" id="submission_start" name="submission_start" class="datepicker" value="<%= event ? formatBRDate(event.submission_start) : '' %>">
            </div>
            <div class="form-group">
              <label for="submission_end">Fim Submissão</label>
              <input type="text" id="submission_end" name="submission_end" class="datepicker" value="<%= event ? formatBRDate(event.submission_end) : '' %>">
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="review_start">Início Análise das Submissões</label>
              <input type="text" id="review_start" name="review_start" class="datepicker" value="<%= event ? formatBRDate(event.review_start) : '' %>">
            </div>
            <div class="form-group">
              <label for="review_end">Fim Análise das Submissões</label>
              <input type="text" id="review_end" name="review_end" class="datepicker" value="<%= event ? formatBRDate(event.review_end) : '' %>">
            </div>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="certificates_start">Início Certificados</label>
            <input type="text" id="certificates_start" name="certificates_start" class="datepicker" value="<%= event ? formatBRDate(event.certificates_start) : '' %>">
          </div>
          <div class="form-group">
            <label for="certificates_end">Fim Certificados</label>
            <input type="text" id="certificates_end" name="certificates_end" class="datepicker" value="<%= event ? formatBRDate(event.certificates_end) : '' %>">
          </div>
        </div>
        <div class="form-group">
          <label for="location">Local</label>
          <input type="text" id="location" name="location" value="<%= event ? event.location : '' %>">
        </div>
        <div class="form-group">
          <label for="description">Descrição</label>
          <textarea id="description" name="description" rows="4"><%= event ? event.description : '' %></textarea>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="institution">Instituição</label>
            <input type="text" id="institution" name="institution" value="<%= event ? event.institution : '' %>">
          </div>
          <div class="form-group">
            <label for="language">Idioma</label>
            <select id="language" name="language">
              <option value="pt" <%= event && event.language === 'pt' ? 'selected' : '' %>>Português</option>
              <option value="es" <%= event && event.language === 'es' ? 'selected' : '' %>>Español</option>
              <option value="en" <%= event && event.language === 'en' ? 'selected' : '' %>>English</option>
              <option value="other" <%= event && event.language === 'other' ? 'selected' : '' %>>Outro</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label for="offers_subsidy">O evento oferece subsídio a participantes?</label>
          <select id="offers_subsidy" name="offers_subsidy">
            <option value="0" <%= !event || !event.offers_subsidy ? 'selected' : '' %>>Não</option>
            <option value="1" <%= event && event.offers_subsidy ? 'selected' : '' %>>Sim</option>
          </select>
          <div class="help-text">Defina se o evento prevê algum tipo de apoio financeiro, bolsa ou subsídio para participantes.</div>
        </div>
        <div class="email-card">
          <h2>Identidade dos e-mails</h2>
          <p class="help-text" style="margin-bottom:1rem;">O master switch global está <strong style="color:<%= systemEmailSettings.email_enabled ? '#86efac' : '#fca5a5' %>"><%= systemEmailSettings.email_enabled ? 'ativado' : 'desativado' %></strong>. O evento também precisa estar habilitado para enviar mensagens.</p>
          <div class="toggle-row">
            <div class="toggle-copy"><strong>Habilitar e-mails deste evento?</strong><span>Desligado por padrão. Quando desligado, nenhum gatilho deste evento envia mensagens.</span></div>
            <label class="switch" for="email_enabled"><input type="checkbox" id="email_enabled" name="email_enabled" value="1" <%= event && event.email_enabled ? 'checked' : '' %>><span class="switch-slider"></span></label>
          </div>
          <div class="form-row">
            <div class="form-group"><label for="email_platform_name">Nome da plataforma</label><input type="text" maxlength="160" id="email_platform_name" name="email_platform_name" value="<%= event ? event.email_platform_name || '' : '' %>" placeholder="Padrão: nome do evento"></div>
            <div class="form-group"><label for="email_sender_name">Nome do remetente</label><input type="text" maxlength="160" id="email_sender_name" name="email_sender_name" value="<%= event ? event.email_sender_name || '' : '' %>" placeholder="Padrão: nome do evento"></div>
          </div>
          <div class="form-group"><label for="email_signature">Assinatura</label><textarea maxlength="1000" id="email_signature" name="email_signature" rows="3" placeholder="Padrão: Equipe organizadora"><%= event ? event.email_signature || '' : '' %></textarea></div>
          <div class="form-group" style="margin-bottom:0"><label for="email_contact">E-mail de contato (Reply-To)</label><input type="email" maxlength="254" id="email_contact" name="email_contact" value="<%= event ? event.email_contact || '' : '' %>" placeholder="Padrão: contato SMTP do sistema"><div class="help-text">O endereço SMTP real permanece configurado no servidor; respostas serão encaminhadas a este contato.</div></div>
        </div>
      </div>
      <div class="form-actions">
        <div>
          <% if (event) { %>
            <button type="submit" form="delete-event-form" class="btn btn-danger">Apagar Evento</button>
          <% } %>
        </div>
        <div class="form-actions-main">
          <a href="/admin/events" class="btn btn-ghost">Cancelar</a>
          <button type="submit" class="btn btn-primary"><%= event ? 'Salvar' : 'Criar Evento' %></button>
        </div>
      </div>
    </form>
  </main>

  <script nonce="<%= cspNonce %>">
    (function() {
      var toggle = document.getElementById('has_article_submission');
      var settings = document.querySelector('[data-submission-settings]');
      var submissionStart = document.getElementById('submission_start');
      var submissionEnd = document.getElementById('submission_end');
      var reviewStart = document.getElementById('review_start');
      var reviewEnd = document.getElementById('review_end');
      var logoInput = document.getElementById('logo');
      var logoPreview = document.getElementById('logo-preview');
      var logoPreviewImage = document.getElementById('logo-preview-image');
      var logoPreviewName = document.getElementById('logo-preview-name');
      var removeLogo = document.getElementById('remove_logo');
      var eventPdfInput = document.getElementById('event_pdf');
      var removeEventPdf = document.getElementById('remove_event_pdf');
      var previewObjectUrl = null;

      if (logoInput && logoPreview && logoPreviewImage) {
        logoInput.addEventListener('change', function() {
          var file = logoInput.files && logoInput.files[0];
          if (!file) return;
          if (previewObjectUrl) URL.revokeObjectURL(previewObjectUrl);
          previewObjectUrl = URL.createObjectURL(file);
          logoPreviewImage.src = previewObjectUrl;
          logoPreviewName.textContent = file.name;
          logoPreview.hidden = false;
          if (removeLogo) removeLogo.checked = false;
        });
        window.addEventListener('beforeunload', function() {
          if (previewObjectUrl) URL.revokeObjectURL(previewObjectUrl);
        });
      }

      if (eventPdfInput && removeEventPdf) {
        eventPdfInput.addEventListener('change', function() {
          if (eventPdfInput.files && eventPdfInput.files[0]) removeEventPdf.checked = false;
        });
      }

      if (!toggle || !settings) return;

      function syncSubmissionSettings() {
        var enabled = toggle.checked;
        settings.classList.toggle('is-hidden', !enabled);

        if (!enabled) {
          submissionStart.value = '';
          submissionEnd.value = '';
          reviewStart.value = '';
          reviewEnd.value = '';
        }
      }

       toggle.addEventListener('change', syncSubmissionSettings);
       syncSubmissionSettings();
     })();
   </script>

  <script src="/lib/flatpickr/flatpickr.min.js" nonce="<%= cspNonce %>"></script>
  <script src="/lib/flatpickr/l10n/pt.js" nonce="<%= cspNonce %>"></script>
  <script src="/lib/flatpickr/init.js" nonce="<%= cspNonce %>"></script>

   <footer>&copy; <%= year %> LIGEM.Redes • <%= typeof appVersion !== 'undefined' ? appVersion : 'V0.1' %></footer>
<%- include("../../partials/csrf-inject") %>
</body>
</html>
