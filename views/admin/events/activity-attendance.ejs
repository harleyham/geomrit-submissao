<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"><style>*{box-sizing:border-box;margin:0;padding:0}body{font-family:'Inter',sans-serif;background:#0a0f1a;color:#e2e8f0;min-height:100vh}.topbar{background:rgba(15,23,42,0.8);border-bottom:1px solid rgba(148,163,184,0.1);backdrop-filter:blur(20px);padding:0 2rem;height:64px;display:flex;align-items:center;position:sticky;top:0;z-index:100}.topbar-inner{width:100%;max-width:1440px;margin:0 auto;display:flex;align-items:center;justify-content:space-between}.logo{font-size:1.25rem;font-weight:700;color:#e2e8f0;text-decoration:none}.logo-icon{color:#60a5fa}.topbar-nav{display:flex;gap:0.25rem;align-items:center}.topbar-nav a{color:#94a3b8;padding:0.5rem 0.75rem;border-radius:6px;text-decoration:none;font-size:0.875rem;font-weight:500}.topbar-nav a:hover,.topbar-nav a.active{color:#e2e8f0;background:rgba(148,163,184,0.1)}.main{max-width:1440px;margin:0 auto;padding:2rem}.page-header{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;margin-bottom:1.5rem}.page-header h1{font-size:1.75rem;font-weight:700;color:#f8fafc}.page-header p{color:#94a3b8;margin-top:0.4rem}.header-actions{display:flex;gap:0.75rem;flex-wrap:wrap}.btn{display:inline-flex;align-items:center;gap:0.35rem;padding:0.55rem 0.9rem;border-radius:8px;font-size:0.8125rem;font-weight:600;text-decoration:none;border:1px solid transparent;cursor:pointer}.btn-primary{background:#2563eb;color:white}.btn-ghost{background:transparent;color:#94a3b8;border-color:rgba(148,163,184,0.18)}.btn-ghost:hover{background:rgba(148,163,184,0.1);color:#e2e8f0}.btn-sm{padding:0.35rem 0.7rem;font-size:0.75rem}.btn-danger{color:#fca5a5;border-color:rgba(248,113,113,0.35);background:transparent}.card{background:rgba(30,41,59,0.6);border:1px solid rgba(148,163,184,0.1);border-radius:12px;padding:1.25rem;margin:1rem 0}table{width:100%;border-collapse:collapse}th{padding:.8rem 1.2rem;text-align:left;color:#64748b;font-size:.72rem;text-transform:uppercase;letter-spacing:.05em;background:rgba(15,23,42,0.25)}td{padding:.85rem 1.2rem;border-top:1px solid rgba(148,163,184,0.07);vertical-align:middle;font-size:.86rem}tr:hover td{background:rgba(148,163,184,0.03)}strong{color:#f8fafc}small{color:#94a3b8}.badge{display:inline-flex;border-radius:999px;font-size:.72rem;font-weight:700;padding:.25rem .6rem}.present{background:rgba(34,197,94,.15);color:#86efac}.absent{background:rgba(148,163,184,.14);color:#cbd5e1}.workload{color:#fbbf24}.row-form{display:flex;align-items:center;gap:.5rem}.alert{padding:.85rem 1rem;border-radius:9px;margin-bottom:1rem}.success{color:#86efac;background:rgba(34,197,94,.1);border:1px solid rgba(74,222,128,.22)}.error{color:#fca5a5;background:rgba(239,68,68,.1);border:1px solid rgba(248,113,113,.24)}.form-group{display:flex;flex-direction:column;gap:.35rem}.form-row{display:flex;gap:.75rem;align-items:end;flex-wrap:wrap}input,select{border:1px solid rgba(148,163,184,0.18);border-radius:8px;background:rgba(2,6,23,0.42);color:#f8fafc;padding:.65rem .75rem;font:inherit;font-size:.86rem}label{display:block;color:#94a3b8;font-size:.78rem;margin-bottom:.4rem}.empty-state{padding:2rem 1.25rem;color:#94a3b8}.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:1rem;margin-bottom:1.5rem}.stat{background:rgba(30,41,59,0.6);border:1px solid rgba(148,163,184,0.1);border-radius:12px;padding:1.1rem}.stat-value{color:#f8fafc;font-size:1.7rem;font-weight:700}.stat-label{color:#64748b;font-size:.73rem;text-transform:uppercase;letter-spacing:.05em;margin-top:.25rem}footer{text-align:center;padding:2rem;color:#475569;font-size:.75rem}@media(max-width:900px){.page-header{flex-direction:column}.stats{grid-template-columns:1fr}}</style></head><body><header class="topbar"><div class="topbar-inner"><a href="/" class="logo"><span class="logo-icon">◆</span> Artigos LIGEM</a><nav class="topbar-nav"><a href="/admin">Dashboard</a><a href="/admin/events" class="active">Eventos</a><a href="/admin/events/<%= event.id %>/activities" class="active">Atividades</a></nav></div></header><main class="main"><p style="margin-bottom:1rem"><a href="/admin/events/<%= event.id %>/activities">← Voltar às atividades</a></p><div class="page-header"><div><h1>Presença — <%= activity.name %></h1><p><span class="badge badge-<%= activity.activity_type %>"><%= activity.activity_type === 'lecture' ? 'Palestra' : activity.activity_type === 'seminar' ? 'Seminário' : activity.activity_type === 'roundtable' ? 'Mesa redonda' : activity.activity_type === 'course' ? 'Minicurso' : 'Outra' %></span> · Data: <strong><%= activity.activity_date || 'Não informada' %></strong> · Carga horária: <span class="workload"><%= activity.workload_hours %>h</span></p></div><div class="header-actions"><a href="/admin/events/<%= event.id %>/certificates" class="btn btn-ghost">Certificados</a></div></div><% if(success){ %><p class="alert success"><%= success %></p><% } %><% if(error){ %><p class="alert error"><%= error %></p><% } %>
<section class="card"><h2>Regra de certificado para esta atividade</h2><p style="color:#94a3b8;font-size:.85rem;margin-bottom:0.75rem">Define o número mínimo de presenças (nesta atividade) necessário para elegibilidade de certificado.</p><form method="post" action="/admin/events/<%= event.id %>/activities/<%= activity.id %>/certificate-rule"><div class="form-row"><div class="form-group" style="max-width:200px"><label for="min_attendance">Mínimo de presenças</label><input id="min_attendance" type="number" min="1" name="min_attendance" value="<%= (activityRule && activityRule.min_attendance) || 1 %>"></div><div class="form-group" style="max-width:280px"><label for="background_id">Fundo do certificado</label><select id="background_id" name="background_id"><option value="">Sem fundo específico (usa o fundo do evento)</option><optgroup label="Fundos padrão"><% backgrounds.filter(b=>String(b.file_path||'').startsWith('assets/Fundos/')).forEach(b=>{ %><option value="<%= b.id %>" <%= (activityRule && Number(activityRule.background_id)===Number(b.id))?'selected':'' %>><%= b.name %></option><% }) %></optgroup><optgroup label="Fundos enviados"><% backgrounds.filter(b=>!String(b.file_path||'').startsWith('assets/Fundos/')).forEach(b=>{ %><option value="<%= b.id %>" <%= (activityRule && Number(activityRule.background_id)===Number(b.id))?'selected':'' %>><%= b.name %></option><% }) %></optgroup></select></div><button class="btn btn-primary">Salvar regra</button></div></form></section>
<section class="card" style="margin-top:1.5rem"><h2>Lista de participantes</h2><div class="stats"><div class="stat"><div class="stat-value"><%= participants.filter(p=>p.present).length %></div><div class="stat-label">Presentes</div></div><div class="stat"><div class="stat-value"><%= participants.filter(p=>!p.present).length %></div><div class="stat-label">Ausentes</div></div><div class="stat"><div class="stat-value"><%= participants.length %></div><div class="stat-label">Total inscritos</div></div></div><% if (participants.length === 0) { %><div class="empty-state">Nenhum participante inscrito neste evento.</div><% } else { %><table><thead><tr><th>Participante</th><th>Tipo</th><th>Situação</th><th>Ação</th></tr></thead><tbody><% participants.forEach(p=>{ %><tr><td><strong><%= p.name %></strong><br><small><%= p.email %><br><%= p.institution || 'Instituição não informada' %></small></td><td><span class="badge <%= p.registration_type === 'author' ? 'present' : 'absent' %>"><%= p.registration_type === 'author' ? 'Com artigo' : 'Participante' %></span></td><td><% if (p.present) { %><span class="badge present">Presente</span><% } else { %><span class="badge absent">Ausente</span><% } %></td><td><form class="row-form" method="post" action="/admin/events/<%= event.id %>/activities/<%= activity.id %>/attendance/<%= p.id %>"><button class="btn btn-sm <%= p.present ? 'btn-danger' : 'btn-primary' %>" type="submit" name="action" value="<%= p.present ? 'absent' : 'present' %>"><%= p.present ? 'Remover' : 'Marcar presente' %></button></form></td></tr><% }) %></tbody></table><% } %>
</section></main><footer>&copy; <%= year %> LIGEM.Redes • <%= typeof appVersion !== 'undefined' ? appVersion : 'V0.1' %></footer></body></html>
