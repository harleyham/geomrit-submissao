<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: #0a0f1a; color: #e2e8f0; min-height: 100vh; }
    .topbar { background: rgba(15,23,42,0.8); border-bottom: 1px solid rgba(148,163,184,0.1); backdrop-filter: blur(20px); padding: 0 2rem; height: 64px; display: flex; align-items: center; position: sticky; top: 0; z-index: 100; }
    .topbar-inner { width: 100%; max-width: 1440px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
    .logo { font-size: 1.25rem; font-weight: 700; color: #e2e8f0; text-decoration: none; }
    .logo-icon { color: #60a5fa; }
    .topbar-nav { display:flex; gap:0.4rem; align-items:center; flex-wrap:wrap; }
    .topbar-nav a { color: #94a3b8; padding: 0.5rem 0.75rem; border-radius: 6px; text-decoration: none; font-size: 0.875rem; font-weight: 500; }
    .topbar-nav a:hover, .topbar-nav a.active { color: #e2e8f0; background: rgba(148,163,184,0.1); }
    .session-pill { padding: 0.42rem 0.78rem; border: 1px solid rgba(148,163,184,0.18); border-radius: 999px; color: #e2e8f0; font-size: 0.82rem; }
    .btn-logout { background: transparent; color: #f87171; border: 1px solid rgba(248,113,113,0.25); font-family: inherit; cursor: pointer; }
    .btn-secondary { background: rgba(148,163,184,0.12); color: #e2e8f0; border: 1px solid rgba(148,163,184,0.18); }
    .btn-secondary:hover { background: rgba(148,163,184,0.2); }
    .btn-ghost { background: transparent; color: #94a3b8; border: 1px solid rgba(148,163,184,0.2); font-size: 0.875rem; padding: 0.5rem 1rem; }
    .btn-ghost:hover { background: rgba(148,163,184,0.1); color: #e2e8f0; }
    .btn-ghost.btn-sm { padding: 0.3rem 0.5rem; font-size: 0.75rem; }
    .btn { display: inline-flex; align-items: center; justify-content: center; padding: 0.625rem 1.25rem; border-radius: 8px; font-size: 0.875rem; font-weight: 500; cursor: pointer; border: none; text-decoration: none; }
    .btn-sm { padding: 0.3rem 0.5rem; font-size: 0.75rem; }
    .main-content { max-width: 1440px; margin: 0 auto; padding: 2rem; }
    .page-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
    .page-header h1 { font-size: 1.75rem; font-weight: 700; color: #f8fafc; }
    .page-header p { color: #94a3b8; margin-top: 0.4rem; font-size: 0.9rem; }
    .header-back { color: #93c5fd; text-decoration: none; font-size: 0.9rem; display: inline-flex; align-items: center; gap: 0.4rem; margin-bottom: 0.75rem; }
    .header-back:hover { color: #bfdbfe; }
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
    .stat-card { background: rgba(30,41,59,0.6); border: 1px solid rgba(148,163,184,0.1); border-radius: 12px; padding: 1.2rem; }
    .stat-value { font-size: 1.85rem; font-weight: 700; color: #f8fafc; }
    .stat-label { color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.74rem; margin-top: 0.25rem; }
    .section { background: rgba(30,41,59,0.6); border: 1px solid rgba(148,163,184,0.1); border-radius: 12px; overflow: hidden; margin-bottom: 1.5rem; }
    .section-header { padding: 1.2rem 1.5rem; border-bottom: 1px solid rgba(148,163,184,0.1); display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
    .section-header h2 { font-size: 1.1rem; font-weight: 600; color: #f1f5f9; }
    .section-body { padding: 1.5rem; }
    .alert { margin-bottom: 1rem; padding: 0.9rem 1rem; border-radius: 10px; font-size: 0.9rem; }
    .alert-success { background: rgba(34,197,94,0.1); border: 1px solid rgba(74,222,128,0.22); color: #86efac; }
    .alert-error { background: rgba(239,68,68,0.1); border: 1px solid rgba(248,113,113,0.24); color: #fca5a5; }
    table { width: 100%; border-collapse: collapse; }
    th { text-align: left; padding: 0.85rem 1rem; font-size: 0.76rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; border-bottom: 1px solid rgba(148,163,184,0.15); }
    td { padding: 0.85rem 1rem; border-bottom: 1px solid rgba(148,163,184,0.07); vertical-align: middle; font-size: 0.9rem; }
    tr:last-child td { border-bottom: none; }
    input, select, button { padding: 0.5rem 0.75rem; background: #0f172a; color: #e2e8f0; border: 1px solid #334155; border-radius: 8px; font-size: 0.875rem; font-family: 'Inter', sans-serif; }
    input:focus, select:focus { outline: none; border-color: #60a5fa; box-shadow: 0 0 0 2px rgba(96,165,250,0.15); }
    button { cursor: pointer; font-weight: 500; transition: all 0.15s ease; }
    .btn-primary { background: #2563eb; border-color: #2563eb; color: #fff; }
    .btn-primary:hover { background: #1d4ed8; }
    .btn-success { background: #16a34a; border-color: #16a34a; color: #fff; }
    .btn-success:hover { background: #15803d; }
    .btn-danger { background: #dc2626; border-color: #dc2626; color: #fff; }
    .btn-danger:hover { background: #b91c1c; }
    .btn-ghost { background: transparent; border-color: #334155; color: #94a3b8; }
    .btn-ghost:hover { background: rgba(148,163,184,0.1); color: #e2e8f0; }
    .btn-sm { padding: 0.35rem 0.7rem; font-size: 0.8rem; }
    .badge { display: inline-flex; align-items: center; padding: 0.2rem 0.6rem; border-radius: 999px; font-size: 0.75rem; font-weight: 600; }
    .badge-present { background: rgba(34,197,94,0.15); color: #86efac; border: 1px solid rgba(34,197,94,0.25); }
    .badge-absent { background: rgba(100,116,139,0.15); color: #94a3b8; border: 1px solid rgba(100,116,139,0.25); }
    .badge-role { background: rgba(96,165,250,0.15); color: #93c5fd; border: 1px solid rgba(96,165,250,0.25); }
    .badge-role-teacher { background: rgba(168,85,247,0.15); color: #d8b4fe; border: 1px solid rgba(168,85,247,0.25); }
    .badge-role-speaker { background: rgba(251,146,60,0.15); color: #fdba74; border: 1px solid rgba(251,146,60,0.25); }
    .badge-role-oral { background: rgba(56,189,248,0.15); color: #7dd3fc; border: 1px solid rgba(56,189,248,0.25); }
    .badge-role-poster { background: rgba(192,132,252,0.15); color: #d8b4fe; border: 1px solid rgba(192,132,252,0.25); }
    .form-inline { display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; }
    .form-inline input[type="number"] { width: 90px; }
    .person-name { font-weight: 600; color: #f1f5f9; }
    .person-email { color: #64748b; font-size: 0.8rem; margin-top: 0.15rem; }
    .roles-tags { display: flex; gap: 0.35rem; flex-wrap: wrap; }
    .empty-state { text-align: center; padding: 2rem; color: #64748b; }
    @media (max-width: 768px) {
      .main-content { padding: 1rem; }
      .stats-grid { grid-template-columns: repeat(2, 1fr); }
      .section-body { padding: 1rem; overflow-x: auto; }
      table { min-width: 700px; }
    }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="logo"><span class="logo-icon">◆</span> Artigos LIGEM</a>
      <nav class="topbar-nav">
        <a href="/admin">Dashboard</a>
        <a href="/admin/events">Eventos</a>
        <a href="/admin/events/<%= event.id %>/activities">Atividades</a>
        <a href="/admin/events/<%= event.id %>/participants" class="active">Presença</a>
        <% if (userEmail) { %><span class="session-pill"><%= userEmail %></span><% } %>
        <form method="post" action="/admin/logout" style="display:inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-logout">Sair</button>
        </form>
      </nav>
    </div>
  </header>

  <main class="main-content">
    <a href="/admin/events/<%= event.id %>/activities" class="header-back">← Voltar às atividades</a>

    <div class="page-header">
      <div>
        <h1>Presença — <%= activity.name %></h1>
        <p><%= activity.workload_hours || 0 %>h carga horária · Perfis elegíveis: <%= activity.eligible_roles || 'participant' %></p>
      </div>
    </div>

    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-value"><%= participants.filter(p => p.present).length %></div>
        <div class="stat-label">Presentes</div>
      </div>
      <div class="stat-card">
        <div class="stat-value"><%= participants.filter(p => !p.present).length %></div>
        <div class="stat-label">Ausentes</div>
      </div>
      <div class="stat-card">
        <div class="stat-value"><%= participants.length %></div>
        <div class="stat-label">Total elegível</div>
      </div>
    </div>

    <section class="section">
      <div class="section-header">
        <h2>Vincular participantes e papéis</h2>
      </div>
      <div class="section-body" style="padding:0">
        <% if (participants.length === 0) { %>
          <div class="empty-state">Nenhuma pessoa elegível encontrada para esta atividade.</div>
        <% } else { %>
          <table>
            <thead>
              <tr>
                <th style="width:35%">Pessoa</th>
                <th style="width:25%">Perfis no evento</th>
                <th style="width:25%">Role na atividade</th>
                <th style="width:15%">Presença</th>
              </tr>
            </thead>
            <tbody>
              <% participants.forEach(p => { %>
                <tr>
                  <td>
                    <div class="person-name"><%= p.name %></div>
                    <div class="person-email"><%= p.email %></div>
                  </td>
                  <td>
                    <div class="roles-tags">
                      <% String(p.roles || '').split(',').forEach(r => {
                        const role = r.trim();
                        if (!role) return;
                        let cls = 'badge-role';
                        if (role === 'teacher') cls = 'badge-role-teacher';
                        else if (role === 'speaker') cls = 'badge-role-speaker';
                        else if (role === 'oral_presenter') cls = 'badge-role-oral';
                        else if (role === 'poster_presenter') cls = 'badge-role-poster';
                        else if (role === 'participant') cls = 'badge-role';
                        const labels = {participant:'Participante',reviewer:'Revisor',speaker:'Palestrante',teacher:'Professor',oral_presenter:'Apresent. Oral',poster_presenter:'Apresent. Pôster'};
                      %><span class="badge <%= cls %>"><%= labels[role] || role %></span>
                      <% }); %>
                    </div>
                  </td>
                  <td>
                    <% const attendanceFormId = `attendance-form-${p.user_id}`;
                       const defaultActivityRole = p.activity_role || (p.available_activity_roles.includes('participant') ? 'participant' : p.available_activity_roles[0]); %>
                    <select name="role" form="<%= attendanceFormId %>" style="min-width:170px">
                        <option value="">— selecionar —</option>
                        <% p.available_activity_roles.forEach((role) => { %>
                          <option value="<%= role %>" <%= defaultActivityRole === role ? 'selected' : '' %>><%= roleLabels[role] || role %></option>
                        <% }) %>
                      </select>
                  </td>
                  <td>
                    <form id="<%= attendanceFormId %>" method="post" action="/admin/events/<%= event.id %>/activities/<%= activity.id %>/attendance/<%= p.user_id %>" style="display:flex;gap:.45rem;align-items:center;flex-wrap:wrap">
                    <% if (p.present && p.activity_role) { %>
                      <span class="badge badge-present">Presente</span>
                      <button type="submit" name="action" value="present" class="btn-primary btn-sm">Atualizar</button>
                      <button type="submit" name="action" value="absent" class="btn-danger btn-sm">Remover</button>
                    <% } else { %>
                      <button type="submit" name="action" value="present" class="btn-success btn-sm">Marcar presença</button>
                    <% } %>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </section>
  </main>
<%- include("../../partials/csrf-inject") %>
  </body>
</html>
