<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><title><%=title%></title><style>body{font-family:Arial;background:#0a0f1a;color:#e2e8f0;padding:30px}.card{background:#1e293b;padding:20px;border-radius:10px;margin:15px 0}table{width:100%;border-collapse:collapse}td,th{padding:10px;border-bottom:1px solid #334155;text-align:left}button,input,select{padding:8px;background:#0f172a;color:#fff;border:1px solid #475569}button{background:#2563eb}.present{color:#86efac}.absent{color:#cbd5e1}a{color:#93c5fd}</style></head><body><a href="/admin/events/<%=event.id%>/activities">← Atividades</a><h1>Presença — <%=activity.name%></h1><p><%=activity.workload_hours%>h · Perfis elegíveis: <%=activity.eligible_roles||'participant'%></p><section class="card"><h2>Regra de certificado desta atividade</h2><form method="post" action="/admin/events/<%=event.id%>/activities/<%=activity.id%>/certificate-rule"><input name="min_attendance" type="number" min="1" value="<%=(activityRule&&activityRule.min_attendance)||1%>"><select name="background_id"><option value="">Fundo do evento</option><% backgrounds.forEach(b=>{%><option value="<%=b.id%>" <%=activityRule&&Number(activityRule.background_id)===Number(b.id)?'selected':''%>><%=b.name%></option><%})%></select><button>Salvar regra</button></form></section><section class="card"><h2>Pessoas elegíveis</h2><table><tr><th>Pessoa</th><th>Perfis no evento</th><th>Presença</th><th></th></tr><%participants.forEach(p=>{%><tr><td><strong><%=p.name%></strong><br><small><%=p.email%></small></td><td><%=p.roles||'Participante'%></td><td class="<%=p.present?'present':'absent'%>"><%=p.present?'Presente':'Ausente'%></td><td><form method="post" action="/admin/events/<%=event.id%>/activities/<%=activity.id%>/attendance/<%=p.user_id%>"><button name="action" value="<%=p.present?'absent':'present'%>"><%=p.present?'Remover':'Marcar presente'%></button></form></td></tr><%})%></table></section></body></html>
