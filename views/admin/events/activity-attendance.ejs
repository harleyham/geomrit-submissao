<!doctype html><html><body><h1>Presença — <%= activity.name %></h1><p><a href="/admin/events/<%= activity.event_id %>/activities">Atividades</a></p><table><% participants.forEach(p=>{ %><tr><td><%= p.name %></td><td><%= p.present?'Presente':'Ausente' %></td><td><form method="post" action="/admin/events/<%= activity.event_id %>/activities/<%= activity.id %>/attendance/<%= p.id %>"><button name="action" value="<%= p.present?'absent':'present' %>"><%= p.present?'Remover':'Marcar presente' %></button></form></td></tr><% }) %></table></body></html>
