<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; }
    .topbar { background: var(--surface); border-bottom: 1px solid var(--border); backdrop-filter: blur(20px); padding: 0 2rem; height: 64px; display: flex; align-items: center; position: sticky; top: 0; z-index: 100; }
    .topbar-inner { width: 100%; max-width: 1440px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
    .logo { font-size: 1.25rem; font-weight: 700; color: var(--text); text-decoration: none; }
    .logo-icon { color: var(--accent); }
    .topbar-nav { display:flex; gap:0.4rem; align-items:center; flex-wrap:wrap; }
    .topbar-nav a { color: var(--text-muted); padding: 0.5rem 0.75rem; border-radius: 6px; text-decoration: none; font-size: 0.875rem; font-weight: 500; }
    .topbar-nav a:hover, .topbar-nav a.active { color: var(--text); background: var(--border); }
    .session-pill { padding: 0.42rem 0.78rem; border: 1px solid rgba(148,163,184,0.18); border-radius: 999px; color: var(--text); font-size: 0.82rem; }
    .btn-logout { background: transparent; color: var(--danger); border: 1px solid rgba(248,113,113,0.25); font-family: inherit; cursor: pointer; }
    .btn-secondary { background: rgba(148,163,184,0.12); color: var(--text); border: 1px solid rgba(148,163,184,0.18); }
    .btn-secondary:hover { background: rgba(148,163,184,0.2); }
    .btn-ghost { background: transparent; color: var(--text-muted); border: 1px solid rgba(148,163,184,0.2); font-size: 0.875rem; padding: 0.5rem 1rem; }
    .btn-ghost:hover { background: var(--border); color: var(--text); }
    .btn-ghost.btn-sm { padding: 0.3rem 0.5rem; font-size: 0.75rem; }
    .btn { display: inline-flex; align-items: center; justify-content: center; padding: 0.625rem 1.25rem; border-radius: 8px; font-size: 0.875rem; font-weight: 500; cursor: pointer; border: none; text-decoration: none; }
    .btn-sm { padding: 0.3rem 0.5rem; font-size: 0.75rem; }
    .main-content { max-width: 1440px; margin: 0 auto; padding: 2rem; }
    .page-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
    .page-header h1 { font-size: 1.75rem; font-weight: 700; color: var(--text-strong); }
    .page-header p { color: var(--text-muted); margin-top: 0.4rem; font-size: 0.9rem; }
    .header-back { color: var(--link); text-decoration: none; font-size: 0.9rem; display: inline-flex; align-items: center; gap: 0.4rem; margin-bottom: 0.75rem; }
    .header-back:hover { color: #bfdbfe; }
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
    .stat-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 1.2rem; }
    .stat-value { font-size: 1.85rem; font-weight: 700; color: var(--text-strong); }
    .stat-label { color: var(--text-faint); text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.74rem; margin-top: 0.25rem; }
    .section { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; margin-bottom: 1.5rem; }
    .section-header { padding: 1.2rem 1.5rem; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
    .section-header h2 { font-size: 1.1rem; font-weight: 600; color: var(--text-strong); }
    .section-body { padding: 1.5rem; }
    .alert { margin-bottom: 1rem; padding: 0.9rem 1rem; border-radius: 10px; font-size: 0.9rem; }
    .alert-success { background: rgba(34,197,94,0.1); border: 1px solid rgba(74,222,128,0.22); color: #86efac; }
    .alert-error { background: rgba(239,68,68,0.1); border: 1px solid rgba(248,113,113,0.24); color: #fca5a5; }
    table { width: 100%; border-collapse: collapse; }
    th { text-align: left; padding: 0.85rem 1rem; font-size: 0.76rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-faint); border-bottom: 1px solid rgba(148,163,184,0.15); }
    td { padding: 0.85rem 1rem; border-bottom: 1px solid rgba(148,163,184,0.07); vertical-align: middle; font-size: 0.9rem; }
    tr:last-child td { border-bottom: none; }
    input, select, button { padding: 0.5rem 0.75rem; background: var(--surface); color: var(--text); border: 1px solid var(--border); border-radius: 8px; font-size: 0.875rem; font-family: 'Inter', sans-serif; }
    input:focus, select:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 2px rgba(96,165,250,0.15); }
    button { cursor: pointer; font-weight: 500; transition: all 0.15s ease; }
    .btn-primary { background: var(--primary-hover); border-color: var(--primary-hover); color: #fff; }
    .btn-primary:hover { background: #1d4ed8; }
    .btn-success { background: #16a34a; border-color: #16a34a; color: #fff; }
    .btn-success:hover { background: #15803d; }
    .btn-danger { background: #dc2626; border-color: #dc2626; color: #fff; }
    .btn-danger:hover { background: #b91c1c; }
    .btn-ghost { background: transparent; border-color: var(--border); color: var(--text-muted); }
    .btn-ghost:hover { background: var(--border); color: var(--text); }
    .btn-sm { padding: 0.35rem 0.7rem; font-size: 0.8rem; }
    .badge { display: inline-flex; align-items: center; padding: 0.2rem 0.6rem; border-radius: 999px; font-size: 0.75rem; font-weight: 600; }
    .badge-present { background: rgba(34,197,94,0.15); color: #86efac; border: 1px solid rgba(34,197,94,0.25); }
    .badge-absent { background: rgba(100,116,139,0.15); color: var(--text-muted); border: 1px solid rgba(100,116,139,0.25); }
    .badge-role { background: rgba(96,165,250,0.15); color: var(--link); border: 1px solid rgba(96,165,250,0.25); }
    .badge-role-teacher { background: rgba(168,85,247,0.15); color: #d8b4fe; border: 1px solid rgba(168,85,247,0.25); }
    .badge-role-speaker { background: rgba(251,146,60,0.15); color: #fdba74; border: 1px solid rgba(251,146,60,0.25); }
    .badge-role-oral { background: rgba(56,189,248,0.15); color: #7dd3fc; border: 1px solid rgba(56,189,248,0.25); }
    .badge-role-poster { background: rgba(192,132,252,0.15); color: #d8b4fe; border: 1px solid rgba(192,132,252,0.25); }
    .form-inline { display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; }
    .form-inline input[type="number"] { width: 90px; }
    .person-name { font-weight: 600; color: var(--text-strong); }
    .person-email { color: var(--text-faint); font-size: 0.8rem; margin-top: 0.15rem; }
    tr.row-marked { background: rgba(34,197,94,0.08); }
    tr.row-marked td { border-bottom-color: rgba(74,222,128,0.25); }
    .qr-help { color: var(--text-muted); font-size: 0.82rem; line-height: 1.5; margin-top: 0.9rem; }
    #qr-code-input { min-width: 250px; letter-spacing: 0.15em; text-transform: uppercase; }
    #qr-camera-overlay { position: fixed; inset: 0; background: rgba(2,6,23,0.93); z-index: 200; display: flex; align-items: center; justify-content: center; }
    #qr-camera-overlay[hidden] { display: none; }
    #qr-video { width: min(88vw, 460px); border-radius: 12px; border: 1px solid rgba(148,163,184,0.35); background: #000; }
    #qr-camera-close { position: absolute; top: 1.2rem; right: 1.4rem; background: rgba(148,163,184,0.12); border: 1px solid rgba(148,163,184,0.25); color: var(--text); }
    .roles-tags { display: flex; gap: 0.35rem; flex-wrap: wrap; }
    .empty-state { text-align: center; padding: 2rem; color: var(--text-faint); }
    .evaluations-list { display: flex; flex-direction: column; gap: 0.75rem; }
    .evaluation-item { padding: 0.9rem 1rem; border: 1px solid rgba(148,163,184,0.15); border-radius: 10px; background: rgba(15,23,42,0.3); }
    .evaluation-head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 0.4rem; }
    .evaluation-head strong { color: var(--text-strong); }
    .evaluation-head span { color: var(--text-faint); font-size: 0.78rem; }
    .evaluation-item p { color: var(--text); font-size: 0.88rem; line-height: 1.55; white-space: pre-wrap; }
    @media (max-width: 768px) {
      .main-content { padding: 1rem; }
      .stats-grid { grid-template-columns: repeat(2, 1fr); }
      .section-body { padding: 1rem; overflow-x: auto; }
      table { min-width: 700px; }
    }
  </style>
  <%- include('../../partials/theme') %>
  <%- include('../../partials/mobile-fixes') %>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="logo"><span class="logo-icon">◆</span> Gerência de Eventos</a>
      <nav class="topbar-nav">
        <% if (isAdmin) { %><a href="/admin">Dashboard</a><% } %>
        <a href="/admin/events">Eventos</a>
        <a href="/admin/events/<%= event.id %>/activities">Atividades</a>
        <a href="/admin/events/<%= event.id %>/participants" class="active">Presença</a>
        <% if (userEmail) { %><span class="session-pill"><%= userEmail %></span><% } %>
        <form method="post" action="/admin/logout" style="display:inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-logout">Sair</button>
        </form>
      </nav>
    </div>
  </header>

  <main class="main-content">
    <a href="/admin/events/<%= event.id %>/activities" class="header-back">← Voltar às atividades</a>

    <div class="page-header">
      <div>
        <h1>Presença — <%= activity.name %><% if (selectedSession) { %> · <%= selectedSession.name %><% } %></h1>
        <p>
          <% if (selectedSession) { %><%= selectedSession.session_date ? formatBRDate(selectedSession.session_date) : 'Data a definir' %><% if (Number(selectedSession.workload_hours) > 0) { %> · <%= selectedSession.workload_hours %>h<% } %><% } else { %><%= activityDateRange(activity) %><% if (Number(activity.workload_hours) > 0) { %> · <%= activity.workload_hours %>h carga horária<% } %><% } %>
          · Perfis elegíveis: <%= (activity.eligible_roles || 'participant').split(',').map((r) => roleLabels[r.trim()] || r.trim()).join(', ') %>
        </p>
      </div>
      <div>
        <a href="/admin/events/<%= event.id %>/activities/<%= activity.id %>/attendance-print<%= selectedSession ? `?session_id=${selectedSession.id}` : '' %>" class="btn-secondary btn-sm" style="text-decoration:none">Imprimir lista de presença</a>
      </div>
    </div>

    <% if (sessions && sessions.length) { %>
    <div style="display:flex;gap:0.4rem;flex-wrap:wrap;margin-bottom:1.2rem">
      <% sessions.forEach((s) => { const active = selectedSession && selectedSession.id === s.id; %>
        <a href="/admin/events/<%= event.id %>/activities/<%= activity.id %>/attendance?session_id=<%= s.id %>" class="btn-sm" style="text-decoration:none;padding:0.4rem 0.9rem;border-radius:999px;font-size:0.8rem;border:1px solid <%= active ? 'var(--primary-hover)' : 'var(--border)' %>;background:<%= active ? 'rgba(37,99,235,0.18)' : 'transparent' %>;color:<%= active ? 'var(--link)' : 'var(--text-muted)' %>"><%= s.sequence_no %>. <%= s.name %></a>
      <% }) %>
    </div>
    <% } %>

    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-value"><%= participants.filter(p => p.present).length %></div>
        <div class="stat-label">Presentes</div>
      </div>
      <div class="stat-card">
        <div class="stat-value"><%= participants.filter(p => !p.present).length %></div>
        <div class="stat-label">Ausentes</div>
      </div>
      <div class="stat-card">
        <div class="stat-value"><%= participants.length %></div>
        <div class="stat-label">Total elegível</div>
      </div>
    </div>

    <section class="section">
      <div class="section-header">
        <h2>Presença por QR Code (crachá)</h2>
      </div>
      <div class="section-body">
        <form method="post" action="/admin/events/<%= event.id %>/activities/<%= activity.id %>/attendance/qr" id="qr-form" class="form-inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% if (selectedSession) { %><input type="hidden" name="session_id" value="<%= selectedSession.id %>"><% } %>
          <input type="text" name="code" id="qr-code-input" placeholder="Código do crachá (ex.: K7PM39QX2W)" autocomplete="off" autocapitalize="characters" spellcheck="false">
          <button type="submit" class="btn-primary">Marcar</button>
          <button type="button" id="qr-camera-btn" class="btn-ghost">Ler QR Code</button>
        </form>
        <p class="qr-help" id="qr-help">Aponte a câmera para o QR Code do crachá do participante (ou digite o código exibido na tela dele). A presença é registrada com o mesmo efeito do botão “Marcar presença” da lista abaixo, no papel que a pessoa possui nesta atividade.</p>
      </div>
    </section>

    <section class="section">
      <div class="section-header">
        <h2>Vincular participantes e papéis</h2>
        <form method="post" action="/admin/events/<%= event.id %>/activities/<%= activity.id %>/attendance-bulk" style="display:flex;gap:.45rem;align-items:center">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% if (selectedSession) { %><input type="hidden" name="session_id" value="<%= selectedSession.id %>"><% } %>
          <button type="submit" name="bulk_action" value="mark_all_present" class="btn-success btn btn-sm">Marcar presença (todos)</button>
          <button type="submit" name="bulk_action" value="unmark_all_present" class="btn-danger btn btn-sm">Desmarcar presença (todos)</button>
        </form>
      </div>
      <div class="section-body" style="padding:0">
        <% if (participants.length === 0) { %>
          <div class="empty-state">Nenhuma pessoa elegível encontrada para esta atividade.</div>
        <% } else { %>
          <table>
            <thead>
              <tr>
                <th style="width:35%">Pessoa</th>
                <th style="width:25%">Perfis no evento</th>
                <th style="width:25%">Role na atividade</th>
                <th style="width:15%">Presença</th>
              </tr>
            </thead>
            <tbody>
              <% participants.forEach(p => { %>
                <tr id="person-row-<%= p.user_id %>"<% if (markedUserId === p.user_id) { %> class="row-marked"<% } %>>
                  <td>
                    <div class="person-name"><%= p.name %></div>
                    <div class="person-email"><%= p.email %></div>
                  </td>
                  <td>
                    <div class="roles-tags">
                      <% String(p.roles || '').split(',').forEach(r => {
                        const role = r.trim();
                        if (!role) return;
                        let cls = 'badge-role';
                        if (role === 'teacher') cls = 'badge-role-teacher';
                        else if (role === 'speaker') cls = 'badge-role-speaker';
                        else if (role === 'oral_presenter') cls = 'badge-role-oral';
                        else if (role === 'poster_presenter') cls = 'badge-role-poster';
                        else if (role === 'participant') cls = 'badge-role';
                        const labels = {participant:'Participante',reviewer:'Revisor',speaker:'Palestrante',teacher:'Professor',oral_presenter:'Apresent. Oral',poster_presenter:'Apresent. Pôster'};
                      %><span class="badge <%= cls %>"><%= labels[role] || role %></span>
                      <% }); %>
                    </div>
                  </td>
                  <td>
                    <% const attendanceFormId = `attendance-form-${p.user_id}`;
                       const defaultActivityRole = p.activity_role || (p.available_activity_roles.includes('participant') ? 'participant' : p.available_activity_roles[0]); %>
                    <select name="role" form="<%= attendanceFormId %>" style="min-width:170px">
                        <option value="">— selecionar —</option>
                        <% p.available_activity_roles.forEach((role) => { %>
                          <option value="<%= role %>" <%= defaultActivityRole === role ? 'selected' : '' %>><%= roleLabels[role] || role %></option>
                        <% }) %>
                      </select>
                  </td>
                  <td>
                    <form id="<%= attendanceFormId %>" method="post" action="/admin/events/<%= event.id %>/activities/<%= activity.id %>/attendance/<%= p.user_id %>" style="display:flex;gap:.45rem;align-items:center;flex-wrap:wrap">
                    <% if (selectedSession) { %><input type="hidden" name="session_id" value="<%= selectedSession.id %>"><% } %>
                    <% if (p.present && p.activity_role) { %>
                      <span class="badge badge-present">Presente</span>
                      <button type="submit" name="action" value="present" class="btn-primary btn-sm">Atualizar</button>
                      <button type="submit" name="action" value="absent" class="btn-danger btn-sm">Remover</button>
                    <% } else { %>
                      <button type="submit" name="action" value="present" class="btn-success btn-sm">Marcar presença</button>
                    <% } %>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </section>

    <section class="section">
      <div class="section-header">
        <h2>Avaliações dos participantes</h2>
      </div>
      <div class="section-body">
        <% if (!evaluations.length) { %>
          <div class="empty-state">Nenhuma avaliação registrada para esta atividade.</div>
        <% } else { %>
          <div class="evaluations-list">
            <% evaluations.forEach((ev) => { %>
              <div class="evaluation-item">
                <div class="evaluation-head"><strong><%= ev.name %></strong><span><%= formatBRDate(ev.updated_at) %></span></div>
                <p><%= ev.evaluation %></p>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </section>
  </main>

  <div id="qr-camera-overlay" hidden>
    <video id="qr-video" playsinline muted></video>
    <button type="button" id="qr-camera-close">Fechar (Esc)</button>
  </div>
  <canvas id="qr-canvas" hidden></canvas>
  <script src="/lib/jsQR.min.js" nonce="<%= cspNonce %>"></script>
  <script nonce="<%= cspNonce %>">
    (function () {
      var form = document.getElementById('qr-form');
      var codeInput = document.getElementById('qr-code-input');
      var cameraBtn = document.getElementById('qr-camera-btn');
      var overlay = document.getElementById('qr-camera-overlay');
      var video = document.getElementById('qr-video');
      var canvas = document.getElementById('qr-canvas');
      var help = document.getElementById('qr-help');
      var stream = null;
      var scanning = false;

      function stopCamera() {
        scanning = false;
        if (stream) { stream.getTracks().forEach(function (track) { track.stop(); }); stream = null; }
        if (video) video.srcObject = null;
        if (overlay) overlay.hidden = true;
      }

      function handleScan(text) {
        var code = String(text || '').toUpperCase().replace(/[^A-Z0-9]/g, '');
        if (code.length < 8 || code.length > 16) { stopCamera(); return; }
        stopCamera();
        if (navigator.vibrate) navigator.vibrate(180);
        codeInput.value = code;
        form.submit();
      }

      function tick() {
        if (!scanning) return;
        if (video.readyState === video.HAVE_ENOUGH_DATA) {
          canvas.width = video.videoWidth;
          canvas.height = video.videoHeight;
          var ctx = canvas.getContext('2d');
          ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
          var imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
          var result = window.jsQR(imageData.data, imageData.width, imageData.height, { inversionAttempts: 'dontInvert' });
          if (result && result.data) { handleScan(result.data); return; }
        }
        requestAnimationFrame(tick);
      }

      cameraBtn.addEventListener('click', function () {
        if (scanning) { stopCamera(); return; }
        if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia || typeof window.jsQR === 'undefined') {
          help.innerHTML = 'Câmera indisponível neste navegador ou contexto (a câmera exige HTTPS ou localhost). Use a digitação manual do código.';
          return;
        }
        navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } })
          .then(function (s) {
            stream = s;
            video.srcObject = stream;
            overlay.hidden = false;
            scanning = true;
            video.play().catch(function () {});
            requestAnimationFrame(tick);
          })
          .catch(function () {
            help.innerHTML = 'Não foi possível acessar a câmera. Verifique as permissões do navegador ou use a digitação manual do código.';
          });
      });

      document.getElementById('qr-camera-close').addEventListener('click', stopCamera);
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && scanning) stopCamera(); });

      <% if (markedUserId) { %>
      var markedRow = document.getElementById('person-row-<%= markedUserId %>');
      if (markedRow) markedRow.scrollIntoView({ behavior: 'smooth', block: 'center' });
      <% } %>
    })();
  </script>
<%- include("../../partials/csrf-inject") %>
  </body>
</html>
