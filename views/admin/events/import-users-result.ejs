<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--text);margin:0}.topbar{background:var(--surface);border-bottom:1px solid var(--border);backdrop-filter:blur(20px);padding:0 2rem;height:64px;display:flex;align-items:center;position:sticky;top:0;z-index:100}.topbar-inner{width:100%;max-width:1400px;margin:0 auto;display:flex;align-items:center;justify-content:space-between}.logo{font-size:1.25rem;font-weight:700;color:var(--text);text-decoration:none}.logo-icon{color:var(--accent)}.topbar-nav{display:flex;gap:0.25rem;align-items:center}.topbar-nav a{color:var(--text-muted);padding:0.5rem 0.75rem;border-radius:6px;text-decoration:none;font-size:0.875rem;font-weight:500;transition:all 0.15s}.topbar-nav a:hover,.topbar-nav a.active{color:var(--text);background:var(--border)}.session-pill{padding:0.42rem 0.78rem;border:1px solid rgba(148,163,184,0.18);border-radius:999px;color:var(--text);font-size:0.82rem}.btn-logout{background:transparent;color:var(--danger);border:1px solid rgba(248,113,113,0.25);font-family:inherit;cursor:pointer}.btn-secondary{background:rgba(148,163,184,0.12);color:var(--text);border:1px solid rgba(148,163,184,0.18);text-decoration:none;font-weight:500;cursor:pointer;font-family:inherit;font-size:0.875rem;padding:0.6rem 1.2rem;border-radius:8px;line-height:1.5}.btn-secondary:hover{background:rgba(148,163,184,0.2)}.btn-primary{background:var(--primary-hover);color:#fff;border:none;padding:0.6rem 1.2rem;border-radius:8px;font-weight:600;cursor:pointer;font-family:inherit;font-size:0.875rem;line-height:1.5}.btn-primary:hover{background:#1d4ed8}.alert{padding:1rem 1.25rem;border-radius:10px;font-size:0.9rem;margin-bottom:1.5rem}.alert-success{background:rgba(34,197,94,0.1);border:1px solid rgba(74,222,128,0.22);color:#86efac}.alert-error{background:rgba(239,68,68,0.1);border:1px solid rgba(248,113,113,0.24);color:#fca5a5}.alert-info{background:rgba(59,130,246,0.1);border:1px solid rgba(96,165,250,0.2);color:var(--link)}.stat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:1rem;margin-bottom:1.5rem}.stat-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:1.25rem;text-align:center}.stat-value{font-size:2rem;font-weight:800}.stat-label{color:var(--text-muted);font-size:0.8rem;margin-top:0.25rem}.main-content{max-width:1000px;margin:0 auto;padding:2rem}.card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:1.5rem;margin-bottom:1.5rem;box-shadow:0 4px 6px rgba(0,0,0,0.1)}.card h2{color:var(--text-strong);font-size:1.1rem;font-weight:600;margin-bottom:1rem}table{width:100%;border-collapse:collapse}.th,.td{padding:0.65rem 0.85rem;text-align:left;border-bottom:1px solid var(--surface-input);font-size:0.875rem}.th{color:var(--text-muted);font-weight:600;font-size:0.78rem;text-transform:uppercase;letter-spacing:0.03em}.td{color:var(--text)}.badge{display:inline-block;padding:0.2rem 0.6rem;border-radius:999px;font-size:0.75rem;font-weight:600}.badge-success{background:rgba(34,197,94,0.15);color:#86efac}.badge-error{background:rgba(239,68,68,0.15);color:#fca5a5}.badge-ignored{background:rgba(148,163,184,0.12);color:var(--text-muted)}
  </style>
  <%- include('../../partials/theme') %>
  <%- include('../../partials/mobile-fixes') %>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="logo"><span class="logo-icon">◆</span> Gerência de Eventos</a>
      <nav class="topbar-nav">
        <% if (isAdmin) { %><a href="/admin">Dashboard</a><% } %>
        <a href="/admin/events" class="active">Eventos</a>
        <% if (isAdmin) { %><a href="/admin/users">Usuários</a><% } %>
        <% if (isEventStaff) { %><span class="session-pill" style="border-color:rgba(244,114,182,0.4);color:#f472b6">Staff</span><% } %>
        <% if (userEmail) { %><span class="session-pill"><%= userEmail %></span><% } %>
        <form method="POST" action="/admin/logout" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-logout">Sair</button></form>
      </nav>
    </div>
  </header>
  <main class="main-content">
    <h1 style="font-size:1.75rem;font-weight:700;color:var(--text-strong);margin-bottom:0.25rem">Resultado da Importação</h1>
    <p style="color:var(--text-muted);margin-bottom:1.5rem">Evento: <strong><%= event.name %></strong> — Relatório pessoa por pessoa (criação de usuários + inscrição no evento).</p>

    <div class="stat-grid">
      <div class="stat-card"><div class="stat-value" style="color:#86efac"><%= successes %></div><div class="stat-label">Sucesso</div></div>
      <div class="stat-card"><div class="stat-value" style="color:#fca5a5"><%= errors %></div><div class="stat-label">Falhas</div></div>
      <div class="stat-card"><div class="stat-value" style="color:var(--warn)"><%= imported %></div><div class="stat-label">Novos Criados</div></div>
      <div class="stat-card"><div class="stat-value" style="color:var(--accent)"><%= skipped %></div><div class="stat-label">Já Existiam</div></div>
      <div class="stat-card"><div class="stat-value" style="color:#a78bfa"><%= registered %></div><div class="stat-label">Inscritos</div></div>
    </div>

    <% if (emailMessage) { %><div class="alert alert-success"><%= emailMessage %></div><% } %>
    <% if (emailError) { %><div class="alert alert-error"><%= emailError %></div><% } %>
    <% if (emailSummary && emailSummary.counts.total > 0) { %>
    <div class="card">
      <h2>Envio de e-mails aos participantes</h2>
      <p style="color:var(--text-muted)">Novas contas e inscrições: <strong><%= emailSummary.counts.account_registration %></strong> · Contas existentes recém-inscritas: <strong><%= emailSummary.counts.registration %></strong>.</p>
      <% if (emailSummary.batch.email_authorized_at) { %><div class="alert alert-success">E-mails deste lote já autorizados.</div>
      <% } else if (!systemEmailSettings.email_enabled) { %><div class="alert alert-error">O master switch global de e-mails está desativado.</div>
      <% } else if (!event.email_enabled) { %><div class="alert alert-error">Os e-mails deste evento estão desativados. Ative o switch em Eventos ou na edição do evento.</div>
      <% } else { %><form method="POST" action="/admin/events/<%= event.id %>/import-authorize-emails" nonce="<%= cspNonce %>" onsubmit="return confirm('Autorizar <%= emailSummary.counts.total %> e-mail(s) deste lote?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn-primary">Autorizar e-mails aos participantes</button></form><% } %>
    </div>
    <% } %>

    <% if (report && report.length) { %>
    <div class="card">
      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.5rem;margin-bottom:1rem">
        <h2 style="margin:0">Relatório detalhado (<%= report.length %> registro(s))</h2>
        <button type="button" id="toggleReport" class="btn-secondary" nonce="<%= cspNonce %>" onclick="document.getElementById('reportTable').style.display=document.getElementById('reportTable').style.display==='none'?'block':'none';this.textContent=this.textContent.includes('Mostrar')?'Ocultar relatório':'Mostrar relatório';">Ocultar relatório</button>
      </div>
      <div class="table-scroll"><table id="reportTable">
        <thead><tr><th class="th">Nome</th><th class="th">E-mail</th><th class="th">Status</th><th class="th">Detalhe</th></tr></thead>
        <tbody>
          <% report.forEach((item) => { %>
          <tr>
            <td class="td"><%= item.name %></td>
            <td class="td"><%= item.email %></td>
            <td class="td">
              <% if (item.status === 'success') { %>
                <span class="badge badge-success">Sucesso</span>
              <% } else if (item.status === 'error') { %>
                <span class="badge badge-error">Falha</span>
              <% } else { %>
                <span class="badge badge-ignored">Ignorado</span>
              <% } %>
            </td>
            <td class="td" style="color:<%= item.status === 'error' ? '#fca5a5' : 'var(--text-muted)' %>"><%= item.detail %></td>
          </tr>
          <% }) %>
        </tbody>
      </table></div>
    </div>
    <% } %>

    <% if (!report || !report.length) { %>
    <div class="alert alert-info">
      <strong>Importação sem resultados.</strong> Possíveis causas: o arquivo não contém linhas com dados válidos, ou as colunas do arquivo não foram detectadas. Verifique se a primeira linha contém os nomes dos campos.
    </div>
    <% } %>

    <div style="display:flex;gap:0.75rem;margin-top:1.5rem">
      <a href="/admin/events/<%= event.id %>/import-users" class="btn-primary">Importar novamente</a>
      <a href="/admin/events/<%= event.id %>/import-download-csv" class="btn-secondary">Download relatório CSV</a>
      <a href="/admin/events/<%= event.id %>/participants" class="btn-secondary">Ir para participantes</a>
      <a href="/admin/events" class="btn-secondary">Voltar aos eventos</a>
    </div>
  </main>
  <%- include("../../partials/csrf-inject") %>
</body>
</html>
