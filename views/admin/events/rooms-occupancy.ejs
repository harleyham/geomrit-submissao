<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %></title>
  <link href="/lib/flatpickr/flatpickr.min.css" rel="stylesheet">
  <style>
    body{font-family:'Inter',sans-serif;background:#0a0f1a;color:#e2e8f0;margin:0}.topbar{background:rgba(15,23,42,0.8);border-bottom:1px solid rgba(148,163,184,0.1);backdrop-filter:blur(20px);padding:0 2rem;height:64px;display:flex;align-items:center;position:sticky;top:0;z-index:100}.topbar-inner{width:100%;max-width:1400px;margin:0 auto;display:flex;align-items:center;justify-content:space-between}.logo{font-size:1.25rem;font-weight:700;color:#e2e8f0;text-decoration:none}.logo-icon{color:#60a5fa}.topbar-nav{display:flex;gap:0.4rem;align-items:center;flex-wrap:wrap}.topbar-nav a{color:#94a3b8;padding:0.5rem 0.75rem;border-radius:6px;text-decoration:none;font-size:0.875rem;font-weight:500;transition:all 0.15s}.topbar-nav a:hover{color:#e2e8f0;background:rgba(148,163,184,0.1)}.session-pill{padding:0.42rem 0.78rem;border:1px solid rgba(148,163,184,0.18);border-radius:999px;color:#94a3b8;font-size:0.82rem}.btn-logout{background:transparent;color:#f87171;border:1px solid rgba(248,113,113,0.25);font-family:inherit;cursor:pointer}.btn{display:inline-flex;align-items:center;justify-content:center;padding:0.625rem 1.25rem;border-radius:8px;font-size:0.875rem;font-weight:500;cursor:pointer;border:none;text-decoration:none}.btn-secondary{background:rgba(148,163,184,0.12);color:#e2e8f0;border:1px solid rgba(148,163,184,0.18);text-decoration:none;font-weight:500}.btn-secondary:hover{background:rgba(148,163,184,0.2)}.main-content{max-width:1400px;margin:0 auto;padding:2rem}.hint{color:#64748b;font-size:0.85rem}.alert{padding:0.9rem 1rem;border-radius:10px;font-size:0.9rem;margin-bottom:1rem}.alert.success{background:rgba(34,197,94,0.1);border:1px solid rgba(74,222,128,0.22);color:#86efac}.alert.error{background:rgba(239,68,68,0.1);border:1px solid rgba(248,113,113,0.24);color:#fca5a5}.card{background:#1e293b;border-radius:10px;padding:16px;margin-bottom:16px}.card h2{font-size:1rem;margin:0 0 10px}.card form{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.card input,.card select{padding:0.5rem 0.75rem;background:#0f172a;color:#e2e8f0;border:1px solid #334155;border-radius:8px;font-size:0.875rem}.card input[type=number]{width:110px}.card textarea{padding:0.5rem 0.75rem;background:#0f172a;color:#e2e8f0;border:1px solid #334155;border-radius:8px;font-size:0.875rem;min-width:320px;flex:1 1 100%}.session-description{max-width:420px;word-break:break-word}.card button{padding:0.5rem 1rem;background:#2563eb;color:#fff;border:none;border-radius:8px;cursor:pointer;font-size:0.875rem}.card button.danger{background:transparent;color:#f87171;border:1px solid rgba(248,113,113,0.25);padding:2px 8px;font-size:11px}table{width:100%;border-collapse:collapse}th{text-align:left;padding:0.7rem 0.9rem;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.05em;color:#64748b;border-bottom:1px solid rgba(148,163,184,0.15)}td{padding:0.7rem 0.9rem;border-bottom:1px solid rgba(148,163,184,0.07);font-size:0.9rem}.empty{color:#64748b;font-size:0.9rem}input[type=number]::-webkit-inner-spin-button,input[type=number]::-webkit-outer-spin-button{-webkit-appearance:none;margin:0}input[type=number]{-moz-appearance:textfield;appearance:textfield}
  </style>
</head>
  <main class="main-content">
    <p style="margin-bottom:8px"><a href="/admin/events/<%= event.id %>/rooms" style="color:#93c5fd;text-decoration:none">← Voltar às salas</a></p>
    <div style="display:flex;justify-content:space-between;align-items:center">
      <h1 style="font-size:1.5rem;margin:0 0 4px">Ocupação das salas por dia — <%= event.name %></h1>
      <button type="button" class="btn-secondary" onclick="window.print()" nonce="<%= cspNonce %>">Imprimir / PDF</button>
    </div>
    <p class="hint">Cada dia mostra as salas do evento e o que está agendado em cada uma. Blocos sem sala (alocações órfãs) aparecem no final do dia.</p>
    <% if (!days.length) { %>
      <section class="card"><h2>Nenhuma alocação de sala registrada</h2><p class="hint">Aloque salas às atividades, etapas ou ao evento para visualizar a ocupação.</p></section>
    <% } %>
    <% days.forEach((day) => { %>
      <section class="card">
        <h2><%= formatBRDate(day.date) %></h2>
        <table>
          <thead><tr><th>Sala</th><th>Tamanho</th><th>Capacidade</th><th>Horários ocupados</th></tr></thead>
          <tbody>
            <% day.rooms.forEach((entry) => { %>
              <tr>
                <td><strong><%= entry.room.name %></strong></td>
                <td><%= roomLabel(entry.room.size) %></td>
                <td><%= entry.room.capacity ? entry.room.capacity + ' lugares' : '—' %></td>
                <td>
                  <% if (!entry.blocks.length) { %><span style="color:#64748b">Livre</span><% } %>
                  <% entry.blocks.forEach((block) => { %>
                    <div style="margin-bottom:4px">
                      <strong style="color:#93c5fd"><%= String(block.time_start).slice(0,5) %>–<%= String(block.time_end).slice(0,5) %></strong>
                      <% if (block.is_event_reservation) { %> · Reserva do evento <% } else if (block.session_id) { %> · <%= block.activity_name ? `${block.activity_name}: ` : '' %><%= block.session_name || 'Etapa' %> <% } else { %> · <%= block.activity_name || 'Atividade' %> <% } %>
                    </div>
                  <% }) %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <% if (day.unscheduled.length) { %>
          <p class="hint" style="color:#fca5a5">Sem sala válida: <%= day.unscheduled.map((b) => `${b.room_name} ${String(b.time_start).slice(0,5)}–${String(b.time_end).slice(0,5)}`).join('; ') %></p>
        <% } %>
      </section>
    <% }) %>
  </main>
  <%- include("../../partials/csrf-inject") %>
  </body>
</html>
