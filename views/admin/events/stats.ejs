<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Artigos LIGEM</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: #0a0f1a; color: #e2e8f0; min-height: 100vh; }
    .topbar { background: rgba(15,23,42,0.8); border-bottom: 1px solid rgba(148,163,184,0.1); backdrop-filter: blur(20px); padding: 0 2rem; height: 64px; display: flex; align-items: center; position: sticky; top: 0; z-index: 100; }
    .topbar-inner { width: 100%; max-width: 1400px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
    .logo { font-size: 1.25rem; font-weight: 700; color: #e2e8f0; text-decoration: none; }
    .logo-icon { color: #60a5fa; }
    .topbar-nav { display: flex; gap: 0.25rem; align-items: center; }
    .topbar-nav a { color: #94a3b8; padding: 0.5rem 0.75rem; border-radius: 6px; text-decoration: none; font-size: 0.875rem; font-weight: 500; }
    .topbar-nav a:hover { color: #e2e8f0; background: rgba(148,163,184,0.1); }
    .main-content { max-width: 1400px; margin: 0 auto; padding: 2rem; }
    .page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem; }
    .page-header h1 { font-size: 1.75rem; font-weight: 700; color: #f1f5f9; }
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
    .stat-card { background: rgba(30,41,59,0.6); border: 1px solid rgba(148,163,184,0.1); border-radius: 12px; padding: 1.5rem; text-align: center; }
    .stat-number { font-size: 2rem; font-weight: 700; }
    .stat-number.blue { color: #60a5fa; }
    .stat-number.green { color: #34d399; }
    .stat-number.red { color: #f87171; }
    .stat-number.gray { color: #94a3b8; }
    .stat-label { font-size: 0.75rem; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; margin-top: 0.25rem; }
    .section { background: rgba(30,41,59,0.6); border: 1px solid rgba(148,163,184,0.1); border-radius: 12px; padding: 1.5rem; margin-bottom: 1.5rem; }
    .section h2 { font-size: 1rem; font-weight: 600; color: #f1f5f9; margin-bottom: 1rem; }
    table { width: 100%; border-collapse: collapse; }
    th { text-align: left; padding: 0.6rem 1rem; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; background: rgba(15,23,42,0.3); }
    td { padding: 0.6rem 1rem; font-size: 0.875rem; color: #cbd5e1; border-top: 1px solid rgba(148,163,184,0.05); }
    .badge { display: inline-block; padding: 0.2rem 0.6rem; border-radius: 9999px; font-size: 0.7rem; font-weight: 600; }
    .badge-approved { background: rgba(52,211,153,0.15); color: #34d399; }
    .badge-rejected { background: rgba(239,68,68,0.15); color: #f87171; }
    .badge-pending { background: rgba(251,191,36,0.15); color: #fbbf24; }
    .btn { display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.5rem 1rem; border-radius: 8px; font-size: 0.8125rem; font-weight: 500; text-decoration: none; }
    .btn-ghost { background: transparent; color: #94a3b8; border: 1px solid rgba(148,163,184,0.2); }
    .btn-ghost:hover { background: rgba(148,163,184,0.1); color: #e2e8f0; }
    footer { text-align: center; padding: 2rem; color: #475569; font-size: 0.75rem; }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="logo"><span class="logo-icon">◆</span> Artigos LIGEM</a>
      <nav class="topbar-nav">
        <a href="/admin">Dashboard</a>
        <a href="/admin/events" class="active">Eventos</a>
        <a href="/admin/users">Usuários</a>
        <% if (userEmail) { %><span style="padding:0.3rem 0.65rem; color:#cbd5e1; font-size:0.8125rem; border:1px solid rgba(148,163,184,0.18); border-radius:9999px; background:rgba(15,23,42,0.35);"><%= userEmail %></span><% } %>
        <form method="POST" action="/admin/logout" style="display:inline"><button type="submit" class="btn btn-ghost btn-sm">Sair</button></form>
      </nav>
    </div>
  </header>

  <main class="main-content">
    <div class="page-header">
      <h1>📊 Stats — <%= event.name %></h1>
      <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
        <% if (event.offers_subsidy) { %>
          <a href="/admin/events/<%= event.id %>/subsidies" class="btn btn-ghost">Subsídios</a>
        <% } %>
        <a href="/admin/events" class="btn btn-ghost">← Voltar</a>
      </div>
    </div>

    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-number blue"><%= totalArticles %></div>
        <div class="stat-label">Total Artigos</div>
      </div>
      <div class="stat-card">
        <div class="stat-number blue"><%= registeredParticipants %></div>
        <div class="stat-label">Inscritos</div>
      </div>
      <div class="stat-card">
        <div class="stat-number blue"><%= authorRegistrations %></div>
        <div class="stat-label">Autores Inscritos</div>
      </div>
      <div class="stat-card">
        <div class="stat-number blue"><%= listenerRegistrations %></div>
        <div class="stat-label">Ouvintes Inscritos</div>
      </div>
      <div class="stat-card">
        <div class="stat-number blue"><%= subsidyRequests %></div>
        <div class="stat-label">Pedidos de Subsídio</div>
      </div>
      <div class="stat-card">
        <div class="stat-number green"><%= approved %></div>
        <div class="stat-label">Aprovados</div>
      </div>
      <div class="stat-card">
        <div class="stat-number red"><%= rejected %></div>
        <div class="stat-label">Rejeitados</div>
      </div>
      <div class="stat-card">
        <div class="stat-number gray"><%= pending %></div>
        <div class="stat-label">Pendentes</div>
      </div>
      <div class="stat-card">
        <div class="stat-number blue"><%= reviewers %></div>
        <div class="stat-label">Revisores</div>
      </div>
      <div class="stat-card">
        <div class="stat-number green"><%= assigned %></div>
        <div class="stat-label">Atribuídos</div>
      </div>
    </div>

    <% if (topReviewers.length > 0) { %>
    <div class="section">
      <h2>Top Revisores</h2>
      <table>
        <thead><tr><th>Revisor</th><th>Artigos</th></tr></thead>
        <tbody>
          <% topReviewers.forEach(r => { %>
          <tr>
            <td><%= r.reviewer_name %></td>
            <td><%= r.cnt %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>

    <div class="section">
      <h2>Artigos do Evento</h2>
      <% if (articles.length > 0) { %>
      <table>
        <thead><tr><th>Título</th><th>Autores</th><th>Status</th><th>Data</th></tr></thead>
        <tbody>
          <% articles.forEach(a => { %>
          <tr>
            <td><%= a.title %></td>
            <td><%= (a.authors || '').substring(0, 60) %><%= (a.authors || '').length > 60 ? '...' : '' %></td>
            <td><span class="badge badge-<%= a.status %>"><%= a.status === 'approved' ? 'Aprovado' : a.status === 'rejected' ? 'Rejeitado' : 'Pendente' %></span></td>
            <td><%= new Date(a.created_at).toLocaleDateString('pt-BR') %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } else { %>
      <p style="color:#64748b;font-style:italic">Nenhum artigo submetido ainda.</p>
      <% } %>
    </div>
  </main>

  <footer>&copy; <%= year %> LIGEM.Redes • <%= typeof appVersion !== 'undefined' ? appVersion : 'V0.1' %></footer>
</body>
</html>
