<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %></title>
  <link href="/lib/flatpickr/flatpickr.min.css" rel="stylesheet">
  <style>
    body{font-family:'Inter',sans-serif;background:#0a0f1a;color:#e2e8f0;margin:0}.topbar{background:rgba(15,23,42,0.8);border-bottom:1px solid rgba(148,163,184,0.1);backdrop-filter:blur(20px);padding:0 2rem;height:64px;display:flex;align-items:center;position:sticky;top:0;z-index:100}.topbar-inner{width:100%;max-width:1400px;margin:0 auto;display:flex;align-items:center;justify-content:space-between}.logo{font-size:1.25rem;font-weight:700;color:#e2e8f0;text-decoration:none}.logo-icon{color:#60a5fa}.topbar-nav{display:flex;gap:0.4rem;align-items:center;flex-wrap:wrap}.topbar-nav a{color:#94a3b8;padding:0.5rem 0.75rem;border-radius:6px;text-decoration:none;font-size:0.875rem;font-weight:500;transition:all 0.15s}.topbar-nav a:hover{color:#e2e8f0;background:rgba(148,163,184,0.1)}.session-pill{padding:0.42rem 0.78rem;border:1px solid rgba(148,163,184,0.18);border-radius:999px;color:#94a3b8;font-size:0.82rem}.btn-logout{background:transparent;color:#f87171;border:1px solid rgba(248,113,113,0.25);font-family:inherit;cursor:pointer}.btn{display:inline-flex;align-items:center;justify-content:center;padding:0.625rem 1.25rem;border-radius:8px;font-size:0.875rem;font-weight:500;cursor:pointer;border:none;text-decoration:none}.btn-secondary{background:rgba(148,163,184,0.12);color:#e2e8f0;border:1px solid rgba(148,163,184,0.18);text-decoration:none;font-weight:500}.btn-secondary:hover{background:rgba(148,163,184,0.2)}.main-content{max-width:1400px;margin:0 auto;padding:2rem}.hint{color:#64748b;font-size:0.85rem}.alert{padding:0.9rem 1rem;border-radius:10px;font-size:0.9rem;margin-bottom:1rem}.alert.success{background:rgba(34,197,94,0.1);border:1px solid rgba(74,222,128,0.22);color:#86efac}.alert.error{background:rgba(239,68,68,0.1);border:1px solid rgba(248,113,113,0.24);color:#fca5a5}.card{background:#1e293b;border-radius:10px;padding:16px;margin-bottom:16px}.card h2{font-size:1rem;margin:0 0 10px}.card form{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.card input,.card select{padding:0.5rem 0.75rem;background:#0f172a;color:#e2e8f0;border:1px solid #334155;border-radius:8px;font-size:0.875rem}.card input[type=number]{width:110px}.card textarea{padding:0.5rem 0.75rem;background:#0f172a;color:#e2e8f0;border:1px solid #334155;border-radius:8px;font-size:0.875rem;min-width:min(320px,100%);flex:1 1 100%}.session-description{max-width:420px;word-break:break-word}.card button{padding:0.5rem 1rem;background:#2563eb;color:#fff;border:none;border-radius:8px;cursor:pointer;font-size:0.875rem}.card button.danger{background:transparent;color:#f87171;border:1px solid rgba(248,113,113,0.25);padding:2px 8px;font-size:11px}table{width:100%;border-collapse:collapse}th{text-align:left;padding:0.7rem 0.9rem;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.05em;color:#64748b;border-bottom:1px solid rgba(148,163,184,0.15)}td{padding:0.7rem 0.9rem;border-bottom:1px solid rgba(148,163,184,0.07);font-size:0.9rem}.empty{color:#64748b;font-size:0.9rem}input[type=number]::-webkit-inner-spin-button,input[type=number]::-webkit-outer-spin-button{-webkit-appearance:none;margin:0}input[type=number]{-moz-appearance:textfield;appearance:textfield}
  </style>
  <%- include('../../partials/mobile-fixes') %>
</head>
  <main class="main-content">
    <p style="margin-bottom:8px"><a href="/admin/events" style="color:#93c5fd;text-decoration:none">← Voltar aos eventos</a></p>
    <h1 style="font-size:1.5rem;margin:0 0 4px">Salas — <%= event.name %></h1>
    <p class="hint">Crie quantas salas quiser para este evento, classificando por tipo e informando a capacidade. Alocule salas às atividades sem etapas, às etapas e (quando o evento não tem atividades) ao próprio evento — sobreposições de horário na mesma sala são bloqueadas.</p>
    <% if (success) { %><p class="alert success"><%= success %></p><% } %>
    <% if (error) { %><p class="alert error"><%= error %></p><% } %>

    <section class="card">
      <h2><%= editingRoom ? 'Editar sala' : 'Adicionar sala' %></h2>
      <form method="post" action="<%= editingRoom ? `/admin/events/${event.id}/rooms/${editingRoom.id}` : `/admin/events/${event.id}/rooms` %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input name="name" required maxlength="80" placeholder="Nome da sala (ex.: Sala A, Lab. de Informática)" value="<%= editingRoom ? editingRoom.name : '' %>">
        <select name="size" id="room-size">
          <% Object.entries(roomSizes).forEach(([key, meta]) => { %>
            <option value="<%= key %>" <%= editingRoom && editingRoom.size === key ? 'selected' : '' %>><%= meta.label %><% if (meta.capacity) { %> (<%= meta.capacity %> lugares)<% } %></option>
          <% }) %>
        </select>
        <input name="capacity" id="room-capacity" type="number" min="1" placeholder="Capacidade (lugares)" value="<%= editingRoom && editingRoom.capacity ? editingRoom.capacity : '' %>">
        <button type="submit"><%= editingRoom ? 'Salvar sala' : 'Adicionar sala' %></button>
        <% if (editingRoom) { %><a href="/admin/events/<%= event.id %>/rooms" class="btn btn-secondary">Cancelar</a><% } %>
      </form>
    </section>

    <section class="card">
      <h2>Salas cadastradas (<%= roomsList.length %>)</h2>
      <% if (!roomsList.length) { %>
        <p class="empty">Nenhuma sala cadastrada. Adicione salas acima para poder alocá-las.</p>
      <% } else { %>
        <div class="table-scroll"><table>
          <thead>
            <tr><th>Nome</th><th>Tipo</th><th>Capacidade</th><th>Alocações</th><th style="width:140px">Ações</th></tr>
          </thead>
          <tbody>
            <% roomsList.forEach((room) => { %>
              <tr>
                <td><strong><%= room.name %></strong></td>
                <td><%= roomSizes[room.size] ? roomSizes[room.size].label : room.size %></td>
                <td><%= room.capacity ? room.capacity + ' lugares' : '—' %></td>
                <td><%= room.assignment_count %></td>
                <td>
                  <a href="/admin/events/<%= event.id %>/rooms?edit_room_id=<%= room.id %>" style="color:#93c5fd;text-decoration:none">Editar</a>
                  <form method="post" action="/admin/events/<%= event.id %>/rooms/<%= room.id %>/delete" style="display:inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="danger" nonce="<%= cspNonce %>" onclick="return confirm('Remover esta sala?')">Remover</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table></div>
      <% } %>
    </section>

    <section class="card">
      <% const pending = (typeof unallocated !== 'undefined' && unallocated) || { sessions: [], activities: [] }; %>
      <h2>Aguardando sala (<%= pending.sessions.length + pending.activities.length %>)</h2>
      <% if (!pending.sessions.length && !pending.activities.length) { %>
        <p class="hint">Todas as etapas e atividades (sem etapas) deste evento já têm sala alocada.</p>
      <% } else { %>
        <p class="hint">Etapas e atividades sem etapas que ainda não têm sala alocada. Use os links para editar e escolher a sala.</p>
        <% if (pending.activities.length) { %>
          <h3 style="font-size:.9rem;margin:12px 0 6px;color:#93c5fd">Atividades sem etapas (<%= pending.activities.length %>)</h3>
          <div class="table-scroll"><table>
            <thead><tr><th>Atividade</th><th>Data</th><th>Horário</th><th style="width:100px">Ação</th></tr></thead>
            <tbody>
              <% pending.activities.forEach((activity) => { %>
                <tr>
                  <td><strong><%= activity.name %></strong></td>
                  <td><%= activity.date_start ? formatBRDate(activity.date_start) : 'A definir' %><%= activity.date_end && activity.date_end !== activity.date_start ? ' a ' + formatBRDate(activity.date_end) : '' %></td>
                  <td><%= activity.time_start && activity.time_end ? String(activity.time_start).slice(0,5) + '–' + String(activity.time_end).slice(0,5) : '—' %></td>
                  <td><a href="/admin/events/<%= event.id %>/activities?edit_activity_id=<%= activity.id %>" style="color:#93c5fd;text-decoration:none">Alocar sala</a></td>
                </tr>
              <% }) %>
            </tbody>
          </table></div>
        <% } %>
        <% if (pending.sessions.length) { %>
          <h3 style="font-size:.9rem;margin:12px 0 6px;color:#93c5fd">Etapas (<%= pending.sessions.length %>)</h3>
          <div class="table-scroll"><table>
            <thead><tr><th>Etapa</th><th>Atividade</th><th>Data</th><th>Horário</th><th style="width:100px">Ação</th></tr></thead>
            <tbody>
              <% pending.sessions.forEach((session) => { %>
                <tr>
                  <td><strong><%= session.name %></strong></td>
                  <td><%= session.activity_name %></td>
                  <td><%= session.session_date ? formatBRDate(session.session_date) : 'A definir' %></td>
                  <td><%= session.time_start && session.time_end ? String(session.time_start).slice(0,5) + '–' + String(session.time_end).slice(0,5) : '—' %></td>
                  <td><a href="/admin/events/<%= event.id %>/activities/<%= session.activity_id %>/sessions?edit_session_id=<%= session.id %>" style="color:#93c5fd;text-decoration:none">Alocar sala</a></td>
                </tr>
              <% }) %>
            </tbody>
          </table></div>
        <% } %>
      <% } %>
    </section>

    <section class="card">
      <h2>Sala do evento</h2>
      <% if (activitiesCount > 0) { %>
        <p class="hint">Este evento possui atividades, então a sala é designada por atividade (sem etapas) ou por etapa. A reserva abaixo só está disponível para eventos sem atividades.</p>
      <% } else if (!roomsList.length) { %>
        <p class="hint">Cadastre ao menos uma sala para designar a sala do evento.</p>
      <% } else { %>
        <p class="hint">Quando o evento não possui atividades, você pode designar uma sala para o evento: ela fica reservada no horário informado em <strong>todos os dias</strong> entre a data de início e a data de fim.</p>
        <form method="post" action="/admin/events/<%= event.id %>/rooms/reservations">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <select name="room_id">
            <option value="">— Sem sala do evento —</option>
            <% roomsList.forEach((room) => { %>
              <option value="<%= room.id %>" <%= reservations.length && reservations[0].room_id === room.id ? 'selected' : '' %>><%= room.name %> (<%= roomSizes[room.size] ? roomSizes[room.size].label : room.size %>)</option>
            <% }) %>
          </select>
          <input name="range_start" type="text" class="datepicker" placeholder="Início (ex.: <%= event.date_start ? formatBRDate(event.date_start) : 'dd/mm/aaaa' %>)" value="<%= reservations.length ? formatBRDate(reservations[0].date) : '' %>">
          <input name="range_end" type="text" class="datepicker" placeholder="Fim (ex.: <%= event.date_end ? formatBRDate(event.date_end) : 'dd/mm/aaaa' %>)" value="">
          <input name="time_start" type="time" value="<%= reservations.length ? reservations[0].time_start : '' %>">
          <input name="time_end" type="time" value="<%= reservations.length ? reservations[0].time_end : '' %>">
          <button type="submit">Salvar reserva do evento</button>
        </form>
        <% if (reservations.length) { %>
          <p class="hint">Reserva atual: <%= reservations[0].room_name %>, <%= formatBRDate(reservations[0].date) %><% if (reservations.length > 1) { %> a <%= formatBRDate(reservations[reservations.length - 1].date) %><% } %> das <%= reservations[0].time_start %> às <%= reservations[0].time_end %> (<%= reservations.length %> dia(s)).</p>
        <% } %>
      <% } %>
    </section>

    <section class="card">
      <h2>Relatórios de salas</h2>
      <p>
        <a class="btn btn-secondary" href="/admin/events/<%= event.id %>/rooms/occupancy">Ocupação por dia</a>
        <a class="btn btn-secondary" href="/admin/events/<%= event.id %>/rooms/agenda">Agenda por sala</a>
      </p>
    </section>
  </main>
  <%- include("../../partials/csrf-inject") %>
  <script src="/lib/flatpickr/flatpickr.min.js" nonce="<%= cspNonce %>"></script>
  <script src="/lib/flatpickr/l10n/pt.js" nonce="<%= cspNonce %>"></script>
  <script src="/lib/flatpickr/init.js" nonce="<%= cspNonce %>"></script>
  </body>
</html>
