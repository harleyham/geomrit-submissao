<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><style>body{font-family:Arial;background:#0a0f1a;color:#e2e8f0;margin:0}main{max-width:1200px;margin:auto;padding:2rem}.card{background:#172033;border:1px solid #334155;border-radius:10px;padding:1.25rem;margin:1rem 0}input,select,button{padding:.55rem;margin:.25rem}table{width:100%;border-collapse:collapse}td,th{padding:.7rem;border-top:1px solid #334155;text-align:left}.ok{color:#86efac}.no{color:#fca5a5}a{color:#93c5fd}.alert{padding:.75rem;background:#1e3a2f}.error{background:#4a2025}</style></head><body><main>
<p><a href="/admin/events">← Eventos</a> · <a href="/admin/events/<%= event.id %>/participants">Participantes</a></p><h1>Certificados — <%= event.name %></h1>
<% if(success){ %><p class="alert"><%= success %></p><% } %><% if(error){ %><p class="alert error"><%= error %></p><% } %>
<section class="card"><h2>Regra de elegibilidade</h2><form method="post" action="/admin/events/<%= event.id %>/certificates/rule"><label>Presenças mínimas <input type="number" min="1" name="min_attendance" value="<%= rule.min_attendance %>"></label><label>Fundo <select name="background_id" required><option value="">Selecione</option><% backgrounds.forEach(b=>{ %><option value="<%= b.id %>" <%= Number(rule.background_id)===Number(b.id)?'selected':'' %>><%= b.name %></option><% }) %></select></label><button>Salvar regra</button></form></section>
<section class="card"><h2>Biblioteca de fundos</h2><form method="post" enctype="multipart/form-data" action="/admin/events/<%= event.id %>/certificates/backgrounds"><input name="name" required placeholder="Nome do fundo"><input type="file" name="background_file" accept="image/png,image/jpeg" required><button>Enviar fundo PNG/JPEG</button></form><p>Escolha acima um fundo já enviado ou envie um novo (máximo 10 MB).</p></section>
<section class="card"><h2>Elegibilidade e emissões</h2><table><thead><tr><th>Participante</th><th>Presenças</th><th>Elegível</th><th>Certificado</th></tr></thead><tbody><% participants.forEach(p=>{ %><tr><td><strong><%= p.name %></strong><br><small><%= p.email %></small></td><td><%= p.attendance_count %></td><td class="<%= p.eligible?'ok':'no' %>"><%= p.eligible?'Sim':'Não' %></td><td><% if(p.active_emission_id){ %><a href="/admin/events/<%= event.id %>/certificates/emissions/<%= p.active_emission_id %>/download">Baixar</a> <form style="display:inline" method="post" action="/admin/events/<%= event.id %>/certificates/<%= p.id %>/reissue"><button>Reemitir v<%= p.latest_version %></button></form><% } else if(p.eligible){ %><form method="post" action="/admin/events/<%= event.id %>/certificates/<%= p.id %>/issue"><button>Emitir</button></form><% } else { %>Aguarda presença<% } %></td></tr><% }) %></tbody></table></section>
</main></body></html>
