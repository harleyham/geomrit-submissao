<!doctype html>
<html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title>
<style>
body{font-family:Arial,sans-serif;background:#0a0f1a;color:#e2e8f0;margin:0}.top{background:#0f172a;padding:14px 5%;display:flex;align-items:center;justify-content:space-between;gap:16px}.top a{color:#93c5fd;text-decoration:none;margin-right:16px}.top-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.session-pill{padding:7px 11px;border:1px solid #475569;border-radius:999px;color:#cbd5e1;font-size:13px}.logout-btn{width:auto;background:transparent!important;color:#f87171;border-color:#7f1d1d}.main{max-width:1250px;margin:auto;padding:28px}.card{background:#1e293b;border-radius:10px;padding:20px;margin:20px 0}label{display:block;font-size:13px;color:#cbd5e1;margin:9px 0 4px}input,textarea,button{width:100%;box-sizing:border-box;padding:9px;border:1px solid #475569;border-radius:6px;background:#0f172a;color:#f8fafc}textarea{min-height:64px}button{background:#2563eb;cursor:pointer;width:auto}.secondary{background:#334155}.row{display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:12px}.role{border-top:1px solid #475569;padding-top:16px;margin-top:18px}table{width:100%;border-collapse:collapse;margin-top:15px}th,td{text-align:left;padding:10px;border-bottom:1px solid #334155;vertical-align:top}.ok{color:#86efac}.no{color:#fca5a5}.alert{padding:10px;border-radius:6px}.success{background:#14532d}.error{background:#7f1d1d}.hint{color:#94a3b8;font-size:13px}.background-groups{margin-top:14px}.background-group{margin-top:14px}.background-group h3{font-size:13px;color:#94a3b8;margin:0 0 8px}.background-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(135px,1fr));gap:12px}.background-card{padding:7px;border:2px solid #475569;border-radius:8px;background:#0f172a;cursor:pointer;text-align:left;color:#e2e8f0}.background-card:hover{border-color:#60a5fa}.background-card.selected{border-color:#3b82f6;background:#172554}.background-thumb{display:block;width:100%;height:84px;object-fit:cover;border-radius:5px;background:#334155}.background-name{display:block;margin-top:6px;font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.background-empty{padding:12px;color:#94a3b8;border:1px dashed #475569;border-radius:8px}.preview{display:none;margin-top:16px}.preview iframe{width:100%;height:560px;border:0;border-radius:8px;background:#fff}.preview-error{display:none;color:#fca5a5;margin:8px 0}
</style></head>
<body><header class="top"><nav><a href="/admin/dashboard">Dashboard</a><a href="/admin/events">Eventos</a><a href="/admin/events/<%= event.id %>/participants">Participantes</a><a href="/admin/events/<%= event.id %>/roles">Papéis no evento</a></nav><div class="top-actions"><% if (userEmail) { %><span class="session-pill"><%= userEmail %></span><form method="post" action="/admin/logout"><button type="submit" class="logout-btn">Sair</button></form><% } %></div></header>
<main class="main"><div style="display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap"><div><h1>Certificados — <%= event.name %></h1><p class="hint">Configure e emita um certificado por papel. A mesma pessoa pode receber certificados de papéis distintos.</p></div><form method="post" action="/admin/events/<%= event.id %>/certificates/issue-all"><button type="submit">Emitir todos os certificados elegíveis</button></form></div>
<% if(success){ %><p class="alert success"><%= success %></p><% } %><% if(error){ %><p class="alert error"><%= error %></p><% } %>
<section class="card"><h2>Biblioteca de fundos</h2><form method="post" enctype="multipart/form-data" action="/admin/events/<%= event.id %>/certificates/backgrounds"><input name="name" required placeholder="Nome do fundo"><br><br><input type="file" name="background_file" accept="image/png,image/jpeg" required><br><br><button>Enviar fundo PNG/JPEG</button></form></section>
<% certificatesByRole.forEach((group) => { const rule=group; const defaultBackgrounds=backgrounds.filter((bg)=>String(bg.file_path||'').startsWith('assets/Fundos/')); const uploadedBackgrounds=backgrounds.filter((bg)=>!String(bg.file_path||'').startsWith('assets/Fundos/')); %>
<section class="card role"><h2><%= group.meta.label %></h2><p class="hint"><%= group.meta.attendance ? 'Elegibilidade baseada na presença registrada.' : group.role === 'reviewer' ? 'Elegibilidade automática: ao menos um parecer enviado.' : 'Elegibilidade baseada na atribuição deste papel pela administração.' %></p>
<form method="post" action="/admin/events/<%= event.id %>/certificates/rule" class="certificate-rule-form" data-role="<%= group.role %>"><input type="hidden" name="certificate_role" value="<%= group.role %>"><input type="hidden" name="background_id" class="selected-background-id" value="<%= rule.background_id || '' %>"><div class="row"><div><label>Título</label><input name="title" value="<%= rule.title || group.meta.title %>" required></div><div><label>Cor</label><input type="color" name="text_color" class="text-color" value="<%= rule.text_color || '#0f172a' %>"></div><div><label>Presenças mínimas</label><input type="number" min="0" name="min_attendance" value="<%= rule.min_attendance %>" <%= group.meta.attendance ? '' : 'readonly' %>></div></div><label>Texto (use {event} para o nome do evento)</label><textarea name="body_text"><%= rule.body_text || group.meta.body %></textarea><div class="background-groups"><label>Fundo do certificado</label><% if(!backgrounds.length){ %><div class="background-empty">Envie um fundo PNG ou JPEG para poder configurar este certificado.</div><% } %><% if(defaultBackgrounds.length){ %><div class="background-group"><h3>Fundos padrão</h3><div class="background-grid"><% defaultBackgrounds.forEach((bg)=>{ %><button type="button" class="background-card <%= Number(rule.background_id)===Number(bg.id)?'selected':'' %>" data-background-id="<%= bg.id %>"><img class="background-thumb" src="/<%= bg.file_path %>" alt="<%= bg.name %>"><span class="background-name"><%= bg.name %></span></button><% }) %></div></div><% } %><% if(uploadedBackgrounds.length){ %><div class="background-group"><h3>Fundos enviados</h3><div class="background-grid"><% uploadedBackgrounds.forEach((bg)=>{ %><button type="button" class="background-card <%= Number(rule.background_id)===Number(bg.id)?'selected':'' %>" data-background-id="<%= bg.id %>"><img class="background-thumb" src="/admin/events/<%= event.id %>/certificates/backgrounds/<%= bg.id %>/view" alt="<%= bg.name %>"><span class="background-name"><%= bg.name %></span></button><% }) %></div></div><% } %></div><p><button>Salvar configuração</button> <button type="button" class="secondary preview-button">Visualizar prévia</button></p><p class="preview-error">Selecione um fundo para visualizar a prévia.</p><div class="preview"><iframe title="Prévia do certificado"></iframe></div></form>
<table><thead><tr><th>Pessoa</th><th>Elegibilidade</th><th>Certificado</th></tr></thead><tbody><% if(!group.candidates.length){ %><tr><td colspan="3" class="hint">Nenhuma pessoa neste papel.</td></tr><% } %><% group.candidates.forEach((candidate)=>{ %><tr><td><strong><%= candidate.name %></strong><br><small><%= candidate.email %></small><% if(candidate.article_title){ %><br><small><%= candidate.article_title %></small><% } %></td><td class="<%= candidate.eligible?'ok':'no' %>"><%= candidate.eligible?'Elegível':'Não elegível' %></td><td><% if(candidate.active_emission_id){ %><a href="/admin/events/<%= event.id %>/certificates/emissions/<%= candidate.active_emission_id %>/download">Baixar</a> <form style="display:inline" method="post" action="/admin/events/<%= event.id %>/certificates/<%= group.role %>/<%= candidate.user_id %>/reissue"><button class="secondary">Reemitir v<%= candidate.latest_version %></button></form><% } else if(candidate.eligible){ %><form method="post" action="/admin/events/<%= event.id %>/certificates/<%= group.role %>/<%= candidate.user_id %>/issue"><button>Emitir</button></form><% } else { %>—<% } %></td></tr><% }) %></tbody></table></section><% }) %>
</main><script>document.querySelectorAll('.certificate-rule-form').forEach((form)=>{const input=form.querySelector('.selected-background-id');const color=form.querySelector('.text-color');const preview=form.querySelector('.preview');const iframe=preview.querySelector('iframe');const error=form.querySelector('.preview-error');const button=form.querySelector('.preview-button');const buildPreview=()=>{if(!input.value){error.style.display='block';preview.style.display='none';return;}error.style.display='none';const params=new URLSearchParams({role:form.dataset.role,background_id:input.value,text_color:color.value});iframe.src='/admin/events/<%= event.id %>/certificates/preview?'+params.toString();preview.style.display='block';button.textContent='Atualizar prévia';};form.querySelectorAll('.background-card').forEach((card)=>card.addEventListener('click',()=>{form.querySelectorAll('.background-card').forEach((item)=>item.classList.remove('selected'));card.classList.add('selected');input.value=card.dataset.backgroundId;if(preview.style.display==='block')buildPreview();}));color.addEventListener('input',()=>{if(preview.style.display==='block')buildPreview();});button.addEventListener('click',buildPreview);});</script></body></html>
