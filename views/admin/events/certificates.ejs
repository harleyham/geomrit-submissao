<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"><style>*{box-sizing:border-box;margin:0;padding:0}body{font-family:'Inter',sans-serif;background:#0a0f1a;color:#e2e8f0;min-height:100vh}.topbar{background:rgba(15,23,42,0.8);border-bottom:1px solid rgba(148,163,184,0.1);backdrop-filter:blur(20px);padding:0 2rem;height:64px;display:flex;align-items:center;position:sticky;top:0;z-index:100}.topbar-inner{width:100%;max-width:1440px;margin:0 auto;display:flex;align-items:center;justify-content:space-between}.logo{font-size:1.25rem;font-weight:700;color:#e2e8f0;text-decoration:none}.logo-icon{color:#60a5fa}.topbar-nav{display:flex;gap:0.25rem;align-items:center}.topbar-nav a{color:#94a3b8;padding:0.5rem 0.75rem;border-radius:6px;text-decoration:none;font-size:0.875rem;font-weight:500}.topbar-nav a:hover,.topbar-nav a.active{color:#e2e8f0;background:rgba(148,163,184,0.1)}.main{max-width:1440px;margin:0 auto;padding:2rem}.page-header{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;margin-bottom:1.5rem}.page-header h1{font-size:1.75rem;font-weight:700;color:#f8fafc}.page-header p{color:#94a3b8;margin-top:0.4rem}.header-actions{display:flex;gap:0.75rem;flex-wrap:wrap}.btn{display:inline-flex;align-items:center;gap:0.35rem;padding:0.55rem 0.9rem;border-radius:8px;font-size:0.8125rem;font-weight:600;text-decoration:none;border:1px solid transparent;cursor:pointer}.btn-primary{background:#2563eb;color:white}.btn-ghost{background:transparent;color:#94a3b8;border-color:rgba(148,163,184,0.18)}.btn-ghost:hover{background:rgba(148,163,184,0.1);color:#e2e8f0}.btn-sm{padding:0.35rem 0.7rem;font-size:0.75rem}.card{background:rgba(30,41,59,0.6);border:1px solid rgba(148,163,184,0.1);border-radius:12px;padding:1.25rem;margin:1rem 0}input,select,button{padding:.55rem;margin:.25rem;font:inherit}label{display:block;color:#94a3b8;font-size:.78rem;margin-bottom:.4rem}input,select{border:1px solid rgba(148,163,184,0.18);border-radius:8px;background:rgba(2,6,23,0.42);color:#f8fafc;padding:.65rem .75rem;font-size:.86rem}table{width:100%;border-collapse:collapse}th{padding:.8rem 1.2rem;text-align:left;color:#64748b;font-size:.72rem;text-transform:uppercase;letter-spacing:.05em;background:rgba(15,23,42,0.25)}td{padding:.85rem 1.2rem;border-top:1px solid rgba(148,163,184,0.07);vertical-align:middle;font-size:.86rem}tr:hover td{background:rgba(148,163,184,0.03)}strong{color:#f8fafc}small{color:#94a3b8}.badge{display:inline-flex;border-radius:999px;font-size:.72rem;font-weight:700;padding:.25rem .6rem}.present{background:rgba(34,197,94,.15);color:#86efac}.absent{background:rgba(148,163,184,.14);color:#cbd5e1}.ok{color:#86efac}.no{color:#fca5a5}a{color:#93c5fd}.alert{padding:.85rem 1rem;border-radius:9px;margin-bottom:1rem}.success{color:#86efac;background:rgba(34,197,94,.1);border:1px solid rgba(74,222,128,.22)}.error{color:#fca5a5;background:rgba(239,68,68,.1);border:1px solid rgba(248,113,113,.24)}.activity-tag{display:inline-block;padding:.2rem .55rem;border-radius:6px;font-size:.7rem;background:rgba(167,139,250,0.14);color:#a78bfa;margin:.15rem}.workload{color:#fbbf24}.empty-state{padding:2rem 1.25rem;color:#94a3b8}footer{text-align:center;padding:2rem;color:#475569;font-size:.75rem}@media(max-width:900px){.page-header{flex-direction:column}.card{padding:1rem}}.background-picker{margin-top:1.5rem}.picker-title{color:#f8fafc;font-size:1rem;margin-bottom:0.75rem}.picker-group{margin-bottom:1.5rem}.group-title{color:#94a3b8;font-size:0.85rem;margin-bottom:0.5rem}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:0.75rem}.background-card{border:2px solid rgba(148,163,184,0.18);border-radius:8px;padding:0.5rem;cursor:pointer;background:rgba(15,23,42,0.4);transition:all 0.15s}.background-card:hover{border-color:rgba(148,163,184,0.35);background:rgba(15,23,42,0.6)}.background-card.selected{border-color:#3b82f6;background:rgba(59,130,246,0.15)}.thumbnail{width:100%;height:80px;background-size:cover;background-position:center;border-radius:6px;margin-bottom:0.5rem}.label{text-align:center;color:#94a3b8;font-size:0.75rem}</style></head><body><header class="topbar"><div class="topbar-inner"><a href="/" class="logo"><span class="logo-icon">◆</span> Artigos LIGEM</a><nav class="topbar-nav"><a href="/admin">Dashboard</a><a href="/admin/events" class="active">Eventos</a><a href="/admin/events/<%= event.id %>/participants">Participantes</a></nav></div></header><main class="main"><p style="margin-bottom:1rem"><a href="/admin/events">← Voltar aos eventos</a></p><div class="page-header"><div><h1>Certificados — <%= event.name %></h1></div><div class="header-actions"><button class="btn btn-primary" id="show-preview-btn">Visualizar prévia do certificado</button></div></div><div id="preview-container" style="display:none;margin-top:1.5rem"><iframe id="preview-iframe" style="width:100%;height:800px;border:none;border-radius:8px;background:#fff"></iframe></div><% if(success){ %><p class="alert success"><%= success %></p><% } %><% if(error){ %><p class="alert error"><%= error %></p><% } %>
<section class="card"><h2>Regra de elegibilidade</h2><p style="color:#94a3b8;font-size:.85rem;margin-bottom:0.75rem"><% if (rule.has_activity_rules) { %>As atividades com regras de certificado substituem a regra geral por número de presenças.<% } else { %>Elegibilidade baseada em número de presenças no evento.<% } %></p><form method="post" action="/admin/events/<%= event.id %>/certificates/rule" id="rule-form"><div style="display:flex;gap:1.5rem;flex-wrap:wrap;align-items:end;margin-bottom:0.5rem"><div style="flex:1;min-width:180px"><label>Presenças mínimas <input type="number" min="1" name="min_attendance" value="<%= rule.min_attendance %>"></label></div><div style="max-width:200px"><label>Cor da fonte <input type="color" name="text_color" id="text_color" value="<%= rule.text_color || '#0f172a' %>" style="width:100%;height:38px;padding:2px"></label></div><input type="hidden" name="background_id" id="selected_background_id" value="<%= rule.background_id || '' %>"></div><div class="background-picker"><h3 class="picker-title">Selecione o fundo do certificado</h3><% const defaultBg = backgrounds.filter(b=>String(b.file_path||'').startsWith('assets/Fundos/')); const uploadBg = backgrounds.filter(b=>!String(b.file_path||'').startsWith('assets/Fundos/')); if (defaultBg.length > 0) { %><div class="picker-group"><h4 class="group-title">Fundos padrão</h4><div class="grid"><% defaultBg.forEach(b=>{ %><div class="background-card <%= Number(rule.background_id)===Number(b.id) ? 'selected' : '' %>" data-id="<%= b.id %>"><div class="thumbnail" style="background-image:url('/<%= b.file_path %>')"></div><div class="label"><%= b.name %></div></div><% }) %></div></div><% } %><% if (uploadBg.length > 0) { %><div class="picker-group"><h4 class="group-title">Fundos enviados</h4><div class="grid"><% uploadBg.forEach(b=>{ %><div class="background-card <%= Number(rule.background_id)===Number(b.id) ? 'selected' : '' %>" data-id="<%= b.id %>"><div class="thumbnail" style="background-image:url('/admin/events/<%= event.id %>/certificates/backgrounds/<%= b.id %>/view')"></div><div class="label"><%= b.name %></div></div><% }) %></div></div><% } %></div><div style="margin-top:1.5rem"><button class="btn btn-primary" type="submit" style="padding:.7rem 1.5rem;font-size:.9rem">Salvar regra</button></div></form></section>
<section class="card"><h2>Biblioteca de fundos</h2><form method="post" enctype="multipart/form-data" action="/admin/events/<%= event.id %>/certificates/backgrounds"><input name="name" required placeholder="Nome do fundo"><input type="file" name="background_file" accept="image/png,image/jpeg" required><button>Enviar fundo PNG/JPEG</button></form><p style="margin-top:.5rem;color:#94a3b8;font-size:.82rem">Fundos padrão em <code>assets/Fundos</code>. Fundos enviados em <code>uploads/certificate-backgrounds</code> (máx. 10 MB).</p></section>
<section class="card"><h2>Elegibilidade e emissões</h2><% if (participants.length === 0) { %><div class="empty-state">Nenhum participante inscrito neste evento.</div><% } else { %>
<table><thead><tr><th>Participante</th><th>Presenças</th><% if (participants.some(p=>p.has_activity_rules)) { %><th>Atividades</th><th>Carga Horária</th><% } %><th>Elegível</th><th>Certificado</th></tr></thead><tbody><% participants.forEach(p=>{ %>
<tr><td><strong><%= p.name %></strong><br><small><%= p.email %></small></td><td><%= p.attendance_count %></td><% if (p.has_activity_rules) { %><td><span class="badge <%= p.activities_attended >= (p.activity_rules[0]?.min_attendance || 1) ? 'present' : 'absent' %>"><%= p.activities_attended %> / <%= p.activity_rules[0]?.min_attendance || 0 %></span><% p.attended_activities.forEach(act=>{ %><span class="activity-tag"><%= act.activity_name %> (<%= act.workload_hours %>h)</span><% }) %></td><td><span class="workload"><%= p.total_workload_hours %>h</span></td><% } %><td class="<%= p.eligible?'ok':'no' %>"><%= p.eligible?'Sim':'Não' %></td><td><% if(p.active_emission_id){ %><a href="/admin/events/<%= event.id %>/certificates/emissions/<%= p.active_emission_id %>/download">Baixar</a> <form style="display:inline" method="post" action="/admin/events/<%= event.id %>/certificates/<%= p.id %>/reissue"><button class="btn btn-ghost btn-sm">Reemitir v<%= p.latest_version %></button></form><% } else if(p.eligible){ %><form method="post" action="/admin/events/<%= event.id %>/certificates/<%= p.id %>/issue"><button class="btn btn-primary btn-sm">Emitir</button></form><% } else { %>Aguarda presença<% } %></td></tr><% }) %></tbody></table><% } %>
</section></main><footer>&copy; <%= year %> LIGEM.Redes • <%= typeof appVersion !== 'undefined' ? appVersion : 'V0.1' %></footer><script>document.addEventListener('DOMContentLoaded',function(){const cards=document.querySelectorAll('.background-card');const hiddenInput=document.getElementById('selected_background_id');const colorPicker=document.getElementById('text_color');cards.forEach(card=>{card.addEventListener('click',function(){cards.forEach(c=>c.classList.remove('selected'));this.classList.add('selected');hiddenInput.value=this.dataset.id;updatePreview()})});if(colorPicker){colorPicker.addEventListener('change',function(){updatePreview()})}});function updatePreview(){const hiddenInput=document.getElementById('selected_background_id');const colorPicker=document.getElementById('text_color');const previewIframe=document.getElementById('preview-iframe');const previewContainer=document.getElementById('preview-container');if(!previewIframe||!previewContainer)return;const backgroundId=hiddenInput.value;const textColor=colorPicker?colorPicker.value:'';const params=new URLSearchParams();if(backgroundId)params.set('background_id',backgroundId);if(textColor)params.set('text_color',textColor);const queryString=params.toString();previewIframe.src='/admin/events/<%= event.id %>/certificates/preview'+(queryString?'?'+queryString:'')}const showPreviewBtn=document.getElementById('show-preview-btn');const previewContainer=document.getElementById('preview-container');const previewIframe=document.getElementById('preview-iframe');showPreviewBtn.addEventListener('click',function(){if(previewContainer.style.display==='none'){previewContainer.style.display='block';showPreviewBtn.textContent='Ocultar prévia';updatePreview()}else{previewContainer.style.display='none';showPreviewBtn.textContent='Visualizar prévia do certificado'}});</script></body></html>
