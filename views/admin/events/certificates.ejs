<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title>
  <style>
    body{font-family:Arial,sans-serif;background:#0a0f1a;color:#e2e8f0;margin:0}.top{background:#0f172a;padding:14px 5%;display:flex;align-items:center;justify-content:space-between;gap:16px}.top a{color:#93c5fd;text-decoration:none;margin-right:16px}.top-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.session-pill{padding:7px 11px;border:1px solid #475569;border-radius:999px;color:#cbd5e1;font-size:13px}.logout-btn{width:auto;background:transparent!important;color:#f87171;border-color:#7f1d1d}.main{max-width:1250px;margin:auto;padding:28px}.card{background:#1e293b;border-radius:10px;padding:20px;margin:20px 0}label{display:block;font-size:13px;color:#cbd5e1;margin:9px 0 4px}input,textarea,button{width:100%;box-sizing:border-box;padding:9px;border:1px solid #475569;border-radius:6px;background:#0f172a;color:#f8fafc}textarea{min-height:64px}button{background:#2563eb;cursor:pointer;width:auto}.secondary{background:#334155}.row{display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:12px}.role{border-top:1px solid #475569;padding-top:16px;margin-top:18px}table{width:100%;border-collapse:collapse;margin-top:15px}th,td{text-align:left;padding:10px;border-bottom:1px solid #334155;vertical-align:top}.ok{color:#86efac}.no{color:#fca5a5}.alert{padding:10px;border-radius:6px}.success{background:#14532d}.error{background:#7f1d1d}.hint{color:#94a3b8;font-size:13px}.activity-tag{display:inline-block;padding:3px 7px;margin:2px;border-radius:999px;background:#334155;color:#cbd5e1;font-size:12px}.background-groups{margin-top:14px}.background-group{margin-top:14px}.background-group h3{font-size:13px;color:#94a3b8;margin:0 0 8px}.background-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(135px,1fr));gap:12px}.background-card{padding:7px;border:2px solid #475569;border-radius:8px;background:#0f172a;cursor:pointer;text-align:left;color:#e2e8f0}.background-card:hover{border-color:#60a5fa}.background-card.selected{border-color:#3b82f6;background:#172554}.background-thumb{display:block;width:100%;height:84px;object-fit:cover;border-radius:5px;background:#334155}.background-name{display:block;margin-top:6px;font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.background-empty{padding:12px;color:#94a3b8;border:1px dashed #475569;border-radius:8px}.preview{display:none;margin-top:16px}.preview iframe{width:100%;height:560px;border:0;border-radius:8px;background:#fff}.preview-error{display:none;color:#fca5a5;margin:8px 0}@media(max-width:800px){.row{grid-template-columns:1fr}.card{overflow-x:auto}}
  </style>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="logo"><span class="logo-icon">◆</span> Artigos LIGEM</a>
      <nav class="topbar-nav">
        <a href="/admin">Dashboard</a>
        <a href="/admin/events">Eventos</a>
        <a href="/admin/users">Usuários</a>
        <% if (userEmail) { %><span style="padding:0.3rem 0.65rem; color:#cbd5e1; font-size:0.8125rem; border:1px solid rgba(148,163,184,0.18); border-radius:9999px; background:rgba(15,23,42,0.35);"><%= userEmail %></span><% } %>
        <form method="POST" action="/admin/logout" style="display:inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-ghost" style="padding:0.3rem 0.5rem">Sair</button></form>
      </nav>
    </div>
  </header>
  <main class="main-content">
  <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap"><div><h1>Certificados — <%= event.name %></h1><p class="hint">Cada presença é contabilizada somente no papel exercido na atividade. A mesma pessoa pode receber certificados diferentes, com atividades e cargas horárias independentes.</p></div><form method="post" action="/admin/events/<%= event.id %>/certificates/issue-all"><button type="submit">Emitir todos os elegíveis</button></form></div>
  <% if (success) { %><p class="alert success"><%= success %></p><% } %><% if (error) { %><p class="alert error"><%= error %></p><% } %>
  <section class="card"><h2>Biblioteca de fundos</h2><form method="post" enctype="multipart/form-data" action="/admin/events/<%= event.id %>/certificates/backgrounds"><input name="name" required placeholder="Nome do fundo"><br><br><input type="file" name="background_file" accept="image/png,image/jpeg" required><br><br><button>Enviar fundo PNG/JPEG</button></form></section>

  <% certificatesByRole.forEach((group) => {
    const rule=group;
    const defaultBackgrounds=backgrounds.filter((bg)=>String(bg.file_path||'').startsWith('assets/Fundos/'));
    const uploadedBackgrounds=backgrounds.filter((bg)=>!String(bg.file_path||'').startsWith('assets/Fundos/'));
  %>
    <section class="card role">
      <h2><%= group.meta.label %></h2>
      <p class="hint"><%= group.role === 'reviewer' ? 'Elegibilidade: ao menos um parecer enviado neste evento.' : group.role === 'participant' ? 'Elegibilidade: mínimo de presenças em atividades certificáveis nas quais a pessoa também esteja inscrita.' : 'Elegibilidade: mínimo de presenças registradas neste mesmo papel em atividades certificáveis.' %></p>
      <form method="post" action="/admin/events/<%= event.id %>/certificates/rule" class="certificate-rule-form" data-role="<%= group.role %>">
        <input type="hidden" name="certificate_role" value="<%= group.role %>"><input type="hidden" name="background_id" class="selected-background-id" value="<%= rule.background_id || '' %>">
        <div class="row"><div><label>Título</label><input name="title" value="<%= rule.title || group.meta.title %>" required></div><div><label>Cor</label><input type="color" name="text_color" class="text-color" value="<%= rule.text_color || '#0f172a' %>"></div><div><label>Presenças mínimas</label><input type="number" min="<%= group.role === 'reviewer' ? 0 : 1 %>" name="min_attendance" value="<%= group.role === 'reviewer' ? 0 : rule.min_attendance %>" <%= group.role === 'reviewer' ? 'readonly' : '' %>></div></div>
        <label>Texto (use {event} para o nome do evento)</label><textarea name="body_text"><%= rule.body_text || group.meta.body %></textarea>
        <div class="background-groups"><label>Fundo do certificado</label>
          <% if (!backgrounds.length) { %><div class="background-empty">Envie um fundo PNG ou JPEG para configurar este certificado.</div><% } %>
          <% if (defaultBackgrounds.length) { %><div class="background-group"><h3>Fundos padrão</h3><div class="background-grid"><% defaultBackgrounds.forEach((bg) => { %><button type="button" class="background-card <%= Number(rule.background_id)===Number(bg.id)?'selected':'' %>" data-background-id="<%= bg.id %>"><img class="background-thumb" src="/<%= bg.file_path %>" alt="<%= bg.name %>"><span class="background-name"><%= bg.name %></span></button><% }) %></div></div><% } %>
          <% if (uploadedBackgrounds.length) { %><div class="background-group"><h3>Fundos enviados</h3><div class="background-grid"><% uploadedBackgrounds.forEach((bg) => { %><button type="button" class="background-card <%= Number(rule.background_id)===Number(bg.id)?'selected':'' %>" data-background-id="<%= bg.id %>"><img class="background-thumb" src="/admin/events/<%= event.id %>/certificates/backgrounds/<%= bg.id %>/view" alt="<%= bg.name %>"><span class="background-name"><%= bg.name %></span></button><% }) %></div></div><% } %>
        </div>
        <p><button>Salvar configuração</button> <button type="button" class="secondary preview-button">Visualizar prévia</button></p><p class="preview-error">Selecione um fundo para visualizar a prévia.</p><div class="preview"><iframe title="Prévia do certificado"></iframe></div>
      </form>
      <table><thead><tr><th>Pessoa</th><th>Atuação comprovada</th><th>Atividades e carga horária</th><th>Elegibilidade</th><th>Certificado</th></tr></thead><tbody>
        <% if (!group.candidates.length) { %><tr><td colspan="5" class="hint">Nenhuma pessoa vinculada a este papel.</td></tr><% } %>
        <% group.candidates.forEach((candidate) => { %><tr>
          <td><strong><%= candidate.name %></strong><br><small><%= candidate.email %></small><% if (candidate.article_title) { %><br><small><%= candidate.article_title %></small><% } %></td>
          <td><%= group.role === 'reviewer' ? `${candidate.report_count || 0} parecer(es)` : `${candidate.attendance_count || 0} presença(s) como ${group.meta.label.toLowerCase()}` %></td>
          <td><% if (candidate.attended_activities && candidate.attended_activities.length) { candidate.attended_activities.forEach((activity) => { %><span class="activity-tag"><%= activity.activity_name %></span><% }) %><br><small><%= candidate.total_workload_hours %> hora(s)-aula</small><% } else { %><span class="hint">Nenhuma atividade certificável neste papel.</span><% } %></td>
          <td class="<%= candidate.eligible ? 'ok' : 'no' %>"><%= candidate.eligible ? 'Elegível' : 'Não elegível' %></td>
          <td><% if (candidate.active_emission_id) { %><a href="/admin/events/<%= event.id %>/certificates/emissions/<%= candidate.active_emission_id %>/download">Baixar</a> <form style="display:inline" method="post" action="/admin/events/<%= event.id %>/certificates/<%= group.role %>/<%= candidate.user_id %>/reissue"><button class="secondary">Reemitir v<%= candidate.latest_version %></button></form><% } else if (candidate.eligible) { %><form method="post" action="/admin/events/<%= event.id %>/certificates/<%= group.role %>/<%= candidate.user_id %>/issue"><button>Emitir</button></form><% } else { %>—<% } %></td>
        </tr><% }) %>
      </tbody></table>
    </section>
  <% }) %>
</main>
<script>
document.querySelectorAll('.certificate-rule-form').forEach((form)=>{const input=form.querySelector('.selected-background-id');const color=form.querySelector('.text-color');const preview=form.querySelector('.preview');const iframe=preview.querySelector('iframe');const error=form.querySelector('.preview-error');const button=form.querySelector('.preview-button');const buildPreview=()=>{if(!input.value){error.style.display='block';preview.style.display='none';return}error.style.display='none';const params=new URLSearchParams({role:form.dataset.role,background_id:input.value,text_color:color.value});iframe.src='/admin/events/<%= event.id %>/certificates/preview?'+params.toString();preview.style.display='block';button.textContent='Atualizar prévia'};form.querySelectorAll('.background-card').forEach((card)=>card.addEventListener('click',()=>{form.querySelectorAll('.background-card').forEach((item)=>item.classList.remove('selected'));card.classList.add('selected');input.value=card.dataset.backgroundId;if(preview.style.display==='block')buildPreview()}));color.addEventListener('input',()=>{if(preview.style.display==='block')buildPreview()});button.addEventListener('click',buildPreview)});
</script>
<%- include("../../partials/csrf-inject") %>
  </body></html>
