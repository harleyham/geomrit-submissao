<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body{font-family:'Inter',sans-serif;background:#0a0f1a;color:#e2e8f0;margin:0}.topbar{background:rgba(15,23,42,0.8);border-bottom:1px solid rgba(148,163,184,0.1);backdrop-filter:blur(20px);padding:0 2rem;height:64px;display:flex;align-items:center;position:sticky;top:0;z-index:100}.topbar-inner{width:100%;max-width:1400px;margin:0 auto;display:flex;align-items:center;justify-content:space-between}.logo{font-size:1.25rem;font-weight:700;color:#e2e8f0;text-decoration:none}.logo-icon{color:#60a5fa}.topbar-nav{display:flex;gap:0.25rem;align-items:center}.topbar-nav a{color:#94a3b8;padding:0.5rem 0.75rem;border-radius:6px;text-decoration:none;font-size:0.875rem;font-weight:500;transition:all 0.15s}.topbar-nav a:hover,.topbar-nav a.active{color:#e2e8f0;background:rgba(148,163,184,0.1)}    .btn-ghost{background:transparent;color:#94a3b8;border:1px solid rgba(148,163,184,0.2);font-size:0.875rem;padding:0.5rem 1rem}.btn-ghost:hover{background:rgba(148,163,184,0.1);color:#e2e8f0}.session-pill{padding:0.42rem 0.78rem;border:1px solid rgba(148,163,184,0.18);border-radius:999px;color:#e2e8f0;font-size:0.82rem}    .btn-logout{background:transparent;color:#f87171;border:1px solid rgba(248,113,113,0.25);font-family:inherit;cursor:pointer}.btn-secondary{background:rgba(148,163,184,0.12);color:#e2e8f0;border:1px solid rgba(148,163,184,0.18);text-decoration:none;font-weight:500}.btn-secondary:hover{background:rgba(148,163,184,0.2)}.badge{display:inline-block;padding:3px 10px;border-radius:999px;font-size:11px;font-weight:600;letter-spacing:0.3px;text-transform:uppercase}.badge-lecture{background:#312e81;color:#a5b4fc}.badge-seminar{background:#164e63;color:#67e8f9}.badge-roundtable{background:#365314;color:#84cc16}.badge-course{background:#78350f;color:#fdba74}.badge-oral_presentation{background:#7f1d1d;color:#fca5a5}.badge-poster_presentation{background:#581c87;color:#d8b4fe}.badge-other{background:#1e293b;color:#94a3b8}.activity-card{background:#1e293b;border-radius:10px;padding:16px;margin:16px 0}.activity-card h3{margin:0 0 12px;font-size:1rem;font-weight:600;color:#e2e8f0}.activity-card .hint{color:#94a3b8;font-size:13px;margin:8px 0}.activity-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:10px}.activity-item{background:#0f172a;padding:10px 14px;border-radius:8px;border:1px solid #334155;display:flex;flex-direction:column;gap:4px}.activity-item strong{font-size:13px;color:#f1f5f9}.activity-item small{color:#94a3b8;font-size:11px}.activity-item .stats{display:flex;gap:10px;margin-top:4px}.activity-item .stats span{font-size:11px;color:#64748b}.stats-card{background:#1e293b;border-radius:10px;padding:16px;text-align:center;border:1px solid #334155}.stats-card .number{font-size:1.8rem;font-weight:700;color:#e2e8f0;display:block}.stats-card .label{font-size:11px;color:#94a3b8;text-transform:uppercase;letter-spacing:0.5px}.main-content{max-width:1000px;margin:auto;padding:28px}.card{background:#1e293b;border-radius:10px;padding:20px;margin:20px 0}label{display:block;font-size:13px;color:#cbd5e1;margin:9px 0 4px}input,textarea,button{width:100%;box-sizing:border-box;padding:9px;border:1px solid #475569;border-radius:6px;background:#0f172a;color:#f8fafc}textarea{min-height:64px}button{background:#2563eb;cursor:pointer;width:auto}.secondary{background:#334155;color:#e2e8f0;border:1px solid rgba(148,163,184,0.18);padding:0.5rem 1rem;border-radius:6px;font-weight:500;text-decoration:none;display:inline-block;cursor:pointer}.secondary:hover{background:#475569}.row{display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:12px}.role{border-top:1px solid #475569;padding-top:16px;margin-top:18px}table{width:100%;border-collapse:collapse;margin-top:15px}th,td{text-align:left;padding:10px;border-bottom:1px solid #334155;vertical-align:top}.ok{color:#8AAD34}.no{color:#fca5a5}.alert{padding:10px;border-radius:6px}.success{background:#14532d}.error{background:#7f1d1d}.hint{color:#94a3b8;font-size:13px}.activity-tag{display:inline-block;padding:3px 7px;margin:2px;border-radius:999px;background:#334155;color:#cbd5e1;font-size:12px}.background-groups{margin-top:14px}.background-group{margin-top:14px}.background-group h3{font-size:13px;color:#94a3b8;margin:0 0 8px}.background-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(135px,1fr));gap:12px}.background-card{padding:7px;border:2px solid #475569;border-radius:8px;background:#0f172a;cursor:pointer;text-align:left;color:#e2e8f0}.background-card:hover{border-color:#60a5fa}.background-card.selected{border-color:#3b82f6;background:#172554}.background-thumb{display:block;width:100%;height:84px;object-fit:cover;border-radius:5px;background:#334155}.background-name{display:block;margin-top:6px;font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.background-empty{padding:12px;color:#94a3b8;border:1px dashed #475569;border-radius:8px}.preview{display:none;margin-top:16px}.preview iframe{width:100%;height:560px;border:0;border-radius:8px;background:#fff}.preview-error{display:none;color:#fca5a5;margin:8px 0}@media(max-width:800px){.row{grid-template-columns:1fr}.card{overflow-x:auto}}
  </style>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="logo"><span class="logo-icon">◆</span> Artigos LIGEM</a>
      <nav class="topbar-nav">
        <a href="/admin">Dashboard</a>
        <a href="/admin/events">Eventos</a>
        <a href="/admin/users">Usuários</a>
        <% if (userEmail) { %><span class="session-pill"><%= userEmail %></span><% } %>
        <form method="POST" action="/admin/logout" style="display:inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-logout">Sair</button>
        </form>
      </nav>
    </div>
  </header>
  <main class="main-content">
  <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap"><div><h1>Certificados — <%= event.name %></h1><p class="hint">Cada presença é contabilizada somente no papel exercido na atividade. A mesma pessoa pode receber certificados diferentes, com atividades e cargas horárias independentes.</p></div><form method="post" action="/admin/events/<%= event.id %>/certificates/issue-all"><button type="submit">Emitir todos os elegíveis</button></form><a href="/admin/events/<%= event.id %>/certificates/export-all" style="background:#ea580c;color:#fff;border:none;padding:0.5rem 1rem;border-radius:6px;text-decoration:none;font-weight:500;cursor:pointer">Exportar todos os certificados emitidos</a></div>
  <% if (success) { %><p class="alert success"><%= success %></p><% } %><% if (error) { %><p class="alert error"><%= error %></p><% } %>
  <section class="card"><h2>Biblioteca de fundos</h2><form method="post" enctype="multipart/form-data" action="/admin/events/<%= event.id %>/certificates/backgrounds"><input name="name" required placeholder="Nome do fundo"><br><br><input type="file" name="background_file" accept="image/png,image/jpeg" required><br><br><button>Enviar fundo PNG/JPEG</button></form></section>

  <%
    const activityTypeMap = { lecture:'Palestra', seminar:'Seminário', roundtable:'Mesa-redonda', course:'Minicurso', oral_presentation:'Apresentação oral', poster_presentation:'Apresentação pôster', other:'Outra' };
    const typeClasses = { lecture:'badge-lecture', seminar:'badge-seminar', roundtable:'badge-roundtable', course:'badge-course', oral_presentation:'badge-oral_presentation', poster_presentation:'badge-poster_presentation', other:'badge-other' };
    const activitiesByType = {};
    const sortedActivities = [...(activities||[])].sort((a,b) => String(a.name||'').localeCompare(String(b.name||''), 'pt-BR'));
    sortedActivities.forEach((a) => { const t = a.activity_type || 'other'; if (!activitiesByType[t]) activitiesByType[t] = []; activitiesByType[t].push(a); });
    const typeOrder = ['lecture','seminar','roundtable','course','oral_presentation','poster_presentation','other'];
    const totalActivities = activities ? activities.length : 0;
    const totalEnrolled = activities ? activities.reduce((s,a) => s + (a.enrolled_count||0), 0) : 0;
    const totalAttendees = activities ? activities.reduce((s,a) => s + (a.attendees_count||0), 0) : 0;
  %>
  <% if (totalActivities > 0) { %>
  <section class="card">
    <h2>Atividades do evento</h2>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:16px">
      <div class="stats-card"><span class="number"><%= totalActivities %></span><span class="label">Total de atividades</span></div>
      <div class="stats-card"><span class="number"><%= totalEnrolled %></span><span class="label">Inscrições vinculadas</span></div>
      <div class="stats-card"><span class="number"><%= totalAttendees %></span><span class="label">Presenças registradas</span></div>
    </div>
    <% typeOrder.forEach((type) => { if (!activitiesByType[type]) return; const items = activitiesByType[type]; %>
    <div class="activity-card">
      <h3><span class="badge <%= typeClasses[type] %>"><%= activityTypeMap[type] %></span> <span style="color:#94a3b8;font-weight:400;margin-left:8px">(<%= items.length %> atividade<%= items.length > 1 ? 's' : '' %>)</span></h3>
      <div class="activity-list">
        <% items.forEach((a) => { %>
        <div class="activity-item">
          <strong><%= a.name %></strong>
          <small><%= a.activity_date || 'Data a definir' %><% if (a.workload_hours && Number(a.workload_hours) > 0) { %> · <%= a.workload_hours %>h</small><% } else { %></small><% } %>
          <div class="stats"><span>Inscritos: <%= a.enrolled_count || 0 %></span><span>Presentes: <%= a.attendees_count || 0 %></span></div>
          <% if (a.certificate_enabled) { %><span class="badge" style="background:#14532d;color:#86efac;font-size:10px">Certificável</span><% } else { %><span style="color:#64748b;font-size:10px">Sem certificação</span><% } %>
        </div>
        <% }) %>
      </div>
    </div>
    <% }) %>
    <p style="margin-top:12px"><a href="/admin/events/<%= event.id %>/activities" class="btn-secondary">Gerenciar atividades</a></p>
  </section>
  <% } %>

  <% certificatesByRole.forEach((group) => {
    const rule=group;
    const defaultBackgrounds=backgrounds.filter((bg)=>String(bg.file_path||'').startsWith('assets/Fundos/'));
    const uploadedBackgrounds=backgrounds.filter((bg)=>!String(bg.file_path||'').startsWith('assets/Fundos/'));
  %>
    <section class="card role">
      <h2><%= group.meta.label %> <span style="font-weight:400;font-size:0.8125rem;color:#94a3b8">(<%= group.certificatesIssued %> emitido<%= group.certificatesIssued !== 1 ? 's' : '' %>)</span></h2>
      <p class="hint"><%= group.role === 'reviewer' ? 'Elegibilidade: ao menos um parecer enviado neste evento.' : group.role === 'participant' ? 'Elegibilidade: mínimo de presenças em atividades certificáveis nas quais a pessoa também esteja inscrita.' : 'Elegibilidade: mínimo de presenças registradas neste mesmo papel em atividades certificáveis.' %></p>
      <form method="post" action="/admin/events/<%= event.id %>/certificates/rule" class="certificate-rule-form" data-role="<%= group.role %>">
        <input type="hidden" name="certificate_role" value="<%= group.role %>"><input type="hidden" name="background_id" class="selected-background-id" value="<%= rule.background_id || '' %>">
        <div class="row"><div><label>Título</label><input name="title" value="<%= rule.title || group.meta.title %>" required></div><div><label>Cor</label><input type="color" name="text_color" class="text-color" value="<%= rule.text_color || '#0f172a' %>"></div><div><label>Presenças mínimas</label><input type="number" min="<%= group.role === 'reviewer' ? 0 : 1 %>" name="min_attendance" value="<%= group.role === 'reviewer' ? 0 : rule.min_attendance %>" <%= group.role === 'reviewer' ? 'readonly' : '' %>></div></div>
        <label>Texto (use {event} para o nome do evento)</label><textarea name="body_text"><%= rule.body_text || group.meta.body %></textarea>
        <div class="background-groups"><label>Fundo do certificado</label>
          <% if (!backgrounds.length) { %><div class="background-empty">Envie um fundo PNG ou JPEG para configurar este certificado.</div><% } %>
          <% if (defaultBackgrounds.length) { %><div class="background-group"><h3>Fundos padrão</h3><div class="background-grid"><% defaultBackgrounds.forEach((bg) => { %><button type="button" class="background-card <%= Number(rule.background_id)===Number(bg.id)?'selected':'' %>" data-background-id="<%= bg.id %>"><img class="background-thumb" src="/<%= bg.file_path %>" alt="<%= bg.name %>"><span class="background-name"><%= bg.name %></span></button><% }) %></div></div><% } %>
          <% if (uploadedBackgrounds.length) { %><div class="background-group"><h3>Fundos enviados</h3><div class="background-grid"><% uploadedBackgrounds.forEach((bg) => { %><button type="button" class="background-card <%= Number(rule.background_id)===Number(bg.id)?'selected':'' %>" data-background-id="<%= bg.id %>"><img class="background-thumb" src="/admin/events/<%= event.id %>/certificates/backgrounds/<%= bg.id %>/view" alt="<%= bg.name %>"><span class="background-name"><%= bg.name %></span></button><% }) %></div></div><% } %>
        </div>
        <p><button>Salvar configuração</button> <button type="button" class="secondary preview-button">Visualizar prévia</button> <button type="button" class="secondary reset-button">Visualizar original</button> <input type="hidden" name="apply_to_all" value="0"><button type="button" class="secondary" id="apply-to-all-btn-<%= group.role %>">Salvar configuração geral</button></p>
        <p class="preview-error">Selecione um fundo para visualizar a prévia.</p><div class="preview"><iframe title="Prévia do certificado"></iframe></div>
      </form>
      <table><thead><tr><th>Pessoa</th><th>Atuação comprovada</th><th>Atividades e carga horária</th><th>Elegibilidade</th><th>Certificado</th></tr></thead><tbody>
        <% if (!group.candidates.length) { %><tr><td colspan="5" class="hint">Nenhuma pessoa vinculada a este papel.</td></tr><% } %>
        <% group.candidates.forEach((candidate) => { %><tr>
          <td><strong><%= candidate.name %></strong><br><small><%= candidate.email %></small><% if (candidate.article_title) { %><br><small><%= candidate.article_title %></small><% } %></td>
          <td><%= group.role === 'reviewer' ? `${candidate.report_count || 0} parecer(es)` : `${candidate.attendance_count || 0} presença(s) como ${group.meta.label.toLowerCase()}` %></td>
          <td><% if (candidate.attended_activities && candidate.attended_activities.length) { candidate.attended_activities.forEach((activity) => { %><span class="activity-tag"><%= activity.activity_name %></span><% }) %><br><small><%= candidate.total_workload_hours %> hora(s)-aula</small><% } else { %><span class="hint">Nenhuma atividade certificável neste papel.</span><% } %></td>
          <td class="<%= candidate.active_emission_id ? 'ok' : (candidate.eligible ? 'ok' : 'no') %>"><%- candidate.active_emission_id ? '<span style="color:#329542">Emitido</span>' : (candidate.eligible ? '<span style="color:#8AAD34">Elegível</span>' : 'Não elegível') %></td>
          <td><% if (candidate.active_emission_id) { %><a href="/admin/events/<%= event.id %>/certificates/emissions/<%= candidate.active_emission_id %>/download" class="secondary">Baixar</a> <form style="display:inline" method="post" action="/admin/events/<%= event.id %>/certificates/<%= group.role %>/<%= candidate.user_id %>/reissue"><button class="secondary">Reemitir v<%= candidate.latest_version %></button></form><% } else if (candidate.eligible) { %><form method="post" action="/admin/events/<%= event.id %>/certificates/<%= group.role %>/<%= candidate.user_id %>/issue"><button>Emitir</button></form><% } else { %>—<% } %></td>
        </tr><% }) %>
      </tbody></table>
    </section>
  <% }) %>
</main>
<script>
document.querySelectorAll('.certificate-rule-form').forEach((form)=>{const input=form.querySelector('.selected-background-id');const color=form.querySelector('.text-color');const titleInput=form.querySelector('[name="title"]');const bodyInput=form.querySelector('[name="body_text"]');const preview=form.querySelector('.preview');const iframe=preview.querySelector('iframe');const error=form.querySelector('.preview-error');const button=form.querySelector('.preview-button');const resetButton=form.querySelector('.reset-button');const eventFormAction=form.action;const csrfToken=form.querySelector('[name="_csrf"]')?form.querySelector('[name="_csrf"]').value:document.querySelector('input[name="_csrf"]')?document.querySelector('input[name="_csrf"]').value:'';const showPreview=(params)=>{error.style.display='none';iframe.src='/admin/events/<%= event.id %>/certificates/preview?'+params.toString();preview.style.display='block'};const resetToOriginal=()=>{fetch(eventFormAction.replace('/certificates/rule','/certificates/rule/current'),{headers:csrfToken?{'X-CSRF-Token':csrfToken}:undefined}).then(r=>r.json()).then(data=>{const orig=data[form.dataset.role];if(!orig)return;if(!orig.background_id){error.style.display='block';preview.style.display='none';return}error.style.display='none';const params=new URLSearchParams({role:form.dataset.role,background_id:orig.background_id,text_color:orig.text_color||'#0f172a',title:orig.title||'',body_text:orig.body_text||''});showPreview(params)}).catch(()=>{})};const buildPreview=()=>{if(!input.value){error.style.display='block';preview.style.display='none';return}error.style.display='none';const params=new URLSearchParams({role:form.dataset.role,background_id:input.value,text_color:color.value,title:titleInput?titleInput.value:'',body_text:bodyInput?bodyInput.value:''});showPreview(params)};const handleApplyToAll=(e)=>{e.preventDefault();const applyToAllCheckbox=form.querySelector('[name="apply_to_all"]');applyToAllCheckbox.value='1';if(confirm('Salvar a cor e o fundo selecionados em TODOS os tipos de certificado deste evento?')){form.action='/admin/events/<%= event.id %>/certificates/rule/apply-to-all';form.submit()}};const applyToAllBtn=form.querySelector('#apply-to-all-btn-'+form.dataset.role);if(applyToAllBtn)applyToAllBtn.addEventListener('click',handleApplyToAll);form.querySelectorAll('.background-card').forEach((card)=>card.addEventListener('click',()=>{form.querySelectorAll('.background-card').forEach((item)=>item.classList.remove('selected'));card.classList.add('selected');input.value=card.dataset.backgroundId;buildPreview()}));color.addEventListener('input',buildPreview);titleInput.addEventListener('input',buildPreview);bodyInput.addEventListener('input',buildPreview);button.addEventListener('click',buildPreview);resetButton.addEventListener('click',resetToOriginal)});
</script>
<%- include("../../partials/csrf-inject") %>
  </body></html>
