<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %></title>
  <link href="/lib/flatpickr/flatpickr.min.css" rel="stylesheet">
  <style>
    body{font-family:'Inter',sans-serif;background:#0a0f1a;color:#e2e8f0;margin:0}.topbar{background:rgba(15,23,42,0.8);border-bottom:1px solid rgba(148,163,184,0.1);backdrop-filter:blur(20px);padding:0 2rem;height:64px;display:flex;align-items:center;position:sticky;top:0;z-index:100}.topbar-inner{width:100%;max-width:1400px;margin:0 auto;display:flex;align-items:center;justify-content:space-between}.logo{font-size:1.25rem;font-weight:700;color:#e2e8f0;text-decoration:none}.logo-icon{color:#60a5fa}.topbar-nav{display:flex;gap:0.4rem;align-items:center;flex-wrap:wrap}.topbar-nav a{color:#94a3b8;padding:0.5rem 0.75rem;border-radius:6px;text-decoration:none;font-size:0.875rem;font-weight:500;transition:all 0.15s}.topbar-nav a:hover{color:#e2e8f0;background:rgba(148,163,184,0.1)}.session-pill{padding:0.42rem 0.78rem;border:1px solid rgba(148,163,184,0.18);border-radius:999px;color:#e2e8f0;font-size:0.82rem}.btn-logout{background:transparent;color:#f87171;border:1px solid rgba(248,113,113,0.25);font-family:inherit;cursor:pointer}    .btn{display:inline-flex;align-items:center;justify-content:center;padding:0.625rem 1.25rem;border-radius:8px;font-size:0.875rem;font-weight:500;cursor:pointer;border:none;text-decoration:none}.btn-secondary{background:rgba(148,163,184,0.12);color:#e2e8f0;border:1px solid rgba(148,163,184,0.18);text-decoration:none;font-weight:500}.btn-secondary:hover{background:rgba(148,163,184,0.2)}.badge{display:inline-block;padding:3px 10px;border-radius:999px;font-size:11px;font-weight:600;letter-spacing:0.3px;text-transform:uppercase}.badge-lecture{background:#312e81;color:#a5b4fc}.badge-seminar{background:#164e63;color:#67e8f9}.badge-roundtable{background:#365314;color:#84cc16}.badge-course{background:#78350f;color:#fdba74}.badge-oral_presentation{background:#7f1d1d;color:#fca5a5}.badge-poster_presentation{background:#581c87;color:#d8b4fe}.badge-other{background:#1e293b;color:#94a3b8}.activity-card{background:#1e293b;border-radius:10px;padding:16px;margin:16px 0}.activity-card h3{margin:0 0 12px;font-size:1rem;font-weight:600;color:#e2e8f0}.activity-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:10px}.activity-item{background:#0f172a;padding:12px 14px;border-radius:8px;border:1px solid #334155;display:flex;flex-direction:column;gap:6px}.activity-item strong{font-size:13px;color:#f1f5f9}.activity-item small{color:#94a3b8;font-size:11px}.activity-item .item-actions{display:flex;gap:6px;margin-top:4px;flex-wrap:wrap}.activity-item .item-actions a{flex:1;text-align:center;text-decoration:none;background:#334155;color:#e2e8f0;border:1px solid #475569;border-radius:6px;padding:5px 10px;font-size:12px;cursor:pointer;font-weight:500;display:block}main{padding:30px 6%;max-width:1300px;margin:auto}.card{background:#1e293b;padding:20px;border-radius:10px;margin:15px 0}input,select,textarea,button{padding:8px;margin:4px;background:#0f172a;color:#fff;border:1px solid #475569;border-radius:6px}input[name="video_url"]{width:300px}input[name="workload_hours"]{width:240px}.activity-description-field{display:block;width:min(800px,calc(100% - 24px));min-height:90px}button{background:#2563eb;cursor:pointer}label{display:inline-block;margin:6px}a{color:#93c5fd}table{width:100%;border-collapse:collapse}td,th{padding:10px;border-bottom:1px solid #334155;text-align:left;vertical-align:top}.hint{color:#94a3b8;font-size:13px}.alert{padding:10px;border-radius:6px}.success{background:#14532d}.error{background:#7f1d1d}.badge{display:inline-block;padding:3px 7px;margin:2px;border-radius:999px;background:#334155;font-size:12px}.disabled{color:#94a3b8}input[type=number]::-webkit-inner-spin-button,input[type=number]::-webkit-outer-spin-button{-webkit-appearance:none;margin:0}input[type=number]{-moz-appearance:textfield;appearance:textfield}
  </style>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="logo"><span class="logo-icon">◆</span> Gerência de Eventos</a>
      <nav class="topbar-nav">
        <% const canManageActivities = (typeof canManage !== 'undefined') ? canManage : true; const isStaffView = (typeof isStaff !== 'undefined') && isStaff; const canEditActivities = canManageActivities || isStaffView; %>
        <% if (isAdmin) { %><a href="/admin">Dashboard</a><% } %>
        <a href="/admin/events">Eventos</a>
        <% if (isAdmin) { %><a href="/admin/users">Usuários</a><% } %>
        <% if (userEmail) { %><span class="session-pill"><%= userEmail %></span><% } %>
        <form method="POST" action="/admin/logout" style="display:inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-logout">Sair</button>
        </form>
      </nav>
    </div>
  </header>
  <main class="main-content">
    <h1>Atividades — <%= event.name %></h1>
    <% if (canManageActivities) { %>
    <p class="hint">Os papéis elegíveis definem quem pode atuar na atividade. Inscrições de participantes são vinculadas ao criar ou <a href="/admin/events/<%= event.id %>/participants">editar participantes</a>; depois, a chamada registra a presença efetiva e o papel exercido.</p>
    <% } else { %>
    <p class="hint">Você está no modo <strong>Staff</strong>: edite atividades/etapas existentes e use <strong>Marcar Presença</strong>, <strong>Imp. Lista</strong> e <strong>QR Presença</strong>. Criar/excluir atividades, etapas e salas, além de configurar o evento, permanecem com a administração.</p>
    <% } %>
    <% if (success) { %><p class="alert success"><%= success %></p><% } %>
    <% if (error) { %><p class="alert error"><%= error %></p><% } %>
    <% const activityForm = (typeof formDraft !== 'undefined' && formDraft) ? formDraft : (editingActivity || {}); const selectedRoles = String(activityForm.eligible_roles || 'participant,reviewer,speaker,teacher,oral_presenter,poster_presenter').split(','); %>
    <% if (canManageActivities || (isStaffView && editingActivity)) { %>
    <section class="card">
      <h2><%= editingActivity ? 'Editar atividade' : 'Cadastrar atividade' %></h2>
      <form method="post" class="availability-form" data-availability-url="/admin/events/<%= event.id %>/rooms/availability" data-date-field="date_start" data-exclude-activity="<%= editingActivity ? editingActivity.id : '' %>" action="<%= editingActivity ? `/admin/events/${event.id}/activities/${editingActivity.id}` : `/admin/events/${event.id}/activities` %>">
        <input name="name" required placeholder="Nome da atividade" value="<%= activityForm.name || '' %>">
        <select id="activity_type" name="activity_type">
          <% [['lecture','Palestra'],['seminar','Seminário'],['roundtable','Mesa-redonda'],['course','Minicurso'],['oral_presentation','Apresentação oral'],['poster_presentation','Apresentação pôster'],['other','Outra']].forEach((type) => { %><option value="<%= type[0] %>" <%= activityForm.activity_type === type[0] ? 'selected' : '' %>><%= type[1] %></option><% }) %>
        </select>
        <div id="activity-description-wrap">
          <textarea class="activity-description-field" id="description" name="description" maxlength="2000" placeholder="Descrição breve ou ementa da atividade"><%= activityForm.description || '' %></textarea>
          <div class="hint">Disponível para palestras e minicursos. Máximo de 2000 caracteres.</div>
        </div>
        <input name="date_start" type="text" class="datepicker" title="Data de início" value="<%= activityForm.date_start ? formatBRDate(activityForm.date_start) : '' %>">
        <input name="date_end" type="text" class="datepicker" title="Data de fim" value="<%= activityForm.date_end ? formatBRDate(activityForm.date_end) : '' %>">
        <input name="time_start" type="time" title="Hora de início" value="<%= activityForm.time_start || '' %>">
        <input name="time_end" type="time" title="Hora de término" value="<%= activityForm.time_end || '' %>">
        <% const activityHasSessions = Boolean(editingActivity) && Number(editingActivity.session_count || 0) > 0; %>
        <% if (!activityHasSessions && eventRooms && eventRooms.length) { %>
          <select name="room_id" id="room-select" title="Sala (somente para atividades sem etapas)">
            <option value="">— Sem sala —</option>
            <% eventRooms.forEach((room) => { %>
              <option value="<%= room.id %>" <%= activityForm.room_allocation && activityForm.room_allocation.room_id === room.id ? 'selected' : '' %>><%= room.name %> (<%= room.size === 'auditorium' ? 'Auditório' : room.size === 'small' ? 'Pequena' : room.size === 'medium' ? 'Média' : 'Grande' %>)</option>
            <% }) %>
          </select>
          <span class="hint" style="display:block;margin:6px 4px">A sala usa a data e os horários acima (em atividades de vários dias, a reserva vale no dia de início).</span>
        <% } else if (activityHasSessions) { %>
          <span class="hint" style="display:block;margin:6px 4px">Atividades com etapas têm a sala alocada <a href="/admin/events/<%= event.id %>/activities/<%= editingActivity.id %>/sessions" style="color:#93c5fd">por etapa</a>.</span>
        <% } else if (eventRooms && !eventRooms.length) { %>
          <span class="hint" style="display:block;margin:6px 4px">Cadastre <a href="/admin/events/<%= event.id %>/rooms" style="color:#93c5fd">salas</a> para poder alocá-las a atividades e etapas.</span>
        <% } %>
        <input name="workload_hours" type="number" step=".5" min="0" placeholder="Carga horária (total, se sem etapas)" value="<%= activityForm.workload_hours ?? '' %>">
        <input name="video_url" type="url" title="Link da transmissão de vídeo" placeholder="Link da transmissão de vídeo (ex.: YouTube)" value="<%= activityForm.video_url || '' %>">
        <label style="margin-left:10px;font-size:13px;color:#94a3b8"><input type="checkbox" name="has_video" value="1" style="margin:0 6px 0 0" <%= activityForm.has_video || activityForm.video_url ? 'checked' : '' %>> Haverá transmissão de vídeo (mesmo que o link ainda não esteja disponível)</label>
        <h3>Papéis elegíveis na chamada</h3>
        <% const roles=[['participant','Participante'],['reviewer','Revisor'],['speaker','Palestrante'],['teacher','Professor'],['oral_presenter','Apresentador Oral'],['poster_presenter','Apresentador Pôster']]; roles.forEach((role) => { %>
          <label><input type="checkbox" name="eligible_roles" value="<%= role[0] %>" <%= selectedRoles.includes(role[0]) ? 'checked' : '' %>> <%= role[1] %></label>
        <% }) %>
        <p><label><input type="checkbox" name="certificate_enabled" value="1" <%= ((typeof formDraft !== 'undefined' && formDraft) ? formDraft.certificate_enabled : !editingActivity) ? 'checked' : '' %>> Contabilizar esta atividade para certificados e carga horária</label></p>
        <button type="submit"><%= editingActivity ? 'Salvar atividade' : 'Cadastrar atividade' %></button>
        <% if (editingActivity) { %><a href="/admin/events/<%= event.id %>/activities">Cancelar edição</a><% } %>
      </form>
    </section>
    <% } %>
    <%
      const activityTypeMap = { lecture:'Palestra', seminar:'Seminário', roundtable:'Mesa-redonda', course:'Minicurso', oral_presentation:'Apresentação oral', poster_presentation:'Apresentação pôster', other:'Outra' };
      const typeClasses = { lecture:'badge-lecture', seminar:'badge-seminar', roundtable:'badge-roundtable', course:'badge-course', oral_presentation:'badge-oral_presentation', poster_presentation:'badge-poster_presentation', other:'badge-other' };
      const activityRolesMap = { participant:'Participante', reviewer:'Revisor', speaker:'Palestrante', teacher:'Professor', oral_presenter:'Apresentador Oral', poster_presenter:'Apresentador Pôster' };
      const activitiesByType = {};
      const sortedActivities = [...(activities||[])].sort((a,b) => {
        const da = a.date_start ? String(a.date_start) : '9999-99-99';
        const db = b.date_start ? String(b.date_start) : '9999-99-99';
        if (da !== db) return da < db ? -1 : 1;
        return String(a.name||'').localeCompare(String(b.name||''), 'pt-BR');
      });
      sortedActivities.forEach((a) => { const t = a.activity_type || 'other'; if (!activitiesByType[t]) activitiesByType[t] = []; activitiesByType[t].push(a); });
      const typeOrder = ['lecture','seminar','roundtable','course','oral_presentation','poster_presentation','other'];
    %>
    <% if (!activities.length) { %>
    <section class="card"><h2>Atividades cadastradas</h2><p class="hint">Nenhuma atividade cadastrada.</p></section>
    <% } else { %>
    <% typeOrder.forEach((type) => { if (!activitiesByType[type]) return; const items = activitiesByType[type]; %>
    <section class="activity-card">
      <h3><span class="badge <%= typeClasses[type] %>"><%= activityTypeMap[type] %></span> <span style="color:#94a3b8;font-weight:400;margin-left:8px">(<%= items.length %> atividade<%= items.length > 1 ? 's' : '' %>)</span></h3>
      <div class="activity-list">
        <% items.forEach((activity) => { %>
        <% const hasSessions = Number(activity.session_count || 0) > 0;
           const displayWorkload = hasSessions ? Number(activity.sessions_workload || 0) : Number(activity.workload_hours || 0); %>
        <div class="activity-item">
          <strong><%= activity.name %></strong>
          <% if (activity.description) { %><small><%= activity.description %></small><% } %>
          <small><%= activityDateRange(activity) %><% if (activity.time_start || activity.time_end) { %> · <%= activity.time_start || '?' %>–<%= activity.time_end || '?' %><% } %><% if (displayWorkload > 0) { %> · <%= displayWorkload %>h<% if (hasSessions) { %> (etapas)<% } %></small><% } else { %></small><% } %>
          <% if (activity.room_allocation) { %><small style="color:#93c5fd">Sala: <%= activity.room_allocation.room_name %> (<%= String(activity.room_allocation.time_start).slice(0,5) %>–<%= String(activity.room_allocation.time_end).slice(0,5) %>)</small><% } %>
          <small>
            <% String(activity.eligible_roles || '').split(',').filter(Boolean).forEach((role) => { %><span class="badge" style="background:#334155;color:#94a3b8;font-size:10px"><%= activityRolesMap[role] || role %></span> <% }) %>
          </small>
          <div class="item-actions">
            <% if (canEditActivities) { %>
            <a href="/admin/events/<%= event.id %>/activities?edit_activity_id=<%= activity.id %>">Editar</a>
            <% } %>
            <% if (canManageActivities) { %>
            <form method="post" action="/admin/events/<%= event.id %>/activities/<%= activity.id %>/delete" style="display:inline" nonce="<%= cspNonce %>" onsubmit="return confirm('Excluir a atividade \"<%= activity.name %>\"? Isso remove também etapas, inscrições e avaliações vinculadas.');">
              <button type="submit" style="display:inline;padding:2px 8px;font-size:10px;background:#1e293b;color:#f87171;border:1px solid #7f1d1d;border-radius:4px;cursor:pointer;width:auto">Excluir</button>
            </form>
            <% } %>
            <a href="/admin/events/<%= event.id %>/activities/<%= activity.id %>/sessions">Etapas<% if (hasSessions) { %> (<%= activity.session_count %>)<% } %></a>
            <a href="/admin/events/<%= event.id %>/activities/<%= activity.id %>/attendance">Marcar Presença</a>
            <% if (activity.video_url) { %><a href="<%= activity.video_url %>" target="_blank" rel="noopener noreferrer">Vídeo</a><% } else if (activity.has_video) { %><span style="flex:1;text-align:center;background:#1e293b;color:#93c5fd;border:1px solid #334155;border-radius:6px;padding:5px 10px;font-size:12px">Transmissão</span><% } %>
            <% if (hasSessions) { %>
              <% (activity.sessions || []).forEach((session) => { %>
                <a href="/admin/events/<%= event.id %>/activities/<%= activity.id %>/attendance-print?session_id=<%= session.id %>" class="btn-secondary" style="margin-left:4px;font-size:11px;padding:2px 8px;text-decoration:none;border:1px solid #334155;border-radius:4px">Imp. Lista · <%= session.name %></a>
                <a href="/admin/events/<%= event.id %>/activities/<%= activity.id %>/checkin-print?session_id=<%= session.id %>" class="btn-secondary" style="margin-left:4px;font-size:11px;padding:2px 8px;text-decoration:none;border:1px solid #0f766e;border-radius:4px">QR Presença · <%= session.name %></a>
              <% }) %>
            <% } else { %>
              <a href="/admin/events/<%= event.id %>/activities/<%= activity.id %>/attendance-print" class="btn-secondary" style="margin-left:4px;font-size:11px;padding:2px 8px;text-decoration:none;border:1px solid #334155;border-radius:4px">Imp. Lista Presença</a>
              <a href="/admin/events/<%= event.id %>/activities/<%= activity.id %>/checkin-print" class="btn-secondary" style="margin-left:4px;font-size:11px;padding:2px 8px;text-decoration:none;border:1px solid #0f766e;border-radius:4px">QR Presença</a>
            <% } %>
          </div>
          <div style="display:flex;gap:10px;align-items:center;margin-top:2px">
            <span style="font-size:11px;color:#64748b">Inscritos: <%= activity.enrolled_count || 0 %></span>
            <span style="font-size:11px;color:#64748b">Presentes: <%= activity.attendees_count || 0 %></span>
            <% if (activity.certificate_enabled) { %><span class="badge" style="background:#14532d;color:#86efac;font-size:10px">Certificável</span><% } else if (canManageActivities) { %><form method="post" action="/admin/events/<%= event.id %>/activities/<%= activity.id %>/certificate-enabled"><input type="hidden" name="enabled" value="1"><button type="submit" style="display:inline;padding:2px 8px;font-size:10px;background:#1e293b;color:#64748b;border:1px solid #334155;border-radius:4px;cursor:pointer;width:auto">Ativar cert.</button></form><% } %>
          </div>
        </div>
        <% }) %>
      </div>
    </section>
    <% }) %>
    <% } %>
  </main>
<%- include("../../partials/csrf-inject") %>
  <script nonce="<%= cspNonce %>">
    (function () {
      var type = document.getElementById('activity_type');
      var descriptionWrap = document.getElementById('activity-description-wrap');
      var description = document.getElementById('description');
      if (!type || !descriptionWrap || !description) return;
      function syncDescription() {
        var enabled = type.value === 'lecture' || type.value === 'course';
        descriptionWrap.hidden = !enabled;
        description.disabled = !enabled;
      }
      type.addEventListener('change', syncDescription);
      syncDescription();
    })();
  </script>
  <script src="/lib/flatpickr/flatpickr.min.js" nonce="<%= cspNonce %>"></script>
  <script src="/lib/flatpickr/l10n/pt.js" nonce="<%= cspNonce %>"></script>
  <script src="/lib/flatpickr/init.js" nonce="<%= cspNonce %>"></script>
  <script nonce="<%= cspNonce %>">
    (function () {
      function isoOf(field) {
        if (!field) return '';
        var fp = field.flatpickrInstance || (field._flatpickr);
        if (fp && fp.selectedDates && fp.selectedDates[0]) {
          var d = fp.selectedDates[0];
          return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
        }
        var val = (field.value || '').trim();
        var br = val.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
        if (br) return br[3] + '-' + br[2].padStart(2, '0') + '-' + br[1].padStart(2, '0');
        return /^\d{4}-\d{2}-\d{2}$/.test(val) ? val : '';
      }
      function setup(form) {
        var select = form.querySelector('select[name="room_id"]');
        if (!select || !form.dataset.availabilityUrl) return;
        var url = form.dataset.availabilityUrl;
        var excludeActivity = form.dataset.excludeActivity || '';
        var excludeSession = form.dataset.excludeSession || '';
        var dateField = form.querySelector('[name="' + (form.dataset.dateField || 'date_start') + '"]');
        var ts = form.querySelector('[name="time_start"]');
        var te = form.querySelector('[name="time_end"]');
        var templates = Array.prototype.slice.call(select.options).filter(function (o) { return o.value !== ''; });
        function rebuild(availableIds) {
          var keep = select.value;
          select.innerHTML = '';
          var blank = document.createElement('option');
          blank.value = ''; blank.textContent = '— Sem sala —';
          select.appendChild(blank);
          templates.forEach(function (o) {
            if (availableIds && !availableIds[o.value]) return;
            var opt = document.createElement('option');
            opt.value = o.value; opt.textContent = o.textContent;
            select.appendChild(opt);
          });
          if (keep && (!availableIds || availableIds[keep])) select.value = keep;
        }
        function refresh() {
          var date = isoOf(dateField), t1 = ts ? (ts.value || '') : '', t2 = te ? (te.value || '') : '';
          if (!date || !t1 || !t2) { rebuild(null); return; }
          var qs = '?date=' + encodeURIComponent(date) + '&timeStart=' + encodeURIComponent(t1) + '&timeEnd=' + encodeURIComponent(t2);
          if (excludeActivity) qs += '&activityId=' + encodeURIComponent(excludeActivity);
          if (excludeSession) qs += '&sessionId=' + encodeURIComponent(excludeSession);
          fetch(url + qs, { credentials: 'same-origin' })
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (list) {
              if (!Array.isArray(list)) { rebuild(null); return; }
              var ids = {}; list.forEach(function (room) { if (room.available) ids[String(room.id)] = true; });
              rebuild(ids);
            })
            .catch(function () { rebuild(null); });
        }
        [dateField, ts, te].forEach(function (el) { if (el) el.addEventListener('change', refresh); });
        refresh();
      }
      Array.prototype.forEach.call(document.querySelectorAll('form.availability-form'), setup);
    })();
  </script>
  </body>
</html>
