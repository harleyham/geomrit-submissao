<!doctype html><html><body><h1>Atividades — <%= event.name %></h1><p><a href="/admin/events">Eventos</a></p><form method="post"><input name="name" placeholder="Nome" required><select name="activity_type"><option value="lecture">Palestra</option><option value="seminar">Seminário</option><option value="roundtable">Mesa redonda</option><option value="course">Minicurso</option><option value="other">Outra</option></select><input type="date" name="activity_date"><input type="number" step=".5" name="workload_hours" placeholder="Carga horária"><label><input type="checkbox" name="certificate_enabled" checked> Certificado</label><button>Adicionar</button></form><ul><% activities.forEach(a=>{ %><li><strong><%= a.name %></strong> — <%= a.activity_type %> · <%= a.workload_hours %>h <a href="/admin/events/<%= event.id %>/activities/<%= a.id %>/attendance">Presença</a></li><% }) %></ul></body></html>
