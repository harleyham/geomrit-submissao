<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"><style>*{box-sizing:border-box;margin:0;padding:0}body{font-family:'Inter',sans-serif;background:#0a0f1a;color:#e2e8f0;min-height:100vh}.topbar{background:rgba(15,23,42,0.8);border-bottom:1px solid rgba(148,163,184,0.1);backdrop-filter:blur(20px);padding:0 2rem;height:64px;display:flex;align-items:center;position:sticky;top:0;z-index:100}.topbar-inner{width:100%;max-width:1440px;margin:0 auto;display:flex;align-items:center;justify-content:space-between}.logo{font-size:1.25rem;font-weight:700;color:#e2e8f0;text-decoration:none}.logo-icon{color:#60a5fa}.topbar-nav{display:flex;gap:0.25rem;align-items:center}.topbar-nav a{color:#94a3b8;padding:0.5rem 0.75rem;border-radius:6px;text-decoration:none;font-size:0.875rem;font-weight:500}.topbar-nav a:hover,.topbar-nav a.active{color:#e2e8f0;background:rgba(148,163,184,0.1)}.main{max-width:1440px;margin:0 auto;padding:2rem}.page-header{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;margin-bottom:1.5rem}.page-header h1{font-size:1.75rem;font-weight:700;color:#f8fafc}.page-header p{color:#94a3b8;margin-top:0.4rem}.header-actions{display:flex;gap:0.75rem;flex-wrap:wrap}.btn{display:inline-flex;align-items:center;gap:0.35rem;padding:0.55rem 0.9rem;border-radius:8px;font-size:0.8125rem;font-weight:600;text-decoration:none;border:1px solid transparent;cursor:pointer}.btn-primary{background:#2563eb;color:white}.btn-ghost{background:transparent;color:#94a3b8;border-color:rgba(148,163,184,0.18)}.btn-ghost:hover{background:rgba(148,163,184,0.1);color:#e2e8f0}.btn-sm{padding:0.35rem 0.7rem;font-size:0.75rem}.btn-danger{color:#fca5a5;border-color:rgba(248,113,113,0.35);background:transparent}.card{background:rgba(30,41,59,0.6);border:1px solid rgba(148,163,184,0.1);border-radius:12px;padding:1.25rem;margin:1rem 0}input,select,button{padding:.55rem;margin:.25rem;font:inherit}label{display:block;color:#94a3b8;font-size:.78rem;margin-bottom:.4rem}input,select{border:1px solid rgba(148,163,184,0.18);border-radius:8px;background:rgba(2,6,23,0.42);color:#f8fafc;padding:.65rem .75rem;font-size:.86rem}table{width:100%;border-collapse:collapse}th{padding:.8rem 1.2rem;text-align:left;color:#64a48b;font-size:.72rem;text-transform:uppercase;letter-spacing:.05em;background:rgba(15,23,42,0.25)}td{padding:.85rem 1.2rem;border-top:1px solid rgba(148,163,184,0.07);vertical-align:middle;font-size:.86rem}tr:hover td{background:rgba(148,163,184,0.03)}strong{color:#f8fafc}small{color:#94a3b8}.badge{display:inline-flex;border-radius:999px;font-size:.72rem;font-weight:700;padding:.25rem .6rem}.badge-lecture{background:rgba(96,165,250,0.14);color:#60a5fa}.badge-seminar{background:rgba(167,139,250,0.14);color:#a78bfa}.badge-roundtable{background:rgba(56,189,248,0.14);color:#38bdf8}.badge-course{background:rgba(34,197,94,0.14);color:#86efac}.badge-other{background:rgba(148,163,184,0.14);color:#cbd5e1}.workload{color:#fbbf24}.activity-link{color:#93c5fd;text-decoration:none;font-weight:600}.activity-link:hover{text-decoration:underline}.empty-state{padding:2rem 1.25rem;color:#94a3b8}.form-row{display:flex;gap:.75rem;align-items:end;flex-wrap:wrap}.form-group{display:flex;flex-direction:column;gap:.35rem}.footer{text-align:center;padding:2rem;color:#475569;font-size:.75rem}@media(max-width:900px){.page-header{flex-direction:column}.form-row{flex-direction:column;align-items:stretch}}</style></head><body><header class="topbar"><div class="topbar-inner"><a href="/" class="logo"><span class="logo-icon">◆</span> Artigos LIGEM</a><nav class="topbar-nav"><a href="/admin">Dashboard</a><a href="/admin/events" class="active">Eventos</a><a href="/admin/events/<%= event.id %>/participants">Participantes</a></nav></div></header><main class="main"><p style="margin-bottom:1rem"><a href="/admin/events">← Voltar aos eventos</a></p><div class="page-header"><div><h1>Atividades — <%= event.name %></h1><p>Registre palestras, minicursos, seminários e demais atividades do evento.</p></div><div class="header-actions"><a href="/admin/events/<%= event.id %>/certificates" class="btn btn-ghost">Certificados</a><a href="/admin/events/<%= event.id %>/attendance" class="btn btn-ghost">Presença</a></div></div>
<section class="card"><h2>Adicionar atividade</h2><form method="post"><div class="form-row"><div class="form-group"><label for="name">Nome</label><input id="name" name="name" placeholder="Ex: Minicurso de Machine Learning" required></div><div class="form-group" style="max-width:200px"><label for="activity_type">Tipo</label><select id="activity_type" name="activity_type"><option value="lecture">Palestra</option><option value="seminar">Seminário</option><option value="roundtable">Mesa redonda</option><option value="course">Minicurso</option><option value="other">Outra</option></select></div><div class="form-group" style="max-width:180px"><label for="activity_date">Data</label><input id="activity_date" type="date" name="activity_date"></div><div class="form-group" style="max-width:160px"><label for="workload_hours">Carga horária (h)</label><input id="workload_hours" type="number" step=".5" min="0" name="workload_hours" placeholder="0"></div><div class="form-group" style="max-width:180px"><label>&nbsp;</label><button type="submit" class="btn btn-primary">Adicionar atividade</button></div></div></form></section>
<section class="card" style="margin-top:1.5rem"><h2>Atividades cadastradas (<%= activities.length %>)</h2><% if (activities.length === 0) { %><div class="empty-state">Nenhuma atividade cadastrada. Adicione atividades para acompanhar presença e gerar certificados por atividade.</div><% } else { %><table><thead><tr><th>Nome</th><th>Tipo</th><th>Data</th><th>Carga horária</th><th>Presenças</th><th>Atividades com regra de cert.</th><th>Ações</th></tr></thead><tbody><% activities.forEach(a=>{ %><tr><td><strong><%= a.name %></strong></td><td><span class="badge badge-<%= a.activity_type %>"><%= a.activity_type === 'lecture' ? 'Palestra' : a.activity_type === 'seminar' ? 'Seminário' : a.activity_type === 'roundtable' ? 'Mesa redonda' : a.activity_type === 'course' ? 'Minicurso' : 'Outra' %></span></td><td><%= a.activity_date || '—' %></td><td><span class="workload"><%= a.workload_hours %>h</span></td><td><strong><%= a.attendees_count %></strong><br><small>participante(s)</small></td><td><% if (a.certificate_enabled) { %><span class="badge present">Certificado ativo</span><% } else { %><span class="badge absent">Sem certificado</span><% } %></td><td><a class="activity-link" href="/admin/events/<%= event.id %>/activities/<%= a.id %>/attendance">Gerenciar presença</a></td></tr><% }) %></tbody></table><% } %></section></main><footer class="footer">&copy; <%= year %> LIGEM.Redes • <%= typeof appVersion !== 'undefined' ? appVersion : 'V0.1' %></footer></body></html>
