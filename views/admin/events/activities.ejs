<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><title><%=title%></title><style>body{font-family:Arial;background:#0a0f1a;color:#e2e8f0;margin:0}.top{background:#0f172a;padding:14px 6%;display:flex;justify-content:space-between;align-items:center}.top a{color:#93c5fd;margin-right:14px}.session{border:1px solid #475569;border-radius:999px;padding:7px 10px;color:#cbd5e1;font-size:13px}.logout{background:transparent!important;color:#f87171;border-color:#7f1d1d}main{padding:30px 6%}.card{background:#1e293b;padding:20px;border-radius:10px;margin:15px 0}input,select,button{padding:8px;margin:4px;background:#0f172a;color:#fff;border:1px solid #475569}button{background:#2563eb}label{display:inline-block;margin:6px}a{color:#93c5fd}table{width:100%;border-collapse:collapse}td,th{padding:10px;border-bottom:1px solid #334155;text-align:left}</style></head><body><header class="top"><nav><a href="/admin/dashboard">Dashboard</a><a href="/admin/events">Eventos</a><a href="/admin/events/<%=event.id%>/participants">Participantes</a><a href="/admin/events/<%=event.id%>/attendance">Presença</a></nav><div><%if(userEmail){%><span class="session"><%=userEmail%></span><form method="post" action="/admin/logout" style="display:inline"><button class="logout">Sair</button></form><%}%></div></header><main><h1>Partes do evento — <%=event.name%></h1><section class="card"><h2>Cadastrar parte/atividade</h2><form method="post"><input name="name" required placeholder="Nome da atividade"><select name="activity_type"><option value="lecture">Palestra</option><option value="seminar">Seminário</option><option value="roundtable">Mesa</option><option value="course">Minicurso</option><option value="other">Outra</option></select><input name="activity_date" type="date"><input name="workload_hours" type="number" step=".5" min="0" placeholder="Carga horária"><h3>Perfis elegíveis</h3><% const roles=[['participant','Participante'],['reviewer','Revisor'],['speaker','Palestrante'],['teacher','Professor'],['oral_presenter','Apresentador Oral'],['poster_presenter','Apresentador Pôster']]; roles.forEach(r=>{%><label><input type="checkbox" name="eligible_roles" value="<%=r[0]%>" checked> <%=r[1]%></label><%})%><p>Certificado que esta atividade habilita: <select name="certificate_role"><%roles.forEach(r=>{%><option value="<%=r[0]%>"><%=r[1]%></option><%})%></select><button>Cadastrar atividade</button></p></form></section><section class="card"><h2>Atividades cadastradas</h2><table><tr><th>Atividade</th><th>Perfis</th><th>Certificado</th><th>Presença</th></tr><%activities.forEach(a=>{%><tr><td><strong><%=a.name%></strong><br><small><%=a.activity_date||'Data a definir'%> · <%=a.workload_hours%>h</small></td><td><%=a.eligible_roles%></td><td><%=a.certificate_role%></td><td><a href="/admin/events/<%=event.id%>/activities/<%=a.id%>/attendance">Marcar presença</a></td></tr><%})%></table></section></main></body></html>
