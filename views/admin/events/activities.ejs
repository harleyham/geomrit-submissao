<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %></title>
  <style>
    body{font-family:'Inter',sans-serif;background:#0a0f1a;color:#e2e8f0;margin:0}.topbar{background:rgba(15,23,42,0.8);border-bottom:1px solid rgba(148,163,184,0.1);backdrop-filter:blur(20px);padding:0 2rem;height:64px;display:flex;align-items:center;position:sticky;top:0;z-index:100}.topbar-inner{width:100%;max-width:1400px;margin:0 auto;display:flex;align-items:center;justify-content:space-between}.logo{font-size:1.25rem;font-weight:700;color:#e2e8f0;text-decoration:none}.logo-icon{color:#60a5fa}.topbar-nav{display:flex;gap:0.4rem;align-items:center;flex-wrap:wrap}.topbar-nav a{color:#94a3b8;padding:0.5rem 0.75rem;border-radius:6px;text-decoration:none;font-size:0.875rem;font-weight:500;transition:all 0.15s}.topbar-nav a:hover{color:#e2e8f0;background:rgba(148,163,184,0.1)}.session-pill{padding:0.42rem 0.78rem;border:1px solid rgba(148,163,184,0.18);border-radius:999px;color:#e2e8f0;font-size:0.82rem}.btn-logout{background:transparent;color:#f87171;border:1px solid rgba(248,113,113,0.25);font-family:inherit;cursor:pointer}    .btn{display:inline-flex;align-items:center;justify-content:center;padding:0.625rem 1.25rem;border-radius:8px;font-size:0.875rem;font-weight:500;cursor:pointer;border:none;text-decoration:none}.btn-secondary{background:rgba(148,163,184,0.12);color:#e2e8f0;border:1px solid rgba(148,163,184,0.18);text-decoration:none;font-weight:500}.btn-secondary:hover{background:rgba(148,163,184,0.2)}.badge{display:inline-block;padding:3px 10px;border-radius:999px;font-size:11px;font-weight:600;letter-spacing:0.3px;text-transform:uppercase}.badge-lecture{background:#312e81;color:#a5b4fc}.badge-seminar{background:#164e63;color:#67e8f9}.badge-roundtable{background:#365314;color:#84cc16}.badge-course{background:#78350f;color:#fdba74}.badge-oral_presentation{background:#7f1d1d;color:#fca5a5}.badge-poster_presentation{background:#581c87;color:#d8b4fe}.badge-other{background:#1e293b;color:#94a3b8}.activity-card{background:#1e293b;border-radius:10px;padding:16px;margin:16px 0}.activity-card h3{margin:0 0 12px;font-size:1rem;font-weight:600;color:#e2e8f0}.activity-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:10px}.activity-item{background:#0f172a;padding:12px 14px;border-radius:8px;border:1px solid #334155;display:flex;flex-direction:column;gap:6px}.activity-item strong{font-size:13px;color:#f1f5f9}.activity-item small{color:#94a3b8;font-size:11px}.activity-item .item-actions{display:flex;gap:6px;margin-top:4px;flex-wrap:wrap}.activity-item .item-actions a{flex:1;text-align:center;text-decoration:none;background:#334155;color:#e2e8f0;border:1px solid #475569;border-radius:6px;padding:5px 10px;font-size:12px;cursor:pointer;font-weight:500;display:block}main{padding:30px 6%;max-width:1300px;margin:auto}.card{background:#1e293b;padding:20px;border-radius:10px;margin:15px 0}input,select,button{padding:8px;margin:4px;background:#0f172a;color:#fff;border:1px solid #475569;border-radius:6px}button{background:#2563eb;cursor:pointer}label{display:inline-block;margin:6px}a{color:#93c5fd}table{width:100%;border-collapse:collapse}td,th{padding:10px;border-bottom:1px solid #334155;text-align:left;vertical-align:top}.hint{color:#94a3b8;font-size:13px}.alert{padding:10px;border-radius:6px}.success{background:#14532d}.error{background:#7f1d1d}.badge{display:inline-block;padding:3px 7px;margin:2px;border-radius:999px;background:#334155;font-size:12px}.disabled{color:#94a3b8}
  </style>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="logo"><span class="logo-icon">◆</span> Artigos LIGEM</a>
      <nav class="topbar-nav">
        <a href="/admin">Dashboard</a>
        <a href="/admin/events">Eventos</a>
        <a href="/admin/users">Usuários</a>
        <% if (userEmail) { %><span class="session-pill"><%= userEmail %></span><% } %>
        <form method="POST" action="/admin/logout" style="display:inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-logout">Sair</button>
        </form>
      </nav>
    </div>
  </header>
  <main class="main-content">
    <h1>Atividades — <%= event.name %></h1>
    <p class="hint">Os papéis elegíveis definem quem pode atuar na atividade. Inscrições de participantes são vinculadas ao criar ou <a href="/admin/events/<%= event.id %>/participants">editar participantes</a>; depois, a chamada registra a presença efetiva e o papel exercido.</p>
    <% if (success) { %><p class="alert success"><%= success %></p><% } %>
    <% if (error) { %><p class="alert error"><%= error %></p><% } %>
    <% const activityForm = editingActivity || {}; const selectedRoles = String(activityForm.eligible_roles || 'participant,reviewer,speaker,teacher,oral_presenter,poster_presenter').split(','); %>
    <section class="card">
      <h2><%= editingActivity ? 'Editar atividade' : 'Cadastrar atividade' %></h2>
      <form method="post" action="<%= editingActivity ? `/admin/events/${event.id}/activities/${editingActivity.id}` : `/admin/events/${event.id}/activities` %>">
        <input name="name" required placeholder="Nome da atividade" value="<%= activityForm.name || '' %>">
        <select name="activity_type">
          <% [['lecture','Palestra'],['seminar','Seminário'],['roundtable','Mesa-redonda'],['course','Minicurso'],['oral_presentation','Apresentação oral'],['poster_presentation','Apresentação pôster'],['other','Outra']].forEach((type) => { %><option value="<%= type[0] %>" <%= activityForm.activity_type === type[0] ? 'selected' : '' %>><%= type[1] %></option><% }) %>
        </select>
        <input name="date_start" type="date" title="Data de início" value="<%= activityForm.date_start || '' %>">
        <input name="date_end" type="date" title="Data de fim" value="<%= activityForm.date_end || '' %>">
        <input name="workload_hours" type="number" step=".5" min="0" placeholder="Carga horária (total, se sem etapas)" value="<%= activityForm.workload_hours ?? '' %>">
        <h3>Papéis elegíveis na chamada</h3>
        <% const roles=[['participant','Participante'],['reviewer','Revisor'],['speaker','Palestrante'],['teacher','Professor'],['oral_presenter','Apresentador Oral'],['poster_presenter','Apresentador Pôster']]; roles.forEach((role) => { %>
          <label><input type="checkbox" name="eligible_roles" value="<%= role[0] %>" <%= selectedRoles.includes(role[0]) ? 'checked' : '' %>> <%= role[1] %></label>
        <% }) %>
        <p><label><input type="checkbox" name="certificate_enabled" value="1" <%= !editingActivity || activityForm.certificate_enabled ? 'checked' : '' %>> Contabilizar esta atividade para certificados e carga horária</label></p>
        <button type="submit"><%= editingActivity ? 'Salvar atividade' : 'Cadastrar atividade' %></button>
        <% if (editingActivity) { %><a href="/admin/events/<%= event.id %>/activities">Cancelar edição</a><% } %>
      </form>
    </section>
    <%
      const activityTypeMap = { lecture:'Palestra', seminar:'Seminário', roundtable:'Mesa-redonda', course:'Minicurso', oral_presentation:'Apresentação oral', poster_presentation:'Apresentação pôster', other:'Outra' };
      const typeClasses = { lecture:'badge-lecture', seminar:'badge-seminar', roundtable:'badge-roundtable', course:'badge-course', oral_presentation:'badge-oral_presentation', poster_presentation:'badge-poster_presentation', other:'badge-other' };
      const activityRolesMap = { participant:'Participante', reviewer:'Revisor', speaker:'Palestrante', teacher:'Professor', oral_presenter:'Apresentador Oral', poster_presenter:'Apresentador Pôster' };
      const activitiesByType = {};
      const sortedActivities = [...(activities||[])].sort((a,b) => String(a.name||'').localeCompare(String(b.name||''), 'pt-BR'));
      sortedActivities.forEach((a) => { const t = a.activity_type || 'other'; if (!activitiesByType[t]) activitiesByType[t] = []; activitiesByType[t].push(a); });
      const typeOrder = ['lecture','seminar','roundtable','course','oral_presentation','poster_presentation','other'];
    %>
    <% if (!activities.length) { %>
    <section class="card"><h2>Atividades cadastradas</h2><p class="hint">Nenhuma atividade cadastrada.</p></section>
    <% } else { %>
    <% typeOrder.forEach((type) => { if (!activitiesByType[type]) return; const items = activitiesByType[type]; %>
    <section class="activity-card">
      <h3><span class="badge <%= typeClasses[type] %>"><%= activityTypeMap[type] %></span> <span style="color:#94a3b8;font-weight:400;margin-left:8px">(<%= items.length %> atividade<%= items.length > 1 ? 's' : '' %>)</span></h3>
      <div class="activity-list">
        <% items.forEach((activity) => { %>
        <% const hasSessions = Number(activity.session_count || 0) > 0;
           const displayWorkload = hasSessions ? Number(activity.sessions_workload || 0) : Number(activity.workload_hours || 0); %>
        <div class="activity-item">
          <strong><%= activity.name %></strong>
          <small><%= activityDateRange(activity) %><% if (displayWorkload > 0) { %> · <%= displayWorkload %>h<% if (hasSessions) { %> (etapas)<% } %></small><% } else { %></small><% } %>
          <small>
            <% String(activity.eligible_roles || '').split(',').filter(Boolean).forEach((role) => { %><span class="badge" style="background:#334155;color:#94a3b8;font-size:10px"><%= activityRolesMap[role] || role %></span> <% }) %>
          </small>
          <div class="item-actions">
            <a href="/admin/events/<%= event.id %>/activities?edit_activity_id=<%= activity.id %>">Editar</a>
            <a href="/admin/events/<%= event.id %>/activities/<%= activity.id %>/sessions">Etapas<% if (hasSessions) { %> (<%= activity.session_count %>)<% } %></a>
            <a href="/admin/events/<%= event.id %>/activities/<%= activity.id %>/attendance">Marcar Presença</a>
            <% if (hasSessions) { %>
              <% (activity.sessions || []).forEach((session) => { %>
                <a href="/admin/events/<%= event.id %>/activities/<%= activity.id %>/attendance-print?session_id=<%= session.id %>" class="btn-secondary" style="margin-left:4px;font-size:11px;padding:2px 8px;text-decoration:none;border:1px solid #334155;border-radius:4px">Imp. Lista · <%= session.name %></a>
                <a href="/admin/events/<%= event.id %>/activities/<%= activity.id %>/checkin-print?session_id=<%= session.id %>" class="btn-secondary" style="margin-left:4px;font-size:11px;padding:2px 8px;text-decoration:none;border:1px solid #0f766e;border-radius:4px">QR Presença · <%= session.name %></a>
              <% }) %>
            <% } else { %>
              <a href="/admin/events/<%= event.id %>/activities/<%= activity.id %>/attendance-print" class="btn-secondary" style="margin-left:4px;font-size:11px;padding:2px 8px;text-decoration:none;border:1px solid #334155;border-radius:4px">Imp. Lista Presença</a>
              <a href="/admin/events/<%= event.id %>/activities/<%= activity.id %>/checkin-print" class="btn-secondary" style="margin-left:4px;font-size:11px;padding:2px 8px;text-decoration:none;border:1px solid #0f766e;border-radius:4px">QR Presença</a>
            <% } %>
          </div>
          <div style="display:flex;gap:10px;align-items:center;margin-top:2px">
            <span style="font-size:11px;color:#64748b">Inscritos: <%= activity.enrolled_count || 0 %></span>
            <span style="font-size:11px;color:#64748b">Presentes: <%= activity.attendees_count || 0 %></span>
            <% if (activity.certificate_enabled) { %><span class="badge" style="background:#14532d;color:#86efac;font-size:10px">Certificável</span><% } else { %><form method="post" action="/admin/events/<%= event.id %>/activities/<%= activity.id %>/certificate-enabled"><input type="hidden" name="enabled" value="1"><button type="submit" style="display:inline;padding:2px 8px;font-size:10px;background:#1e293b;color:#64748b;border:1px solid #334155;border-radius:4px;cursor:pointer;width:auto">Ativar cert.</button></form><% } %>
          </div>
        </div>
        <% }) %>
      </div>
    </section>
    <% }) %>
    <% } %>
  </main>
<%- include("../../partials/csrf-inject") %>
  </body>
</html>
