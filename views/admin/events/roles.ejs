<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; }
    .topbar { background: var(--surface); border-bottom: 1px solid var(--border); backdrop-filter: blur(20px); padding: 0 2rem; height: 64px; display: flex; align-items: center; position: sticky; top: 0; z-index: 100; }
    .topbar-inner { width: 100%; max-width: 1400px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
    .logo { font-size: 1.25rem; font-weight: 700; color: var(--text); text-decoration: none; }
    .logo-icon { color: var(--accent); }
    .topbar-nav { display: flex; gap: 0.25rem; align-items: center; }
    .topbar-nav a { color: var(--text-muted); padding: 0.5rem 0.75rem; border-radius: 6px; text-decoration: none; font-size: 0.875rem; font-weight: 500; }
    .topbar-nav a:hover, .topbar-nav a.active { color: var(--text); background: var(--border); }
    .main-content { max-width: 1400px; margin: 0 auto; padding: 2rem; }
    .section { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 2rem; margin-bottom: 1.5rem; }
    .section-title { font-size: 1.125rem; font-weight: 600; color: var(--text-strong); margin-bottom: 1rem; }
    .hint { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.5rem; line-height: 1.6; }
    .form-group { margin-bottom: 1rem; }
    .form-group label { display: block; color: var(--text-muted); font-size: 0.875rem; font-weight: 500; margin-bottom: 0.375rem; }
    .form-group select { width: 100%; padding: 0.75rem 1rem; border: 1px solid rgba(148,163,184,0.2); border-radius: 8px; background: rgba(15,23,42,0.5); color: var(--text); font-size: 0.9375rem; font-family: 'Inter', sans-serif; }
    .form-group select:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px rgba(59,130,246,0.15); }
    .btn { display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.625rem 1.25rem; border-radius: 8px; font-size: 0.875rem; font-weight: 500; cursor: pointer; border: none; text-decoration: none; }
    .btn-primary { background: var(--primary); color: white; }
    .btn-primary:hover { background: var(--primary-hover); }
    .btn-ghost { background: transparent; color: var(--text-muted); border: 1px solid rgba(148,163,184,0.2); }
    .btn-ghost:hover { background: var(--border); color: var(--text); }
    .btn-danger { background: rgba(239,68,68,0.15); color: var(--danger); border: 1px solid rgba(239,68,68,0.2); }
    .btn-danger:hover { background: rgba(239,68,68,0.25); }
    .btn-secondary { background: rgba(148,163,184,0.12); color: var(--text); border: 1px solid rgba(148,163,184,0.18); text-decoration: none; }
    .btn-secondary:hover { background: rgba(148,163,184,0.2); }
    .session-pill { padding: 0.42rem 0.78rem; border: 1px solid rgba(148,163,184,0.18); border-radius: 999px; color: var(--text); font-size: 0.82rem; }
    .btn-logout { background: transparent; color: var(--danger); border: 1px solid rgba(248,113,113,0.25); font-family: inherit; cursor: pointer; }
    table { width: 100%; border-collapse: collapse; }
    th { text-align: left; padding: 0.75rem 1rem; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-faint); background: rgba(15,23,42,0.3); }
    td { padding: 0.75rem 1rem; font-size: 0.8125rem; color: var(--text); border-top: 1px solid rgba(148,163,184,0.05); }
    .badge { display: inline-block; padding: 0.2rem 0.5rem; border-radius: 9999px; font-size: 0.65rem; font-weight: 600; }
    .badge-admin { background: rgba(167,139,250,0.15); color: #a78bfa; }
    .badge-staff { background: rgba(244,114,182,0.15); color: #f472b6; }
    .badge-reviewer { background: rgba(52,211,153,0.15); color: var(--success); }
    .badge-participant { background: rgba(59,130,246,0.15); color: var(--accent); }
    .badge-speaker { background: rgba(251,191,36,0.15); color: var(--warn); }
    .badge-teacher { background: rgba(167,139,250,0.15); color: #a78bfa; }
    .badge-oral { background: rgba(167,139,250,0.15); color: #a78bfa; }
    .badge-poster { background: rgba(56,189,248,0.15); color: #38bdf8; }
    .alert { padding: 0.875rem 1rem; border-radius: 8px; margin-bottom: 1.5rem; font-size: 0.875rem; }
    .alert-success { background: rgba(52,211,153,0.1); color: var(--success); border: 1px solid rgba(52,211,153,0.2); }
    .alert-error { background: rgba(248,113,113,0.1); color: var(--danger); border: 1px solid rgba(248,113,113,0.2); }
    footer { text-align: center; padding: 2rem; color: var(--text-faint); font-size: 0.75rem; }
  </style>
  <%- include('../../partials/theme') %>
  <%- include('../../partials/mobile-fixes') %>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="logo"><span class="logo-icon">◆</span> Gerência de Eventos</a>
      <nav class="topbar-nav">
        <% if (isAdmin) { %><a href="/admin">Dashboard</a><% } %>
        <a href="/admin/events">Eventos</a>
        <% if (isAdmin) { %><a href="/admin/users">Usuários</a><% } %>
        <% if (userEmail) { %><span class="session-pill"><%= userEmail %></span><% } %>
        <form method="POST" action="/admin/logout" style="display:inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-logout">Sair</button>
        </form>
      </nav>
    </div>
  </header>

  <main class="main-content">
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <section class="section">
      <h2 class="section-title">Atribuir papel</h2>
      <p class="hint">Administrador controla somente este evento. Somente pessoas inscritas neste evento (ou que já tenham papel nele) podem receber papéis; o participante comum não precisa de papel — a inscrição basta.</p>
      <form method="GET" action="/admin/events/<%= event.id %>/roles" class="role-filters" style="display:flex;gap:1rem;flex-wrap:wrap;align-items:flex-end;border:1px solid var(--border);border-radius:8px;padding:1rem 1.25rem;margin-bottom:1.25rem;background:rgba(15,23,42,0.3);">
        <div style="flex:1 1 260px;">
          <label for="q" style="display:block;color:var(--text-muted);font-size:0.8125rem;font-weight:500;margin-bottom:0.375rem;">Buscar pessoa</label>
          <input id="q" type="text" name="q" value="<%= filters.query %>" placeholder="Nome, e-mail, instituição ou CPF" style="width:100%;padding:0.6rem 0.85rem;border:1px solid rgba(148,163,184,0.2);border-radius:8px;background:rgba(15,23,42,0.5);color:var(--text);font-size:0.875rem;font-family:'Inter',sans-serif;">
        </div>
        <div style="flex:0 1 180px;">
          <label for="titulation" style="display:block;color:var(--text-muted);font-size:0.8125rem;font-weight:500;margin-bottom:0.375rem;">Titulação</label>
          <select id="titulation" name="titulation" style="width:100%;padding:0.6rem 0.85rem;border:1px solid rgba(148,163,184,0.2);border-radius:8px;background:rgba(15,23,42,0.5);color:var(--text);font-size:0.875rem;font-family:'Inter',sans-serif;">
            <option value="all" <%= filters.titulation === 'all' ? 'selected' : '' %>>Todas</option>
            <option value="Graduado" <%= filters.titulation === 'Graduado' ? 'selected' : '' %>>Graduado</option>
            <option value="Mestre" <%= filters.titulation === 'Mestre' ? 'selected' : '' %>>Mestre</option>
            <option value="Doutor" <%= filters.titulation === 'Doutor' ? 'selected' : '' %>>Doutor</option>
            <option value="Não especificado" <%= filters.titulation.toLowerCase() === 'não especificado' ? 'selected' : '' %>>Não especificado</option>
          </select>
        </div>
        <div style="display:flex;gap:0.5rem;">
          <button type="submit" class="btn btn-primary">Aplicar Filtros</button>
          <a href="/admin/events/<%= event.id %>/roles" class="btn btn-ghost">Limpar</a>
        </div>
      </form>
      <form method="POST" action="/admin/events/<%= event.id %>/roles">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label for="user_id">Pessoa <span style="color:var(--text-faint);font-size:0.75rem;font-weight:400">(<%= users.length %> pessoa<%= users.length === 1 ? '' : 's' %> na lista<%= (filters.query || filters.titulation !== 'all') ? ' — com filtros ativos' : '' %>)</span></label>
          <select name="user_id" id="user_id" required>
            <option value="">Selecione</option>
            <% users.forEach(u => { %><option value="<%= u.id %>"><%= u.name %> — <%= u.email %></option><% }) %>
          </select>
        </div>
        <div class="form-group">
          <label for="role">Papel</label>
          <select name="role" id="role" required>
            <option value="admin">Administrador do evento</option>
            <option value="staff">Staff (operação do evento: presença, participantes e certificados)</option>
            <option value="reviewer">Revisor (avalia artigos do evento)</option>
            <option value="speaker">Palestrante</option>
            <option value="teacher">Professor</option>
            <option value="oral_presenter">Apresentador Oral</option>
            <option value="poster_presenter">Apresentador Pôster</option>
          </select>
        </div>
        <div class="form-group">
          <label for="article_id">Artigo aprovado (opcional)</label>
          <select name="article_id" id="article_id">
            <option value="">Nenhum</option>
            <% articles.forEach(a => { %><option value="<%= a.id %>"><%= a.title %> — <%= a.type %></option><% }) %>
          </select>
        </div>
        <div class="form-actions" style="margin-top:1.5rem">
          <button type="submit" class="btn btn-primary">Atribuir</button>
        </div>
      </form>
    </section>

    <section class="section">
      <h2 class="section-title">Papéis atribuídos</h2>
      <div class="table-scroll"><table>
        <thead><tr><th>Pessoa</th><th>Papel</th><th>Artigo</th><th></th></tr></thead>
        <tbody>
          <% assignments.forEach(a => { %><tr>
            <td><%= a.user_name %><br><small style="color:var(--text-faint)"><%= a.user_email %></small></td>
            <td><span class="badge badge-<%= a.role === 'admin' ? 'admin' : a.role === 'staff' ? 'staff' : a.role === 'reviewer' ? 'reviewer' : a.role === 'speaker' ? 'speaker' : a.role === 'teacher' ? 'teacher' : a.role === 'oral_presenter' ? 'oral' : 'poster' %>"><%= (roleMeta[a.role] && roleMeta[a.role].label) || a.role %></span></td>
            <td><%= a.article_title || '—' %></td>
            <td>
              <form method="POST" action="/admin/events/<%= event.id %>/roles/<%= a.role %>/<%= a.user_id %>/delete">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-danger btn-sm">Remover</button>
              </form>
            </td>
          </tr><% }) %>
        </tbody>
      </table></div>
    </section>
  </main>

  <footer>&copy; <%= year %> LIGEM.Redes • <%= typeof appVersion !== 'undefined' ? appVersion : 'V0.1' %></footer>
</body>
</html>
