<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><title><%= title %></title><style>body{font-family:Arial;background:#0a0f1a;color:#e2e8f0;margin:0}.top,.main{padding:20px 5%}.top{background:#0f172a}.top a{color:#93c5fd;margin-right:16px}.card{background:#1e293b;border-radius:9px;padding:20px;margin:18px 0}select,button{padding:9px;margin:4px;background:#0f172a;color:#fff;border:1px solid #475569}button{background:#2563eb}table{width:100%;border-collapse:collapse}td,th{padding:10px;border-bottom:1px solid #334155;text-align:left}.hint{color:#94a3b8}.danger{background:#991b1b}</style></head><body><header class="top"><a href="/admin/events">Eventos</a><a href="/admin/events/<%= event.id %>/certificates">Certificados</a></header><main class="main"><h1>Papéis no evento — <%= event.name %></h1><p class="hint">Administrador controla somente este evento. Participante e Revisor são atribuídos pela inscrição e pelos artigos.</p><% if(success){ %><p><%= success %></p><% } %><% if(error){ %><p><%= error %></p><% } %><section class="card"><h2>Atribuir papel</h2><form method="post"><select name="user_id" required><option value="">Pessoa</option><% users.forEach(u=>{ %><option value="<%=u.id%>"><%=u.name%> — <%=u.email%></option><% }) %></select><select name="role" id="role"><option value="admin">Administrador do evento</option><option value="speaker">Palestrante</option><option value="teacher">Professor</option><option value="oral_presenter">Apresentador Oral</option><option value="poster_presenter">Apresentador Pôster</option></select><span id="article"><select name="article_id"><option value="">Artigo aprovado</option><% articles.forEach(a=>{ %><option value="<%=a.id%>"><%=a.title%> — <%=a.type%></option><% }) %></select></span><button>Atribuir</button></form></section><section class="card"><h2>Papéis atribuídos</h2><table><tr><th>Pessoa</th><th>Papel</th><th>Artigo</th><th></th></tr><% assignments.forEach(a=>{ %><tr><td><%=a.user_name%><br><small><%=a.user_email%></small></td><td><%=roleMeta[a.role].label%></td><td><%=a.article_title||'—'%></td><td><form method="post" action="/admin/events/<%=event.id%>/roles/<%=a.role%>/<%=a.user_id%>/delete"><button class="danger">Remover</button></form></td></tr><% }) %></table></section></main><script>const r=document.getElementById('role'),a=document.getElementById('article');function s(){a.style.display=['oral_presenter','poster_presenter'].includes(r.value)?'inline':'none'}r.onchange=s;s()</script></body></html>
