<!DOCTYPE html>
<html lang="pt-BR"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %></title>
<style>body{margin:0;background:#0a0f1a;color:#e2e8f0;font:16px Arial,sans-serif}.page{max-width:760px;margin:0 auto;padding:2rem}.card{background:#172033;border:1px solid #334155;border-radius:14px;padding:1.5rem}h1{margin-top:0}.muted{color:#94a3b8}.activity{display:flex;gap:.7rem;padding:.85rem;margin:.6rem 0;border:1px solid #334155;border-radius:10px;cursor:pointer}.activity input{width:18px;height:18px}.activity small{display:block;color:#94a3b8;margin-top:.25rem}.field{margin:1rem 0}.field textarea{width:100%;min-height:100px;box-sizing:border-box;background:#0f172a;color:#e2e8f0;border:1px solid #475569;border-radius:8px;padding:.7rem}.actions{display:flex;gap:.7rem;flex-wrap:wrap;margin-top:1.3rem}.btn{border:0;border-radius:8px;padding:.75rem 1rem;font-weight:bold;cursor:pointer}.approve{background:#059669;color:#fff}.reject{background:#b91c1c;color:#fff}.back{color:#93c5fd;text-decoration:none}.error{padding:.8rem;background:#451a1a;color:#fecaca;border-radius:8px}</style>  <%- include('../../partials/mobile-fixes') %>
</head>
<body><main class="page"><p><a class="back" href="/admin/events/<%= event.id %>/participants">← Participantes</a></p><section class="card"><h1>Analisar inscrição</h1><p><strong><%= registration.name %></strong><br><span class="muted"><%= registration.email %><% if (registration.institution) { %> · <%= registration.institution %><% } %></span></p>
<p class="muted">Marque as atividades que serão aprovadas. É possível aceitar apenas parte da solicitação.</p><% if (error) { %><p class="error"><%= error %></p><% } %>
<form method="POST" action="/admin/events/<%= event.id %>/participants/<%= registration.id %>/review"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<% if (!activities.length) { %><p class="muted">A pessoa não solicitou atividades. Você ainda pode aprovar ou rejeitar a inscrição.</p><% } %>
<% const requiredReviewIds = (typeof requiredIds !== 'undefined' && requiredIds) ? requiredIds : new Set(); activities.forEach((activity) => { const isRequiredReview = requiredReviewIds.has(Number(activity.id)); %><label class="activity"><input type="checkbox" name="activity_ids" value="<%= activity.id %>" <%= isRequiredReview ? 'checked disabled' : '' %>><span><strong><%= activity.name %><% if (isRequiredReview) { %><span class="badge" style="background:#1d4ed8;color:#bfdbfe;margin-left:6px;font-size:10px;vertical-align:middle">Obrigatória</span><% } %></strong><small><%= activity.date_start || 'Data a definir' %> · <%= activity.effective_workload_hours || activity.workload_hours || 0 %>h<% if (isRequiredReview) { %> · aprovada automaticamente<% } %></small></span></label><% }) %>
<div class="field"><label for="registration_review_notes">Observações para a pessoa (opcional)</label><textarea id="registration_review_notes" name="registration_review_notes" maxlength="2000"></textarea></div>
<div class="actions"><button class="btn approve" type="submit" name="decision" value="approved">Aprovar inscrição</button><button class="btn reject" type="submit" name="decision" value="rejected" nonce="<%= cspNonce %>" onclick="return confirm('Rejeitar esta solicitação de inscrição?')">Rejeitar solicitação</button></div></form></section></main></body></html>
