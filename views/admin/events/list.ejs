<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Artigos LIGEM</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: #0a0f1a; color: #e2e8f0; min-height: 100vh; }
    .topbar { background: rgba(15,23,42,0.8); border-bottom: 1px solid rgba(148,163,184,0.1); backdrop-filter: blur(20px); padding: 0 2rem; height: 64px; display: flex; align-items: center; position: sticky; top: 0; z-index: 100; }
    .topbar-inner { width: 100%; max-width: 1400px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
    .logo { font-size: 1.25rem; font-weight: 700; color: #e2e8f0; text-decoration: none; }
    .logo-icon { color: #60a5fa; }
    .topbar-nav { display: flex; gap: 0.25rem; align-items: center; }
    .topbar-nav a { color: #94a3b8; padding: 0.5rem 0.75rem; border-radius: 6px; text-decoration: none; font-size: 0.875rem; font-weight: 500; transition: all 0.15s; }
    .topbar-nav a:hover, .topbar-nav a.active { color: #e2e8f0; background: rgba(148,163,184,0.1); }
    .btn-logout { color: #f87171 !important; }
    .main-content { max-width: 1400px; margin: 0 auto; padding: 2rem; }
    .page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem; }
    .page-header h1 { font-size: 1.75rem; font-weight: 700; color: #f1f5f9; }
    .section { background: rgba(30,41,59,0.6); border: 1px solid rgba(148,163,184,0.1); border-radius: 12px; overflow-x: auto; }
    .section-body { padding: 0; }
    table { width: 100%; border-collapse: collapse; }
    th { text-align: left; padding: 0.75rem 1.5rem; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; background: rgba(15,23,42,0.3); }
    td { padding: 0.75rem 1.5rem; font-size: 0.875rem; color: #cbd5e1; border-top: 1px solid rgba(148,163,184,0.05); }
    tr:hover td { background: rgba(148,163,184,0.03); }
    .badge { display: inline-block; padding: 0.2rem 0.6rem; border-radius: 9999px; font-size: 0.7rem; font-weight: 600; }
    .badge-published { background: rgba(52,211,153,0.15); color: #34d399; }
    .badge-draft { background: rgba(100,116,139,0.2); color: #94a3b8; }
    .badge-oral { background: rgba(167,139,250,0.15); color: #a78bfa; }
    .actions { display: flex; gap: 0.375rem; flex-wrap: wrap; min-width: 250px; }
    .btn { display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.4rem 0.75rem; border-radius: 8px; font-size: 0.8125rem; font-weight: 500; cursor: pointer; border: none; transition: all 0.15s; text-decoration: none; }
    .btn-primary { background: #3b82f6; color: white; }
    .btn-primary:hover { background: #2563eb; }
    .btn-ghost { background: transparent; color: #94a3b8; border: 1px solid rgba(148,163,184,0.2); }
    .btn-ghost:hover { background: rgba(148,163,184,0.1); color: #e2e8f0; }
    .btn-danger { background: rgba(239,68,68,0.15); color: #f87171; border: 1px solid rgba(239,68,68,0.2); }
    .btn-danger:hover { background: rgba(239,68,68,0.25); }
    .btn-sm { padding: 0.25rem 0.5rem; font-size: 0.75rem; }
    .session-pill { padding: 0.42rem 0.78rem; border: 1px solid rgba(148,163,184,0.18); border-radius: 999px; color: #e2e8f0; font-size: 0.82rem; }
    .btn-logout { background: transparent; color: #f87171; border: 1px solid rgba(248,113,113,0.25); font-family: inherit; cursor: pointer; }
    .btn-secondary { background: rgba(148,163,184,0.12); color: #e2e8f0; border: 1px solid rgba(148,163,184,0.18); text-decoration: none; }
    .btn-secondary:hover { background: rgba(148,163,184,0.2); }
    footer { text-align: center; padding: 2rem; color: #475569; font-size: 0.75rem; }
    a { color: #60a5fa; text-decoration: none; }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="logo"><span class="logo-icon">◆</span> Artigos LIGEM</a>
      <nav class="topbar-nav">
        <a href="/admin">Dashboard</a>
        <a href="/admin/events" class="active">Eventos</a>
        <a href="/admin/users">Usuários</a>
        <% if (userEmail) { %><span class="session-pill"><%= userEmail %></span><% } %>
        <form method="POST" action="/admin/logout" style="display:inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-logout">Sair</button>
        </form>
      </nav>
    </div>
  </header>

  <main class="main-content">
    <div class="page-header">
      <h1>Eventos</h1>
      <a href="/admin/events/new" class="btn btn-primary">+ Novo Evento</a>
    </div>

    <div class="section">
      <div class="section-body">
        <table>
          <thead>
            <tr><th>Nome</th><th>Áreas</th><th>Data do Evento</th><th>Submissão</th><th>Inscritos</th><th>Subsídios</th><th>Status</th><th>Ações</th></tr>
          </thead>
          <tbody>
            <% events.forEach(e => { %>
            <tr>
              <td><strong><%= e.name %></strong><br><small style="color:#64748b"><%= e.short_name || '' %></small></td>
              <td><span class="badge badge-oral"><%= e.area_display %></span></td>
              <td><%= new Date(e.date_start).toLocaleDateString('pt-BR') %><% if (e.date_end) { %> – <%= new Date(e.date_end).toLocaleDateString('pt-BR') %><% } %></td>
              <td>
                <% if (e.has_article_submission && (e.submission_start || e.submission_end)) { %>
                  <%= e.submission_start ? new Date(e.submission_start).toLocaleDateString('pt-BR') : 'Sem início' %>
                  –
                  <%= e.submission_end ? new Date(e.submission_end).toLocaleDateString('pt-BR') : 'Sem fim' %>
                <% } else { %>
                  <span style="color:#64748b;">Sem submissão de artigos</span>
                <% } %>
              </td>
              <td>
                <strong><%= e.registered_count %></strong><br>
                <small style="color:#64748b">Autores: <%= e.author_registered_count %> · Participantes: <%= e.listener_registered_count %></small>
              </td>
              <td>
                <% if (e.offers_subsidy) { %>
                  <strong><%= e.subsidy_request_count %></strong><br>
                  <small style="color:#64748b">pedidos</small>
                <% } else { %>
                  <span style="color:#64748b;">Não oferece</span>
                <% } %>
              </td>
              <td><span class="badge badge-<%= e.status %>"><%= e.status === 'published' ? 'Publicado' : 'Rascunho' %></span></td>
              <td class="actions">
                <a href="/admin/events/<%= e.id %>/edit" class="btn btn-ghost btn-sm">Editar</a>
                <a href="/admin/events/<%= e.id %>/participants" class="btn btn-ghost btn-sm">Participantes</a>
                <a href="/admin/events/<%= e.id %>/activities" class="btn btn-ghost btn-sm">Atividades</a>
                <a href="/admin/events/<%= e.id %>/certificates" class="btn btn-ghost btn-sm">Certificados</a>
                <% if (e.offers_subsidy) { %>
                  <a href="/admin/events/<%= e.id %>/subsidies" class="btn btn-ghost btn-sm">Subsídios</a>
                <% } %>
                <a href="/admin/reports?eventId=<%= e.id %>" class="btn btn-ghost btn-sm">Relatórios</a>
                <a href="/admin/articles?eventId=<%= e.id %>" class="btn btn-ghost btn-sm">Artigos</a>
                <% if (e.status !== 'published') { %>
                  <form method="POST" action="/admin/events/<%= e.id %>/publish" style="display:inline" onsubmit="return confirm('Publicar o evento <%= e.name %>?')">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-primary btn-sm">Publicar</button>
                  </form>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <footer>&copy; <%= year %> LIGEM.Redes • <%= typeof appVersion !== 'undefined' ? appVersion : 'V0.1' %></footer>
<%- include("../../partials/csrf-inject") %>
  </body>
</html>
