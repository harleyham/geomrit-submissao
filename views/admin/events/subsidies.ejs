<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Gerência de Eventos</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; }
    .topbar { background: var(--surface); border-bottom: 1px solid var(--border); backdrop-filter: blur(20px); padding: 0 2rem; height: 64px; display: flex; align-items: center; position: sticky; top: 0; z-index: 100; }
    .topbar-inner { width: 100%; max-width: 1400px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
    .logo { font-size: 1.25rem; font-weight: 700; color: var(--text); text-decoration: none; }
    .logo-icon { color: var(--accent); }
    .topbar-nav { display: flex; gap: 0.25rem; align-items: center; }
    .topbar-nav a { color: var(--text-muted); padding: 0.5rem 0.75rem; border-radius: 6px; text-decoration: none; font-size: 0.875rem; font-weight: 500; }
    .topbar-nav a:hover, .topbar-nav a.active { color: var(--text); background: var(--border); }
    .main-content { max-width: 1440px; margin: 0 auto; padding: 2rem; }
    .page-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; }
    .page-header h1 { font-size: 1.75rem; font-weight: 700; color: var(--text-strong); }
    .page-header p { color: var(--text-muted); margin-top: 0.45rem; }
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
    .stat-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 1.25rem; }
    .stat-value { font-size: 1.85rem; font-weight: 700; color: var(--text-strong); }
    .stat-label { color: var(--text-faint); text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.74rem; margin-top: 0.25rem; }
    .section { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem; }
    .empty { color: var(--text-faint); font-style: italic; }
    .request-list { display: grid; gap: 1rem; }
    .request-card { border: 1px solid rgba(148,163,184,0.12); border-radius: 14px; background: rgba(15,23,42,0.35); padding: 1.25rem; }
    .request-header { display: flex; justify-content: space-between; gap: 1rem; align-items: flex-start; margin-bottom: 1rem; }
    .request-header h2 { font-size: 1.05rem; color: var(--text-strong); }
    .request-meta { color: var(--text-muted); font-size: 0.875rem; line-height: 1.7; }
    .badge { display: inline-block; padding: 0.25rem 0.65rem; border-radius: 999px; font-size: 0.72rem; font-weight: 700; }
    .badge-pending { background: rgba(251,191,36,0.14); color: var(--warn); }
    .badge-approved { background: rgba(34,197,94,0.15); color: #4ade80; }
    .badge-rejected { background: rgba(248,113,113,0.15); color: var(--danger); }
    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem; }
    .panel { padding: 1rem; border-radius: 12px; background: rgba(2,6,23,0.3); border: 1px solid var(--border); }
    .panel h3 { font-size: 0.95rem; color: var(--text-strong); margin-bottom: 0.8rem; }
    .panel p { color: var(--text); line-height: 1.6; font-size: 0.9rem; }
    .document-links { display: flex; flex-wrap: wrap; gap: 0.6rem; }
    .btn { display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.55rem 0.95rem; border-radius: 8px; font-size: 0.8125rem; font-weight: 600; text-decoration: none; border: none; cursor: pointer; }
    .btn-ghost { background: transparent; color: var(--text-muted); border: 1px solid rgba(148,163,184,0.2); }
    .btn-ghost:hover { background: var(--border); color: var(--text); }
    .btn-success { background: rgba(34,197,94,0.16); color: #86efac; border: 1px solid rgba(74,222,128,0.24); }
    .btn-danger { background: rgba(239,68,68,0.15); color: #fca5a5; border: 1px solid rgba(248,113,113,0.24); }
    .session-pill { padding: 0.42rem 0.78rem; border: 1px solid rgba(148,163,184,0.18); border-radius: 999px; color: var(--text); font-size: 0.82rem; }
    .btn-logout { background: transparent; color: var(--danger); border: 1px solid rgba(248,113,113,0.25); font-family: inherit; cursor: pointer; }
    .btn-secondary { background: rgba(148,163,184,0.12); color: var(--text); border: 1px solid rgba(148,163,184,0.18); text-decoration: none; }
    .btn-secondary:hover { background: rgba(148,163,184,0.2); }
    .analysis-form textarea { width: 100%; min-height: 110px; padding: 0.85rem 0.95rem; border-radius: 10px; border: 1px solid rgba(148,163,184,0.16); background: rgba(2,6,23,0.4); color: var(--text-strong); font-family: 'Inter', sans-serif; resize: vertical; }
    .analysis-form textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px rgba(59,130,246,0.16); }
    .analysis-actions { display: flex; gap: 0.75rem; margin-top: 0.9rem; flex-wrap: wrap; }
    .review-info { margin-top: 0.8rem; color: var(--text-muted); font-size: 0.82rem; }
    footer { text-align: center; padding: 2rem; color: var(--text-faint); font-size: 0.75rem; }
    @media (max-width: 960px) { .grid { grid-template-columns: 1fr; } .request-header { flex-direction: column; } }
  </style>
  <%- include('../../partials/theme') %>
  <%- include('../../partials/mobile-fixes') %>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="logo"><span class="logo-icon">◆</span> Gerência de Eventos</a>
      <nav class="topbar-nav">
        <% if (isAdmin) { %><a href="/admin">Dashboard</a><% } %>
        <a href="/admin/events" class="active">Eventos</a>
        <% if (isAdmin) { %><a href="/admin/users">Usuários</a><% } %>
        <% if (isEventStaff) { %><span class="session-pill" style="border-color:rgba(244,114,182,0.4);color:#f472b6">Staff</span><% } %>
        <% if (userEmail) { %><span class="session-pill"><%= userEmail %></span><% } %>
        <form method="POST" action="/admin/logout" style="display:inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-logout">Sair</button>
        </form>
      </nav>
    </div>
  </header>

  <main class="main-content">
    <div class="page-header">
      <div>
        <h1>Pedidos de Subsídio</h1>
        <p><strong>Evento:</strong> <%= event.name %></p>
      </div>
      <div style="display:flex;gap:0.75rem;flex-wrap:wrap;"></div>
    </div>

    <div class="stats-grid">
      <div class="stat-card"><div class="stat-value"><%= summary.total %></div><div class="stat-label">Total de Pedidos</div></div>
      <div class="stat-card"><div class="stat-value"><%= summary.pending %></div><div class="stat-label">Pendentes</div></div>
      <div class="stat-card"><div class="stat-value"><%= summary.approved %></div><div class="stat-label">Aprovados</div></div>
      <div class="stat-card"><div class="stat-value"><%= summary.rejected %></div><div class="stat-label">Reprovados</div></div>
    </div>

    <div class="section">
      <% if (subsidyRequests.length === 0) { %>
        <p class="empty">Ainda não há pedidos de subsídio registrados para este evento.</p>
      <% } else { %>
        <div class="request-list">
          <% subsidyRequests.forEach(function(request) { %>
            <article class="request-card">
              <div class="request-header">
                <div>
                  <h2><%= request.name %></h2>
                  <div class="request-meta">
                    <div><strong>E-mail:</strong> <%= request.email %></div>
                    <div><strong>Instituição:</strong> <%= request.institution || '-' %></div>
                    <div><strong>Inscrição:</strong> <%= request.registration_type === 'author' ? 'Apresentador/Autor' : 'Participante' %></div>
                    <div><strong>Pedido enviado em:</strong> <%= new Date(request.created_at).toLocaleString('pt-BR') %></div>
                  </div>
                </div>
                <span class="badge badge-<%= request.subsidy_status === 'approved' ? 'approved' : request.subsidy_status === 'rejected' ? 'rejected' : 'pending' %>">
                  <%= request.subsidy_status === 'approved' ? 'Aprovado' : request.subsidy_status === 'rejected' ? 'Reprovado' : 'Pendente' %>
                </span>
              </div>

              <div class="grid">
                <section class="panel">
                  <h3>Dados Acadêmicos</h3>
                  <p><strong>Nível:</strong> <%= request.student_level || '-' %></p>
                  <p><strong>Curso:</strong> <%= request.student_course || '-' %></p>
                  <p><strong>Instituição de vínculo:</strong> <%= request.student_institution_name || '-' %></p>
                  <p><strong>UF:</strong> <%= request.student_institution_state || '-' %></p>
                  <p><strong>ID Lattes:</strong> <%= request.student_lattes_id || '-' %></p>
                </section>

                <section class="panel">
                  <h3>Documentos</h3>
                  <div class="document-links">
                    <% if (request.academic_history_pdf_path) { %>
                      <a href="/admin/events/<%= event.id %>/subsidies/<%= request.id %>/document/academic-history" class="btn btn-ghost" target="_blank" rel="noopener noreferrer">Histórico Escolar</a>
                    <% } %>
                    <% if (request.motivation_letter_pdf_path) { %>
                      <a href="/admin/events/<%= event.id %>/subsidies/<%= request.id %>/document/motivation-letter" class="btn btn-ghost" target="_blank" rel="noopener noreferrer">Carta de Motivação</a>
                    <% } %>
                    <% if (request.recommendation_letter_pdf_path) { %>
                      <a href="/admin/events/<%= event.id %>/subsidies/<%= request.id %>/document/recommendation-letter" class="btn btn-ghost" target="_blank" rel="noopener noreferrer">Carta de Recomendação</a>
                    <% } %>
                  </div>
                </section>
              </div>

              <form method="POST" action="/admin/events/<%= event.id %>/subsidies/<%= request.id %>/decision" class="analysis-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <textarea name="subsidy_review_notes" placeholder="Registre observações da análise, critérios usados, pendências ou justificativa da decisão."><%= request.subsidy_review_notes || '' %></textarea>
                <div class="analysis-actions">
                  <button type="submit" name="subsidy_status" value="approved" class="btn btn-success">Aprovar Pedido</button>
                  <button type="submit" name="subsidy_status" value="rejected" class="btn btn-danger">Reprovar Pedido</button>
                </div>
              </form>

              <% if (request.subsidy_reviewed_at) { %>
                <div class="review-info">
                  Última análise em <%= new Date(request.subsidy_reviewed_at).toLocaleString('pt-BR') %><% if (request.reviewed_by_name) { %> por <strong><%= request.reviewed_by_name %></strong><% } %>.
                </div>
              <% } %>
            </article>
          <% }) %>
        </div>
      <% } %>
    </div>
  </main>

  <footer>&copy; <%= year %> LIGEM.Redes • <%= typeof appVersion !== 'undefined' ? appVersion : 'V0.1' %></footer>
<%- include("../../partials/csrf-inject") %>
  </body>
</html>
