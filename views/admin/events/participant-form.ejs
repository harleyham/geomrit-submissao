<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Artigos LIGEM</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: #0a0f1a; color: #e2e8f0; min-height: 100vh; }
    .topbar { background: rgba(15,23,42,0.8); border-bottom: 1px solid rgba(148,163,184,0.1); backdrop-filter: blur(20px); padding: 0 2rem; height: 64px; display: flex; align-items: center; position: sticky; top: 0; z-index: 100; }
    .topbar-inner { width: 100%; max-width: 1080px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
    .logo { font-size: 1.25rem; font-weight: 700; color: #e2e8f0; text-decoration: none; }
    .logo-icon { color: #60a5fa; }
    .topbar-nav { display: flex; gap: 0.25rem; align-items: center; }
    .topbar-nav a { color: #94a3b8; padding: 0.5rem 0.75rem; border-radius: 6px; text-decoration: none; font-size: 0.875rem; font-weight: 500; }
    .topbar-nav a:hover, .topbar-nav a.active { color: #e2e8f0; background: rgba(148,163,184,0.1); }
    .main-content { max-width: 820px; margin: 0 auto; padding: 2rem; }
    .page-header { margin-bottom: 1.5rem; }
    .page-header h1 { font-size: 1.75rem; font-weight: 700; color: #f8fafc; }
    .page-header p { color: #94a3b8; margin-top: 0.45rem; line-height: 1.6; }
    .card { background: rgba(30,41,59,0.6); border: 1px solid rgba(148,163,184,0.1); border-radius: 14px; padding: 1.5rem; }
    .alert { margin-bottom: 1rem; padding: 0.9rem 1rem; border-radius: 10px; font-size: 0.9rem; }
    .alert-error { background: rgba(239,68,68,0.1); border: 1px solid rgba(248,113,113,0.24); color: #fca5a5; }
    .meta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem; }
    .meta-box { padding: 1rem; border-radius: 12px; background: rgba(2,6,23,0.28); border: 1px solid rgba(148,163,184,0.1); }
    .meta-box strong { display: block; color: #f8fafc; margin-bottom: 0.35rem; }
    .meta-box span { color: #94a3b8; line-height: 1.6; font-size: 0.9rem; }
    .form-group { margin-bottom: 1rem; }
    .form-group label { display: block; color: #cbd5e1; font-size: 0.9rem; font-weight: 600; margin-bottom: 0.45rem; }
    .form-group input, .form-group select { width: 100%; padding: 0.78rem 0.95rem; border: 1px solid rgba(148,163,184,0.2); border-radius: 10px; background: rgba(2,6,23,0.35); color: #f8fafc; font-size: 0.95rem; font-family: 'Inter', sans-serif; }
    .form-group input:focus, .form-group select:focus { outline: none; border-color: #60a5fa; box-shadow: 0 0 0 3px rgba(59,130,246,0.16); }
    .help-text { color: #94a3b8; font-size: 0.78rem; line-height: 1.5; margin-top: 0.4rem; }
    .actions { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-top: 1.5rem; flex-wrap: wrap; }
    .btn { display: inline-flex; align-items: center; justify-content: center; padding: 0.75rem 1.05rem; border-radius: 10px; text-decoration: none; font-weight: 600; border: 1px solid transparent; cursor: pointer; }
    .btn-primary { background: linear-gradient(135deg, #2563eb, #0ea5e9); color: white; }
    .btn-secondary { background: transparent; color: #cbd5e1; border-color: rgba(148,163,184,0.2); }
    .event-role-option { display:flex !important; align-items:center; gap:.6rem; margin:.6rem 0 !important; cursor:pointer; }
    .event-role-option input[type="checkbox"] { width:auto !important; min-width:16px; height:16px; margin:0; accent-color:#f97316; }
    .activity-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:.75rem; margin-top:.65rem; }
    .activity-option { display:flex !important; align-items:flex-start; gap:.7rem; padding:.85rem; margin:0 !important; border:1px solid rgba(148,163,184,.16); border-radius:10px; background:rgba(2,6,23,.28); cursor:pointer; }
    .activity-option:has(input:checked) { border-color:#3b82f6; background:rgba(37,99,235,.12); }
    .activity-option input { width:auto !important; min-width:17px; height:17px; margin-top:.1rem; accent-color:#3b82f6; }
    .activity-option strong { display:block; color:#f8fafc; font-size:.88rem; }
    .activity-option small { display:block; color:#94a3b8; margin-top:.25rem; line-height:1.35; }
    footer { text-align: center; padding: 2rem; color: #64748b; font-size: 0.75rem; }
    @media (max-width: 720px) { .meta-grid { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="logo"><span class="logo-icon">◆</span> Artigos LIGEM</a>
      <nav class="topbar-nav">
        <a href="/admin">Dashboard</a>
        <a href="/admin/events" class="active">Eventos</a>
        <a href="/admin/users">Usuários</a>
        <% if (userEmail) { %><span class="session-pill"><%= userEmail %></span><% } %>
        <form method="POST" action="/admin/logout" style="display:inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-logout">Sair</button>
        </form>
      </nav>
    </div>
  </header>

  <main class="main-content">
    <div class="page-header">
      <h1><%= registration ? 'Editar Participante' : 'Adicionar Participante' %></h1>
      <p>Evento: <strong><%= event.name %></strong>. Cadastre a pessoa e selecione as atividades em que ela está inscrita. Essa seleção poderá ser alterada posteriormente.</p>
    </div>

    <div class="card">
      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <% if (registration) { %>
      <div class="meta-grid">
        <div class="meta-box">
          <strong>Situação atual</strong>
          <span>
            <%= registration.approved_articles > 0 ? 'Apresentador com artigo aprovado' : registration.registration_type === 'author' ? 'Participante com artigo submetido' : 'Participante inscrito' %><br>
            <%= registration.submitted_articles %> artigo(s) submetido(s)
          </span>
        </div>
        <div class="meta-box">
          <strong>Conta vinculada</strong>
          <span>
            <% if (registration.user_id) { %>
              <%= registration.linked_user_name || registration.name %><br>
              <%= registration.linked_user_email || registration.email %>
            <% } else { %>
              Registro sem vínculo direto com conta de usuário.
            <% } %>
          </span>
        </div>
      </div>
      <% } else { %>
        <p class="help-text" style="margin-bottom:1.5rem;">Toda inscrição administrativa possui uma conta vinculada. Crie uma conta com senha temporária ou selecione uma conta existente.</p>
      <% } %>

      <form method="POST" action="<%= registration ? `/admin/events/${event.id}/participants/${registration.id}` : `/admin/events/${event.id}/participants` %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <% if (!registration) { %>
          <div class="form-group">
            <label for="account_mode">Como adicionar o participante</label>
            <select id="account_mode" name="account_mode">
              <option value="new" <%= formData.account_mode !== 'existing' ? 'selected' : '' %>>Criar conta e inscrever no evento</option>
              <option value="existing" <%= formData.account_mode === 'existing' ? 'selected' : '' %>>Inscrever conta já cadastrada</option>
            </select>
          </div>

          <div class="form-group" id="existing-user-group">
            <label for="existing_user_id">Conta já cadastrada</label>
            <select id="existing_user_id" name="existing_user_id">
              <option value="">Selecione uma conta</option>
              <% availableUsers.forEach((user) => { %>
                <option
                  value="<%= user.id %>"
                  data-name="<%= user.name %>"
                  data-email="<%= user.email %>"
                  data-institution="<%= user.institution || '' %>"
                  <%= String(formData.existing_user_id || '') === String(user.id) ? 'selected' : '' %>
                ><%= user.name %> — <%= user.email %><%= user.is_public ? '' : ' (conta inativa)' %></option>
              <% }) %>
            </select>
            <div class="help-text">Os dados da conta selecionada serão usados para criar a inscrição no evento.</div>
          </div>
        <% } %>

        <div class="form-group">
          <label for="name">Nome do participante</label>
          <input type="text" id="name" name="name" required value="<%= formData.name %>">
        </div>

        <div class="form-group">
          <label for="email">E-mail de contato</label>
          <input type="email" id="email" name="email" required value="<%= formData.email %>">
          <div class="help-text">Se houver conta vinculada, este campo altera o registro da participação no evento, não o e-mail da conta global do usuário.</div>
        </div>

        <div class="form-group">
          <label for="institution">Instituição</label>
          <input type="text" id="institution" name="institution" value="<%= formData.institution %>">
        </div>

        <div class="form-group">
          <label for="phone">Telefone (opcional)</label>
          <input type="tel" id="phone" name="phone" value="<%= formData.phone || '' %>" placeholder="+55 11 912345678">
          <div class="help-text">Formato internacional: +XX XXX XXXXXXXXX</div>
        </div>

        <% if (registration && registration.user_id) { %>
        <div style="border-top:1px solid rgba(148,163,184,0.1);padding-top:1rem;margin-top:1rem;">
          <p style="color:#94a3b8;font-size:0.85rem;margin-bottom:0.75rem;font-weight:600;">Formação acadêmica (da conta vinculada)</p>

          <div class="form-group">
            <label for="formacao_area">Área de Formação</label>
            <select id="formacao_area" name="formacao_area">
              <option value="">Selecione uma área</option>
              <% (areas || formacaoAreas || []).forEach((area) => { %>
                <option value="<%= area.codigo %>" <%= formData.formacao_area === area.codigo ? 'selected' : '' %>><%= area.area %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label for="formacao_curso">Curso</label>
            <select id="formacao_curso" name="formacao_curso">
              <% const selArea = formData.formacao_area || ''; %>
              <% const selCurso = formData.formacao_curso || ''; %>
              <option value="<%= selArea ? 'Selecione um curso' : 'Selecione primeiro uma área' %>"><%= selArea ? 'Selecione um curso' : 'Selecione primeiro uma área' %></option>
              <% ((cursosMap && cursosMap[selArea]) || []).forEach((curso) => { %>
                <option value="<%= curso %>" <%= selCurso === curso ? 'selected' : '' %>><%= curso %></option>
              <% }) %>
            </select>
          </div>
          <div id="formacao-titulacao-status" style="display:<%= formData.formacao_curso === noDegreeCourse ? 'none' : 'grid' %>;grid-template-columns:1fr 1fr;gap:1rem;">
            <div class="form-group">
              <label for="formacao_titulacao">Titulação</label>
              <select id="formacao_titulacao" name="formacao_titulacao">
                <option value="">Selecione</option>
                <option value="Graduado" <%= formData.formacao_titulacao === 'Graduado' ? 'selected' : '' %>>Graduado</option>
                <option value="Mestre" <%= formData.formacao_titulacao === 'Mestre' ? 'selected' : '' %>>Mestre</option>
                <option value="Doutor" <%= formData.formacao_titulacao === 'Doutor' ? 'selected' : '' %>>Doutor</option>
              </select>
            </div>
            <div class="form-group">
              <label for="formacao_status">Status</label>
              <select id="formacao_status" name="formacao_status">
                <option value="">Selecione</option>
                <option value="Formado" <%= formData.formacao_status === 'Formado' ? 'selected' : '' %>>Formado</option>
                <option value="Cursando" <%= formData.formacao_status === 'Cursando' ? 'selected' : '' %>>Cursando</option>
              </select>
            </div>
          </div>
        </div>
        <% } %>

        <% if (!registration) { %>
          <div id="temporary-password-fields">
            <div class="form-group">
              <label for="temporary_password">Senha temporária</label>
              <input type="password" id="temporary_password" name="temporary_password" minlength="6" autocomplete="new-password">
              <div class="help-text">O participante deverá trocar esta senha no primeiro acesso.</div>
            </div>
            <div class="form-group">
              <label for="confirm_temporary_password">Confirmar senha temporária</label>
              <input type="password" id="confirm_temporary_password" name="confirm_temporary_password" minlength="6" autocomplete="new-password">
            </div>
          </div>
        <% } %>

        <div class="form-group">
          <label for="registration_type">Tipo de participação</label>
          <select id="registration_type" name="registration_type" <%= registration && registration.submitted_articles > 0 ? 'disabled' : '' %>>
            <option value="listener" <%= formData.registration_type === 'listener' ? 'selected' : '' %>>Participante</option>
            <option value="author" <%= formData.registration_type === 'author' ? 'selected' : '' %>>Participante com artigo</option>
          </select>
          <% if (registration && registration.submitted_articles > 0) { %>
            <input type="hidden" name="registration_type" value="author">
            <div class="help-text">Este participante possui artigo submetido. Por isso, o tipo de participação permanece travado como participante com artigo.</div>
          <% } else { %>
            <div class="help-text">Use esta opção para corrigir registros administrativos quando a participação estiver classificada incorretamente.</div>
          <% } %>
        </div>

        <div class="form-group">
          <label>Atividades da inscrição</label>
          <% if (!activities.length) { %>
            <div class="help-text">Nenhuma atividade foi cadastrada neste evento. Cadastre atividades antes de vincular a programação do participante.</div>
          <% } else { %>
            <div class="activity-grid">
              <% activities.forEach((activity) => { const selected = (formData.activity_ids || []).map(Number).includes(Number(activity.id)); %>
                <label class="activity-option">
                  <input type="checkbox" name="activity_ids" value="<%= activity.id %>" <%= selected ? 'checked' : '' %>>
                  <span><strong><%= activity.name %></strong><small><%= activityDateRange(activity) %> · <%= activity.workload_hours || 0 %>h<%= activity.certificate_enabled ? ' · contabiliza para certificado' : '' %></small></span>
                </label>
              <% }) %>
            </div>
            <div class="help-text">A inscrição habilita a pessoa para a chamada da atividade. A presença efetiva continua sendo registrada separadamente.</div>
          <% } %>
        </div>

        <% if (registration && registration.user_id) { %><p class="help-text">Os papéis da pessoa neste evento são administrados em <a href="/admin/users/<%= registration.user_id %>/edit?event_id=<%= event.id %>">Perfis por evento</a>.</p><% } %>

        <div class="actions">
          <a href="/admin/events/<%= event.id %>/participants" class="btn btn-secondary">Cancelar</a>
          <button type="submit" class="btn btn-primary">Salvar alterações</button>
        </div>
      </form>
    </div>
  </main>

  <% if (!registration) { %>
    <script>
      const accountModeSelect = document.getElementById('account_mode');
      const existingUserSelect = document.getElementById('existing_user_id');
      const existingUserGroup = document.getElementById('existing-user-group');
      const temporaryPasswordFields = document.getElementById('temporary-password-fields');
      const temporaryPassword = document.getElementById('temporary_password');
      const confirmTemporaryPassword = document.getElementById('confirm_temporary_password');
      const syncAccountMode = () => {
        const usesExistingAccount = accountModeSelect.value === 'existing';
        const option = existingUserSelect.options[existingUserSelect.selectedIndex];
        const isExistingUser = usesExistingAccount && !!(option && option.value);
        const nameInput = document.getElementById('name');
        const emailInput = document.getElementById('email');
        const institutionInput = document.getElementById('institution');
        existingUserGroup.style.display = usesExistingAccount ? 'block' : 'none';
        existingUserSelect.disabled = !usesExistingAccount;
        temporaryPasswordFields.style.display = usesExistingAccount ? 'none' : 'block';
        temporaryPassword.required = !usesExistingAccount;
        confirmTemporaryPassword.required = !usesExistingAccount;
        if (isExistingUser) {
          nameInput.value = option.dataset.name || '';
          emailInput.value = option.dataset.email || '';
          institutionInput.value = option.dataset.institution || '';
        }
        nameInput.readOnly = isExistingUser;
        emailInput.readOnly = isExistingUser;
        institutionInput.readOnly = isExistingUser;
      };
      accountModeSelect.addEventListener('change', syncAccountMode);
      existingUserSelect.addEventListener('change', syncAccountMode);
      syncAccountMode();
    </script>
  <% } %>

  <% if (registration && registration.user_id) { %>
    <script>
      (function() {
        var cursosMap = <%- JSON.stringify(cursosMap || {}) %>;
        var noDegreeCourse = <%- JSON.stringify(noDegreeCourse || '') %>;
        var areaSelect = document.getElementById('formacao_area');
        var cursoSelect = document.getElementById('formacao_curso');
        var titulacaoStatusRow = document.getElementById('formacao-titulacao-status');

        function syncTitulacaoVisibility() {
          if (!cursoSelect || !titulacaoStatusRow) return;
          var isNoDegree = cursoSelect.value === noDegreeCourse;
          titulacaoStatusRow.style.display = isNoDegree ? 'none' : 'grid';
          if (isNoDegree) {
            var tit = document.getElementById('formacao_titulacao');
            var st = document.getElementById('formacao_status');
            if (tit) tit.value = '';
            if (st) st.value = '';
          }
        }

        if (areaSelect && cursoSelect) {
          areaSelect.addEventListener('change', function() {
            var selectedArea = this.value;
            var selectedCurso = '';
            for (var i = 0; i < cursoSelect.options.length; i++) {
              if (cursoSelect.options[i].selected) {
                selectedCurso = cursoSelect.options[i].value;
                break;
              }
            }
            cursoSelect.innerHTML = '<option value="">' + (selectedArea ? 'Selecione um curso' : 'Selecione primeiro uma área') + '</option>';
            if (selectedArea && cursosMap[selectedArea]) {
              var cursos = cursosMap[selectedArea];
              for (var j = 0; j < cursos.length; j++) {
                var option = document.createElement('option');
                option.value = cursos[j];
                option.textContent = cursos[j];
                if (cursos[j] === selectedCurso) {
                  option.selected = true;
                }
                cursoSelect.appendChild(option);
              }
            }
            syncTitulacaoVisibility();
          });

          cursoSelect.addEventListener('change', function() {
            syncTitulacaoVisibility();
          });

          syncTitulacaoVisibility();
        }
      })();
    </script>
  <% } %>

  <footer>&copy; <%= year %> LIGEM.Redes • <%= typeof appVersion !== 'undefined' ? appVersion : 'V0.1' %></footer>
</body>
</html>
