<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Artigos LIGEM</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: #0a0f1a; color: #e2e8f0; min-height: 100vh; }
    
    .topbar { background: rgba(15,23,42,0.8); border-bottom: 1px solid rgba(148,163,184,0.1); backdrop-filter: blur(20px); padding: 0 2rem; height: 64px; display: flex; align-items: center; position: sticky; top: 0; z-index: 100; }
    .topbar-inner { width: 100%; max-width: 1400px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
    .logo { font-size: 1.25rem; font-weight: 700; color: #e2e8f0; text-decoration: none; }
    .logo-icon { color: #60a5fa; }
    .topbar-nav { display: flex; gap: 0.25rem; align-items: center; }
    .topbar-nav a { color: #94a3b8; padding: 0.5rem 0.75rem; border-radius: 6px; text-decoration: none; font-size: 0.875rem; font-weight: 500; transition: all 0.15s; }
    .topbar-nav a:hover, .topbar-nav a.active { color: #e2e8f0; background: rgba(148,163,184,0.1); }
    .btn-logout { color: #f87171 !important; }
    .topbar-user { color: #94a3b8; font-size: 0.875rem; }

    .main-content { max-width: 1400px; margin: 0 auto; padding: 2rem; }
    .page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem; }
    .page-header h1 { font-size: 1.75rem; font-weight: 700; color: #f1f5f9; }

    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
    .stat-card { background: rgba(30,41,59,0.6); border: 1px solid rgba(148,163,184,0.1); border-radius: 12px; padding: 1.5rem; }
    .stat-card .stat-label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; margin-bottom: 0.5rem; }
    .stat-card .stat-value { font-size: 2rem; font-weight: 700; color: #f1f5f9; }
    .stat-card.events .stat-value { color: #60a5fa; }
    .stat-card.articles .stat-value { color: #a78bfa; }
    .stat-card.reviewers .stat-value { color: #34d399; }
    .stat-card.published .stat-value { color: #fbbf24; }

    .section { background: rgba(30,41,59,0.6); border: 1px solid rgba(148,163,184,0.1); border-radius: 12px; overflow: hidden; }
    .section-header { padding: 1.25rem 1.5rem; border-bottom: 1px solid rgba(148,163,184,0.1); display: flex; align-items: center; justify-content: space-between; }
    .section-header h2 { font-size: 1.125rem; font-weight: 600; color: #f1f5f9; }
    .section-body { padding: 0; }

    table { width: 100%; border-collapse: collapse; }
    th { text-align: left; padding: 0.75rem 1.5rem; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; background: rgba(15,23,42,0.3); }
    td { padding: 0.75rem 1.5rem; font-size: 0.875rem; color: #cbd5e1; border-top: 1px solid rgba(148,163,184,0.05); }
    tr:hover td { background: rgba(148,163,184,0.03); }

    .badge { display: inline-block; padding: 0.2rem 0.6rem; border-radius: 9999px; font-size: 0.7rem; font-weight: 600; }
    .badge-submitted { background: rgba(96,165,250,0.15); color: #60a5fa; }
    .badge-in-review { background: rgba(251,191,36,0.15); color: #fbbf24; }
    .badge-approved { background: rgba(52,211,153,0.15); color: #34d399; }
    .badge-rejected { background: rgba(248,113,113,0.15); color: #f87171; }
    .badge-oral { background: rgba(167,139,250,0.15); color: #a78bfa; }
    .badge-poster { background: rgba(56,189,248,0.15); color: #38bdf8; }

    .btn { display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.5rem 1rem; border-radius: 8px; font-size: 0.8125rem; font-weight: 500; cursor: pointer; border: none; transition: all 0.15s; }
    .btn-primary { background: #3b82f6; color: white; }
    .btn-primary:hover { background: #2563eb; }
    .btn-sm { padding: 0.3rem 0.7rem; font-size: 0.75rem; }
    .btn-ghost { background: transparent; color: #94a3b8; border: 1px solid rgba(148,163,184,0.2); }
    .btn-ghost:hover { background: rgba(148,163,184,0.1); color: #e2e8f0; }
    .btn-danger { background: rgba(239,68,68,0.15); color: #f87171; border: 1px solid rgba(239,68,68,0.2); }
    .btn-danger:hover { background: rgba(239,68,68,0.25); }

    .empty { padding: 3rem; text-align: center; color: #64748b; }
    .empty p { margin-top: 0.5rem; font-size: 0.875rem; }

    footer { text-align: center; padding: 2rem; color: #475569; font-size: 0.75rem; }
    a { color: #60a5fa; text-decoration: none; }
    a:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="logo"><span class="logo-icon">◆</span> Artigos LIGEM</a>
      <nav class="topbar-nav">
        <a href="/admin" class="active">Dashboard</a>
        <a href="/admin/events">Eventos</a>
        <a href="/admin/reviewers">Revisores</a>
        <a href="/admin/logout" style="padding:0.3rem 0.5rem; color: #f87171; text-decoration: none; font-size: 0.875rem; font-weight: 500;">Sair</a>
      </nav>
    </div>
  </header>

  <main class="main-content">
    <div class="page-header">
      <h1>Dashboard</h1>
    </div>

    <div class="stats-grid">
      <div class="stat-card events">
        <div class="stat-label">Total de Eventos</div>
        <div class="stat-value"><%= totalEvents %></div>
      </div>
      <div class="stat-card published">
        <div class="stat-label">Eventos Publicados</div>
        <div class="stat-value"><%= publishedEvents %></div>
      </div>
      <div class="stat-card articles">
        <div class="stat-label">Total de Artigos</div>
        <div class="stat-value"><%= totalArticles %></div>
      </div>
      <div class="stat-card reviewers">
        <div class="stat-label">Revisores Ativos</div>
        <div class="stat-value"><%= totalReviewers %></div>
      </div>
    </div>

    <div class="section">
      <div class="section-header">
        <h2>Artigos Recentes</h2>
        <a href="/admin/events" class="btn btn-primary btn-sm">+ Novo Evento</a>
      </div>
      <div class="section-body">
        <% if (recentArticles.length > 0) { %>
        <table>
          <thead>
            <tr><th>Título</th><th>Evento</th><th>Tipo</th><th>Status</th><th>Data</th></tr>
          </thead>
          <tbody>
            <% recentArticles.forEach(a => { %>
            <tr>
              <td><a href="/admin/articles/<%= a.id %>?eventId=<%= a.event_id %>"><%= a.title %></a></td>
              <td><%= a.event_name %></td>
              <td><span class="badge badge-<%= a.type %>"><%= a.type === 'oral' ? 'Oral' : 'Poster' %></span></td>
              <td><span class="badge badge-<%= a.status %>"><%= a.status %></span></td>
              <td><%= new Date(a.created_at).toLocaleDateString('pt-BR') %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
        <% } else { %>
        <div class="empty">
          <p>Nenhum artigo submetido ainda.</p>
          <p>Crie um evento para começar.</p>
        </div>
        <% } %>
      </div>
    </div>
  </main>

  <footer>&copy; <%= year %> LIGEM.Redes</footer>
</body>
</html>