      </div>
    </div>
    <% } %>
  </main>

  <footer>&copy; <%= year %> LIGEM.Redes • <%= typeof appVersion !== 'undefined' ? appVersion : 'V0.1' %></footer>
  <script nonce="<%= cspNonce %>">
    (function() {
      var printButton = document.getElementById('print-report-btn');
      var sectionToggles = Array.prototype.slice.call(document.querySelectorAll('[data-report-toggle]'));
      var syncSection = function(toggle) {
        var section = document.querySelector('[data-report-section="' + toggle.dataset.reportToggle + '"]');
        if (section) section.classList.toggle('report-excluded', !toggle.checked);
      };
      sectionToggles.forEach(function(toggle) {
        toggle.addEventListener('change', function() { syncSection(toggle); });
        syncSection(toggle);
      });

      var setSelection = function(checked) {
        sectionToggles.forEach(function(toggle) {
          toggle.checked = checked;
          syncSection(toggle);
        });
      };
      var selectAllButton = document.getElementById('select-all-report-sections');
      var clearButton = document.getElementById('clear-report-sections');
      if (selectAllButton) selectAllButton.addEventListener('click', function() { setSelection(true); });
      if (clearButton) clearButton.addEventListener('click', function() { setSelection(false); });

      var evaluationsToggles = Array.prototype.slice.call(document.querySelectorAll('.btn-evaluations-toggle'));
      evaluationsToggles.forEach(function(button) {
        button.addEventListener('click', function() {
          var target = document.getElementById(button.dataset.evaluationsTarget);
          if (!target) return;
          target.hidden = !target.hidden;
          button.textContent = target.hidden
            ? 'Ver avaliações (' + button.dataset.count + ')'
            : 'Ocultar avaliações';
        });
      });

      if (!printButton) return;
      printButton.addEventListener('click', function() {
        window.print();
      });
    })();
  </script>
</body>
</html>
