<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Gerência de Eventos</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; }
    .topbar { background: var(--surface); border-bottom: 1px solid var(--border); backdrop-filter: blur(20px); padding: 0 2rem; height: 64px; display: flex; align-items: center; position: sticky; top: 0; z-index: 100; }
    .topbar-inner { width: 100%; max-width: 1400px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
    .logo { font-size: 1.25rem; font-weight: 700; color: var(--text); text-decoration: none; }
    .logo-icon { color: var(--accent); }
    .topbar-nav { display: flex; gap: 0.25rem; align-items: center; }
    .topbar-nav a { color: var(--text-muted); padding: 0.5rem 0.75rem; border-radius: 6px; text-decoration: none; font-size: 0.875rem; font-weight: 500; transition: all 0.15s; }
    .topbar-nav a:hover, .topbar-nav a.active { color: var(--text); background: var(--border); }
    .main-content { max-width: 1400px; margin: 0 auto; padding: 2rem; }
    .page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem; }
    .page-header-actions { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
    .page-header h1 { font-size: 1.75rem; font-weight: 700; color: var(--text-strong); }
    .event-meta { color: var(--text-faint); font-size: 0.875rem; margin-top: 0.25rem; }
    .report-logo { display: block; max-height: 72px; max-width: 240px; object-fit: contain; background: #fff; border-radius: 8px; padding: 6px; flex-shrink: 0; }
    .report-logo-print { max-height: 80px; max-width: 280px; margin-bottom: 0.75rem; }
    .section { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; margin-bottom: 1.5rem; }
    .section-header { padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
    .section-header h2 { font-size: 1.125rem; font-weight: 600; color: var(--text-strong); }
    .section-body { padding: 0; }
    table { width: 100%; border-collapse: collapse; }
    th { text-align: left; padding: 0.75rem 1.5rem; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-faint); background: rgba(15,23,42,0.3); }
    td { padding: 0.75rem 1.5rem; font-size: 0.875rem; color: var(--text); border-top: 1px solid rgba(148,163,184,0.05); }
    tr:hover td { background: rgba(148,163,184,0.03); }
    .badge { display: inline-block; padding: 0.2rem 0.6rem; border-radius: 9999px; font-size: 0.7rem; font-weight: 600; }
    .badge-area { background: rgba(167,139,250,0.15); color: #a78bfa; }
    .badge-approved { background: rgba(52,211,153,0.15); color: var(--success); }
    .badge-rejected { background: rgba(248,113,113,0.15); color: var(--danger); }
    .badge-revision { background: rgba(251,191,36,0.15); color: var(--warn); }
    .badge-pending { background: rgba(100,116,139,0.2); color: var(--text-muted); }
    .badge-role { background: rgba(96,165,250,0.15); color: var(--link); border: 1px solid rgba(96,165,250,0.25); }
    .badge-role-teacher { background: rgba(168,85,247,0.15); color: #d8b4fe; border: 1px solid rgba(168,85,247,0.25); }
    .badge-role-speaker { background: rgba(251,146,60,0.15); color: #fdba74; border: 1px solid rgba(251,146,60,0.25); }
    .badge-role-oral { background: rgba(56,189,248,0.15); color: #7dd3fc; border: 1px solid rgba(56,189,248,0.25); }
    .badge-role-poster { background: rgba(192,132,252,0.15); color: #d8b4fe; border: 1px solid rgba(192,132,252,0.25); }
    .btn { display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.4rem 0.75rem; border-radius: 8px; font-size: 0.8125rem; font-weight: 500; cursor: pointer; border: none; transition: all 0.15s; text-decoration: none; }
    .btn-ghost { background: transparent; color: var(--text-muted); border: 1px solid rgba(148,163,184,0.2); }
    .btn-ghost:hover { background: var(--border); color: var(--text); }
    .btn-primary { background: var(--primary); color: white; }
    .btn-primary:hover { background: var(--primary-hover); }
    .btn-sm { padding: 0.25rem 0.5rem; font-size: 0.75rem; }
    .session-pill { padding: 0.42rem 0.78rem; border: 1px solid rgba(148,163,184,0.18); border-radius: 999px; color: var(--text); font-size: 0.82rem; }
    .btn-logout { background: transparent; color: var(--danger); border: 1px solid rgba(248,113,113,0.25); font-family: inherit; cursor: pointer; }
    .btn-secondary { background: rgba(148,163,184,0.12); color: var(--text); border: 1px solid rgba(148,163,184,0.18); text-decoration: none; }
    .btn-secondary:hover { background: rgba(148,163,184,0.2); }
    .actions { display: flex; gap: 0.375rem; align-items: center; }
    .decision-select { background: rgba(15,23,42,0.6); color: var(--text); border: 1px solid rgba(148,163,184,0.2); border-radius: 6px; padding: 0.35rem 0.6rem; font-size: 0.8125rem; }
    .form-inline { display: inline-flex; align-items: center; gap: 0.5rem; }
    .empty-state { text-align: center; padding: 3rem 2rem; color: var(--text-faint); }
    .empty-state p { margin-bottom: 1rem; }
    footer { text-align: center; padding: 2rem; color: var(--text-faint); font-size: 0.75rem; }
    .print-only { display: none; }
    .report-selection { display: inline-flex; align-items: center; gap: 0.45rem; color: var(--text-muted); font-size: 0.78rem; font-weight: 500; white-space: nowrap; }
    .report-selection input { accent-color: var(--primary); }
    @media print {
      body { background: #ffffff; color: #111827; min-height: auto; }
      .topbar, .no-print, footer, .report-selection, .page-header { display: none !important; }
      .section.report-excluded { display: none !important; }
      .print-only { display: block; }
      .main-content { max-width: none; margin: 0; padding: 0; }
      .page-header { margin-bottom: 1rem; }
      .page-header h1, .section-header h2 { color: #111827; }
      .event-meta, .empty-state, td, p, small, div { color: #374151; }
      .section {
        background: #ffffff;
        border: 1px solid #d1d5db;
        break-inside: avoid;
        page-break-inside: avoid;
        margin-bottom: 1rem;
      }
      .section-header, th {
        background: #f3f4f6 !important;
        color: #111827 !important;
        border-color: #d1d5db;
      }
      table { width: 100%; }
      tr, td, th { break-inside: avoid; page-break-inside: avoid; }
      .badge {
        color: #111827 !important;
        background: #e5e7eb !important;
        border: 1px solid #d1d5db;
      }
      a { color: #111827; text-decoration: none; }
      @page { size: A4 portrait; margin: 12mm; }
    }
  </style>
  <%- include('../../partials/theme') %>
  <%- include('../../partials/mobile-fixes') %>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="logo"><span class="logo-icon">◆</span> Gerência de Eventos</a>
      <nav class="topbar-nav">
        <% if (isAdmin) { %><a href="/admin">Dashboard</a><% } %>
        <a href="/admin/events" class="active">Eventos</a>
        <% if (isAdmin) { %><a href="/admin/users">Usuários</a><% } %>
        <form method="POST" action="/admin/logout" style="display:inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-logout">Sair</button>
        </form>
      </nav>
    </div>
  </header>

  <main class="main-content">
    <div class="print-only" style="margin-bottom: 1rem;">
      <% if (event.logo_path) { %>
        <img src="/uploads/event-logos/<%= String(event.logo_path).split('/').pop() %>" alt="" class="report-logo report-logo-print">
      <% } %>
      <h1 style="font-size: 1.6rem; margin-bottom: 0.35rem;"><%= event.name %> - Relatório do Evento</h1>
      <p style="font-size: 0.9rem;">Gerado em <%= new Date().toLocaleDateString('pt-BR') %></p>
    </div>
    <div class="page-header">
      <div style="display:flex;align-items:center;gap:1rem;min-width:0">
        <% if (event.logo_path) { %>
          <img src="/uploads/event-logos/<%= String(event.logo_path).split('/').pop() %>" alt="" class="report-logo">
        <% } %>
        <div>
          <h1>Relatórios - <%= event.name %></h1>
          <p class="event-meta"><%= event.area_display || event.area %> · <%= formatBRDate(event.date_start) %> – <%= event.date_end ? formatBRDate(event.date_end) : '' %></p>
        </div>
      </div>
      <div class="page-header-actions no-print">
        <button type="button" id="print-report-btn" class="btn btn-primary">Imprimir em PDF</button>
        <button type="button" id="select-all-report-sections" class="btn btn-ghost">Selecionar todos</button>
        <button type="button" id="clear-report-sections" class="btn btn-ghost">Limpar seleção</button>
        <a href="/admin/events" class="btn btn-ghost">← Voltar</a>
      </div>
    </div>

    <!-- Informações do Evento -->
    <div class="section" data-report-section="event-info">
      <div class="section-header">
        <h2>Informações do Evento</h2>
        <label class="report-selection no-print"><input type="checkbox" data-report-toggle="event-info" checked> Incluir no PDF</label>
      </div>
      <div class="section-body" style="padding: 1.5rem;">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%,250px), 1fr)); gap: 1.5rem;">
          <div>
            <h3 style="font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-faint); margin-bottom: 0.5rem;">Nome</h3>
            <p style="font-size: 1.0625rem; color: var(--text-strong); font-weight: 600;"><%= event.name %></p>
          </div>
          <div>
            <h3 style="font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-faint); margin-bottom: 0.5rem;">Localização</h3>
            <p style="font-size: 1.0625rem; color: var(--text-strong);"><%= event.location || 'Não informada' %></p>
          </div>
          <div>
            <h3 style="font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-faint); margin-bottom: 0.5rem;">Período do Evento</h3>
            <p style="font-size: 1.0625rem; color: var(--text-strong);"><%= formatBRDate(event.date_start) %> – <%= event.date_end ? formatBRDate(event.date_end) : 'Não definido' %></p>
          </div>
          <div>
            <h3 style="font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-faint); margin-bottom: 0.5rem;">Período de Submissão</h3>
            <p style="font-size: 1.0625rem; color: var(--text-strong);"><%= event.submission_start ? formatBRDate(event.submission_start) : 'ND' %> – <%= event.submission_end ? formatBRDate(event.submission_end) : 'ND' %></p>
          </div>
          <div>
            <h3 style="font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-faint); margin-bottom: 0.5rem;">Área</h3>
            <p style="font-size: 1.0625rem; color: var(--text-strong);"><%= event.area %></p>
          </div>
          <% if (event.url) { %>
          <div>
            <h3 style="font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-faint); margin-bottom: 0.5rem;">Website</h3>
            <p style="font-size: 1.0625rem;"><a href="<%= event.url %>" target="_blank" style="color: var(--accent); text-decoration: none;"><%= event.url %></a></p>
          </div>
          <% } %>
        </div>
        <% if (event.description) { %>
        <div style="margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border);">
          <h3 style="font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-faint); margin-bottom: 0.5rem;">Descrição</h3>
          <p style="color: var(--text); line-height: 1.6;"><%= event.description %></p>
        </div>
        <% } %>
      </div>
    </div>

    <!-- Estatísticas -->
    <div class="section" data-report-section="event-stats">
      <div class="section-header">
        <h2>Estatísticas do Evento</h2>
        <label class="report-selection no-print"><input type="checkbox" data-report-toggle="event-stats" checked> Incluir no PDF</label>
      </div>
      <div class="section-body" style="padding: 1.5rem;">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1.5rem;">
          <div style="text-align: center; padding: 1.5rem; background: rgba(15,23,42,0.3); border-radius: 10px;">
            <div style="font-size: 2rem; font-weight: 700; color: var(--accent);"><%= totalSubmited %></div>
            <div style="font-size: 0.8125rem; color: var(--text-muted); margin-top: 0.25rem;">Artigos Submetidos</div>
          </div>
          <div style="text-align: center; padding: 1.5rem; background: rgba(15,23,42,0.3); border-radius: 10px;">
            <div style="font-size: 2rem; font-weight: 700; color: var(--success);"><%= oralApproved %></div>
            <div style="font-size: 0.8125rem; color: var(--text-muted); margin-top: 0.25rem;">Aprovados - Oral</div>
          </div>
          <div style="text-align: center; padding: 1.5rem; background: rgba(15,23,42,0.3); border-radius: 10px;">
            <div style="font-size: 2rem; font-weight: 700; color: #a78bfa;"><%= posterApproved %></div>
            <div style="font-size: 0.8125rem; color: var(--text-muted); margin-top: 0.25rem;">Aprovados - Pôster</div>
          </div>
          <div style="text-align: center; padding: 1.5rem; background: rgba(15,23,42,0.3); border-radius: 10px;">
            <div style="font-size: 2rem; font-weight: 700; color: var(--danger);"><%= oralRejected %></div>
            <div style="font-size: 0.8125rem; color: var(--text-muted); margin-top: 0.25rem;">Reprovados - Oral</div>
          </div>
          <div style="text-align: center; padding: 1.5rem; background: rgba(15,23,42,0.3); border-radius: 10px;">
            <div style="font-size: 2rem; font-weight: 700; color: var(--danger);"><%= posterRejected %></div>
            <div style="font-size: 0.8125rem; color: var(--text-muted); margin-top: 0.25rem;">Reprovados - Pôster</div>
          </div>
          <div style="text-align: center; padding: 1.5rem; background: rgba(15,23,42,0.3); border-radius: 10px;">
            <div style="font-size: 2rem; font-weight: 700; color: var(--accent);"><%= authorRegistrations %></div>
            <div style="font-size: 0.8125rem; color: var(--text-muted); margin-top: 0.25rem;">Inscritos com Artigo</div>
          </div>
          <div style="text-align: center; padding: 1.5rem; background: rgba(15,23,42,0.3); border-radius: 10px;">
            <div style="font-size: 2rem; font-weight: 700; color: var(--warn);"><%= listenerRegistrations %></div>
            <div style="font-size: 0.8125rem; color: var(--text-muted); margin-top: 0.25rem;">Inscritos Participantes</div>
          </div>
          <div style="text-align: center; padding: 1.5rem; background: rgba(15,23,42,0.3); border-radius: 10px;">
            <div style="font-size: 2rem; font-weight: 700; color: var(--success);"><%= certificatesIssued %></div>
            <div style="font-size: 0.8125rem; color: var(--text-muted); margin-top: 0.25rem;">Certificados Emitidos</div>
          </div>
          <div style="text-align: center; padding: 1.5rem; background: rgba(15,23,42,0.3); border-radius: 10px;">
            <div style="font-size: 2rem; font-weight: 700; color: #22d3ee;"><%= evaluatorsCount %></div>
            <div style="font-size: 0.8125rem; color: var(--text-muted); margin-top: 0.25rem;">Participantes que avaliaram</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Atividades do Evento -->
    <div class="section" data-report-section="activities">
      <div class="section-header">
        <h2>Atividades do Evento</h2>
        <label class="report-selection no-print"><input type="checkbox" data-report-toggle="activities" <%= activities.length > 0 ? 'checked' : '' %>> Incluir no PDF</label>
      </div>
      <div class="section-body" style="padding:1.5rem">
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem;margin-bottom:1.5rem">
          <div style="background:rgba(15,23,42,0.35);border:1px solid var(--border);border-radius:8px;padding:1rem">
            <div style="font-size:1.5rem;font-weight:700;color:var(--text-strong)"><%= totalActivities %></div>
            <div style="color:var(--text-faint);text-transform:uppercase;letter-spacing:0.05em;font-size:0.74rem;margin-top:0.25rem">Total de atividades</div>
          </div>
          <div style="background:rgba(15,23,42,0.35);border:1px solid var(--border);border-radius:8px;padding:1rem">
            <div style="font-size:1.5rem;font-weight:700;color:var(--text-strong)"><%= totalEnrollments %></div>
            <div style="color:var(--text-faint);text-transform:uppercase;letter-spacing:0.05em;font-size:0.74rem;margin-top:0.25rem">Inscrições vinculadas</div>
          </div>
          <div style="background:rgba(15,23,42,0.35);border:1px solid var(--border);border-radius:8px;padding:1rem">
            <div style="font-size:1.5rem;font-weight:700;color:var(--text-strong)"><%= totalAttendance %></div>
            <div style="color:var(--text-faint);text-transform:uppercase;letter-spacing:0.05em;font-size:0.74rem;margin-top:0.25rem">Presenças registradas</div>
          </div>
          <div style="background:rgba(15,23,42,0.35);border:1px solid var(--border);border-radius:8px;padding:1rem">
            <div style="font-size:1.5rem;font-weight:700;color:var(--text-strong)"><%= certifiedActivities %></div>
            <div style="color:var(--text-faint);text-transform:uppercase;letter-spacing:0.05em;font-size:0.74rem;margin-top:0.25rem">Atividades certificáveis</div>
          </div>
        </div>
        <% if (activities.length === 0) { %>
          <div class="empty-state"><p>Nenhuma atividade cadastrada para este evento.</p></div>
        <% } else { %>
          <% const activityTypeMap = { lecture:'Palestra', seminar:'Seminário', roundtable:'Mesa-redonda', course:'Minicurso', oral_presentation:'Apresentação oral', poster_presentation:'Apresentação pôster', breakfast:'Café da manhã', coffee_break:'Coffee Break', brunch:'Brunch', lunch:'Almoço', dinner:'Jantar', other:'Outra' }; %>
          <% const typeBgColors = {lecture:'var(--primary)',seminar:'#8b5cf6',roundtable:'#f59e0b',course:'#10b981',oral_presentation:'#06b6d4',poster_presentation:'#a78bfa',breakfast:'#f59e0b',coffee_break:'#78716c',brunch:'#14b8a6',lunch:'#f97316',dinner:'#8b5cf6',other:'var(--text-faint)'}; %>
          <% groupedTypes.forEach(function(type) { %>
            <% var items = activitiesByType[type]; %>
            <div style="margin-bottom:1.25rem">
              <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.75rem">
                <span style="background:<%= typeBgColors[type] || 'var(--text-faint)' %>;color:#fff;padding:0.2rem 0.6rem;border-radius:999px;font-size:0.75rem;font-weight:600"><%= activityTypeMap[type] || type %></span>
                <span style="color:var(--text-muted);font-size:0.85rem;font-weight:400">(<%= items.length %> atividade<%= items.length > 1 ? 's' : '' %>)</span>
              </div>
              <div style="display:flex;flex-direction:column;gap:0.5rem">
                <% items.forEach(function(activity) { %>
                  <div style="background:rgba(15,23,42,0.3);border:1px solid var(--border);border-radius:8px;padding:0.85rem 1rem">
                    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.5rem">
                      <div>
                        <div style="font-weight:600;color:var(--text-strong);font-size:0.9rem"><%= activity.name %></div>
                        <div style="color:var(--text-faint);font-size:0.8rem;margin-top:0.15rem">
                          <%= activityDateRange(activity) %>
                          <%= Number(activity.workload_hours) > 0 ? ' · ' + activity.workload_hours + 'h' : '' %>
                        </div>
                      </div>
                      <div style="display:flex;gap:1rem;align-items:center;flex-wrap:wrap">
                        <div style="text-align:center;padding:0.3rem 0.8rem;background:rgba(96,165,250,0.1);border-radius:6px">
                          <div style="font-size:1.1rem;font-weight:700;color:var(--accent)"><%= activity.enrolled_count || 0 %></div>
                          <div style="font-size:0.65rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.05em">Inscritos</div>
                        </div>
                        <div style="text-align:center;padding:0.3rem 0.8rem;background:rgba(52,211,153,0.1);border-radius:6px">
                          <div style="font-size:1.1rem;font-weight:700;color:var(--success)"><%= activity.attendees_count || 0 %></div>
                          <div style="font-size:0.65rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.05em">Presentes</div>
                        </div>
                        <div style="text-align:center;padding:0.3rem 0.8rem;background:rgba(34,211,238,0.1);border-radius:6px">
                          <div style="font-size:1.1rem;font-weight:700;color:#22d3ee"><%= (activity.evaluations || []).length %></div>
                          <div style="font-size:0.65rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.05em">Avaliações</div>
                        </div>
                      </div>
                    </div>
                    <% if (activity.evaluations && activity.evaluations.length > 0) { %>
                      <div style="margin-top:0.75rem">
                        <button type="button" class="btn btn-ghost no-print btn-evaluations-toggle" data-evaluations-target="evaluations-<%= activity.id %>" data-count="<%= activity.evaluations.length %>" style="font-size:0.78rem;padding:0.3rem 0.7rem">Ver avaliações (<%= activity.evaluations.length %>)</button>
                        <div id="evaluations-<%= activity.id %>" hidden style="margin-top:0.65rem">
                          <% activity.evaluations.forEach(function(ev) { %>
