    <!-- Participantes do Evento -->
    <div class="section" data-report-section="participants">
      <div class="section-header">
        <h2>Participantes do Evento (<%= participants.length %>)</h2>
        <label class="report-selection no-print"><input type="checkbox" data-report-toggle="participants" <%= participants.length > 0 ? 'checked' : '' %>> Incluir no PDF</label>
      </div>
      <div class="section-body">
        <% if (participants.length > 0) { %>
        <div class="table-scroll"><table>
          <thead>
            <tr>
              <th>Nome</th>
              <th>E-mail</th>
              <th>Órgão</th>
              <th>Participação</th>
            </tr>
          </thead>
          <tbody>
            <% participants.forEach((participant) => { %>
            <tr>
              <td><strong style="color: var(--text-strong);"><%= participant.name || '-' %></strong></td>
              <td><%= participant.email || '-' %></td>
              <td><%= participant.institution || '-' %></td>
              <td>
                <% if (participant.roles) { %>
                  <div style="display:flex;gap:3px;flex-wrap:wrap">
                    <% String(participant.roles).split(',').forEach((r) => {
                      const role = r.trim();
                      if (!role) return;
                      let cls = 'badge-role';
                      if (role === 'teacher') cls = 'badge-role-teacher';
                      else if (role === 'speaker') cls = 'badge-role-speaker';
                      else if (role === 'oral_presenter') cls = 'badge-role-oral';
                      else if (role === 'poster_presenter') cls = 'badge-role-poster';
                      else if (role === 'participant') cls = 'badge-role';
                      const labels = {participant:'Participante',reviewer:'Revisor',speaker:'Palestrante',teacher:'Professor',oral_presenter:'Apresent. Oral',poster_presenter:'Apresent. Pôster',admin:'Administrador'};
                    %><span class="badge <%= cls %>" style="font-size:0.68rem;padding:0.12rem 0.45rem"><%= labels[role] || role %></span>
                    <% }); %>
                  </div>
                <% } else { %>
                  <% if (participant.participation_label === 'Artigo aprovado') { %>
                    <span class="badge badge-approved">Artigo aprovado</span>
                  <% } else if (participant.participation_label === 'Participante') { %>
                    <span class="badge badge-pending">Participante</span>
                  <% } else { %>
                    <span class="badge badge-revision">Inscrito com artigo</span>
                  <% } %>
