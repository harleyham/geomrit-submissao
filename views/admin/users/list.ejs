<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Usuários | Gerência de Eventos</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: #0a0f1a; color: #e2e8f0; min-height: 100vh; }
    .topbar { background: rgba(15,23,42,0.8); border-bottom: 1px solid rgba(148,163,184,0.1); backdrop-filter: blur(20px); padding: 0 2rem; height: 64px; display: flex; align-items: center; position: sticky; top: 0; z-index: 100; }
    .topbar-inner { width: 100%; max-width: 1600px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
    .logo { font-size: 1.25rem; font-weight: 700; color: #e2e8f0; text-decoration: none; }
    .logo-icon { color: #60a5fa; }
    .topbar-nav { display: flex; gap: 0.25rem; align-items: center; }
    .topbar-nav a { color: #94a3b8; padding: 0.5rem 0.75rem; border-radius: 6px; text-decoration: none; font-size: 0.875rem; font-weight: 500; transition: all 0.15s; }
    .topbar-nav a:hover, .topbar-nav a.active { color: #e2e8f0; background: rgba(148,163,184,0.1); }
    .main-content { max-width: 1600px; margin: 0 auto; padding: 2rem; }
    .page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem; }
    .page-header h1 { font-size: 1.75rem; font-weight: 700; color: #f1f5f9; }
    .section { background: rgba(30,41,59,0.6); border: 1px solid rgba(148,163,184,0.1); border-radius: 12px; padding: 2rem; margin-bottom: 1.5rem; }
    .section-title { font-size: 1.125rem; font-weight: 600; color: #f1f5f9; margin-bottom: 0.5rem; }
    .section-desc { color: #64748b; font-size: 0.875rem; margin-bottom: 1.5rem; }
    .section-note { margin-bottom: 1rem; padding: 0.875rem 1rem; border-radius: 10px; border: 1px solid rgba(96,165,250,0.18); background: rgba(15,23,42,0.35); color: #cbd5e1; font-size: 0.8125rem; line-height: 1.6; }
    .form-group { margin-bottom: 1rem; }
    .form-group label { display: block; color: #94a3b8; font-size: 0.875rem; font-weight: 500; margin-bottom: 0.375rem; }
    .form-group input { width: 100%; padding: 0.625rem 1rem; border: 1px solid rgba(148,163,184,0.2); border-radius: 8px; background: rgba(15,23,42,0.5); color: #e2e8f0; font-size: 0.9375rem; font-family: 'Inter', sans-serif; }
    .form-group input:focus { outline: none; border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,0.15); }
    .password-field { position: relative; }
    .password-field input { padding-right: 3.25rem; }
    .toggle-password { position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%); background: transparent; border: none; color: #94a3b8; cursor: pointer; font-size: 1rem; }
    .form-actions { display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem; }
    .btn { display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.625rem 1.25rem; border-radius: 8px; font-size: 0.875rem; font-weight: 500; cursor: pointer; border: none; transition: all 0.15s; }
    .btn-primary { background: #3b82f6; color: white; }
    .btn-primary:hover { background: #2563eb; }
    .btn-danger { background: rgba(239,68,68,0.15); color: #f87171; border: 1px solid rgba(239,68,68,0.2); }
    .btn-danger:hover { background: rgba(239,68,68,0.25); }
    .btn-ghost { background: transparent; color: #94a3b8; border: 1px solid rgba(148,163,184,0.2); }
    .btn-ghost:hover { background: rgba(148,163,184,0.1); color: #e2e8f0; }
    .btn-sm { padding: 0.25rem 0.5rem; font-size: 0.7rem; }
    .session-pill { padding: 0.42rem 0.78rem; border: 1px solid rgba(148,163,184,0.18); border-radius: 999px; color: #e2e8f0; font-size: 0.82rem; }
    .btn-logout { background: transparent; color: #f87171; border: 1px solid rgba(248,113,113,0.25); font-family: inherit; cursor: pointer; }
    .btn-secondary { background: rgba(148,163,184,0.12); color: #e2e8f0; border: 1px solid rgba(148,163,184,0.18); text-decoration: none; }
    .btn-secondary:hover { background: rgba(148,163,184,0.2); }
    .alert { padding: 0.875rem 1rem; border-radius: 8px; margin-bottom: 1.5rem; font-size: 0.875rem; }
    .alert-success { background: rgba(52,211,153,0.1); color: #34d399; border: 1px solid rgba(52,211,153,0.2); }
    .alert-error { background: rgba(248,113,113,0.1); color: #f87171; border: 1px solid rgba(248,113,113,0.2); }
    table { width: 100%; border-collapse: collapse; }
    th { text-align: left; padding: 0.75rem 1rem; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; background: rgba(15,23,42,0.3); }
    td { padding: 0.75rem 1rem; font-size: 0.8125rem; color: #cbd5e1; border-top: 1px solid rgba(148,163,184,0.05); }
    tr:hover td { background: rgba(148,163,184,0.03); }
    .badge { display: inline-block; padding: 0.2rem 0.5rem; border-radius: 9999px; font-size: 0.65rem; font-weight: 600; }
    .badge-admin { background: rgba(167,139,250,0.15); color: #a78bfa; }
    .badge-reviewer { background: rgba(52,211,153,0.15); color: #34d399; }
    .badge-staff { background: rgba(244,114,182,0.15); color: #f472b6; }
    .badge-public { background: rgba(59,130,246,0.15); color: #60a5fa; }
    .badge-active { background: rgba(52,211,153,0.15); color: #34d399; }
    .badge-inactive { background: rgba(100,116,139,0.2); color: #94a3b8; }
    .badge-warning { background: rgba(251,191,36,0.15); color: #fbbf24; }
    .badge-info { background: rgba(59,130,246,0.15); color: #93c5fd; }
    .toggle-switch { position: relative; display: inline-block; width: 40px; height: 22px; }
    .toggle-switch input { opacity: 0; width: 0; height: 0; }
    .toggle-slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background: rgba(100,116,139,0.4); border-radius: 24px; transition: 0.2s; }
    .toggle-slider:before { content: ""; position: absolute; height: 16px; width: 16px; left: 3px; bottom: 3px; background: white; border-radius: 50%; transition: 0.2s; }
    input:checked + .toggle-slider { background: #3b82f6; }
    input:checked + .toggle-slider:before { transform: translateX(18px); }
    .actions-cell { display: flex; gap: 0.375rem; align-items: center; }
    footer { text-align: center; padding: 2rem; color: #475569; font-size: 0.75rem; }
    a { color: #60a5fa; text-decoration: none; }
    a:hover { text-decoration: underline; }
    .user-detail { color: #64748b; font-size: 0.7rem; display: block; margin-top: 0.1rem; }
    .filters { padding: 1rem 1.25rem; border-bottom: 1px solid rgba(148,163,184,0.1); display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: end; background: rgba(15,23,42,0.2); margin: -2rem -2rem 1.5rem -2rem; border-radius: 12px 12px 0 0; }
    .filter-group { min-width: 180px; flex: 1; }
    .filter-group label { display: block; font-size: 0.8rem; color: #94a3b8; margin-bottom: 0.45rem; }
    .filter-group input, .filter-group select { width: 100%; padding: 0.7rem 0.9rem; border-radius: 10px; border: 1px solid rgba(148,163,184,0.16); background: rgba(2,6,23,0.45); color: #f8fafc; font-family: 'Inter', sans-serif; }
    .filter-group input:focus, .filter-group select:focus { outline: none; border-color: #60a5fa; box-shadow: 0 0 0 3px rgba(59,130,246,0.16); }
    .filter-actions { display: flex; gap: 0.5rem; }
    .empty-state { text-align: center; padding: 3rem; color: #64748b; font-size: 0.95rem; }
    .modal-backdrop { position: fixed; inset: 0; background: rgba(2,6,23,0.72); display: none; align-items: center; justify-content: center; padding: 1.5rem; z-index: 1200; }
    .modal-backdrop.visible { display: flex; }
    .modal-card { width: 100%; max-width: 460px; background: rgba(15,23,42,0.98); border: 1px solid rgba(148,163,184,0.18); border-radius: 18px; padding: 1.5rem; box-shadow: 0 30px 80px rgba(2,6,23,0.5); }
    .modal-card h2 { color: #f8fafc; font-size: 1.15rem; margin-bottom: 0.7rem; }
    .modal-card p { color: #94a3b8; line-height: 1.65; margin-bottom: 1.25rem; white-space: pre-line; }
    .modal-actions { display: flex; justify-content: flex-end; gap: 0.75rem; flex-wrap: wrap; }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="logo"><span class="logo-icon">◆</span> Gerência de Eventos</a>
      <nav class="topbar-nav">
        <a href="/admin">Dashboard</a>
        <a href="/admin/events">Eventos</a>
        <a href="/admin/users" class="active">Usuários</a>
        <% if (userEmail) { %><span class="session-pill"><%= userEmail %></span><% } %>
        <form method="POST" action="/admin/logout" style="display:inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-logout">Sair</button>
        </form>
      </nav>
    </div>
  </header>

  <main class="main-content">
    <% const pendingList = pendingUsers; %>
    <% const approvedList = approvedUsers; %>
    <div class="page-header">
      <h1>Usuários</h1>
      <div style="display:flex;gap:0.5rem">
        <a href="/admin/users/new" class="btn btn-primary">+ Novo Usuário</a>
        <a href="/admin/users/import" class="btn btn-primary" style="background:#059669">Importar lista</a>
      </div>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success"><%= success %></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error"><%= error %></div>
    <% } %>

    <!-- Trocar senha do admin -->
    <div class="section">
      <div class="section-title">Minha Senha</div>
      <div class="section-desc">Altere a senha de acesso ao painel administrativo</div>
      <form method="POST" action="/admin/users/change-password" style="max-width: 400px;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label for="current_password">Senha Atual *</label>
          <div class="password-field">
            <input type="password" id="current_password" name="current_password" required autocomplete="current-password">
            <button type="button" class="toggle-password" aria-label="Mostrar senha" data-target="current_password">👁</button>
          </div>
        </div>
        <div class="form-group">
          <label for="new_password">Nova Senha *</label>
          <div class="password-field">
            <input type="password" id="new_password" name="new_password" required minlength="6" autocomplete="new-password">
            <button type="button" class="toggle-password" aria-label="Mostrar senha" data-target="new_password">👁</button>
          </div>
        </div>
        <div class="form-group">
          <label for="confirm_password">Confirmar Nova Senha *</label>
          <div class="password-field">
            <input type="password" id="confirm_password" name="confirm_password" required minlength="6" autocomplete="new-password">
            <button type="button" class="toggle-password" aria-label="Mostrar senha" data-target="confirm_password">👁</button>
          </div>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Salvar Senha</button>
        </div>
      </form>
    </div>

    <% if (pendingList.length > 0) { %>
    <div class="section" id="cadastros-pendentes">
      <div class="section-title">Cadastros Pendentes de Aprovação</div>
      <div class="section-desc">Solicitações externas aguardando validação administrativa</div>
      <table>
        <thead>
          <tr>
            <th>Nome</th>
            <th>E-mail</th>
            <th>Dados Complementares</th>
            <th>Status</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% pendingList.forEach(u => { %>
          <tr>
            <td>
              <div>
                <strong style="color: #f1f5f9;"><%= u.name || u.email %></strong>
              </div>
            </td>
            <td><%= u.email %></td>
            <td>
              <% if (u.cpf || u.passport || u.country || u.institution) { %>
                <div style="display:flex; flex-direction:column; gap:0.25rem;">
                  <% if (u.institution) { %><span><strong>Instituição:</strong> <%= u.institution %></span><% } %>
                  <% if (u.country) { %><span><strong>País:</strong> <%= u.country %></span><% } %>
                  <% if (u.cpf) { %><span><strong>CPF:</strong> <%= u.cpf %></span><% } %>
                  <% if (u.passport) { %><span><strong>Passaporte:</strong> <%= u.passport %></span><% } %>
                </div>
              <% } else { %>
                <span style="color:#64748b;">Sem dados complementares</span>
              <% } %>
            </td>
            <td><span class="badge badge-info">Pendente de aprovação</span></td>
            <td class="actions-cell">
              <a href="/admin/users/<%= u.id %>/participant" class="btn btn-ghost btn-sm">Área do Participante</a>
              <a href="/admin/users/<%= u.id %>/edit" class="btn btn-ghost btn-sm">Editar</a>
              <form method="POST" action="/admin/users/<%= u.id %>/approve" style="display:inline" nonce="<%= cspNonce %>" onsubmit="return confirm('Aprovar o cadastro de <%= u.email %>?')">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-primary btn-sm">Aprovar Cadastro</button>
              </form>
              <% if (u.id !== currentUser.id && u.email !== 'admin@admin.com') { %>
              <form method="POST" action="/admin/users/<%= u.id %>" class="js-delete-user-pending" data-email="<%= u.email %>" style="display:inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="_method" value="DELETE">
                <button type="submit" class="btn btn-danger btn-sm">Excluir</button>
              </form>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>

    <div class="section">
      <div class="section-title">Gerenciar Usuários</div>
      <div class="section-desc">Usuários já aprovados, com gestão de papéis e status de acesso</div>
       <div class="section-note">
        Revisor define o papel do usuário no fluxo de avaliação.
        Conta ativa define se ele pode entrar no sistema.
        Desativar a conta <strong>não remove</strong> automaticamente o papel de revisor.
        Um usuário com Revisor ligado e Conta ativa desligada será contado como <strong>revisor inativo</strong>.
        Para bloquear o acesso preservando o histórico (inscrições, presenças, certificados), desligue o controle <strong>Conta ativa</strong>.
        O botão <strong>Excluir</strong> é definitivo: remove também papéis em eventos, inscrições em atividades, presenças, crachá e revisões — reserve para cadastros por engado.
      </div>
      <form method="GET" class="filters">
        <div class="filter-group">
          <label for="q">Buscar usuário</label>
          <input id="q" type="text" name="q" value="<%= (filters && filters.query) || '' %>" placeholder="Nome, e-mail, instituição ou CPF">
        </div>
        <div class="filter-actions">
          <button type="submit" class="btn btn-primary">Buscar</button>
          <a href="/admin/users" class="btn btn-ghost">Limpar</a>
        </div>
      </form>
       <% if (pagination) { %>
       <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;flex-wrap:wrap;gap:0.5rem">
         <span style="color:#64748b;font-size:0.8125rem">Exibindo <%= ((pagination.currentPage - 1) * pagination.perPage) + 1 %>-<%= Math.min(pagination.currentPage * pagination.perPage, pagination.totalApproved) %> de <%= pagination.totalApproved %> usuário(s)</span>
         <div style="display:flex;gap:0.5rem;align-items:center">
           <% if (pagination.hasPrev) { %>
            <a href="/admin/users?page=<%= pagination.currentPage - 1 %>&per_page=<%= pagination.perPage %><% if (filters && filters.query) { %>&q=<%= encodeURIComponent(filters.query) %><% } %>" class="btn btn-ghost btn-sm" style="display:inline-block">← Anterior</a>
           <% } %>
           <% if (pagination.totalPages > 1) { %>
           <span style="color:#94a3b8;font-size:0.8125rem;padding:0.25rem 0.5rem">Página <%= pagination.currentPage %> de <%= pagination.totalPages %></span>
           <% } %>
           <% if (pagination.hasNext) { %>
            <a href="/admin/users?page=<%= pagination.currentPage + 1 %>&per_page=<%= pagination.perPage %><% if (filters && filters.query) { %>&q=<%= encodeURIComponent(filters.query) %><% } %>" class="btn btn-ghost btn-sm" style="display:inline-block">Próxima →</a>
           <% } %>
           <select id="per-page-select" style="background:rgba(15,23,42,0.5);color:#e2e8f0;border:1px solid rgba(148,163,184,0.2);border-radius:6px;padding:0.25rem 0.5rem;font-size:0.8125rem;font-family:'Inter',sans-serif">
             <option value="25"<%= pagination.perPage === 25 ? ' selected' : ''%>>25 por página</option>
             <option value="50"<%= pagination.perPage === 50 ? ' selected' : ''%>>50 por página</option>
             <option value="100"<%= pagination.perPage === 100 ? ' selected' : ''%>>100 por página</option>
             <option value="200"<%= pagination.perPage === 200 ? ' selected' : ''%>>200 por página</option>
           </select>
          </div>
        </div>
       <% } %>
       <% if (!approvedList.length) { %>
       <div class="empty-state">Nenhum usuário encontrado<% if (filters && filters.query) { %> para a busca "<%= filters.query %>"<% } %>.</div>
       <% } else { %>
       <table>
        <thead>
          <tr>
            <th>Nome</th>
            <th>E-mail</th>
            <th>Papéis no Sistema</th>
            <th>Conta Ativa</th>
            <th>Primeiro acesso</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% approvedList.forEach(u => { %>
          <tr>
            <input type="hidden" name="user_ids" value="<%= u.id %>" form="bulk-flags-form">
            <td>
              <div>
                <strong style="color: #f1f5f9;"><%= u.name || u.email %></strong>
                <% if (u.cpf || u.institution) { %>
                  <span class="user-detail"><%= u.cpf || '' %> <%= u.cpf && u.institution ? '|' : '' %> <%= u.institution || '' %></span>
                <% } %>
              </div>
            </td>
            <td>
              <div style="display:flex; flex-direction:column; gap:0.35rem;">
                <span><%= u.email %></span>
              </div>
            </td>
            <td>
              <div style="display: flex; gap: 0.25rem; align-items: center;">
                <label class="toggle-switch">
                  <input name="is_admin_<%= u.id %>" value="1" type="checkbox" form="bulk-flags-form" <%= u.is_admin ? 'checked' : '' %>>
                  <span class="toggle-slider"></span>
                </label>
                <% if (u.is_admin) { %><span class="badge badge-admin">Admin</span><% } else { %><span class="badge badge-inactive">Admin</span><% } %>
                <label class="toggle-switch" style="margin-left: 0.5rem;">
                  <input name="is_reviewer_<%= u.id %>" value="1" type="checkbox" form="bulk-flags-form" <%= u.is_reviewer ? 'checked' : '' %>>
                  <span class="toggle-slider"></span>
                </label>
                <% if (u.is_reviewer) { %><span class="badge badge-reviewer">Revisor</span><% } else { %><span class="badge badge-inactive">Revisor</span><% } %>
                <label class="toggle-switch" style="margin-left: 0.5rem;" title="Habilita elegibilidade a Staff (depois marque Staff em cada evento)">
                  <input name="is_staff_<%= u.id %>" value="1" type="checkbox" form="bulk-flags-form" <%= u.is_staff ? 'checked' : '' %>>
                  <span class="toggle-slider"></span>
                </label>
                <% if (u.is_staff) { %><span class="badge badge-staff">Staff</span><% } else { %><span class="badge badge-inactive">Staff</span><% } %>
              </div>
              <div style="margin-top: 0.45rem; color:#64748b; font-size:0.72rem;">
                <% if (u.is_participant) { %><span class="badge badge-active">Participante</span><% } %>
                <% if (u.is_speaker) { %><span class="badge badge-active">Palestrante</span><% } %>
                <% if (u.is_teacher) { %><span class="badge badge-active">Professor</span><% } %>
                <% if (u.is_oral_presenter) { %><span class="badge badge-active">Apresentador Oral</span><% } %>
                <% if (u.is_poster_presenter) { %><span class="badge badge-active">Apresentador Pôster</span><% } %>
                <% if (!u.is_participant && !u.is_speaker && !u.is_teacher && !u.is_oral_presenter && !u.is_poster_presenter) { %>Admin e Revisor são papéis de acesso; os demais perfis ainda não foram definidos.<% } %>
              </div>
            </td>
            <td>
              <label class="toggle-switch">
                <input name="is_public_<%= u.id %>" value="1" type="checkbox" form="bulk-flags-form" <%= u.is_public ? 'checked' : '' %>>
                <span class="toggle-slider"></span>
              </label>
              <span style="margin-left: 0.5rem; font-size: 0.75rem;">
                <%= u.is_public ? 'Conta ativa' : 'Conta inativa' %>
              </span>
              <% if (u.is_reviewer && !u.is_public) { %>
                <div style="margin-top: 0.45rem;"><span class="badge badge-warning">Revisor inativo</span></div>
              <% } %>
            </td>
            <td>
              <span class="badge badge-<%= u.password_changed ? 'active' : 'inactive' %>">
                <%= u.password_changed ? 'Senha alterada' : 'Trocar senha' %>
              </span>
              <div style="margin-top:0.4rem;">
                <span class="badge badge-<%= u.profile_completed ? 'active' : 'inactive' %>">
                  <%= u.profile_completed ? 'Perfil completo' : 'Completar perfil' %>
                </span>
              </div>
            </td>
            <td class="actions-cell">
              <a href="/admin/users/<%= u.id %>/participant" class="btn btn-ghost btn-sm">Área do Participante</a>
              <a href="/admin/users/<%= u.id %>/edit" class="btn btn-ghost btn-sm">Editar</a>
              <% if (u.id !== currentUser.id) { %>
              <form method="POST" action="/admin/users/<%= u.id %>/reset-password" style="display:inline" nonce="<%= cspNonce %>" onsubmit="return confirm('Resetar senha de <%= u.email %> para 123456?')">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-danger btn-sm">Resetar Senha</button>
              </form>
              <% if (u.email !== 'admin@admin.com') { %>
              <form method="POST" action="/admin/users/<%= u.id %>" class="js-delete-user" data-email="<%= u.email %>" style="display:inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="_method" value="DELETE">
                <button type="submit" class="btn btn-danger btn-sm">Excluir</button>
              </form>
              <% } else { %>
              <span class="badge badge-warning">Conta protegida</span>
              <% } %>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
       <% } %>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary" form="bulk-flags-form">Salvar Alterações</button>
      </div>
    </div>
  </main>

  <footer>&copy; <%= year %> LIGEM.Redes • <%= typeof appVersion !== 'undefined' ? appVersion : 'V0.1' %></footer>

  <form id="bulk-flags-form" method="POST" action="/admin/users/bulk-update-flags" style="display:none;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"></form>

  <div class="modal-backdrop" id="delete-user-modal" aria-hidden="true">
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="delete-user-title">
      <h2 id="delete-user-title">Excluir usuário</h2>
      <p id="delete-user-message"></p>
      <div class="modal-actions">
        <button type="button" class="btn btn-ghost" id="delete-user-cancel-btn">Cancelar</button>
        <button type="button" class="btn btn-danger" id="delete-user-confirm-btn">Excluir</button>
      </div>
    </div>
  </div>

  <script nonce="<%= cspNonce %>">
    document.querySelectorAll('.toggle-password').forEach(function(button) {
      button.addEventListener('click', function() {
        var input = document.getElementById(button.getAttribute('data-target'));
        var showing = input.type === 'text';
        input.type = showing ? 'password' : 'text';
        button.textContent = showing ? '👁' : '🙈';
        button.setAttribute('aria-label', showing ? 'Mostrar senha' : 'Ocultar senha');
      });
    });
  </script>
  <script nonce="<%= cspNonce %>">
    (function() {
      var sel = document.getElementById('per-page-select');
      if (!sel) return;
      sel.addEventListener('change', function() {
        var perPage = this.value;
        var url = '/admin/users?page=1&per_page=' + perPage;
        var q = document.getElementById('q');
        if (q && q.value.trim()) {
          url += '&q=' + encodeURIComponent(q.value.trim());
        }
        window.location.href = url;
      });
    })();
  </script>

  <script nonce="<%= cspNonce %>">
    (function() {
      var modal = document.getElementById('delete-user-modal');
      var confirmBtn = document.getElementById('delete-user-confirm-btn');
      var cancelBtn = document.getElementById('delete-user-cancel-btn');
      var titleEl = document.getElementById('delete-user-title');
      var msgEl = document.getElementById('delete-user-message');
      var pendingForm = null;

      function openDeleteModal(form, title, message) {
        pendingForm = form;
        titleEl.textContent = title;
        msgEl.textContent = message;
        modal.classList.add('visible');
        modal.setAttribute('aria-hidden', 'false');
        confirmBtn.focus();
      }

      function closeDeleteModal() {
        pendingForm = null;
        modal.classList.remove('visible');
        modal.setAttribute('aria-hidden', 'true');
      }

      document.querySelectorAll('form.js-delete-user, form.js-delete-user-pending').forEach(function(form) {
        form.addEventListener('submit', function(e) {
          e.preventDefault();
          var email = form.getAttribute('data-email') || '';
          var pending = form.classList.contains('js-delete-user-pending');
          var title = pending ? 'Excluir solicitação de cadastro' : 'Excluir usuário';
          var message = pending
            ? 'Excluir solicitação de cadastro de ' + email + '?\nEsta ação não pode ser desfeita.'
            : 'Excluir o usuário ' + email + '?\nEsta ação é definitiva e não pode ser desfeita: ela também remove os papéis em eventos, as inscrições em atividades, as presenças, o crachá (QR Code) e as atribuições de revisão do usuário.\nSe o objetivo for apenas bloquear o acesso, desligue o controle "Conta ativa" na listagem — o histórico é preservado.';
          openDeleteModal(form, title, message);
        });
      });

      if (cancelBtn) cancelBtn.addEventListener('click', closeDeleteModal);
      if (confirmBtn) confirmBtn.addEventListener('click', function() {
        if (pendingForm) pendingForm.submit();
      });
      if (modal) modal.addEventListener('click', function(e) {
        if (e.target === modal) closeDeleteModal();
      });
    })();
  </script>

</body>
</html>
