<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Artigos LIGEM</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: #0a0f1a; color: #e2e8f0; min-height: 100vh; }
    .topbar { background: rgba(15,23,42,0.8); border-bottom: 1px solid rgba(148,163,184,0.1); backdrop-filter: blur(20px); padding: 0 2rem; height: 64px; display: flex; align-items: center; position: sticky; top: 0; z-index: 100; }
    .topbar-inner { width: 100%; max-width: 1400px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
    .logo { font-size: 1.25rem; font-weight: 700; color: #e2e8f0; text-decoration: none; }
    .logo-icon { color: #60a5fa; }
    .topbar-nav { display: flex; gap: 0.25rem; align-items: center; }
    .topbar-nav a { color: #94a3b8; padding: 0.5rem 0.75rem; border-radius: 6px; text-decoration: none; font-size: 0.875rem; font-weight: 500; }
    .topbar-nav a:hover { color: #e2e8f0; background: rgba(148,163,184,0.1); }
    .topbar-nav a.active { color: #e2e8f0; background: rgba(148,163,184,0.1); }
    .main-content { max-width: 700px; margin: 0 auto; padding: 2rem; }
    .page-header { margin-bottom: 2rem; }
    .page-header h1 { font-size: 1.75rem; font-weight: 700; color: #f1f5f9; }
    .section { background: rgba(30,41,59,0.6); border: 1px solid rgba(148,163,184,0.1); border-radius: 12px; padding: 2rem; }
    .section-title { font-size: 0.9375rem; font-weight: 600; color: #94a3b8; margin-bottom: 1.25rem; padding-bottom: 0.75rem; border-bottom: 1px solid rgba(148,163,184,0.1); }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .form-group { margin-bottom: 1.25rem; }
    .form-group label { display: block; color: #94a3b8; font-size: 0.875rem; font-weight: 500; margin-bottom: 0.5rem; }
    .form-group input, .form-group select, .form-group textarea { width: 100%; padding: 0.75rem 1rem; border: 1px solid rgba(148,163,184,0.2); border-radius: 8px; background: rgba(15,23,42,0.5); color: #e2e8f0; font-size: 0.9375rem; font-family: 'Inter', sans-serif; }
    .form-group input:focus, .form-group select:focus, .form-group textarea:focus { outline: none; border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,0.15); }
    .form-group textarea { min-height: 90px; resize: vertical; }
    .password-field { position: relative; }
    .password-field input { padding-right: 3.25rem; }
    .toggle-password { position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%); background: transparent; border: none; color: #94a3b8; cursor: pointer; font-size: 1rem; }
    .form-group input:disabled { background: rgba(15,23,42,0.2); color: #64748b; }
    .checkbox-group { display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border: 1px solid rgba(148,163,184,0.15); border-radius: 8px; background: rgba(15,23,42,0.3); cursor: pointer; transition: all 0.15s; }
    .checkbox-group:hover { border-color: rgba(59,130,246,0.4); background: rgba(15,23,42,0.5); }
    .checkbox-group input[type="checkbox"] { width: 18px; height: 18px; accent-color: #3b82f6; cursor: pointer; }
    .checkbox-group label { color: #cbd5e1; font-size: 0.9375rem; font-weight: 500; cursor: pointer; margin-bottom: 0 !important; }
    .checkbox-group .role-desc { color: #64748b; font-size: 0.75rem; display: block; margin-top: 0.125rem; }
    .form-actions { display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 2rem; }
    .btn { display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.625rem 1.25rem; border-radius: 8px; font-size: 0.875rem; font-weight: 500; cursor: pointer; border: none; text-decoration: none; }
    .btn-primary { background: #3b82f6; color: white; }
    .btn-primary:hover { background: #2563eb; }
    .btn-ghost { background: transparent; color: #94a3b8; border: 1px solid rgba(148,163,184,0.2); }
    .btn-ghost:hover { background: rgba(148,163,184,0.1); color: #e2e8f0; }
    footer { text-align: center; padding: 2rem; color: #475569; font-size: 0.75rem; }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="logo"><span class="logo-icon">◆</span> Artigos LIGEM</a>
      <nav class="topbar-nav">
        <a href="/admin">Dashboard</a>
        <a href="/admin/events">Eventos</a>
        <a href="/admin/users" class="active">Usuários</a>
        <% if (userEmail) { %><span style="padding:0.3rem 0.65rem; color:#cbd5e1; font-size:0.8125rem; border:1px solid rgba(148,163,184,0.18); border-radius:9999px; background:rgba(15,23,42,0.35);"><%= userEmail %></span><% } %>
        <form method="POST" action="/admin/logout" style="display:inline">
          <button type="submit" class="btn btn-ghost btn-sm" style="padding:0.3rem 0.5rem; color:#f87171;">Sair</button>
        </form>
      </nav>
    </div>
  </header>

  <main class="main-content">
    <div class="page-header">
      <h1><%= user ? 'Editar Usuário' : 'Novo Usuário' %></h1>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div style="background:rgba(239,68,68,0.15);border:1px solid rgba(239,68,68,0.3);border-radius:8px;padding:0.75rem 1rem;color:#fca5a5;margin-bottom:1.25rem;font-size:0.875rem;">
        <%= error %>
      </div>
    <% } %>

    <form method="POST" action="<%= user ? '/admin/users/' + user.id : '/admin/users' %>">
      <% if (user) { %>
        <input type="hidden" name="_method" value="PUT">
      <% } %>

      <div class="section" style="margin-bottom: 1.5rem;">
        <div class="section-title">Dados de Acesso</div>
        <div class="form-group">
          <label for="email">E-mail *</label>
          <input type="email" id="email" name="email" required value="<%= user ? user.email : '' %>" autocomplete="username">
        </div>
        <div class="form-group">
          <label for="password"><%= user ? 'Nova Senha (deixe vazio para manter a atual)' : 'Senha *' %></label>
          <div class="password-field">
            <input type="password" id="password" name="password" <%= user ? '' : 'required' %> autocomplete="new-password" minlength="6">
            <button type="button" class="toggle-password" aria-label="Mostrar senha" data-target="password">👁</button>
          </div>
        </div>
      </div>

      <div class="section" style="margin-bottom: 1.5rem;">
        <div class="section-title">Dados Pessoais</div>
        <div class="form-group">
          <label for="name">Nome</label>
          <input type="text" id="name" name="name" value="<%= user ? user.name : '' %>">
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="cpf">CPF</label>
            <input type="text" id="cpf" name="cpf" placeholder="000.000.000-00" value="<%= user ? (user.cpf || '') : '' %>">
          </div>
          <div class="form-group">
            <label for="passport">Passaporte</label>
            <input type="text" id="passport" name="passport" value="<%= user ? (user.passport || '') : '' %>">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="country">País</label>
            <%- include('../../partials/country-select', { selectedCountry: user ? (user.country || '') : '', selectId: 'country', selectName: 'country' }) %>
          </div>
          <div class="form-group">
            <label for="institution">Instituição</label>
            <input type="text" id="institution" name="institution" value="<%= user ? (user.institution || '') : '' %>">
          </div>
        </div>
      </div>

      <div class="section" style="margin-bottom: 1.5rem;">
        <div class="section-title">Perfil de Acesso</div>
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          <label class="checkbox-group">
            <input type="checkbox" name="is_admin" <%= (user && user.is_admin) ? 'checked' : '' %>>
            <div>
              Administrador
              <span class="role-desc">Acesso completo ao painel administrativo</span>
            </div>
          </label>
          <label class="checkbox-group">
            <input type="checkbox" name="is_reviewer" <%= (user && user.is_reviewer) ? 'checked' : '' %>>
            <div>
              Revisor
              <span class="role-desc">Acesso ao painel de revisão de artigos</span>
            </div>
          </label>
        </div>
        <div class="form-group" style="margin-top:1.25rem;">
          <label for="reviewer_areas">Áreas de atuação do revisor</label>
          <textarea id="reviewer_areas" name="reviewer_areas" placeholder="Ex.: Inteligência Artificial, Educação, Engenharia de Software"><%= user ? (user.reviewer_areas || '') : '' %></textarea>
          <small style="display:block;margin-top:0.4rem;color:#94a3b8;">Use vírgulas, ponto e vírgula ou quebra de linha. Essas áreas serão usadas para sugerir revisores compatíveis com a trilha do artigo.</small>
        </div>
      </div>

      <div class="form-actions">
        <a href="/admin/users" class="btn btn-ghost">Cancelar</a>
        <button type="submit" class="btn btn-primary"><%= user ? 'Salvar Alterações' : 'Criar Usuário' %></button>
      </div>
    </form>
  </main>

  <footer>&copy; <%= year %> LIGEM.Redes</footer>
  <script>
    document.querySelectorAll('.toggle-password').forEach(function(button) {
      button.addEventListener('click', function() {
        var input = document.getElementById(button.getAttribute('data-target'));
        var showing = input.type === 'text';
        input.type = showing ? 'password' : 'text';
        button.textContent = showing ? '👁' : '🙈';
        button.setAttribute('aria-label', showing ? 'Mostrar senha' : 'Ocultar senha');
      });
    });
  </script>
</body>
</html>
