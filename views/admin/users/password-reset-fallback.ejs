<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Senha temporária | Gerência de Eventos</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; }
    .topbar { background: var(--surface); border-bottom: 1px solid var(--border); backdrop-filter: blur(20px); padding: 0 2rem; height: 64px; display: flex; align-items: center; position: sticky; top: 0; z-index: 100; }
    .topbar-inner { width: 100%; max-width: 1600px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
    .logo { color: var(--text-strong); text-decoration: none; font-weight: 800; font-size: 1.1rem; }
    .logo span { color: #38bdf8; }
    .topbar-nav { display: flex; align-items: center; gap: 1rem; }
    .topbar-nav a { color: var(--text-muted); text-decoration: none; font-size: 0.9rem; }
    .topbar-nav a:hover, .topbar-nav a.active { color: var(--text-strong); }
    .session-pill { background: rgba(56,189,248,0.1); color: #7dd3fc; padding: 0.35rem 0.8rem; border-radius: 999px; font-size: 0.82rem; }
    .btn { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.55rem 1.1rem; border-radius: 8px; border: none; cursor: pointer; font-family: inherit; font-size: 0.9rem; font-weight: 600; text-decoration: none; }
    .btn-primary { background: #0ea5e9; color: #062033; }
    .btn-logout { background: transparent; color: var(--danger); border: 1px solid rgba(248,113,113,0.3); }
    main { max-width: 680px; margin: 0 auto; padding: 2.5rem 1.25rem; }
    .card { background: rgba(15,23,42,0.75); border: 1px solid rgba(148,163,184,0.12); border-radius: 16px; padding: 2rem; }
    h1 { font-size: 1.4rem; color: var(--text-strong); margin-bottom: 1rem; }
    .notice { background: rgba(245,158,11,0.12); border: 1px solid rgba(245,158,11,0.35); color: #fcd34d; border-radius: 10px; padding: 0.9rem 1rem; font-size: 0.9rem; line-height: 1.55; margin-bottom: 1.25rem; }
    .meta { color: var(--text-muted); font-size: 0.92rem; line-height: 1.7; margin-bottom: 1rem; }
    .meta strong { color: var(--text); }
    .pw { font-family: 'Consolas', monospace; font-size: 1.05rem; color: var(--text-strong); background: rgba(2,6,23,0.7); border: 1px solid rgba(148,163,184,0.25); border-radius: 10px; padding: 0.85rem 1.1rem; display: block; margin: 0.4rem 0 1.4rem; user-select: all; }
    .actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
    footer { text-align: center; color: var(--text-faint); font-size: 0.8rem; padding: 1.5rem; }
  </style>
  <%- include('../../partials/theme') %>
  <%- include('../../partials/mobile-fixes') %>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="logo"><span class="logo-icon">◆</span> Gerência de Eventos</a>
      <nav class="topbar-nav">
        <a href="/admin">Dashboard</a>
        <a href="/admin/events">Eventos</a>
        <a href="/admin/users" class="active">Usuários</a>
        <% if (userEmail) { %><span class="session-pill"><%= userEmail %></span><% } %>
        <form method="POST" action="/admin/logout" style="display:inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-logout">Sair</button>
        </form>
      </nav>
    </div>
  </header>
  <main>
    <div class="card">
      <h1>Senha temporária de <%= targetUser.name %></h1>
      <div class="notice"><%= reason %></div>
      <p class="meta"><strong>Conta:</strong> <%= targetUser.email || '(sem e-mail)' %><br>
      A senha abaixo substitui a anterior. O usuário será <strong>obrigado a trocá-la no primeiro acesso</strong>.</p>
      <span class="pw"><%= tempPassword %></span>
      <div class="actions">
        <a href="/admin/users" class="btn btn-primary">Voltar para Usuários</a>
      </div>
    </div>
  </main>
  <footer>&copy; <%= year %> LIGEM.Redes • <%= typeof appVersion !== 'undefined' ? appVersion : 'V0.1' %></footer>
  <%- include("../../partials/csrf-inject") %>
</body>
</html>
