<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Artigos LIGEM</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: #0a0f1a; color: #e2e8f0; min-height: 100vh; }
    .topbar { background: rgba(15,23,42,0.8); border-bottom: 1px solid rgba(148,163,184,0.1); backdrop-filter: blur(20px); padding: 0 2rem; height: 64px; display: flex; align-items: center; position: sticky; top: 0; z-index: 100; }
    .topbar-inner { width: 100%; max-width: 1400px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
    .logo { font-size: 1.25rem; font-weight: 700; color: #e2e8f0; text-decoration: none; }
    .logo-icon { color: #60a5fa; }
    .topbar-nav { display: flex; gap: 0.25rem; align-items: center; }
    .topbar-nav a { color: #94a3b8; padding: 0.5rem 0.75rem; border-radius: 6px; text-decoration: none; font-size: 0.875rem; font-weight: 500; }
    .topbar-nav a:hover { color: #e2e8f0; background: rgba(148,163,184,0.1); }
    .main-content { max-width: 1000px; margin: 0 auto; padding: 2rem; }
    .page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem; }
    .page-header h1 { font-size: 1.5rem; font-weight: 700; color: #f1f5f9; }
    .section { background: rgba(30,41,59,0.6); border: 1px solid rgba(148,163,184,0.1); border-radius: 12px; padding: 1.5rem; margin-bottom: 1.5rem; }
    .section h2 { font-size: 1rem; font-weight: 600; color: #f1f5f9; margin-bottom: 1rem; padding-bottom: 0.75rem; border-bottom: 1px solid rgba(148,163,184,0.1); }
    .detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
    .decision-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .detail-item { }
    .detail-label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; margin-bottom: 0.25rem; }
    .detail-value { font-size: 0.9375rem; color: #e2e8f0; }
    .badge { display: inline-block; padding: 0.2rem 0.6rem; border-radius: 9999px; font-size: 0.7rem; font-weight: 600; }
    .badge-submitted { background: rgba(96,165,250,0.15); color: #60a5fa; }
    .badge-draft { background: rgba(148,163,184,0.15); color: #cbd5e1; }
    .badge-in-review { background: rgba(251,191,36,0.15); color: #fbbf24; }
    .badge-approved { background: rgba(52,211,153,0.15); color: #34d399; }
    .badge-rejected { background: rgba(248,113,113,0.15); color: #f87171; }
    .badge-oral { background: rgba(167,139,250,0.15); color: #a78bfa; }
    .btn { display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.5rem 1rem; border-radius: 8px; font-size: 0.8125rem; font-weight: 500; cursor: pointer; border: none; text-decoration: none; }
    .btn-ghost { background: transparent; color: #94a3b8; border: 1px solid rgba(148,163,184,0.2); }
    .btn-ghost:hover { background: rgba(148,163,184,0.1); color: #e2e8f0; }
    .btn-primary { background: #3b82f6; color: white; }
    .btn-danger { background: rgba(239,68,68,0.15); color: #f87171; border: 1px solid rgba(239,68,68,0.2); }
    .btn-sm { padding: 0.3rem 0.6rem; font-size: 0.75rem; }
    .revisores-list { display: flex; flex-direction: column; gap: 0.5rem; }
    .revisor-item { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1rem; padding: 0.75rem; background: rgba(15,23,42,0.4); border-radius: 8px; border: 1px solid rgba(148,163,184,0.1); }
    .revisor-content { min-width: 0; }
    .revisor-info { font-size: 0.875rem; }
    .revisor-area { font-size: 0.75rem; color: #64748b; }
    .revisor-meta { color: #94a3b8; font-size: 0.78rem; margin-top: 0.25rem; }
    .revisor-actions { display: flex; gap: 0.5rem; align-items: center; align-self: start; }
    .revisor-tags { display: flex; gap: 0.35rem; flex-wrap: wrap; margin-top: 0.45rem; }
    .review-details { display: block; margin-top: 0.75rem; width: 100%; }
    .review-details summary { cursor: pointer; color: #93c5fd; font-size: 0.78rem; }
    .review-details[open] summary { margin-bottom: 0.6rem; }
    .review-report { display: block; width: 100%; white-space: pre-wrap; font-size: 0.84rem; color: #cbd5e1; line-height: 1.6; background: rgba(2,6,23,0.35); border: 1px solid rgba(148,163,184,0.12); border-radius: 10px; padding: 0.9rem; }
    .review-report-meta { display: block; width: 100%; color: #64748b; font-size: 0.72rem; margin-bottom: 0.45rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; line-height: 1.4; }
    .form-group { margin-bottom: 1rem; }
    .form-group label { display: block; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: #94a3b8; margin-bottom: 0.45rem; }
    .form-group select { width: 100%; padding: 0.7rem 0.85rem; border-radius: 8px; border: 1px solid rgba(148,163,184,0.18); background: rgba(15,23,42,0.5); color: #e2e8f0; font-size: 0.9rem; }
    .section-text { color: #94a3b8; line-height: 1.6; font-size: 0.9rem; margin-bottom: 1rem; }
    .alert { padding: 0.95rem 1rem; border-radius: 12px; margin-bottom: 1rem; font-size: 0.9rem; }
    .alert-success { background: rgba(34,197,94,0.1); border: 1px solid rgba(74,222,128,0.2); color: #86efac; }
    .alert-error { background: rgba(239,68,68,0.1); border: 1px solid rgba(248,113,113,0.25); color: #fca5a5; }
    .empty { color: #64748b; font-size: 0.875rem; font-style: italic; }
    a { color: #60a5fa; text-decoration: none; }
    footer { text-align: center; padding: 2rem; color: #475569; font-size: 0.75rem; }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="logo"><span class="logo-icon">◆</span> Artigos LIGEM</a>
      <nav class="topbar-nav">
        <a href="/admin">Dashboard</a>
        <a href="/admin/events">Eventos</a>
        <a href="/admin/users">Usuários</a>
        <form method="POST" action="/admin/logout" style="display:inline">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-ghost btn-sm">Sair</button></form>
      </nav>
    </div>
  </header>

  <main class="main-content">
    <% if (success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <div class="page-header">
      <h1><%= article.title %></h1>
      <div>
        <a href="/admin/articles?eventId=<%= article.event_id %>" class="btn btn-ghost btn-sm">← Voltar</a>
        <a href="/admin/articles/<%= article.id %>/download?eventId=<%= article.event_id %>" class="btn btn-primary btn-sm">📄 Baixar PDF</a>
      </div>
    </div>

    <div class="section">
      <h2>Informações</h2>
      <div class="detail-grid">
        <div class="detail-item">
          <div class="detail-label">Evento</div>
          <div class="detail-value"><%= article.event_name %></div>
        </div>
        <div class="detail-item">
          <div class="detail-label">Área</div>
          <div class="detail-value"><%= article.area %></div>
        </div>
        <div class="detail-item">
          <div class="detail-label">Tipo</div>
          <div class="detail-value"><span class="badge badge-<%= article.type %>"><%= article.type === 'oral' ? 'Oral' : 'Poster' %></span></div>
        </div>
        <div class="detail-item">
          <div class="detail-label">Status</div>
          <div class="detail-value"><span class="badge badge-<%= article.status %>"><%= article.status %></span></div>
        </div>
        <div class="detail-item">
          <div class="detail-label">Autores</div>
          <div class="detail-value"><%= article.authors || 'Não informados' %></div>
        </div>
        <div class="detail-item">
          <div class="detail-label">Submetido em</div>
          <div class="detail-value"><%= new Date(article.created_at).toLocaleString('pt-BR') %></div>
        </div>
      </div>
    </div>

    <div class="section">
      <h2>Deliberação Final Administrativa</h2>
      <p class="section-text">Após ler os pareceres e conferir o PDF do artigo, defina a decisão final e, se necessário, ajuste a modalidade de apresentação entre <strong>Oral</strong> e <strong>Pôster</strong>.</p>
      <form method="POST" action="/admin/articles/<%= article.id %>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">/final-decision">
        <input type="hidden" name="eventId" value="<%= article.event_id %>">
        <div class="decision-grid">
          <div class="form-group">
            <label for="final_status">Decisão Final</label>
            <select id="final_status" name="final_status" required>
              <option value="pending" <%= article.status === 'pending' ? 'selected' : '' %>>Pendente</option>
              <option value="in_review" <%= article.status === 'in_review' ? 'selected' : '' %>>Em análise</option>
              <option value="approved" <%= article.status === 'approved' ? 'selected' : '' %>>Aprovado</option>
              <option value="rejected" <%= article.status === 'rejected' ? 'selected' : '' %>>Rejeitado</option>
            </select>
          </div>
          <div class="form-group">
            <label for="presentation_type">Modalidade</label>
            <select id="presentation_type" name="presentation_type" required>
              <option value="oral" <%= article.type === 'oral' ? 'selected' : '' %>>Oral</option>
              <option value="poster" <%= article.type === 'poster' ? 'selected' : '' %>>Pôster</option>
            </select>
          </div>
        </div>
        <button type="submit" class="btn btn-primary">Salvar Deliberação Final</button>
      </form>
    </div>

    <div class="section">
      <h2>Revisores Atribuídos</h2>
      <div class="revisores-list">
        <% if (assignedReviewers.length > 0) { %>
          <% assignedReviewers.forEach(function(reviewer) { %>
          <div class="revisor-item">
            <div class="revisor-content">
              <div class="revisor-info"><%= reviewer.name %></div>
              <div class="revisor-meta"><%= reviewer.email %><% if (reviewer.institution) { %> • <%= reviewer.institution %><% } %></div>
              <% if (reviewer.report) { %>
              <details class="review-details">
                <summary>Ver texto do parecer</summary>
                <div class="review-report">
                  <div class="review-report-meta">
                    <% if (reviewer.report_updated_at || reviewer.reviewed_at) { %>
                      Parecer enviado em <%= new Date(reviewer.report_updated_at || reviewer.reviewed_at).toLocaleString('pt-BR') %>
                    <% } %>
                  </div>
                  <%= reviewer.report %>
                </div>
              </details>
              <% } %>
            </div>
            <div class="revisor-actions">
              <span class="badge badge-in-review"><%= reviewer.assignment_status === 'reviewed' ? 'Parecer enviado' : reviewer.assignment_status === 'accepted' ? 'Aceita' : reviewer.assignment_status === 'declined' ? 'Recusada' : 'Pendente' %></span>
              <% if (reviewer.recommendation) { %>
                <span class="badge <%= reviewer.recommendation === 'approved' ? 'badge-approved' : reviewer.recommendation === 'rejected' ? 'badge-rejected' : 'badge-in-review' %>">
                  <%= reviewer.recommendation === 'approved' ? 'Recomenda aprovação' : reviewer.recommendation === 'rejected' ? 'Recomenda rejeição' : 'Solicita revisão' %>
                </span>
              <% } %>
              <form method="POST" action="/admin/articles/<%= article.id %>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">/assign">
                <input type="hidden" name="reviewer_id" value="<%= reviewer.id %>">
                <input type="hidden" name="action" value="unassign">
                <input type="hidden" name="eventId" value="<%= article.event_id %>">
                <button type="submit" class="btn btn-danger btn-sm">Remover</button>
              </form>
            </div>
          </div>
          <% }) %>
        <% } else { %>
          <p class="empty">Nenhum revisor atribuído.</p>
        <% } %>
      </div>
    </div>

    <div class="section">
      <h2>Designar Revisores</h2>
      <div class="revisores-list">
        <% if (availableReviewers.length > 0) { %>
          <% availableReviewers.forEach(function(reviewer) { %>
          <div class="revisor-item">
            <div>
              <div class="revisor-info"><%= reviewer.name %></div>
              <div class="revisor-meta"><%= reviewer.email %><% if (reviewer.institution) { %> • <%= reviewer.institution %><% } %></div>
              <% if (reviewer.reviewer_area_list && reviewer.reviewer_area_list.length > 0) { %>
              <div class="revisor-tags">
                <% reviewer.reviewer_area_list.forEach(function(area) { %>
                <span class="badge badge-oral"><%= area %></span>
                <% }) %>
              </div>
              <% } %>
            </div>
            <div class="revisor-actions">
              <% if (reviewer.is_assigned) { %>
                <span class="badge badge-approved">Já atribuído</span>
              <% } else if (reviewer.matches_article_area) { %>
                <span class="badge badge-approved">Compatível com a trilha</span>
                <form method="POST" action="/admin/articles/<%= article.id %>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">/assign">
                  <input type="hidden" name="reviewer_id" value="<%= reviewer.id %>">
                  <input type="hidden" name="action" value="assign">
                  <input type="hidden" name="eventId" value="<%= article.event_id %>">
                  <button type="submit" class="btn btn-primary btn-sm">Atribuir</button>
                </form>
              <% } else { %>
                <span class="badge badge-draft">Sem aderência direta</span>
                <form method="POST" action="/admin/articles/<%= article.id %>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">/assign">
                  <input type="hidden" name="reviewer_id" value="<%= reviewer.id %>">
                  <input type="hidden" name="action" value="assign">
                  <input type="hidden" name="eventId" value="<%= article.event_id %>">
                  <button type="submit" class="btn btn-primary btn-sm">Atribuir</button>
                </form>
              <% } %>
            </div>
          </div>
          <% }) %>
        <% } else { %>
          <p class="empty">Não há revisores ativos disponíveis para designação.</p>
        <% } %>
      </div>
    </div>
  </main>

  <footer>&copy; <%= year %> LIGEM.Redes • <%= typeof appVersion !== 'undefined' ? appVersion : 'V0.1' %></footer>
</body>
</html>
