<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Artigos LIGEM</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: #0a0f1a; color: #e2e8f0; min-height: 100vh; }
    .topbar { background: rgba(15,23,42,0.8); border-bottom: 1px solid rgba(148,163,184,0.1); backdrop-filter: blur(20px); padding: 0 2rem; height: 64px; display: flex; align-items: center; position: sticky; top: 0; z-index: 100; }
    .topbar-inner { width: 100%; max-width: 1400px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
    .logo { font-size: 1.25rem; font-weight: 700; color: #e2e8f0; text-decoration: none; }
    .logo-icon { color: #60a5fa; }
    .topbar-nav { display: flex; gap: 0.25rem; align-items: center; }
    .topbar-nav a { color: #94a3b8; padding: 0.5rem 0.75rem; border-radius: 6px; text-decoration: none; font-size: 0.875rem; font-weight: 500; }
    .topbar-nav a:hover { color: #e2e8f0; background: rgba(148,163,184,0.1); }
    .main-content { max-width: 1400px; margin: 0 auto; padding: 2rem; }
    .page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem; }
    .page-header h1 { font-size: 1.75rem; font-weight: 700; color: #f1f5f9; }
    .page-header-copy p { margin-top: 0.4rem; color: #94a3b8; font-size: 0.92rem; }
    .section { background: rgba(30,41,59,0.6); border: 1px solid rgba(148,163,184,0.1); border-radius: 12px; overflow: hidden; }
    .filters { display: flex; gap: 0.75rem; align-items: end; padding: 1rem 1.25rem; border-bottom: 1px solid rgba(148,163,184,0.1); background: rgba(15,23,42,0.2); flex-wrap: wrap; }
    .filter-group label { display: block; margin-bottom: 0.4rem; color: #94a3b8; font-size: 0.8rem; }
    .filter-group select, .filter-group input { min-width: 220px; padding: 0.55rem 0.7rem; border-radius: 8px; border: 1px solid rgba(148,163,184,0.2); background: rgba(15,23,42,0.5); color: #e2e8f0; font-size: 0.85rem; }
    .filters-actions { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
    table { width: 100%; border-collapse: collapse; }
    th { text-align: left; padding: 0.75rem 1.5rem; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; background: rgba(15,23,42,0.3); }
    td { padding: 0.75rem 1.5rem; font-size: 0.875rem; color: #cbd5e1; border-top: 1px solid rgba(148,163,184,0.05); }
    tr:hover td { background: rgba(148,163,184,0.03); }
    .badge { display: inline-block; padding: 0.2rem 0.6rem; border-radius: 9999px; font-size: 0.7rem; font-weight: 600; }
    .badge-submitted { background: rgba(96,165,250,0.15); color: #60a5fa; }
    .badge-in-review { background: rgba(251,191,36,0.15); color: #fbbf24; }
    .badge-approved { background: rgba(52,211,153,0.15); color: #34d399; }
    .badge-rejected { background: rgba(248,113,113,0.15); color: #f87171; }
    .badge-oral { background: rgba(167,139,250,0.15); color: #a78bfa; }
    .badge-poster { background: rgba(56,189,248,0.15); color: #38bdf8; }
    .badge-area { background: rgba(96,165,250,0.14); color: #93c5fd; }
    .badge-missing-area { background: rgba(248,113,113,0.14); color: #fda4af; border: 1px solid rgba(248,113,113,0.22); }
    .btn { display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.3rem 0.7rem; border-radius: 8px; font-size: 0.75rem; font-weight: 500; cursor: pointer; border: none; transition: all 0.15s; text-decoration: none; }
    .btn-ghost { background: transparent; color: #94a3b8; border: 1px solid rgba(148,163,184,0.2); }
    .btn-ghost:hover { background: rgba(148,163,184,0.1); color: #e2e8f0; }
    .btn-primary { background: #3b82f6; color: white; }
    .btn-danger { background: rgba(239,68,68,0.15); color: #f87171; border: 1px solid rgba(239,68,68,0.2); }
    .btn-sm { padding: 0.25rem 0.5rem; font-size: 0.7rem; }
    .session-pill { padding: 0.42rem 0.78rem; border: 1px solid rgba(148,163,184,0.18); border-radius: 999px; color: #e2e8f0; font-size: 0.82rem; }
    .btn-logout { background: transparent; color: #f87171; border: 1px solid rgba(248,113,113,0.25); font-family: inherit; cursor: pointer; }
    .btn-secondary { background: rgba(148,163,184,0.12); color: #e2e8f0; border: 1px solid rgba(148,163,184,0.18); text-decoration: none; }
    .btn-secondary:hover { background: rgba(148,163,184,0.2); }
    .actions { display: flex; gap: 0.375rem; }
    a { color: #60a5fa; text-decoration: none; }
    .modal-backdrop { position: fixed; inset: 0; background: rgba(2,6,23,0.72); display: none; align-items: center; justify-content: center; padding: 1.5rem; z-index: 1200; }
    .modal-backdrop.visible { display: flex; }
    .modal-card { width: 100%; max-width: 420px; background: rgba(15,23,42,0.98); border: 1px solid rgba(148,163,184,0.18); border-radius: 18px; padding: 1.5rem; box-shadow: 0 30px 80px rgba(2,6,23,0.5); }
    .modal-card h2 { color: #f8fafc; font-size: 1.15rem; margin-bottom: 0.7rem; }
    .modal-card p { color: #94a3b8; line-height: 1.65; margin-bottom: 1.25rem; }
    .modal-actions { display: flex; justify-content: flex-end; gap: 0.75rem; flex-wrap: wrap; }
    footer { text-align: center; padding: 2rem; color: #475569; font-size: 0.75rem; }
    .status-select { padding: 0.3rem 0.5rem; border-radius: 6px; border: 1px solid rgba(148,163,184,0.2); background: rgba(15,23,42,0.5); color: #e2e8f0; font-size: 0.8rem; }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="logo"><span class="logo-icon">◆</span> Artigos LIGEM</a>
      <nav class="topbar-nav">
        <a href="/admin">Dashboard</a>
        <a href="/admin/events">Eventos</a>
        <a href="/admin/users">Usuários</a>
        <form method="POST" action="/admin/logout" style="display:inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-logout">Sair</button>
        </form>
      </nav>
    </div>
  </header>

  <main class="main-content">
    <div class="page-header">
      <div class="page-header-copy">
        <h1>Artigos - <%= event.name %></h1>
        <p>Mostrando <strong><%= filteredCount %></strong> de <strong><%= totalArticles %></strong> artigo(s).</p>
      </div>
      <div class="actions">
        <a href="/admin/articles/download-all?eventId=<%= event.id %>" class="btn btn-primary btn-sm">⇩ Baixar todos os PDFs</a>
        <a href="/admin/events" class="btn btn-ghost btn-sm">← Voltar</a>
      </div>
    </div>

    <div class="section">
      <form method="GET" class="filters">
        <input type="hidden" name="eventId" value="<%= event.id %>">
        <div class="filter-group">
          <label for="area">Filtrar por Área / Trilha</label>
          <select id="area" name="area" onchange="this.form.submit()">
            <option value="all" <%= !filters || filters.area === 'all' ? 'selected' : '' %>>Todas as áreas</option>
            <% availableAreas.forEach(function(area) { %>
              <option value="<%= area %>" <%= filters && filters.area === area ? 'selected' : '' %>><%= area %></option>
            <% }) %>
          </select>
        </div>
        <div class="filter-group">
          <label for="type">Filtrar por Modalidade</label>
          <select id="type" name="type" onchange="this.form.submit()">
            <option value="all" <%= !filters || filters.type === 'all' ? 'selected' : '' %>>Todas as modalidades</option>
            <option value="oral" <%= filters && filters.type === 'oral' ? 'selected' : '' %>>Oral</option>
            <option value="poster" <%= filters && filters.type === 'poster' ? 'selected' : '' %>>Poster</option>
          </select>
        </div>
        <div class="filter-group">
          <label for="status">Filtrar por Status</label>
          <select id="status" name="status" onchange="this.form.submit()">
            <option value="all" <%= !filters || filters.status === 'all' ? 'selected' : '' %>>Todos os status</option>
            <option value="pending" <%= filters && filters.status === 'pending' ? 'selected' : '' %>>Pendente</option>
            <option value="in_review" <%= filters && filters.status === 'in_review' ? 'selected' : '' %>>Em análise</option>
            <option value="approved" <%= filters && filters.status === 'approved' ? 'selected' : '' %>>Aprovado</option>
            <option value="rejected" <%= filters && filters.status === 'rejected' ? 'selected' : '' %>>Rejeitado</option>
          </select>
        </div>
        <div class="filter-group">
          <label for="q">Buscar por Título</label>
          <input id="q" name="q" type="text" value="<%= filters ? filters.q : '' %>" placeholder="Digite parte do título">
        </div>
        <div class="filter-group">
          <label for="sort">Ordenar por</label>
          <select id="sort" name="sort" onchange="this.form.submit()">
            <option value="date_desc" <%= filters && filters.sort === 'date_desc' ? 'selected' : '' %>>Data mais recente</option>
            <option value="date_asc" <%= filters && filters.sort === 'date_asc' ? 'selected' : '' %>>Data mais antiga</option>
            <option value="title_asc" <%= filters && filters.sort === 'title_asc' ? 'selected' : '' %>>Título A-Z</option>
            <option value="title_desc" <%= filters && filters.sort === 'title_desc' ? 'selected' : '' %>>Título Z-A</option>
            <option value="area_asc" <%= filters && filters.sort === 'area_asc' ? 'selected' : '' %>>Área A-Z</option>
            <option value="area_desc" <%= filters && filters.sort === 'area_desc' ? 'selected' : '' %>>Área Z-A</option>
          </select>
        </div>
        <div class="filters-actions">
          <button type="submit" class="btn btn-primary btn-sm">Aplicar</button>
          <% if (filters && (filters.area !== 'all' || filters.type !== 'all' || filters.status !== 'all' || filters.q || filters.sort !== 'date_desc')) { %>
            <a href="/admin/articles?eventId=<%= event.id %>" class="btn btn-ghost btn-sm">Limpar filtros</a>
          <% } %>
        </div>
      </form>
      <table>
        <thead>
          <tr><th>Título</th><th>Área / Trilha</th><th>Tipo</th><th>Status</th><th>Data</th><th>Ações</th></tr>
        </thead>
        <tbody>
          <% articles.forEach(a => { %>
          <tr>
            <td><a href="/admin/articles/<%= a.id %>?eventId=<%= event.id %>"><%= a.title %></a></td>
            <td>
              <% if (a.area && a.area.trim()) { %>
                <span class="badge badge-area"><%= a.area %></span>
              <% } else { %>
                <span class="badge badge-missing-area">Sem área informada</span>
              <% } %>
            </td>
            <td><span class="badge badge-<%= a.type %>"><%= a.type === 'oral' ? 'Oral' : 'Poster' %></span></td>
            <td><span class="badge badge-<%= a.status %>"><%= a.status_label %></span></td>
            <td><%= new Date(a.created_at).toLocaleDateString('pt-BR') %></td>
            <td class="actions">
              <select class="status-select" onchange="changeStatus(<%= a.id %>, this.value)">
                <option value="pending" <%= a.status === 'pending' ? 'selected' : '' %>>Pendente</option>
                <option value="in_review" <%= a.status === 'in_review' ? 'selected' : '' %>>Em análise</option>
                <option value="approved" <%= a.status === 'approved' ? 'selected' : '' %>>Aprovado</option>
                <option value="rejected" <%= a.status === 'rejected' ? 'selected' : '' %>>Rejeitado</option>
              </select>
              <a href="/admin/articles/<%= a.id %>/download?eventId=<%= event.id %>" class="btn btn-ghost btn-sm">📄</a>
              <button type="button" class="btn btn-danger btn-sm" data-delete-article data-article-id="<%= a.id %>" data-event-id="<%= event.id %>">✕</button>
            </td>
          </tr>
          <% }) %>
          <% if (!articles.length) { %>
          <tr>
            <td colspan="6" style="color:#94a3b8;">Nenhum artigo encontrado para o filtro selecionado.</td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </main>

  <div class="modal-backdrop" id="delete-modal" aria-hidden="true">
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="delete-modal-title">
      <h2 id="delete-modal-title">Excluir artigo</h2>
      <p>Essa ação remove o artigo e o arquivo PDF associado. Deseja continuar?</p>
      <div class="modal-actions">
        <button type="button" class="btn btn-ghost" id="delete-cancel-btn">Cancelar</button>
        <button type="button" class="btn btn-danger" id="delete-confirm-btn">Excluir</button>
      </div>
    </div>
  </div>

  <footer>&copy; <%= year %> LIGEM.Redes • <%= typeof appVersion !== 'undefined' ? appVersion : 'V0.1' %></footer>

  <script>
    let pendingDelete = null;
    const deleteModal = document.getElementById('delete-modal');
    const deleteCancelBtn = document.getElementById('delete-cancel-btn');
    const deleteConfirmBtn = document.getElementById('delete-confirm-btn');

    function changeStatus(id, status) {
      fetch('/admin/articles/' + id, { method: 'PUT', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({status}) });
    }

    function openDeleteModal(id, eventId) {
      pendingDelete = { id, eventId };
      deleteModal.classList.add('visible');
      deleteModal.setAttribute('aria-hidden', 'false');
      deleteConfirmBtn.focus();
    }

    function closeDeleteModal() {
      pendingDelete = null;
      deleteModal.classList.remove('visible');
      deleteModal.setAttribute('aria-hidden', 'true');
    }

    async function deleteArticle(id, eventId) {

      try {
        const response = await fetch('/admin/articles/' + id + '?eventId=' + eventId, {
          method: 'DELETE',
          headers: {
            'Accept': 'application/json'
          }
        });

        if (!response.ok) {
          throw new Error('Falha ao excluir o artigo.');
        }

        const result = await response.json();
        if (!result || !result.success) {
          throw new Error('Falha ao excluir o artigo.');
        }

        location.reload();
      } catch (error) {
        alert(error.message || 'Nao foi possivel excluir o artigo.');
      }
    }

    document.querySelectorAll('[data-delete-article]').forEach(function(button) {
      button.addEventListener('click', function() {
        openDeleteModal(button.getAttribute('data-article-id'), button.getAttribute('data-event-id'));
      });
    });

    deleteCancelBtn.addEventListener('click', closeDeleteModal);
    deleteConfirmBtn.addEventListener('click', async function() {
      if (!pendingDelete) return;
      const currentDelete = pendingDelete;
      closeDeleteModal();
      await deleteArticle(currentDelete.id, currentDelete.eventId);
    });

    deleteModal.addEventListener('click', function(event) {
      if (event.target === deleteModal) {
        closeDeleteModal();
      }
    });

    document.addEventListener('keydown', function(event) {
      if (event.key === 'Escape' && deleteModal.classList.contains('visible')) {
        closeDeleteModal();
      }
    });
  </script>
</body>
</html>
