<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Gerência de Eventos</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--text);margin:0}
    .topbar { background: var(--surface-elevated); border-bottom: 1px solid var(--border-strong); backdrop-filter: blur(20px); padding: 0 2rem; height: 64px; display: flex; align-items: center; position: sticky; top: 0; z-index: 100; }
    .topbar-inner { width: 100%; max-width: 1400px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
    .logo { font-size: 1.25rem; font-weight: 700; color: var(--text); text-decoration: none; }
    .logo-icon { color: var(--accent); }
    .topbar-nav { display: flex; gap: 0.25rem; align-items: center; }
    .topbar-nav a { color: var(--text-muted); padding: 0.5rem 0.75rem; border-radius: 6px; text-decoration: none; font-size: 0.875rem; font-weight: 500; }
    .topbar-nav a:hover { color: var(--text); background: var(--surface-hover); }
    .main-content { max-width: 900px; margin: 0 auto; padding: 2rem 1.25rem; }
    .hero h1 { font-size: 1.75rem; font-weight: 800; color: var(--text-strong); margin-bottom: 0.5rem; }
    .hero p { color: var(--text-muted); line-height: 1.7; }
    .btn-secondary { background: var(--surface-hover); color: var(--text); border: 1px solid var(--border-strong); text-decoration: none; padding: 0.5rem 1rem; border-radius: 8px; font-size: 0.875rem; display: inline-block; }
    .people-list { list-style: none; margin: 2rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 1rem; }
    .person { display: flex; gap: 1.25rem; padding: 1.25rem; border: 1px solid var(--border); border-radius: 14px; background: var(--surface-elevated); }
    .photo-circle { width: 88px; height: 88px; border-radius: 50%; overflow: hidden; background: var(--surface-input); border: 2px solid var(--border-strong); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .photo-circle img { width: 100%; height: 100%; object-fit: cover; }
    .photo-circle .photo-initial { font-size: 1.75rem; font-weight: 700; color: var(--text-faint); }
    .person-body { flex: 1; min-width: 0; }
    .person-name { font-size: 1.1rem; font-weight: 700; color: var(--text-strong); }
    .person-role { display: inline-block; margin-left: 0.5rem; padding: 0.12rem 0.6rem; border-radius: 999px; font-size: 0.7rem; font-weight: 700; background: var(--surface-selected); color: var(--link); vertical-align: middle; }
    .person-inst { color: var(--text-muted); font-size: 0.82rem; margin-top: 0.2rem; }
    .person-bio { color: var(--text); font-size: 0.9rem; line-height: 1.6; margin-top: 0.6rem; white-space: pre-line; }
    .empty { color: var(--text-faint); font-size: 0.875rem; padding: 2rem 0; text-align: center; }
    footer { text-align: center; padding: 2rem; color: var(--text-faint); font-size: 0.75rem; }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }
    @media (max-width: 720px) {
      .topbar { height: auto; padding: 1rem 1.25rem; }
      .topbar-inner { gap: 1rem; flex-wrap: wrap; }
      .person { flex-direction: column; }
    }
  </style>
  <%- include('../partials/theme') %>
  <%- include('../partials/mobile-fixes') %>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="logo"><span class="logo-icon">◆</span> Gerência de Eventos</a>
      <nav class="topbar-nav">
        <a href="/<%= typeof isAdmin !== 'undefined' && (isAdmin || isEventAdmin) ? 'admin/dashboard' : 'author' %>" class="btn-secondary"><%= (typeof isAdmin !== 'undefined' && (isAdmin || isEventAdmin)) ? 'Dashboard' : 'Área do Participante' %></a>
      </nav>
    </div>
  </header>

  <main class="main-content">
    <div class="hero">
      <h1>Palestrantes e Professores</h1>
      <p><%= activity.name %> · <a href="/evento/<%= event.id %>"><%= event.name %></a></p>
    </div>

    <% if (people.length === 0) { %>
      <div class="empty">Nenhum professor/palestrante vinculado a esta atividade ainda.</div>
    <% } else { %>
    <ul class="people-list">
      <% people.forEach(function (p) { %>
        <li class="person">
          <div class="photo-circle">
            <% if (p.photo_path) { %><img src="/<%= p.photo_path %>" alt="Foto de <%= p.name %>"><% } else { %><span class="photo-initial"><%= (String(p.name).trim()[0] || '◆').toUpperCase() %></span><% } %>
          </div>
          <div class="person-body">
            <div class="person-name"><%= p.name %><span class="person-role"><%= roleLabels[p.role] || p.role %></span></div>
            <% if (p.institution) { %><div class="person-inst"><%= p.institution %></div><% } %>
            <% if (p.mini_bio) { %><div class="person-bio"><%= p.mini_bio %></div><% } %>
          </div>
        </li>
      <% }) %>
    </ul>
    <% } %>
  </main>

  <footer>&copy; <%= typeof year !== 'undefined' ? year : new Date().getFullYear() %> LIGEM.Redes • <%= typeof appVersion !== 'undefined' ? appVersion : '' %></footer>
</body>
</html>
