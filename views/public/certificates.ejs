<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><style>body{font-family:Arial;background:var(--bg);color:var(--text);margin:0}main{max-width:900px;margin:auto;padding:2rem}.card{background:var(--surface-2);border:1px solid var(--border);border-radius:10px;padding:1rem;margin:1rem 0}a{color:var(--link)}</style>  <%- include('../partials/theme') %>
  <%- include('../partials/mobile-fixes') %>
</head><body><main><p><a href="/author">← Área do participante</a></p><h1>Meus Certificados</h1><% if(!certificates.length){ %><p>Nenhum certificado emitido.</p><% } %><% certificates.forEach(c=>{ %><section class="card"><h2><%= c.event_name %></h2><p>Versão <%= c.version %> · Código: <%= c.certificate_code %></p><% if(c.window.isOpen){ %><a href="/author/certificates/<%= c.id %>/download">Baixar certificado em PDF</a><% } else { %><p><%= c.window.message %></p><% } %></section><% }) %></main></body></html>
