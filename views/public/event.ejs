<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= event.name %> - Submissão de Artigos</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: #0a0f1a; color: #e2e8f0; min-height: 100vh; }
    .topbar { background: rgba(15,23,42,0.8); border-bottom: 1px solid rgba(148,163,184,0.1); backdrop-filter: blur(20px); padding: 0 2rem; height: 64px; display: flex; align-items: center; position: sticky; top: 0; z-index: 100; }
    .topbar-inner { width: 100%; max-width: 1400px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
    .logo { font-size: 1.25rem; font-weight: 700; color: #e2e8f0; text-decoration: none; }
    .logo-icon { color: #60a5fa; }
    .topbar-nav { display:flex; gap:0.4rem; align-items:center; flex-wrap:wrap; }
    .topbar-nav a { color: #94a3b8; padding: 0.5rem 0.75rem; border-radius: 6px; text-decoration: none; font-size: 0.875rem; font-weight: 500; transition:all 0.15s; }
    .topbar-nav a:hover { color: #e2e8f0; background: rgba(148,163,184,0.1); }
    .main-content { max-width: 1568px; margin: 0 auto; padding: 2rem; }
    .event-shell { background: rgba(30,41,59,0.58); border: 1px solid rgba(148,163,184,0.1); border-radius: 18px; padding: 2rem; margin-bottom: 1.5rem; }
    .event-header .area { display: inline-block; background: rgba(167,139,250,0.15); color: #a78bfa; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; margin-bottom: 0.9rem; }
    .event-header .event-logo { display: block; max-height: 96px; max-width: 320px; object-fit: contain; background: #fff; border-radius: 10px; padding: 10px; margin-bottom: 1rem; }
    .event-header h1 { font-size: 2rem; font-weight: 800; color: #f8fafc; margin-bottom: 0.4rem; }
    .event-meta { color: #94a3b8; font-size: 0.94rem; line-height: 1.7; }
    .event-description { color: #cbd5e1; line-height: 1.7; font-size: 0.95rem; margin-top: 1rem; }
    .event-link-card { margin-top: 1.25rem; padding: 1rem 1.1rem; border-radius: 12px; background: rgba(59,130,246,0.08); border: 1px solid rgba(96,165,250,0.18); }
    .event-link-card .label { display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: #93c5fd; margin-bottom: 0.45rem; }
    .event-link-card .value { font-size: 0.98rem; font-weight: 600; color: #f8fafc; word-break: break-word; }
    .event-link-card .value a { color: #93c5fd; text-decoration: none; }
    .event-link-card .value a:hover { text-decoration: underline; }
    .timeline-title { font-size: 1rem; font-weight: 700; color: #f8fafc; margin: 1.5rem 0 0.85rem; letter-spacing: 0.04em; text-transform: uppercase; }
    .timeline-table-wrap { border: 1px solid rgba(148,163,184,0.12); border-radius: 14px; overflow: hidden; background: rgba(2,6,23,0.3); }
    .timeline-table { width: 100%; border-collapse: collapse; }
    .timeline-table th { text-align: left; padding: 0.9rem 1rem; font-size: 0.76rem; text-transform: uppercase; letter-spacing: 0.05em; color: #94a3b8; background: rgba(15,23,42,0.6); }
    .timeline-table td { padding: 1rem; font-size: 0.94rem; color: #e2e8f0; border-top: 1px solid rgba(148,163,184,0.08); }
    .timeline-table tr:first-child td { border-top: none; }
    .timeline-label { font-weight: 700; color: #f8fafc; }
    .muted { color: #94a3b8; }
    .timeline-action { white-space: nowrap; }
    .timeline-status { display: inline-flex; align-items: center; padding: 0.32rem 0.75rem; border-radius: 999px; font-size: 0.74rem; font-weight: 700; border: 1px solid transparent; }
    .timeline-status.status-positive { background: rgba(34,197,94,0.13); color: #4ade80; border-color: rgba(74,222,128,0.16); }
    .timeline-status.status-neutral { background: rgba(96,165,250,0.12); color: #93c5fd; border-color: rgba(147,197,253,0.18); }
    .timeline-status.status-negative { background: rgba(248,113,113,0.12); color: #fca5a5; border-color: rgba(252,165,165,0.18); }
    .timeline-status.status-muted { background: rgba(148,163,184,0.14); color: #cbd5e1; border-color: rgba(203,213,225,0.14); }
    .btn { display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.625rem 1.25rem; border-radius: 8px; font-size: 0.875rem; font-weight: 500; cursor: pointer; border: none; text-decoration: none; }
    .btn-primary { background: #3b82f6; color: white; }
    .btn-primary:hover { background: #2563eb; }
    .btn-secondary { background: rgba(148,163,184,0.12); color: #e2e8f0; border: 1px solid rgba(148,163,184,0.18); }
    .btn-secondary:hover { background: rgba(148,163,184,0.2); }
    .activity-video { padding: 0.4rem 0.85rem; font-size: 0.78rem; white-space: nowrap; }
    .timeline-table tr.session-row td { background: rgba(15,23,42,0.25); padding-top: 0.6rem; padding-bottom: 0.6rem; font-size: 0.86rem; color: #94a3b8; }
    .timeline-table tr.session-row .timeline-label { font-weight: 500; color: #94a3b8; padding-left: 1.5rem; }
    .session-pill { padding: 0.42rem 0.78rem; border: 1px solid rgba(148,163,184,0.18); border-radius: 999px; color: #e2e8f0; font-size: 0.82rem; }
    .btn-logout { background: transparent; color: #f87171; border: 1px solid rgba(248,113,113,0.25); font-family: inherit; }
    .closed-notice { margin: 0 0 1.5rem; padding: 0.9rem 1.1rem; border-radius: 10px; background: rgba(251,191,36,0.1); border: 1px solid rgba(251,191,36,0.25); color: #fde68a; font-size: 0.9rem; line-height: 1.6; }
    .closed-notice strong { color: #fbbf24; }
    footer { text-align: center; padding: 2rem; color: #475569; font-size: 0.75rem; }
    @media (max-width: 860px) {
      .main-content { padding: 1rem; }
      .event-shell { padding: 1.25rem; }
      .timeline-table th, .timeline-table td { padding: 0.75rem; font-size: 0.82rem; }
    }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="logo"><span class="logo-icon">◆</span> Gerência de Eventos</a>
      <nav class="topbar-nav">
        <a href="/">← Eventos</a>
        <% if (userEmail) { %>
          <a href="<%= isAdmin ? '/admin/dashboard' : isReviewer ? '/reviewer' : '/author' %>" class="btn btn-secondary"><%= isAdmin ? 'Dashboard' : isReviewer ? 'Revisor' : 'Área do Participante' %></a>
          <span class="session-pill"><%= userEmail %></span>
          <form method="POST" action="<%= isAdmin ? '/admin/logout' : isReviewer ? '/reviewer/logout' : '/login/logout' %>" style="display:inline;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-logout">Sair</button>
          </form>
        <% } %>
      </nav>
    </div>
  </header>

  <main class="main-content">
    <div class="event-shell">
      <div class="event-header">
        <% if (event.logo_path) { %>
          <img src="/uploads/event-logos/<%= String(event.logo_path).split('/').pop() %>" alt="" class="event-logo">
        <% } %>
        <span class="area"><%= event.area_display %></span>
        <h1><%= event.name %></h1>
        <div class="event-meta">
          <% if (event.location) { %><div><strong style="color:#cbd5e1;">Local:</strong> <%= event.location %></div><% } %>
          <% if (event.formattedDateStart) { %>
            <div><strong style="color:#cbd5e1;">Período do evento:</strong> <%= event.formattedDateStart %><% if (event.formattedDateEnd) { %> - <%= event.formattedDateEnd %><% } %></div>
          <% } %>
        </div>
        <div class="event-link-card">
          <span class="label"><%= event.content_pdf_path ? 'Conteúdo do Evento' : 'URL do Evento' %></span>
          <div class="value">
            <% if (event.content_pdf_path) { %>
              <a href="/evento/<%= event.id %>/conteudo">Abrir página do evento</a>
              <% if (event.url && event.url.trim()) { %>
                <span style="margin:0 0.5rem;color:#64748b;">•</span><a href="<%= event.url %>" target="_blank" rel="noopener noreferrer">Site externo</a>
              <% } %>
            <% } else if (event.url && event.url.trim()) { %>
              <a href="<%= event.url %>" target="_blank" rel="noopener noreferrer"><%= event.url %></a>
            <% } else { %>
              TBD
            <% } %>
          </div>
        </div>
        <% if (event.description) { %>
          <p class="event-description"><%= event.description %></p>
        <% } %>
      </div>

      <% if (event.status === 'encerrado') { %>
        <div class="closed-notice">
          <strong>Evento encerrado.</strong> Este evento já foi realizado. Inscrições e submissões de artigos não estão mais disponíveis, mas você pode consultar o cronograma e, se houver participações registradas, acessar seus certificados.
        </div>
      <% } %>

      <div class="timeline-title">Cronograma</div>
      <div class="timeline-table-wrap">
        <table class="timeline-table">
          <thead>
            <tr>
              <th>Cronograma</th>
              <th>Data Início</th>
              <th>Data Fim</th>
              <th>Status</th>
              <th>Ação</th>
            </tr>
          </thead>
          <tbody>
            <% timeline.forEach(function(item) { %>
              <tr>
                <td class="timeline-label"><%= item.label %></td>
                <td class="muted"><%= item.startLabel %></td>
                <td class="muted"><%= item.endLabel %></td>
                <td><span class="timeline-status <%= item.statusTone %>"><%= item.status %></span></td>
                <td class="timeline-action">
                  <% if (item.actionHref) { %>
                    <a
                      href="<%= item.actionHref %>"
                      class="btn <%= item.actionTone === 'primary' ? 'btn-primary' : 'btn-secondary' %>"
                      <%= item.actionExternal ? 'target="_blank" rel="noopener noreferrer"' : '' %>
                    ><%= item.actionLabel %></a>
                  <% } else { %>
                    <span class="muted">-</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <% if (activities && activities.length) { %>
        <%
          var actOcc = [];
          activities.forEach(function(a){
            if (a.sessions && a.sessions.length) {
              a.sessions.forEach(function(s){ if (s.session_date && s.time_start) actOcc.push({ day: s.session_date, hour: String(s.time_start).slice(0,2), name: a.name + ' : ' + s.name }); });
            } else if (a.date_start && a.time_start) {
              actOcc.push({ day: a.date_start, hour: String(a.time_start).slice(0,2), name: a.name });
            }
          });
          var gridDays = Array.from(new Set(actOcc.map(function(o){ return o.day; }))).sort();
          var gridHours = Array.from(new Set(actOcc.map(function(o){ return o.hour; }))).sort();
          var gridCell = {};
          actOcc.forEach(function(o){ var k = o.day + '|' + o.hour; (gridCell[k] = gridCell[k] || []).push(o.name); });
          var hasActivityGrid = gridDays.length > 0 && gridHours.length > 0;
          var actTypeMap = { lecture:'Palestra', seminar:'Seminário', roundtable:'Mesa-redonda', course:'Minicurso', oral_presentation:'Apresentação oral', poster_presentation:'Apresentação pôster', other:'Outra' };
          var actTypeOrder = ['lecture','seminar','roundtable','course','oral_presentation','poster_presentation','other'];
          var actTypeStyle = { lecture:['#312e81','#a5b4fc'], seminar:['#164e63','#67e8f9'], roundtable:['#365314','#84cc16'], course:['#78350f','#fdba74'], oral_presentation:['#7f1d1d','#fca5a5'], poster_presentation:['#581c87','#d8b4fe'], other:['#1e293b','#94a3b8'] };
          var actByType = {};
          activities.forEach(function(a){ var t = a.activity_type || 'other'; (actByType[t] = actByType[t] || []).push(a); });
        %>
        <div class="timeline-title">Atividades do Evento</div>
        <div class="activities-toggle-block">
          <style>
            .activities-toggle-block .activities-radio { position:absolute;opacity:0;pointer-events:none; }
            .activities-toggle-block .activities-toggle { display:flex;gap:8px;margin-bottom:12px; }
            .activities-toggle-block .activities-toggle label { padding:6px 14px;border:1px solid rgba(148,163,184,.35);border-radius:999px;font-size:.8rem;color:#cbd5e1;cursor:pointer; }
            .activities-toggle-block #activities-view-cards:checked ~ .activities-toggle label[for="activities-view-cards"],
            .activities-toggle-block #activities-view-list:checked ~ .activities-toggle label[for="activities-view-list"],
            .activities-toggle-block #activities-view-grid:checked ~ .activities-toggle label[for="activities-view-grid"] { background:rgba(59,130,246,.25);border-color:#60a5fa;color:#fff; }
            .activities-toggle-block .activities-view { display:none; }
            .activities-toggle-block #activities-view-cards:checked ~ .activities-view-cards,
            .activities-toggle-block #activities-view-list:checked ~ .activities-view-list,
            .activities-toggle-block #activities-view-grid:checked ~ .activities-view-grid { display:block; }
            .activities-toggle-block .act-cards { display:flex; flex-direction:column; gap:16px; }
            .activities-toggle-block .act-type-card { background:#1e293b; border-radius:10px; padding:16px; }
            .activities-toggle-block .act-type-head { margin:0 0 12px; font-size:1rem; display:flex; align-items:center; gap:8px; }
            .activities-toggle-block .act-type-count { color:#94a3b8; font-weight:400; font-size:.85rem; }
            .activities-toggle-block .act-badge { display:inline-block; padding:4px 10px; border-radius:999px; font-size:11px; font-weight:600; letter-spacing:.3px; text-transform:uppercase; }
            .activities-toggle-block .act-type-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:10px; }
            .activities-toggle-block .act-item { background:#0f172a; padding:12px 14px; border-radius:8px; border:1px solid #334155; display:flex; flex-direction:column; gap:5px; }
            .activities-toggle-block .act-item-title { font-size:14px; color:#f1f5f9; }
            .activities-toggle-block .act-item-desc, .activities-toggle-block .act-item-meta { color:#94a3b8; font-size:12px; line-height:1.5; }
            .activities-toggle-block .act-item-actions { display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin-top:4px; }
            .activities-toggle-block .grid-wrap { border:1px solid rgba(148,163,184,0.12); border-radius:14px; background:rgba(2,6,23,0.3); overflow-x:auto; }
            .activities-toggle-block .grid-table { width:100%; border-collapse:collapse; min-width:520px; }
            .activities-toggle-block .grid-table th, .activities-toggle-block .grid-table td { border:1px solid rgba(148,163,184,0.1); padding:0.6rem 0.7rem; font-size:0.82rem; text-align:center; vertical-align:top; }
            .activities-toggle-block .grid-table thead th { background:rgba(15,23,42,0.6); color:#94a3b8; text-transform:uppercase; letter-spacing:0.04em; font-size:0.72rem; }
            .activities-toggle-block .grid-table tbody th { background:rgba(15,23,42,0.6); color:#94a3b8; white-space:nowrap; font-weight:600; text-align:left; }
            .activities-toggle-block .grid-table td .grid-item { display:block; color:#f8fafc; }
            .activities-toggle-block .grid-table td .grid-item + .grid-item { margin-top:6px; padding-top:6px; border-top:1px dashed rgba(148,163,184,0.15); }
          </style>
          <input type="radio" name="activities-view" id="activities-view-cards" class="activities-radio" checked>
          <input type="radio" name="activities-view" id="activities-view-list" class="activities-radio">
          <input type="radio" name="activities-view" id="activities-view-grid" class="activities-radio">
          <div class="activities-toggle">
            <label for="activities-view-cards">Cards</label>
            <label for="activities-view-list">Lista</label>
            <label for="activities-view-grid">Grade (dia × hora)</label>
          </div>
          <div class="activities-view activities-view-cards">
            <div class="act-cards">
              <% actTypeOrder.forEach(function(type){ var items = actByType[type]; if (!items) return; var st = actTypeStyle[type] || actTypeStyle.other; %>
                <section class="act-type-card">
                  <h3 class="act-type-head"><span class="act-badge" style="background:<%= st[0] %>;color:<%= st[1] %>"><%= actTypeMap[type] %></span> <span class="act-type-count">(<%= items.length %> atividade<%= items.length > 1 ? 's' : '' %>)</span></h3>
                  <div class="act-type-grid">
                    <% items.forEach(function(a){ var hasSess = a.sessions && a.sessions.length; %>
                      <div class="act-item">
                        <strong class="act-item-title"><%= a.name %></strong>
                        <% if (a.description) { %><small class="act-item-desc"><%= a.description %></small><% } %>
                        <small class="act-item-meta"><%= activityDateRange(a) || 'A definir' %><% if (a.time_start || a.time_end) { %> · <%= String(a.time_start || '?').slice(0,5) %>–<%= String(a.time_end || '?').slice(0,5) %><% } %><% if (!hasSess && a.room_allocation) { %> · <%= a.room_allocation.room_name %><% } %></small>
                        <% if (hasSess) { a.sessions.forEach(function(s){ %><small class="act-item-meta">• <%= s.name %><% if (s.session_date) { %> — <%= formatBRDate(s.session_date) %><% } %><% if (s.time_start || s.time_end) { %> · <%= String(s.time_start || '?').slice(0,5) %>–<%= String(s.time_end || '?').slice(0,5) %><% } %><% if (s.room_allocation) { %> · <%= s.room_allocation.room_name %><% } %></small><% }) } %>
                        <div class="act-item-actions">
                          <% if (hasSess) { %><a class="btn btn-secondary activity-video" href="/evento/<%= event.id %>/atividades/<%= a.id %>/etapas">Etapas (<%= a.sessions.length %>)</a><% } %>
                          <% if (a.video_url) { %><a class="btn btn-secondary activity-video" href="<%= a.video_url %>" target="_blank" rel="noopener noreferrer">Transmissão</a><% } else if (a.has_video) { %><span class="muted">Transmissão prevista</span><% } %>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                </section>
              <% }) %>
            </div>
          </div>
          <div class="activities-view activities-view-list">
        <div class="timeline-table-wrap">
          <table class="timeline-table">
            <thead>
              <tr>
                <th>Data</th>
                <th>Hora</th>
                <th>Atividade</th>
                <th>Sala</th>
                <th>Descrição / Ementa</th>
                <th>Transmissão</th>
              </tr>
            </thead>
            <tbody>
              <% activities.forEach(function(activity) {
                const activityTime = (activity.time_start || activity.time_end) ? String(activity.time_start || '?').slice(0,5) + '–' + String(activity.time_end || '?').slice(0,5) : '—';
              %>
                <tr>
                  <td class="muted"><%= activityDateRange(activity) || 'A definir' %></td>
                  <td class="muted"><%= activityTime %></td>
                  <td class="timeline-label"><%= activity.name %></td>
                  <td><%= activity.room_allocation ? activity.room_allocation.room_name : '—' %></td>
                  <td style="color:#f8fafc"><%= activity.description || '—' %></td>
                  <td class="timeline-action">
                    <% if (activity.video_url) { %>
                      <a href="<%= activity.video_url %>" target="_blank" rel="noopener noreferrer" class="btn btn-secondary activity-video">Assistir transmissão</a>
                    <% } else if (activity.has_video) { %>
                      <span class="muted">Transmissão prevista — link a ser divulgado</span>
                    <% } else { %>
                      <span class="muted">—</span>
                    <% } %>
                  </td>
                </tr>
                <% (activity.sessions || []).forEach(function(session) {
                  const sessionVideo = session.video_url || (session.has_video ? null : activity.video_url);
                  const sessionTime = (session.time_start || session.time_end) ? String(session.time_start || '?').slice(0,5) + '–' + String(session.time_end || '?').slice(0,5) : '—';
                %>
                <tr class="session-row">
                  <td class="muted"><%= formatBRDate(session.session_date) || 'A definir' %></td>
                  <td class="muted"><%= sessionTime %></td>
                  <td class="timeline-label">— <%= session.name %></td>
                  <td class="muted"><%= session.room_allocation ? session.room_allocation.room_name : '—' %></td>
                  <td class="muted"><%= session.description || '—' %></td>
                  <td class="timeline-action">
                    <% if (sessionVideo) { %>
                      <a href="<%= sessionVideo %>" target="_blank" rel="noopener noreferrer" class="btn btn-secondary activity-video">Assistir transmissão</a>
                    <% } else if (session.has_video || activity.has_video) { %>
                      <span class="muted">Transmissão prevista — link a ser divulgado</span>
                    <% } else { %>
                      <span class="muted">—</span>
                    <% } %>
                  </td>
                </tr>
                <% }) %>
              <% }) %>
            </tbody>
          </table>
        </div>
          </div>
          <div class="activities-view activities-view-grid">
            <% if (!hasActivityGrid) { %>
              <p class="muted">Defina data e horário das atividades/etapas para visualizar em grade.</p>
            <% } else { %>
              <div class="grid-wrap">
                <table class="grid-table">
                  <thead>
                    <tr>
                      <th>Hora</th>
                      <% gridDays.forEach(function(day){ %><th><%= formatBRDate(day) %></th><% }) %>
                    </tr>
                  </thead>
                  <tbody>
                    <% gridHours.forEach(function(hour){ %>
                      <tr>
                        <th scope="row"><%= hour %>:00</th>
                        <% gridDays.forEach(function(day){ %>
                          <% var items = gridCell[day + '|' + hour] || []; %>
                          <td>
                            <% if (items.length) { items.forEach(function(nm){ %><span class="grid-item"><%= nm %></span><% }); } else { %><span class="muted">—</span><% } %>
                          </td>
                        <% }) %>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </div>
        </div>
      <% } %>

      <% if (hasSchedule) { %>
        <%
          const scheduleByDay = {};
          scheduleAssignments.forEach(function(row) { (scheduleByDay[row.date] = scheduleByDay[row.date] || []).push(row); });
          const scheduleDayKeys = Object.keys(scheduleByDay).sort();
          const scheduleByRoom = {};
          scheduleAssignments.forEach(function(row) { (scheduleByRoom[row.room_id] = scheduleByRoom[row.room_id] || []).push(row); });
        %>
        <div class="timeline-title">Programação nas Salas</div>
        <div class="schedule-block">
          <style>
            .schedule-block .schedule-radio { position:absolute;opacity:0;pointer-events:none; }
            .schedule-block .schedule-toggle { display:flex;gap:8px;margin-bottom:12px; }
            .schedule-block .schedule-toggle label { padding:6px 14px;border:1px solid rgba(148,163,184,.35);border-radius:999px;font-size:.8rem;color:#cbd5e1;cursor:pointer; }
            .schedule-block #schedule-view-day:checked ~ .schedule-toggle label[for="schedule-view-day"],
            .schedule-block #schedule-view-room:checked ~ .schedule-toggle label[for="schedule-view-room"] { background:rgba(59,130,246,.25);border-color:#60a5fa;color:#fff; }
            .schedule-block #schedule-view-day:checked ~ .schedule-view-room { display:none; }
            .schedule-block #schedule-view-room:checked ~ .schedule-view-day { display:none; }
            .schedule-day-title { font-weight:700;color:#93c5fd;margin:14px 0 6px; }
            .schedule-block .timeline-table { table-layout:fixed; }
            .schedule-block .timeline-table td { overflow-wrap:anywhere; }
          </style>
          <input type="radio" name="schedule-view" id="schedule-view-day" class="schedule-radio" checked>
          <input type="radio" name="schedule-view" id="schedule-view-room" class="schedule-radio">
          <div class="schedule-toggle">
            <label for="schedule-view-day">Por dia</label>
            <label for="schedule-view-room">Por sala</label>
          </div>
          <div class="schedule-view schedule-view-day">
            <% scheduleDayKeys.forEach(function(day) { %>
              <div class="schedule-day-title"><%= formatBRDate(day) %></div>
              <div class="timeline-table-wrap">
                <table class="timeline-table">
                  <colgroup><col style="width:22%"><col style="width:28%"><col style="width:50%"></colgroup>
                  <thead><tr><th>Horário</th><th>Sala</th><th>Item</th></tr></thead>
                  <tbody>
                    <% scheduleByDay[day].forEach(function(row) { %>
                      <tr>
                        <td class="muted"><%= String(row.time_start).slice(0,5) %>–<%= String(row.time_end).slice(0,5) %></td>
                        <td><%= row.room_name %></td>
                        <td><%= assignmentLabel(row) %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% }) %>
          </div>
          <div class="schedule-view schedule-view-room">
            <% scheduleRooms.forEach(function(room) { %>
              <% const rows = scheduleByRoom[room.id] || []; %>
              <div class="schedule-day-title"><%= room.name %> — <%= roomLabel(room.size) %><%= room.capacity ? ` (${room.capacity} lugares)` : '' %></div>
              <% if (!rows.length) { %>
                <p class="muted">Sem alocações.</p>
              <% } else { %>
                <div class="timeline-table-wrap">
                  <table class="timeline-table">
                    <colgroup><col style="width:22%"><col style="width:22%"><col style="width:56%"></colgroup>
                    <thead><tr><th>Data</th><th>Horário</th><th>Item</th></tr></thead>
                    <tbody>
                      <% rows.forEach(function(row) { %>
                        <tr>
                          <td class="muted"><%= formatBRDate(row.date) %></td>
                          <td class="muted"><%= String(row.time_start).slice(0,5) %>–<%= String(row.time_end).slice(0,5) %></td>
                          <td><%= assignmentLabel(row) %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            <% }) %>
          </div>
        </div>
      <% } %>
    </div>
  </main>

  <footer>&copy; <%= year %> LIGEM.Redes • <%= typeof appVersion !== 'undefined' ? appVersion : 'V0.1' %></footer>
<%- include("../partials/csrf-inject") %>
  </body>
</html>
