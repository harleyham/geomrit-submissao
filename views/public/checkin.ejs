<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Gerência de Eventos</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { box-sizing:border-box; margin:0; padding:0; }
    body { min-height:100vh; background:var(--bg); color:var(--text); font-family:'Inter',sans-serif; }
    .topbar { min-height:64px; padding:.7rem 1.5rem; background:var(--surface-elevated); border-bottom:1px solid var(--border-strong); }
    .topbar-inner { max-width:860px; margin:auto; display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap; }
    .logo { font-size:1.25rem; font-weight:700; color:var(--text); text-decoration:none; }
    .logo span { color:var(--accent); }
    .topbar-nav { display:flex; gap:.4rem; align-items:center; flex-wrap:wrap; }
    .topbar-nav a { color:var(--text-muted); padding: 0.5rem 0.75rem; border-radius: 6px; text-decoration: none; font-size: 0.875rem; font-weight: 500; transition:all .15s; }
    .topbar-nav a:hover { color: var(--text); background: var(--surface-hover); }
    .session-pill { padding: 0.42rem 0.78rem; border: 1px solid var(--border-strong); border-radius: 999px; color: var(--text); font-size: 0.82rem; }
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.375rem; padding: 0.625rem 1.25rem; border-radius: 8px; font-size: 0.875rem; font-weight: 500; cursor: pointer; border: none; text-decoration: none; }
    .btn-secondary { background:var(--surface-hover); color: var(--text); border: 1px solid var(--border-strong); }
    .btn-secondary:hover { background:var(--surface-hover); }
    .btn-logout { background: transparent; color: var(--danger); border: 1px solid var(--danger-border); font-family: inherit; }
    main { max-width:640px; margin:0 auto; padding:2.5rem 1.25rem; }
    .card { padding:2rem; border:1px solid var(--border-strong); border-radius:18px; background:var(--surface-elevated); }
    .badge { display:inline-block; padding:.3rem .7rem; border-radius:999px; background:rgba(16,185,129,.14); color:#6ee7b7; font-size:.75rem; font-weight:700; letter-spacing:.3px; text-transform:uppercase; }
    h1 { margin:.85rem 0 .65rem; color:var(--text-strong); font-size:1.8rem; }
    .lead { color:var(--text-muted); line-height:1.65; margin-bottom:1.4rem; }
    .info { display:grid; gap:.55rem; margin:1.2rem 0; padding:1.1rem 1.2rem; border:1px solid var(--border-strong); border-radius:12px; background:var(--surface-subtle); }
    .info div { display:flex; gap:.6rem; align-items:baseline; }
    .info span { color:var(--text-faint); font-size:.8rem; text-transform:uppercase; letter-spacing:.4px; min-width:74px; }
    .info strong { color:var(--text-strong); font-size:1rem; }
    .alert { margin-bottom:1rem; padding:.9rem 1rem; border-radius:10px; }
    .success { color:var(--success); background:var(--success-subtle); border:1px solid var(--success-border); }
    .error { color:var(--danger); background:var(--danger-subtle); border:1px solid var(--danger-border); }
    label { display:block; color:var(--text-muted); font-size:.85rem; margin:.9rem 0 .4rem; }
    select { width:100%; padding:.7rem .8rem; border-radius:8px; border:1px solid var(--border-strong); background:var(--surface-input); color:var(--text); font-size:.95rem; font-family:inherit; }
    .help { color:var(--text-muted); line-height:1.55; margin-top:1rem; font-size:.875rem; }
    .actions { display:flex; justify-content:space-between; align-items:center; gap:1rem; margin-top:1.35rem; flex-wrap:wrap; }
    .btn { display:inline-flex; text-decoration:none; color:var(--text); background:transparent; cursor:pointer; }
    .primary { color:var(--on-success); border:0; background:linear-gradient(135deg,var(--success),var(--success-hover)); font-size:1rem; padding:.8rem 2rem; }
    .primary:hover { opacity:.92; }
    .present { display:inline-block; margin-top:.5rem; padding:.2rem .5rem; border-radius:999px; color:var(--success); background:var(--success-subtle); font-size:.72rem; font-weight:700; }
    .empty { margin:1.25rem 0; padding:1rem; color:var(--text-muted); border:1px dashed var(--border-strong); border-radius:12px; }
  </style>
  <%- include('../partials/theme') %>
  <%- include('../partials/mobile-fixes') %>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="logo"><span class="logo-icon">◆</span> Gerência de Eventos</a>
      <nav class="topbar-nav">
        <a href="/evento/<%= event.id %>" class="btn btn-secondary">← Voltar ao evento</a>
        <span class="session-pill"><%= userEmail %></span>
        <form method="POST" action="/login/logout" style="display:inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-logout">Sair</button>
        </form>
      </nav>
    </div>
  </header>
  <main>
    <section class="card">
      <span class="badge">Registro de presença</span>
      <h1>Registrar presença</h1>
      <p class="lead">Você acessou esta página pelo código QR da folha de presença. Confira as informações abaixo e confirme.</p>

      <% if (message) { %><div class="alert <%= messageIsError ? 'error' : 'success' %>"><%= message %></div><% } %>

      <div class="info">
        <div><span>Evento</span><strong><%= event.name %></strong></div>
        <div><span>Atividade</span><strong><%= activity.name %></strong></div>
        <div><span>Data</span><strong><%= session && session.session_date ? formatBRDate(session.session_date) : activityDateRange(activity) %></strong></div>
        <% if (session) { %><div><span>Etapa</span><strong><%= session.name %></strong></div><% } %>
      </div>

      <% if (inWindow && markableRoles.length > 0 && selectedRole) { %>
        <% if (existing) { %><p class="present">Presença já registrada como <%= roleLabels[existing.role] || existing.role %> — confirmar novamente atualiza a marcação.</p><% } %>
        <form method="POST" action="/presenca/<%= event.id %>/<%= activity.id %><%= session ? '/' + session.id : '' %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label for="role">Papel a registrar</label>
          <select id="role" name="role">
            <% markableRoles.forEach((role) => { %>
              <option value="<%= role %>" <%= role === selectedRole ? 'selected' : '' %>><%= roleLabels[role] || role %></option>
            <% }) %>
          </select>
          <div class="actions">
            <a class="btn" href="/evento/<%= event.id %>/atividades">Cancelar</a>
            <button class="btn primary" type="submit">Marcar presença</button>
          </div>
        </form>
        <p class="help">A marcação fica disponível imediatamente na chamada da atividade e nos certificados, no papel selecionado. O administrador pode corrigi-la depois.</p>
      <% } else if (!inWindow) { %>
        <div class="empty">
          <p><strong>Fora do período de registro.</strong></p>
          <p style="margin-top:.5rem"><% if (windowStart) { %>A presença por QR Code pode ser registrada no dia <% if (session) { %>da etapa (<%= formatBRDate(windowStart) %>).<% } else { %>do período da atividade (<%= windowStart !== windowEnd ? formatBRDate(windowStart) + ' a ' + formatBRDate(windowEnd) : formatBRDate(windowStart) %>).<% } %><% } else { %>Esta atividade ainda não tem data definida.<% } %></p>
        </div>
      <% } else { %>
        <div class="empty">
          <p><strong>Sem vínculo para registrar presença.</strong></p>
          <p style="margin-top:.5rem">Sua conta não está inscrita neste evento ou não possui um papel para esta atividade. Fale com a organização do evento.</p>
        </div>
      <% } %>
    </section>
  </main>
</body>
</html>
