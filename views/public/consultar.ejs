<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Consultar Artigo' %> - Gerência de Eventos</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; }
    .topbar { background: var(--surface); border-bottom: 1px solid var(--border); backdrop-filter: blur(20px); padding: 0 2rem; height: 64px; display: flex; align-items: center; position: sticky; top: 0; z-index: 100; }
    .topbar-inner { width: 100%; max-width: 1400px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
    .logo { font-size: 1.25rem; font-weight: 700; color: var(--text); text-decoration: none; }
    .logo-icon { color: var(--accent); }
    .main-content { max-width: 700px; margin: 0 auto; padding: 3rem 2rem; }
    .card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 2rem; }
    .card h1 { font-size: 1.5rem; font-weight: 700; color: var(--text-strong); margin-bottom: 1.5rem; text-align: center; }
    .form-group { margin-bottom: 1.5rem; }
    .form-group label { display: block; font-size: 0.875rem; font-weight: 500; color: var(--text); margin-bottom: 0.375rem; }
    .form-group input {
      width: 100%; padding: 0.625rem 0.75rem; background: rgba(15,23,42,0.6);
      border: 1px solid rgba(148,163,184,0.2); border-radius: 8px; color: var(--text);
      font-family: 'Inter', sans-serif; font-size: 0.875rem;
    }
    .form-group input:focus {
      outline: none; border-color: var(--primary); box-shadow: 0 0 0 2px rgba(59,130,246,0.25);
    }
    .btn { display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.625rem 1.25rem; border-radius: 8px; font-size: 0.875rem; font-weight: 500; text-decoration: none; border: none; cursor: pointer; }
    .btn-primary { background: var(--primary); color: white; width: 100%; justify-content: center; }
    .btn-primary:hover { background: var(--primary-hover); }
    .topbar-nav { display:flex; gap:0.4rem; align-items:center; flex-wrap:wrap; }
    .topbar-nav a { color: var(--text-muted); padding: 0.5rem 0.75rem; border-radius: 6px; text-decoration: none; font-size: 0.875rem; font-weight: 500; }
    .topbar-nav a:hover { color: var(--text); background: var(--border); }
    .session-pill { padding: 0.42rem 0.78rem; border: 1px solid rgba(148,163,184,0.18); border-radius: 999px; color: var(--text); font-size: 0.82rem; }
    .btn-logout { background: transparent; color: var(--danger); border: 1px solid rgba(248,113,113,0.25); font-family: inherit; }
    .btn-secondary { background: var(--border); color: var(--text); border: 1px solid rgba(148,163,184,0.2); }
    .btn-secondary:hover { background: rgba(148,163,184,0.2); }
    .actions { display: flex; gap: 1rem; margin-top: 1rem; }
    .error { background: rgba(248,113,113,0.1); border: 1px solid rgba(248,113,113,0.3); border-radius: 8px; padding: 1rem; color: #fca5a5; text-align: center; margin-bottom: 1rem; }
    .article-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 2rem; margin-top: 1.5rem; }
    .article-card h2 { font-size: 1.125rem; font-weight: 600; color: var(--text-strong); margin-bottom: 0.5rem; }
    .article-card .meta { color: var(--text-muted); font-size: 0.875rem; margin-bottom: 1rem; }
    .article-card .info { font-size: 0.875rem; color: var(--text); line-height: 1.8; }
    .article-card .info strong { color: var(--text); }
    .status-badge { display: inline-block; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 500; }
    .status-pending { background: rgba(251,191,36,0.15); color: var(--warn); }
    .status-in_review { background: rgba(96,165,250,0.15); color: var(--accent); }
    .status-approved { background: rgba(52,211,153,0.15); color: var(--success); }
    .status-rejected { background: rgba(248,113,113,0.15); color: var(--danger); }
    .status-revision_requested { background: rgba(251,146,60,0.15); color: #fb923c; }
    .empty-state { text-align: center; padding: 2rem; color: var(--text-faint); }
    footer { text-align: center; padding: 3rem 2rem; color: var(--text-faint); font-size: 0.75rem; }
  </style>
  <%- include('../partials/theme') %>
  <%- include('../partials/mobile-fixes') %>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="logo"><span class="logo-icon">◆</span> Gerência de Eventos</a>
      <nav class="topbar-nav">
        <a href="/" class="btn btn-secondary">← Início</a>
        <% if (userEmail) { %>
          <a href="/author" class="btn btn-secondary">Área do Participante</a>
          <span class="session-pill"><%= userEmail %></span>
          <form method="POST" action="/login/logout" style="display:inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-logout">Sair</button>
          </form>
        <% } %>
      </nav>
    </div>
  </header>

  <main class="main-content">
    <div class="card">
      <h1>Consultar Artigo</h1>
      <p style="color: var(--text-muted); text-align: center; margin-bottom: 1.5rem; font-size: 0.875rem;">Digite o código de acesso recebido após a submissão para consultar o status do seu artigo.</p>

      <form action="/consultar" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label>Código de Acesso</label>
          <input type="text" name="access_code"           placeholder="Ex: ACC-A1B2C3D4E5F6G7H8" required style="text-transform: uppercase; letter-spacing: 0.1em; font-family: monospace; text-align: center; font-size: 1rem;">
        </div>
        <button type="submit" class="btn btn-primary">Consultar</button>
      </form>
    </div>

    <% if (error) { %>
      <div class="error" style="margin-top: 1.5rem;">
        <%= error %>
      </div>
    <% } %>

    <% if (article) { %>
      <div class="article-card">
        <h2><%= article.title %></h2>
        <% if (article.title_en) { %>
          <p style="color: var(--text-muted); font-size: 0.875rem; margin-bottom: 0.75rem;"><em><%= article.title_en %></em></p>
        <% } %>
        <div style="margin-bottom: 1rem;">
          <% if (article.status === 'pending') { %><span class="status-badge status-pending">Pendente</span><% } %>
          <% if (article.status === 'in_review') { %><span class="status-badge status-in_review">Em Revisão</span><% } %>
          <% if (article.status === 'approved') { %><span class="status-badge status-approved">Aprovado</span><% } %>
          <% if (article.status === 'rejected') { %><span class="status-badge status-rejected">Rejeitado</span><% } %>
          <% if (article.status === 'revision_requested') { %><span class="status-badge status-revision_requested">Revisão Solicitada</span><% } %>
        </div>
        <div class="meta">
          <strong>Evento:</strong> <%= article.event_name %><br>
          <strong>Autores:</strong> <%= article.authors %><br>
          <strong>Área:</strong> <%= article.area %><br>
          <strong>Tipo:</strong> <%= article.type === 'poster' ? 'Pôster' : 'Oral' %>
        </div>
        <% if (article.abstract) { %>
          <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border);">
            <strong style="color: var(--text); font-size: 0.875rem;">Resumo</strong>
            <p style="color: var(--text-muted); font-size: 0.875rem; line-height: 1.6; margin-top: 0.25rem;"><%= article.abstract %></p>
          </div>
        <% } %>
        <% if (article.report_count > 0) { %>
          <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border);">
            <strong style="color: var(--text); font-size: 0.875rem;">Andamento da Avaliação</strong>
            <p style="color: var(--text-muted); font-size: 0.875rem; margin-top: 0.25rem;">
              Pareceres recebidos: <%= article.report_count %>
              <% if (article.approval_count || article.rejection_count || article.revision_count) { %>
                • Aprovações: <%= article.approval_count %>
                • Rejeições: <%= article.rejection_count %>
                • Revisões solicitadas: <%= article.revision_count %>
              <% } %>
            </p>
          </div>
        <% } %>
        <div class="actions" style="margin-top: 1.5rem;">
          <a href="/" class="btn btn-secondary">Voltar ao Início</a>
        </div>
      </div>
    <% } %>
  </main>

  <footer>&copy; <%= typeof year !== 'undefined' ? year : 2026 %> LIGEM.Redes • <%= typeof appVersion !== 'undefined' ? appVersion : 'V0.1' %></footer>
</body>
</html>
