<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Artigos LIGEM</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: #0a0f1a; color: #e2e8f0; min-height: 100vh; }
    .topbar { background: rgba(15,23,42,0.8); border-bottom: 1px solid rgba(148,163,184,0.1); backdrop-filter: blur(20px); padding: 0 2rem; height: 64px; display: flex; align-items: center; position: sticky; top: 0; z-index: 100; }
    .topbar-inner { width: 100%; max-width: 1400px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
    .logo { font-size: 1.25rem; font-weight: 700; color: #e2e8f0; text-decoration: none; }
    .topbar-nav { display:flex; gap:0.4rem; align-items:center; flex-wrap:wrap; }
    .topbar-nav a { color: #94a3b8; padding: 0.5rem 0.75rem; border-radius: 6px; text-decoration: none; font-size: 0.875rem; font-weight: 500; transition:all 0.15s; }
    .topbar-nav a:hover { color: #e2e8f0; background: rgba(148,163,184,0.1); }
    .session-pill { padding: 0.42rem 0.78rem; border: 1px solid rgba(148,163,184,0.18); border-radius: 999px; color: #e2e8f0; font-size: 0.82rem; }
    .main-content { max-width: 1280px; margin: 0 auto; padding: 2rem; }
    .hero { display: grid; grid-template-columns: 1.4fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem; }
    .panel { background: rgba(30,41,59,0.6); border: 1px solid rgba(148,163,184,0.1); border-radius: 16px; padding: 1.5rem; }
    .panel h1, .panel h2 { color: #f8fafc; }
    .hero p { color: #94a3b8; line-height: 1.7; margin-top: 0.75rem; }
    .hero .meta { margin-top: 1rem; color: #cbd5e1; font-size: 0.95rem; }
    .stats { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1rem; }
    .stat { background: rgba(15,23,42,0.4); border: 1px solid rgba(148,163,184,0.12); border-radius: 14px; padding: 1rem; }
    .stat-label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; margin-bottom: 0.45rem; }
    .stat-value { font-size: 1.8rem; font-weight: 700; color: #f8fafc; }
    .grid { display: grid; grid-template-columns: 1.05fr 1.25fr; gap: 1.5rem; }
    .section-title { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
    .section-title h2 { font-size: 1.1rem; }
    .event-list, .info-list { display: flex; flex-direction: column; gap: 0.9rem; }
    .event-item, .info-item { padding: 1rem; border-radius: 12px; background: rgba(15,23,42,0.35); border: 1px solid rgba(148,163,184,0.1); }
    .event-link { display: block; text-decoration: none; color: inherit; transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease; }
    .event-link:hover .event-item, .event-link:focus-visible .event-item { transform: translateY(-2px); border-color: rgba(96,165,250,0.4); background: rgba(15,23,42,0.52); }
    .event-link:focus-visible { outline: none; }
    .event-item h3 { color: #f8fafc; margin-bottom: 0.35rem; }
    .event-item p, .info-item p { color: #94a3b8; font-size: 0.875rem; line-height: 1.6; }
    .badge { display: inline-block; padding: 0.2rem 0.55rem; border-radius: 999px; font-size: 0.68rem; font-weight: 700; }
    .badge-open { background: rgba(34,197,94,0.15); color: #4ade80; }
    .badge-draft { background: rgba(148,163,184,0.18); color: #cbd5e1; }
    .badge-pending { background: rgba(251,191,36,0.16); color: #fbbf24; }
    .badge-approved { background: rgba(34,197,94,0.15); color: #4ade80; }
    .badge-rejected { background: rgba(248,113,113,0.15); color: #fca5a5; }
    .badge-review { background: rgba(96,165,250,0.16); color: #93c5fd; }
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.35rem; padding: 0.65rem 1rem; border-radius: 10px; text-decoration: none; border: none; cursor: pointer; font-weight: 600; }
    .btn-primary { background: #2563eb; color: white; }
    .btn-secondary { background: transparent; color: #cbd5e1; border: 1px solid rgba(148,163,184,0.18); }
    .btn-danger { background: rgba(239,68,68,0.14); color: #fca5a5; border: 1px solid rgba(248,113,113,0.28); }
    table { width: 100%; border-collapse: collapse; }
    th { text-align: left; padding: 0.8rem 0.9rem; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; background: rgba(15,23,42,0.3); }
    td { padding: 0.85rem 0.9rem; border-top: 1px solid rgba(148,163,184,0.08); font-size: 0.86rem; color: #cbd5e1; vertical-align: top; }
    tr:hover td { background: rgba(148,163,184,0.03); }
    .empty { padding: 2rem; text-align: center; color: #64748b; }
    .alert { padding: 0.95rem 1rem; border-radius: 12px; margin-bottom: 1rem; font-size: 0.9rem; }
    .alert-success { background: rgba(34,197,94,0.1); border: 1px solid rgba(74,222,128,0.2); color: #86efac; }
    .alert-error { background: rgba(239,68,68,0.1); border: 1px solid rgba(248,113,113,0.25); color: #fca5a5; }
    .modal-backdrop { position: fixed; inset: 0; background: rgba(2,6,23,0.72); display: none; align-items: center; justify-content: center; padding: 1.5rem; z-index: 1200; }
    .modal-backdrop.visible { display: flex; }
    .modal-card { width: 100%; max-width: 420px; background: rgba(15,23,42,0.98); border: 1px solid rgba(148,163,184,0.18); border-radius: 18px; padding: 1.5rem; box-shadow: 0 30px 80px rgba(2,6,23,0.5); }
    .modal-card h3 { color: #f8fafc; font-size: 1.15rem; margin-bottom: 0.7rem; }
    .modal-card p { color: #94a3b8; line-height: 1.65; margin-bottom: 1.25rem; }
    .modal-actions { display: flex; justify-content: flex-end; gap: 0.75rem; flex-wrap: wrap; }
    footer { text-align: center; padding: 2rem; color: #475569; font-size: 0.75rem; }
    @media (max-width: 1100px) {
      .hero, .grid, .stats { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="logo"><span class="logo-icon">◆</span> Artigos LIGEM</a>
      <nav class="topbar-nav">
        <% if (previewMode) { %>
          <a href="/admin/users" class="btn btn-secondary">Usuários</a>
          <a href="/" class="btn btn-secondary">← Eventos</a>
          <span class="session-pill">Visualizando: <%= previewUser && previewUser.email ? previewUser.email : userEmail %></span>
        <% } else { %>
          <a href="/author" class="btn btn-secondary">Área do Participante</a>
          <% if (isReviewer) { %>
            <a href="/reviewer" class="btn btn-secondary">Painel do Revisor</a>
          <% } %>
          <% if (isAdmin) { %>
            <a href="/admin/dashboard" class="btn btn-secondary">Dashboard</a>
          <% } %>
          <a href="/" class="btn btn-secondary">← Eventos</a>
          <span class="session-pill"><%= userEmail %></span>
          <form method="POST" action="/login/logout" style="display:inline;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-logout">Sair</button>
          </form>
        <% } %>
      </nav>
    </div>
  </header>

  <main class="main-content">
    <% const draftSubmissions = submissions.filter(function(article) { return article.status === 'draft'; }); %>
    <% const submittedSubmissions = submissions.filter(function(article) { return article.status !== 'draft'; }); %>
    <% if (success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <section class="hero">
      <div class="panel">
        <h1><%= previewMode ? 'Visualização da Área do Participante' : 'Área do Participante' %></h1>
        <p>Use este espaço para se inscrever em eventos como participante, submeter artigos, acompanhar suas participações e consultar informações relevantes sobre os eventos em que você está envolvido.</p>
        <div class="meta">
          <strong>Usuário:</strong> <%= userName || userEmail %><br>
          <strong>E-mail vinculado às participações:</strong> <%= userEmail %>
        </div>
        <% if (previewMode) { %>
          <div class="alert" style="margin-top:1rem; margin-bottom:0; background:rgba(59,130,246,0.1); border:1px solid rgba(96,165,250,0.2); color:#bfdbfe;">
            Visualização administrativa em modo leitura.
          </div>
        <% } %>
        <div style="margin-top:1.25rem;display:flex;gap:0.75rem;flex-wrap:wrap;">
          <a href="/" class="btn btn-secondary">Ver Eventos</a>
          <% if (previewMode) { %>
            <a href="/admin/users" class="btn btn-secondary">Voltar para Usuários</a>
          <% } else { %>
            <a href="/author/profile" class="btn btn-primary">Alterar Meus Dados</a>
            <% if (isReviewer) { %>
              <a href="/reviewer" class="btn btn-secondary">Ir para o Painel do Revisor</a>
            <% } %>
            <% if (isAdmin) { %>
              <a href="/admin/dashboard" class="btn btn-secondary">Ir para o Dashboard Admin</a>
            <% } %>
          <% } %>
        </div>
      </div>
      <div class="stats">
        <div class="stat">
          <div class="stat-label">Total</div>
          <div class="stat-value" data-stat-total><%= stats.total %></div>
        </div>
        <div class="stat">
          <div class="stat-label">Rascunhos</div>
          <div class="stat-value" data-stat-drafts><%= stats.drafts %></div>
        </div>
        <div class="stat">
          <div class="stat-label">Em andamento</div>
          <div class="stat-value"><%= stats.pending %></div>
        </div>
        <div class="stat">
          <div class="stat-label">Aprovadas</div>
          <div class="stat-value"><%= stats.approved %></div>
        </div>
        <div class="stat">
          <div class="stat-label">Rejeitadas</div>
          <div class="stat-value"><%= stats.rejected %></div>
        </div>
      </div>
    </section>

    <section class="grid">
      <div class="panel">
        <div class="section-title">
          <h2>Eventos Disponíveis para Participação</h2>
        </div>
        <% if (participantEvents.length > 0) { %>
          <div class="event-list">
            <% participantEvents.forEach(event => { %>
              <a href="/evento/<%= event.id %>" class="event-link" aria-label="Abrir evento <%= event.name %>">
                <div class="event-item">
                  <div style="display:flex;justify-content:space-between;gap:1rem;align-items:flex-start;">
                    <div>
                      <h3><%= event.name %></h3>
                      <p><strong>Áreas:</strong> <%= event.area_display %></p>
                      <p><strong>Período do evento:</strong> <%= event.formattedDateStart || 'TBD' %><% if (event.formattedDateEnd) { %> - <%= event.formattedDateEnd %><% } %></p>
                      <p><strong>Prazo de submissão:</strong> <%= event.has_article_submission ? (event.submissionDisplay.end || 'sem data limite') : 'evento sem submissão de artigos' %></p>
                    </div>
                    <span class="badge <%= event.submission.isOpen ? 'badge-open' : 'badge-draft' %>"><%= event.submission.isOpen ? 'Submissão aberta' : (event.submission.isConfigured ? 'Submissão fechada' : 'Sem submissão') %></span>
                  </div>
                </div>
              </a>
            <% }) %>
          </div>
        <% } else { %>
          <div class="empty">Não há eventos futuros disponíveis no momento.</div>
        <% } %>
      </div>

      <div class="panel">
        <div class="section-title">
          <h2>Informações úteis ao participante</h2>
        </div>
        <div class="info-list">
          <div class="info-item">
            <p>Você pode se inscrever como participante em eventos publicados e manter sua participação vinculada à sua conta.</p>
          </div>
          <div class="info-item">
            <p>Se optar por submeter artigo, o formulário permite múltiplos autores, ordem de autoria e autor correspondente.</p>
          </div>
          <div class="info-item">
            <p>O envio final exige PDF em avaliação cega, declaração de originalidade e autorização de publicação.</p>
          </div>
          <div class="info-item">
            <p>Rascunhos e submissões ficam disponíveis nesta área para edição, acompanhamento e consulta posterior.</p>
          </div>
        </div>
      </div>
    </section>

    <% if (!previewMode && draftSubmissions.length > 0) { %>
      <section class="panel" style="margin-top:1.5rem;" data-drafts-panel>
        <div class="section-title">
          <h2>Meus Rascunhos</h2>
        </div>
        <table>
          <thead>
            <tr>
              <th>Título</th>
              <th>Evento</th>
              <th>Última atualização</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody>
            <% draftSubmissions.forEach(article => { %>
              <tr data-draft-row="<%= article.id %>">
                <td><strong style="color:#f8fafc;"><%= article.title || 'Sem título' %></strong></td>
                <td><%= article.event_name %></td>
                <td><%= new Date(article.updated_at || article.created_at).toLocaleDateString('pt-BR') %></td>
                <td>
                  <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
                    <a href="/submeter/<%= article.event_id %>?draftId=<%= article.id %>" class="btn btn-secondary">Continuar Preenchimento</a>
                    <form method="POST" action="/author/drafts/<%= article.id %>/delete" style="display:inline;" data-draft-delete-form data-draft-id="<%= article.id %>">
                      <button type="submit" class="btn btn-danger">Apagar</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </section>
    <% } %>

    <section class="panel" style="margin-top:1.5rem;">
      <div class="section-title">
        <h2>Minhas Participações</h2>
      </div>
      <% if (participations.length > 0) { %>
        <table>
          <thead>
            <tr>
              <th>Evento</th>
              <th>Período</th>
              <th>Local</th>
              <th>Participação</th>
              <% if (showSubsidyStatus) { %>
                <th>Subsídio</th>
              <% } %>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody>
            <% participations.forEach(participation => { %>
              <tr>
                <td><strong style="color:#f8fafc;"><%= participation.event_name %></strong></td>
                <td>
                  <%= participation.date_start ? new Date(participation.date_start).toLocaleDateString('pt-BR') : 'TBD' %>
                  <% if (participation.date_end) { %> - <%= new Date(participation.date_end).toLocaleDateString('pt-BR') %><% } %>
                </td>
                <td><%= participation.location || '-' %></td>
                <td>
                  <span class="badge <%= participation.approved_articles > 0 ? 'badge-approved' : participation.registration_type === 'author' ? 'badge-review' : 'badge-open' %>">
                    <%= participation.participation_label %>
                  </span>
                </td>
                <% if (showSubsidyStatus) { %>
                  <td>
                    <% if (participation.subsidy_requested) { %>
                      <span class="badge <%= participation.subsidy_status === 'pending' ? 'badge-pending' : participation.subsidy_status === 'approved' ? 'badge-approved' : participation.subsidy_status === 'rejected' ? 'badge-rejected' : 'badge-draft' %>">
                        <%= participation.subsidy_status === 'pending' ? 'Pendente' : participation.subsidy_status === 'approved' ? 'Aprovado' : participation.subsidy_status === 'rejected' ? 'Rejeitado' : 'Não solicitado' %>
                      </span>
                    <% } else { %>
                      <span style="color:#64748b;font-size:0.8rem;">—</span>
                    <% } %>
                  </td>
                <% } %>
                <td>
                  <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
                    <a href="/evento/<%= participation.event_id %>" class="btn btn-secondary">Detalhes</a>
                    <a href="/evento/<%= participation.event_id %>/atividades" class="btn btn-secondary">Minhas atividades</a>
                    <a href="/evento/<%= participation.event_id %>/qr-presenca" class="btn btn-secondary">QR de presença</a>
                    <% if (participation.registration_type === 'listener') { %>
                      <a href="/evento/<%= participation.event_id %>/inscricao" class="btn btn-secondary">Ver Inscrição</a>
                      <% if (participation.can_cancel) { %>
                        <form method="POST" action="/evento/<%= participation.event_id %>/inscricao/cancelar" style="display:inline;" onsubmit="return confirm('Cancelar sua inscrição neste evento?')">
                          <button type="submit" class="btn btn-danger">Cancelar</button>
                        </form>
                      <% } %>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <div class="empty">Você ainda não possui participações registradas em eventos.</div>
      <% } %>
    </section>

    <section class="panel" style="margin-top:1.5rem;">
      <div class="section-title">
        <h2>Submissões Enviadas</h2>
      </div>
      <% if (submittedSubmissions.length > 0) { %>
        <table>
          <thead>
            <tr>
              <th>Título</th>
              <th>Evento</th>
              <th>Tipo</th>
              <th>Status</th>
              <th>Código</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody>
            <% submittedSubmissions.forEach(article => { %>
              <tr>
                <td><strong style="color:#f8fafc;"><%= article.title || 'Sem título' %></strong></td>
                <td><%= article.event_name %></td>
                <td><%= article.type === 'poster' ? 'Pôster' : 'Oral' %></td>
                <td>
                  <span class="badge <%= article.status === 'draft' ? 'badge-draft' : article.status === 'approved' ? 'badge-approved' : article.status === 'rejected' ? 'badge-rejected' : article.status === 'in_review' ? 'badge-review' : 'badge-pending' %>">
                    <%= article.status_label %>
                  </span>
                </td>
                <td><code><%= article.access_code || '-' %></code></td>
                <td>
                  <a href="/consultar" class="btn btn-secondary">Consultar</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <div class="empty">Você ainda não possui submissões enviadas vinculadas a esta conta.</div>
      <% } %>
    </section>
  </main>

  <div class="modal-backdrop" id="draft-delete-modal" aria-hidden="true">
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="draft-delete-title">
      <h3 id="draft-delete-title">Apagar rascunho</h3>
      <p>Tem certeza de que deseja apagar este rascunho? Esta ação não pode ser desfeita.</p>
      <div class="modal-actions">
        <button type="button" class="btn btn-secondary" id="draft-delete-cancel">Cancelar</button>
        <button type="button" class="btn btn-danger" id="draft-delete-confirm">Apagar rascunho</button>
      </div>
    </div>
  </div>

  <footer>&copy; <%= year %> LIGEM.Redes • <%= typeof appVersion !== 'undefined' ? appVersion : 'V0.1' %></footer>
  <script>
    (function() {
      var deleteForms = document.querySelectorAll('[data-draft-delete-form]');
      var totalStat = document.querySelector('[data-stat-total]');
      var draftsStat = document.querySelector('[data-stat-drafts]');
      var draftsPanel = document.querySelector('[data-drafts-panel]');
      var deleteModal = document.getElementById('draft-delete-modal');
      var cancelDeleteButton = document.getElementById('draft-delete-cancel');
      var confirmDeleteButton = document.getElementById('draft-delete-confirm');
      var pendingDeleteForm = null;

      function updateStat(node, delta) {
        if (!node) return;
        var current = parseInt(node.textContent, 10);
        if (Number.isNaN(current)) return;
        node.textContent = String(Math.max(0, current + delta));
      }

      function handleEmptyDraftPanel() {
        if (!draftsPanel) return;
        var remainingRows = draftsPanel.querySelectorAll('[data-draft-row]');
        if (remainingRows.length === 0) {
          draftsPanel.remove();
        }
      }

      function closeDeleteModal() {
        pendingDeleteForm = null;
        if (!deleteModal) return;
        deleteModal.classList.remove('visible');
        deleteModal.setAttribute('aria-hidden', 'true');
      }

      function openDeleteModal(form) {
        pendingDeleteForm = form;
        if (!deleteModal) return;
        deleteModal.classList.add('visible');
        deleteModal.setAttribute('aria-hidden', 'false');
      }

      function submitDraftDeletion(form) {
        fetch(form.action, {
          method: 'POST',
          headers: {
            'Accept': 'application/json'
          }
        }).then(function(response) {
          if (!response.ok) {
            throw new Error('Falha ao apagar rascunho.');
          }
          return response.json();
        }).then(function(result) {
          if (!result || !result.success) {
            throw new Error(result && result.error ? result.error : 'Falha ao apagar rascunho.');
          }

          var row = document.querySelector('[data-draft-row="' + result.deletedDraftId + '"]');
          if (row) {
            row.remove();
          }

          updateStat(totalStat, -1);
          updateStat(draftsStat, -1);
          handleEmptyDraftPanel();
        }).catch(function(error) {
          window.location.href = '/author?error=' + encodeURIComponent(error.message || 'Falha ao apagar rascunho.');
        }).finally(function() {
          closeDeleteModal();
        });
      }

      if (cancelDeleteButton) {
        cancelDeleteButton.addEventListener('click', closeDeleteModal);
      }

      if (confirmDeleteButton) {
        confirmDeleteButton.addEventListener('click', function() {
          if (!pendingDeleteForm) return;
          submitDraftDeletion(pendingDeleteForm);
        });
      }

      if (deleteModal) {
        deleteModal.addEventListener('click', function(event) {
          if (event.target === deleteModal) {
            closeDeleteModal();
          }
        });
      }

      document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape' && deleteModal && deleteModal.classList.contains('visible')) {
          closeDeleteModal();
        }
      });

      deleteForms.forEach(function(form) {
        form.addEventListener('submit', function(event) {
          event.preventDefault();
          openDeleteModal(form);
        });
      });
    })();
  </script>
<%- include("../partials/csrf-inject") %>
  </body>
</html>
