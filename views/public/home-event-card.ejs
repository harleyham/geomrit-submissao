<a href="/evento/<%= event.id %>" class="event-card" aria-label="Abrir detalhes do evento <%= event.name %>">
  <% if (event.logo_path) { %>
    <img src="/uploads/event-logos/<%= String(event.logo_path).split('/').pop() %>" alt="" class="event-logo">
  <% } %>
  <span class="area"><%= event.area_display %></span>
  <% if (locals.isClosed) { %>
    <span class="submission-badge submission-ended">Encerrado</span>
  <% } else if (event.submission.isConfigured) { %>
    <span class="submission-badge <%= event.submission.isOpen ? 'submission-open' : 'submission-closed' %>">
      <%= event.submission.isOpen ? 'Submissão aberta' : 'Submissão fechada' %>
    </span>
  <% } %>
  <h3><%= event.name %></h3>
  <span class="event-section-label">Período do Evento</span>
  <div class="event-meta">
    <span>📅 <%= event.formattedDateStart || formatBRDate(event.date_start) %><% if (event.date_end) { %> - <%= event.formattedDateEnd || formatBRDate(event.date_end) %><% } %></span>
    <% if (event.location) { %><span>📍 <%= event.location %></span><% } %>
  </div>
  <% if (event.submission.start || event.submission.end) { %>
    <span class="event-section-label">Período de Submissão de Artigos</span>
    <div class="event-meta">
      <% if (event.submission.start) { %><span>🟢 Início: <%= event.submission.formattedStart || formatBRDate(event.submission_start) %></span><% } %>
      <% if (event.submission.end) { %><span>⏰ Fim: <%= event.submission.formattedEnd || formatBRDate(event.submission_end) %></span><% } %>
    </div>
  <% } %>
  <% if (event.description) { %>
    <p><%= event.description.length > 150 ? event.description.substring(0, 150) + '...' : event.description %></p>
  <% } %>
</a>
