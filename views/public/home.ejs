<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Artigos LIGEM</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: #0a0f1a; color: #e2e8f0; min-height: 100vh; }
    .topbar { background: rgba(15,23,42,0.8); border-bottom: 1px solid rgba(148,163,184,0.1); backdrop-filter: blur(20px); padding: 0 2rem; height: 64px; display: flex; align-items: center; position: sticky; top: 0; z-index: 100; }
    .topbar-inner { width: 100%; max-width: 1400px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
    .logo { font-size: 1.25rem; font-weight: 700; color: #e2e8f0; text-decoration: none; }
    .logo-icon { color: #60a5fa; }
    .main-content { max-width: 1000px; margin: 0 auto; padding: 3rem 2rem; }
    .hero { text-align: center; margin-bottom: 4rem; }
    .hero h1 { font-size: 2.5rem; font-weight: 800; color: #f1f5f9; margin-bottom: 0.75rem; }
    .hero h1 span { color: #60a5fa; }
    .hero p { font-size: 1.125rem; color: #94a3b8; max-width: 600px; margin: 0 auto; line-height: 1.7; }
    .section-title { font-size: 1.25rem; font-weight: 700; color: #f1f5f9; margin-bottom: 1.5rem; text-align: center; }
    .events-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; }
    .event-card { display: block; background: rgba(30,41,59,0.6); border: 1px solid rgba(148,163,184,0.1); border-radius: 12px; padding: 1.5rem; transition: all 0.2s; text-decoration: none; }
    .event-card:hover { border-color: rgba(96,165,250,0.3); transform: translateY(-2px); }
    .event-card h3 { font-size: 1.125rem; font-weight: 600; color: #f1f5f9; margin-bottom: 0.5rem; }
    .event-card .area { display: inline-block; background: rgba(167,139,250,0.15); color: #a78bfa; padding: 0.2rem 0.6rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 500; margin-bottom: 0.75rem; }
    .event-card .submission-badge { display: inline-block; margin-left: 0.5rem; padding: 0.2rem 0.6rem; border-radius: 9999px; font-size: 0.7rem; font-weight: 600; }
    .event-card .submission-open { background: rgba(52,211,153,0.15); color: #34d399; }
    .event-card .submission-closed { background: rgba(248,113,113,0.12); color: #f87171; }
    .event-card p { color: #94a3b8; font-size: 0.875rem; line-height: 1.6; margin-bottom: 1rem; }
    .event-section-label { display: block; color: #94a3b8; font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.4rem; }
    .event-meta { display: flex; gap: 1rem; color: #64748b; font-size: 0.75rem; margin-bottom: 1rem; }
    .event-meta span { display: flex; align-items: center; gap: 0.25rem; }
    .btn { display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.5rem 1rem; border-radius: 8px; font-size: 0.8125rem; font-weight: 500; text-decoration: none; }
    .btn-primary { background: #3b82f6; color: white; }
    .btn-primary:hover { background: #2563eb; }
    .btn-logout { background: transparent; color: #f87171; border: 1px solid rgba(248,113,113,0.25); cursor: pointer; font-family: inherit; }
    .empty-state { text-align: center; padding: 4rem 2rem; }
    .empty-state h2 { font-size: 1.5rem; font-weight: 600; color: #475569; margin-bottom: 0.5rem; }
    .empty-state p { color: #334155; font-size: 0.9375rem; }
    footer { text-align: center; padding: 3rem 2rem; color: #475569; font-size: 0.75rem; }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="logo"><img src="/assets/Ligem.png" alt="LIGEM" style="height:36px;margin-right:0.5rem;vertical-align:middle"> Artigos LIGEM</a>
      <nav style="display:flex;gap:0.25rem;align-items:center">
        <% if (isAdmin || isReviewer || isPublic) { %>
          <a href="<%= isAdmin ? '/admin/dashboard' : isReviewer ? '/reviewer' : '/author' %>" class="btn" style="padding:0.4rem 0.8rem;font-size:0.8125rem;color:#94a3b8;border:1px solid rgba(148,163,184,0.2);border-radius:6px;text-decoration:none"><%= userName %> | <%= userEmail %> | <%= isAdmin ? 'Dashboard' : isReviewer ? 'Revisor' : 'Autor' %></a>
          <form method="POST" action="<%= isAdmin ? '/admin/logout' : isReviewer ? '/reviewer/logout' : '/login/logout' %>" style="display:inline">
            <button type="submit" class="btn btn-logout">Sair</button>
          </form>
        <% } else { %>
          <a href="/cadastro" class="btn" style="padding:0.4rem 0.8rem;font-size:0.8125rem;color:#cbd5e1;border:1px solid rgba(96,165,250,0.25);border-radius:6px;text-decoration:none;background:rgba(59,130,246,0.08)">Solicitar Cadastro</a>
          <a href="/login" class="btn" style="padding:0.4rem 0.8rem;font-size:0.8125rem;color:#94a3b8;border:1px solid rgba(148,163,184,0.2);border-radius:6px;text-decoration:none">Entrar</a>
        <% } %>
      </nav>
    </div>
  </header>

  <main class="main-content">
    <div class="hero">
      <img src="/assets/Ligem.png" alt="LIGEM" style="max-height:120px;margin-bottom:1.5rem;filter:brightness(1.1)">
      <h1>Artigos <span>LIGEM</span>.Redes</h1>
      <p>Sistema de gerenciamento de participação e submissão de artigos para congressos e eventos</p>
    </div>

    <h2 class="section-title">Eventos</h2>

    <% if (events.length > 0) { %>
      <div class="events-grid">
        <% events.forEach(event => { %>
          <a href="/evento/<%= event.id %>" class="event-card" aria-label="Abrir detalhes do evento <%= event.name %>">
            <span class="area"><%= event.area_display %></span>
            <% if (event.submission.isConfigured) { %>
              <span class="submission-badge <%= event.submission.isOpen ? 'submission-open' : 'submission-closed' %>">
                <%= event.submission.isOpen ? 'Submissão aberta' : 'Submissão fechada' %>
              </span>
            <% } %>
            <h3><%= event.name %></h3>
            <span class="event-section-label">Período do Evento</span>
            <div class="event-meta">
              <span>📅 <%= new Date(event.date_start).toLocaleDateString('pt-BR') %><% if (event.date_end) { %> - <%= new Date(event.date_end).toLocaleDateString('pt-BR') %><% } %></span>
              <% if (event.location) { %><span>📍 <%= event.location %></span><% } %>
            </div>
            <% if (event.submission.start || event.submission.end) { %>
              <span class="event-section-label">Período de Submissão de Artigos</span>
              <div class="event-meta">
                <% if (event.submission.start) { %><span>🟢 Início: <%= event.submission.start.toLocaleDateString('pt-BR') %></span><% } %>
                <% if (event.submission.end) { %><span>⏰ Fim: <%= event.submission.end.toLocaleDateString('pt-BR') %></span><% } %>
              </div>
            <% } %>
            <% if (event.description) { %>
              <p><%= event.description.length > 150 ? event.description.substring(0, 150) + '...' : event.description %></p>
            <% } %>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <h2>Nenhum evento publicado</h2>
        <p>Em breve novos eventos serão disponibilizados.</p>
      </div>
    <% } %>
  </main>

  <footer>&copy; <%= year %> LIGEM.Redes • <%= typeof appVersion !== 'undefined' ? appVersion : 'V0.1' %></footer>
<%- include("../partials/csrf-inject") %>
  </body>
</html>
