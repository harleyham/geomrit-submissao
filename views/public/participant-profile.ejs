<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Gerência de Eventos</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: linear-gradient(180deg, #08111f, #0f172a 48%, #101827); color: #e2e8f0; min-height: 100vh; }
    .topbar { background: rgba(15,23,42,0.8); border-bottom: 1px solid rgba(148,163,184,0.1); backdrop-filter: blur(20px); padding: 0 2rem; height: 64px; display: flex; align-items: center; }
    .topbar-inner { width: 100%; max-width: 1100px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
    .logo { font-size: 1.25rem; font-weight: 700; color: #e2e8f0; text-decoration: none; }
    .topbar-nav { display:flex; gap:0.4rem; align-items:center; flex-wrap:wrap; }
    .topbar-nav a { color: #94a3b8; padding: 0.5rem 0.75rem; border-radius: 6px; text-decoration: none; font-size: 0.875rem; font-weight: 500; transition:all 0.15s; }
    .topbar-nav a:hover { color: #e2e8f0; background: rgba(148,163,184,0.1); }
    .session-pill { padding: 0.42rem 0.78rem; border: 1px solid rgba(148,163,184,0.18); border-radius: 999px; color: #e2e8f0; font-size: 0.82rem; }
    .btn { display: inline-flex; align-items: center; justify-content: center; padding: 0.8rem 1.2rem; border-radius: 10px; text-decoration: none; font-weight: 600; border: none; cursor: pointer; }
    .btn-primary { background: linear-gradient(135deg, #2563eb, #0ea5e9); color: white; }
    .btn-secondary { background: transparent; color: #cbd5e1; border: 1px solid rgba(148,163,184,0.2); }
    .btn-logout { background: transparent; color: #f87171; border: 1px solid rgba(248,113,113,0.25); font-family: inherit; }
    .main-content { max-width: 760px; margin: 0 auto; padding: 3rem 1.5rem; }
    .hero { margin-bottom: 1.75rem; }
    .hero h1 { font-size: 2rem; font-weight: 800; color: #f8fafc; margin-bottom: 0.75rem; }
    .hero p { color: #94a3b8; line-height: 1.7; max-width: 640px; }
    .card { background: rgba(15,23,42,0.78); border: 1px solid rgba(148,163,184,0.14); border-radius: 18px; padding: 2rem; box-shadow: 0 24px 80px rgba(2,6,23,0.35); }
    .alert { padding: 0.9rem 1rem; border-radius: 10px; margin-bottom: 1rem; font-size: 0.9rem; }
    .alert-error { background: rgba(239,68,68,0.1); border: 1px solid rgba(248,113,113,0.25); color: #fca5a5; }
    .alert-success { background: rgba(34,197,94,0.1); border: 1px solid rgba(74,222,128,0.2); color: #86efac; }
    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .form-group { margin-bottom: 1rem; }
    .form-group label { display: block; color: #cbd5e1; font-size: 0.9rem; font-weight: 600; margin-bottom: 0.45rem; }
    .form-group input, .form-group select { width: 100%; padding: 0.8rem 0.95rem; border: 1px solid rgba(148,163,184,0.2); border-radius: 10px; background: rgba(2,6,23,0.35); color: #f8fafc; font-size: 0.95rem; font-family: 'Inter', sans-serif; }
    .form-group input:focus, .form-group select:focus { outline: none; border-color: #60a5fa; box-shadow: 0 0 0 3px rgba(59,130,246,0.16); }
    .actions { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-top: 1.5rem; }
    .note { margin-bottom: 1.5rem; padding: 1rem 1.1rem; border-radius: 12px; background: rgba(59,130,246,0.1); border: 1px solid rgba(96,165,250,0.2); color: #cbd5e1; font-size: 0.9rem; line-height: 1.65; }
    .section-title { font-size: 1.05rem; font-weight: 700; color: #f1f5f9; margin: 1.75rem 0 0.35rem; padding-top: 1.5rem; border-top: 1px solid rgba(148,163,184,0.14); }
    .help { margin: 0 0 1rem; font-size: 0.8rem; color: #64748b; }
    .input-with-toggle { position: relative; }
    .input-with-toggle input { padding-right: 2.75rem; }
    .toggle-password { position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%); background: transparent; border: none; color: #94a3b8; cursor: pointer; font-size: 1rem; line-height: 1; }
    footer { text-align: center; padding: 2rem; color: #64748b; font-size: 0.75rem; }
    @media (max-width: 720px) {
      .grid { grid-template-columns: 1fr; }
      .actions { flex-direction: column-reverse; align-items: stretch; }
      .topbar-inner { gap: 1rem; flex-wrap: wrap; }
      .topbar { height: auto; padding: 1rem 1.25rem; }
    }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="logo"><span class="logo-icon">◆</span> Gerência de Eventos</a>
      <nav class="topbar-nav">
        <a href="/author" class="btn btn-secondary">Área do Participante</a>
        <% if (isReviewer) { %>
          <a href="/reviewer" class="btn btn-secondary">Painel do Revisor</a>
        <% } %>
        <% if (isAdmin) { %>
          <a href="/admin/dashboard" class="btn btn-secondary">Dashboard</a>
        <% } %>
        <a href="/" class="btn btn-secondary">← Eventos</a>
        <span class="session-pill"><%= userEmail %></span>
        <form method="POST" action="/login/logout" style="display:inline;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-logout">Sair</button>
        </form>
      </nav>
    </div>
  </header>

  <main class="main-content">
    <div class="hero">
      <h1>Meus Dados</h1>
      <p>Atualize aqui suas informações cadastrais para manter suas inscrições e submissões vinculadas corretamente à sua conta.</p>
    </div>

    <div class="card">
      <div class="note">
        Alterações de nome, e-mail e instituição passam a valer imediatamente para o seu cadastro de acesso. Se necessário, você ainda poderá complementar dados de inscrição específicos em cada evento.
      </div>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>
      <% if (success) { %>
        <div class="alert alert-success"><%= success %></div>
      <% } %>

      <form method="POST" action="/author/profile">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label for="name">Nome completo *</label>
          <input type="text" id="name" name="name" required value="<%= formData.name || '' %>">
        </div>

        <div class="grid">
          <div class="form-group">
            <label for="email">E-mail *</label>
            <input type="email" id="email" name="email" required value="<%= formData.email || '' %>">
          </div>
          <div class="form-group">
            <label for="institution">Instituição</label>
            <input type="text" id="institution" name="institution" value="<%= formData.institution || '' %>">
          </div>
        </div>

        <div class="grid">
          <div class="form-group">
            <label for="cpf">CPF</label>
            <input type="text" id="cpf" name="cpf" value="<%= formData.cpf || '' %>">
          </div>
          <div class="form-group">
            <label for="passport">Passaporte</label>
            <input type="text" id="passport" name="passport" value="<%= formData.passport || '' %>">
          </div>
        </div>

        <div class="grid">
          <div class="form-group">
            <label for="phone">Telefone</label>
            <input type="text" id="phone" name="phone" value="<%= formData.phone || '' %>" placeholder="(00) 00000-0000">
          </div>
          <div class="form-group">
            <label for="country">País</label>
            <%- include('../partials/country-select', { selectedCountry: formData.country || '', selectId: 'country', selectName: 'country' }) %>
          </div>
        </div>

        <div class="section-title">Formação acadêmica</div>
        <p class="help">Opcional. Preencha todos os campos da seção ou deixe-a vazia.</p>
        <div class="form-group">
          <label for="formacao_area">Área de formação</label>
          <select id="formacao_area" name="formacao_area">
            <option value="">Selecione uma área</option>
            <% (areas || []).forEach((area) => { %>
              <option value="<%= area.codigo %>" <%= formData.formacao_area === area.codigo ? 'selected' : '' %>><%= area.area %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label for="formacao_curso">Curso</label>
          <select id="formacao_curso" name="formacao_curso">
            <option value=""><%= formData.formacao_area ? 'Selecione um curso' : 'Selecione primeiro uma área' %></option>
            <% ((cursosMap && cursosMap[formData.formacao_area]) || []).forEach((curso) => { %>
              <option value="<%= curso %>" <%= formData.formacao_curso === curso ? 'selected' : '' %>><%= curso %></option>
            <% }) %>
          </select>
        </div>
        <div class="grid" id="formacao-titulacao-status" <%= formData.formacao_curso === noDegreeCourse ? 'hidden' : '' %>>
          <div class="form-group">
            <label for="formacao_titulacao">Titulação</label>
            <select id="formacao_titulacao" name="formacao_titulacao">
              <option value="">Selecione</option>
              <% ['Graduado', 'Mestre', 'Doutor'].forEach((value) => { %>
                <option value="<%= value %>" <%= formData.formacao_titulacao === value ? 'selected' : '' %>><%= value %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label for="formacao_status">Status</label>
            <select id="formacao_status" name="formacao_status">
              <option value="">Selecione</option>
              <% ['Formado', 'Cursando'].forEach((value) => { %>
                <option value="<%= value %>" <%= formData.formacao_status === value ? 'selected' : '' %>><%= value %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <div class="section-title">Trocar senha</div>
        <p class="help">Opcional. Preencha os três campos somente se desejar alterar a senha de acesso.</p>
        <div class="grid">
          <div class="form-group">
            <label for="current_password">Senha atual</label>
            <div class="input-with-toggle">
              <input type="password" id="current_password" name="current_password" autocomplete="current-password">
              <button type="button" class="toggle-password" data-target="current_password" aria-label="Mostrar senha">&#128065;</button>
            </div>
          </div>
          <div class="form-group">
            <label for="new_password">Nova senha</label>
            <div class="input-with-toggle">
              <input type="password" id="new_password" name="new_password" autocomplete="new-password">
              <button type="button" class="toggle-password" data-target="new_password" aria-label="Mostrar senha">&#128065;</button>
            </div>
          </div>
        </div>
        <div class="form-group">
          <label for="confirm_password">Confirmar nova senha</label>
          <div class="input-with-toggle">
            <input type="password" id="confirm_password" name="confirm_password" autocomplete="new-password">
            <button type="button" class="toggle-password" data-target="confirm_password" aria-label="Mostrar senha">&#128065;</button>
          </div>
          <p class="help">Mínimo de 8 caracteres, com maiúscula, minúscula e número.</p>
        </div>

        <div class="actions">
          <a href="/author" class="btn btn-secondary">Voltar</a>
          <button type="submit" class="btn btn-primary">Salvar Alterações</button>
        </div>
      </form>
    </div>
  </main>

  <footer>&copy; <%= year %> LIGEM.Redes • <%= typeof appVersion !== 'undefined' ? appVersion : 'V0.1' %></footer>
  <script nonce="<%= cspNonce %>">
    (function() {
      var cursosMap = <%- JSON.stringify(cursosMap || {}) %>;
      var noDegreeCourse = <%- JSON.stringify(noDegreeCourse || '') %>;
      var areaSelect = document.getElementById('formacao_area');
      var cursoSelect = document.getElementById('formacao_curso');
      var titulacaoStatusRow = document.getElementById('formacao-titulacao-status');

      function syncTitulacaoVisibility() {
        if (!cursoSelect || !titulacaoStatusRow) return;
        var isNoDegree = cursoSelect.value === noDegreeCourse;
        titulacaoStatusRow.hidden = isNoDegree;
        if (isNoDegree) {
          var tit = document.getElementById('formacao_titulacao');
          var st = document.getElementById('formacao_status');
          if (tit) tit.value = '';
          if (st) st.value = '';
        }
      }

      if (areaSelect && cursoSelect) {
        areaSelect.addEventListener('change', function() {
          cursoSelect.innerHTML = '<option value="">' + (this.value ? 'Selecione um curso' : 'Selecione primeiro uma área') + '</option>';
          (cursosMap[this.value] || []).forEach(function(curso) {
            var option = document.createElement('option');
            option.value = curso;
            option.textContent = curso;
            cursoSelect.appendChild(option);
          });
          syncTitulacaoVisibility();
        });

        cursoSelect.addEventListener('change', function() {
          syncTitulacaoVisibility();
        });

        syncTitulacaoVisibility();
      }

      document.querySelectorAll('.toggle-password').forEach(function(button) {
        button.addEventListener('click', function() {
          var input = document.getElementById(button.getAttribute('data-target'));
          var showing = input.type === 'text';
          input.type = showing ? 'password' : 'text';
          button.textContent = showing ? '\u{1F441}' : '\u{1F648}';
          button.setAttribute('aria-label', showing ? 'Mostrar senha' : 'Ocultar senha');
        });
      });
    })();
  </script>
</body>
</html>
