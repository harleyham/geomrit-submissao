<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Gerência de Eventos</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; }
    .topbar { background: var(--surface); border-bottom: 1px solid var(--border); backdrop-filter: blur(20px); padding: 0 2rem; height: 64px; display: flex; align-items: center; position: sticky; top: 0; z-index: 100; }
    .topbar-inner { width: 100%; max-width: 1400px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
    .logo { font-size: 1.25rem; font-weight: 700; color: var(--text); text-decoration: none; }
    .logo-icon { color: var(--accent); }
    .topbar-nav { display:flex; gap:0.4rem; align-items:center; flex-wrap:wrap; }
    .topbar-nav a { color: var(--text-muted); padding: 0.5rem 0.75rem; border-radius: 6px; text-decoration: none; font-size: 0.875rem; font-weight: 500; transition:all 0.15s; }
    .topbar-nav a:hover { color: var(--text); background: var(--border); }
    .session-pill { padding: 0.42rem 0.78rem; border: 1px solid rgba(148,163,184,0.18); border-radius: 999px; color: var(--text); font-size: 0.82rem; }
    .btn-logout { background: transparent; color: var(--danger); border: 1px solid rgba(248,113,113,0.25); font-family: inherit; }
    .main-content { max-width: 1000px; margin: 0 auto; padding: 2rem; }
    .page-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; }
    .page-header h1 { font-size: 1.75rem; font-weight: 700; color: var(--text-strong); }
    .btn { display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.625rem 1.25rem; border-radius: 8px; font-size: 0.875rem; font-weight: 500; cursor: pointer; border: none; text-decoration: none; }
    .btn-primary { background: var(--primary); color: white; }
    .btn-primary:hover { background: var(--primary-hover); }
    .btn-secondary { background: rgba(148,163,184,0.12); color: var(--text); border: 1px solid rgba(148,163,184,0.18); }
    .btn-secondary:hover { background: rgba(148,163,184,0.2); }
    .card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 1.25rem; margin-bottom: 1rem; }
    .card h2 { color: var(--text-strong); font-size: 1.1rem; margin-bottom: 0.5rem; }
    .card p { color: var(--text-muted); font-size: 0.9rem; line-height: 1.6; }
    .alert { padding: 0.95rem 1rem; border-radius: 10px; margin-bottom: 1rem; font-size: 0.9rem; }
    .alert-success { background: rgba(34,197,94,0.1); border: 1px solid rgba(74,222,128,0.2); color: #86efac; }
    .alert-error { background: rgba(239,68,68,0.1); border: 1px solid rgba(248,113,113,0.25); color: #fca5a5; }
    .empty { padding: 3rem; text-align: center; color: var(--text-faint); }
    .empty p { margin-bottom: 0.5rem; }
    footer { text-align: center; padding: 2rem; color: var(--text-faint); font-size: 0.75rem; }
    @media (max-width: 768px) {
      .page-header { flex-direction: column; }
      .main-content { padding: 1rem; }
    }
  </style>
  <%- include('../partials/theme') %>
  <%- include('../partials/mobile-fixes') %>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="logo"><span class="logo-icon">◆</span> Gerência de Eventos</a>
      <nav class="topbar-nav">
        <a href="/evento/<%= event.id %>">← Voltar ao evento</a>
        <a href="/consultar-certificado" class="btn btn-secondary">Verificar Certificado</a>
        <% if (userEmail) { %>
          <a href="<%= isAdmin ? '/admin/dashboard' : isReviewer ? '/reviewer' : '/author' %>" class="btn btn-secondary"><%= isAdmin ? 'Dashboard' : isReviewer ? 'Revisor' : 'Área do Participante' %></a>
          <span class="session-pill"><%= userEmail %></span>
          <form method="POST" action="<%= isAdmin ? '/admin/logout' : isReviewer ? '/reviewer/logout' : '/login/logout' %>" style="display:inline;">
            <button type="submit" class="btn btn-logout">Sair</button>
          </form>
        <% } %>
      </nav>
    </div>
  </header>

  <main class="main-content">
    <div class="page-header">
      <h1>Meus Certificados — <%= event.name %></h1>
    </div>

    <% if (success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <% if (!certificatesWindow.isOpen) { %>
      <div class="card">
        <h2>Certificados indisponíveis</h2>
        <p><%= certificatesWindow.message %></p>
      </div>
    <% } else if (certificates.length === 0) { %>
      <div class="card">
        <h2>Nenhum certificado emitido</h2>
        <p>Ainda não há certificados emitidos para este evento. Aguarde a finalização da programação.</p>
      </div>
    <% } else { %>
      <% certificates.forEach(function(certificate) { %>
        <div class="card">
          <h2><%= certificate.certificate_title || certificate.event_name %></h2>
          <p>
            <span style="display:inline-block;background:rgba(99,102,241,.2);color:#c7d2fe;padding:0.2rem 0.55rem;border-radius:999px;margin-bottom:0.45rem;"><%= ({participant:'Participante',reviewer:'Revisor',speaker:'Palestrante',teacher:'Professor',oral_presenter:'Apresentador Oral',poster_presenter:'Apresentador Pôster'})[certificate.certificate_role] || 'Participante' %></span><br>
            Versão <%= certificate.version %> · Código: <code><%= certificate.certificate_code %></code><br>
            <a href="/consultar-certificado?code=<%= certificate.certificate_code %>" class="btn btn-secondary" style="margin-top:0.5rem; font-size:0.8rem; padding:0.35rem 0.75rem;">Verificar autenticidade</a><br>
            Emissão: <%= certificate.issued_at %>
          </p>
          <% if (Number(certificate.total_workload_hours) > 0) { const workloadHours = Number(certificate.total_workload_hours); const formattedHours = Number.isInteger(workloadHours) ? String(workloadHours) : workloadHours.toLocaleString('pt-BR', { maximumFractionDigits: 2 }); %>
            <p style="margin-top:0.5rem;color:var(--text-muted);">
              Carga horária: <strong style="color:var(--warn);"><%= formattedHours %> <%= workloadHours === 1 ? 'hora-aula' : 'horas-aula' %></strong>
            </p>
          <% } %>
          <% if (certificate.activities_summary) { %>
            <p style="margin-top:0.5rem;color:var(--text-muted);">Atividades consideradas: <strong><%= certificate.activities_summary %></strong></p>
          <% } %>
          <% if (certificate.window.isOpen) { %>
            <div style="margin-top:1rem;">
              <a href="/author/certificates/<%= certificate.id %>/download" class="btn btn-primary">Baixar certificado em PDF</a>
            </div>
          <% } else { %>
            <p style="margin-top:0.75rem;color:#fca5a5;"><%= certificate.window.message %></p>
          <% } %>
        </div>
      <% }) %>
    <% } %>
  </main>

  <footer>&copy; <%= year %> LIGEM.Redes • <%= typeof appVersion !== 'undefined' ? appVersion : 'V0.1' %></footer>
<%- include("../partials/csrf-inject") %>
  </body>
</html>
