<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Gerência de Eventos</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { box-sizing:border-box; margin:0; padding:0; }
    body { min-height:100vh; background:var(--bg); color:var(--text); font-family:'Inter',sans-serif; }
    .topbar { min-height:64px; padding:.7rem 1.5rem; background:var(--surface-elevated); border-bottom:1px solid var(--border-strong); }
    .topbar-inner { max-width:960px; margin:auto; display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap; }
    .logo { font-size:1.25rem; font-weight:700; color:var(--text); text-decoration:none; }
    .logo span { color:var(--accent); }
    .topbar-nav { display:flex; gap:0.4rem; align-items:center; flex-wrap:wrap; }
    .topbar-nav a { color:var(--text-muted); padding: 0.5rem 0.75rem; border-radius: 6px; text-decoration: none; font-size: 0.875rem; font-weight: 500; transition:all 0.15s; }
    .topbar-nav a:hover { color: var(--text); background: var(--surface-hover); }
    .session-pill { padding: 0.42rem 0.78rem; border: 1px solid var(--border-strong); border-radius: 999px; color: var(--text); font-size: 0.82rem; }
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.375rem; padding: 0.625rem 1.25rem; border-radius: 8px; font-size: 0.875rem; font-weight: 500; cursor: pointer; border: none; text-decoration: none; }
    .btn-primary { background: var(--primary); color:var(--on-primary); }
    .btn-primary:hover { background: var(--primary-hover); }
    .btn-secondary { background:var(--surface-hover); color: var(--text); border: 1px solid var(--border-strong); }
    .btn-secondary:hover { background:var(--surface-hover); }
    .btn-logout { background: transparent; color: var(--danger); border: 1px solid var(--danger-border); font-family: inherit; }
    main { max-width:800px; margin:0 auto; padding:2.5rem 1.25rem; }
    .card { padding:2rem; border:1px solid var(--border-strong); border-radius:18px; background:var(--surface-elevated); }
    .badge { display:inline-block; padding:.3rem .7rem; border-radius:999px; background:var(--surface-selected); color:var(--link); font-size:.75rem; font-weight:700; }
    h1 { margin:.85rem 0 .65rem; color:var(--text-strong); font-size:1.8rem; }
    .lead,.help { color:var(--text-muted); line-height:1.65; }
    .lead { margin-bottom:1.4rem; }
    .alert { margin-bottom:1rem; padding:.9rem 1rem; border-radius:10px; }
    .success { color:var(--success); background:var(--success-subtle); border:1px solid var(--success-border); }
    .error { color:var(--danger); background:var(--danger-subtle); border:1px solid var(--danger-border); }
    .activities { display:grid; gap:.8rem; margin:1.25rem 0; }
    .activity { display:flex; gap:.85rem; align-items:flex-start; padding:1rem; border:1px solid var(--border-strong); border-radius:12px; background:var(--surface-subtle); cursor:pointer; }
    .activity:has(input:checked) { border-color:var(--primary); background:var(--surface-selected); }
    .activity input[type=checkbox] { width:18px; height:18px; margin-top:.15rem; accent-color:var(--primary); }
    .activity-wrap { display:flex; flex-direction:column; gap:.55rem; }
    .evaluation textarea { width:100%; resize:vertical; min-height:3.2rem; padding:.65rem .8rem; border-radius:10px; border:1px solid var(--border-strong); background:var(--surface-input); color:var(--text); font-family:inherit; font-size:.9rem; line-height:1.5; }
    .evaluation textarea:focus { outline:none; border-color:var(--primary); }
    .notice { margin-bottom:1rem; padding:.9rem 1rem; border-radius:10px; color:var(--link); background:var(--surface-selected); border:1px solid var(--primary-border); }
    .activity strong { display:block; color:var(--text-strong); }
    .activity small { display:block; margin-top:.35rem; color:var(--text-muted); line-height:1.45; }
    .present { display:inline-block; margin-top:.5rem; padding:.2rem .5rem; border-radius:999px; color:var(--success); background:var(--success-subtle); font-size:.72rem; font-weight:700; }
    .actions { display:flex; justify-content:space-between; align-items:center; gap:1rem; margin-top:1.35rem; flex-wrap:wrap; }
    .btn { display:inline-flex; text-decoration:none; color:var(--text); background:transparent; cursor:pointer; }
    .primary { color:var(--on-primary); border:0; background:linear-gradient(135deg,var(--primary),var(--primary-hover)); }
    .empty { margin:1.25rem 0; padding:1rem; color:var(--text-muted); border:1px dashed var(--border-strong); border-radius:12px; }
  </style>
  <%- include('../partials/theme') %>
  <%- include('../partials/mobile-fixes') %>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="logo"><span class="logo-icon">◆</span> Gerência de Eventos</a>
      <nav class="topbar-nav">
        <a href="/evento/<%= event.id %>" class="btn btn-secondary">← Voltar ao evento</a>
        <a href="/author" class="btn btn-secondary">Área do Participante</a>
        <span class="session-pill"><%= userEmail %></span>
        <form method="POST" action="/login/logout" style="display:inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-logout">Sair</button>
        </form>
      </nav>
    </div>
  </header>
  <main>
    <section class="card">
      <span class="badge">Inscrição nas atividades</span>
      <h1>Minhas atividades</h1>
      <p class="lead"><strong><%= event.name %></strong><br><%= isClosed ? 'O evento está encerrado. Você ainda pode avaliar as atividades em que participou.' : 'Atividades em que você está inscrito. A presença será registrada separadamente pela organização. Para solicitar inscrições (como minicursos), use a página de inscrição do evento; e marque suas preferências como interesse na página do evento.' %></p>

      <% if (isClosed) { %><div class="notice">Inscrições nas atividades encerradas — somente as avaliações podem ser editadas.</div><% } %>
      <% if (isPending) { %><div class="notice">Sua inscrição está aguardando análise da organização. As atividades serão liberadas após a aprovação.</div><% } %>
      <% if (isRejected) { %><div class="alert error">Sua inscrição não foi aprovada. Entre em contato com a organização para mais informações.</div><% } %>
      <% if (success) { %><div class="alert success"><%= success %></div><% } %>
      <% if (error) { %><div class="alert error"><%= error %></div><% } %>

      <% if (!activities.length) { %>
        <% if (hasEligibleActivities) { %>
          <div class="empty">Você ainda não está inscrito em nenhuma atividade deste evento<% if (!isPending && !isRejected) { %> — para solicitar inscrição (como minicursos), <a style="color:var(--link)" href="/evento/<%= event.id %>/inscricao">use a página de inscrição</a><% } %>.</div>
        <% } else { %>
          <div class="empty">Este evento ainda não possui atividades abertas para participantes.</div>
        <% } %>
      <% } else { %>
        <form method="POST" action="/evento/<%= event.id %>/atividades">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="activities">
            <% activities.forEach((activity) => { %>
              <div class="activity-wrap">
                <label class="activity">
                  <% if (isPending || isRejected || isClosed || activitiesLockedByReview) { %>
                    <input type="checkbox" <%= activity.enrolled ? 'checked' : '' %> disabled aria-label="Inscrições encerradas">
                  <% } else if (activity.present) { %>
                    <input type="hidden" name="activity_ids" value="<%= activity.id %>">
                    <input type="checkbox" checked disabled aria-label="Atividade com presença registrada">
                  <% } else if (Number(activity.required_for_participants) === 1) { %>
                    <input type="checkbox" checked disabled aria-label="Atividade obrigatória para participantes">
                  <% } else { %>
                    <input type="checkbox" name="activity_ids" value="<%= activity.id %>" <%= activity.enrolled ? 'checked' : '' %>>
                  <% } %>
                  <span>
                    <strong><%= activity.name %><% if (Number(activity.required_for_participants) === 1) { %><span class="badge" style="background:var(--primary-hover);color:var(--link);margin-left:6px;font-size:10px;vertical-align:middle">Obrigatória</span><% } %></strong>
                    <small><%= activityDateRange(activity) %> · <%= Number(activity.effective_workload_hours != null ? activity.effective_workload_hours : activity.workload_hours) > 0 ? (Number(activity.effective_workload_hours != null ? activity.effective_workload_hours : activity.workload_hours)) : 0 %>h<%= activity.certificate_enabled ? ' · certificável mediante presença' : '' %></small>
                    <% if (activity.sessions_total > 0) { %>
                      <span class="present"><%= activity.attended_sessions.length %> de <%= activity.sessions_total %> presenças<% if (activity.attended_sessions.length) { %> — <%= activity.attended_sessions.join(' · ') %><% } %></span>
                    <% } else if (activity.present) { %>
                      <span class="present">Presença registrada — inscrição preservada</span>
                    <% } %>
                  </span>
                </label>
                <% if (activity.enrolled && !isPending && !isRejected) { %>
                  <div class="evaluation">
                    <textarea name="evaluation_<%= activity.id %>" rows="2" maxlength="2000" placeholder="Sua avaliação desta atividade (opcional)"><%= activity.evaluation %></textarea>
                  </div>
                <% } %>
              </div>
            <% }) %>
          </div>
          <p class="help"><%= isClosed || activitiesLockedByReview ? 'Você pode avaliar as atividades em que está inscrito.' : 'O certificado considera somente atividades certificáveis nas quais você esteja inscrito e tenha presença registrada. Atividades já frequentadas não podem ser removidas.' %></p>
          <div class="actions">
            <a class="btn" href="/author">Cancelar</a>
            <% if (!isPending && !isRejected) { %><button class="btn primary" type="submit"><%= isClosed || activitiesLockedByReview ? 'Salvar avaliações' : 'Salvar atividades' %></button><% } %>
          </div>
        </form>
      <% } %>
    </section>

    <%
      var actTypeLabels = { lecture:'Palestra', seminar:'Seminário', roundtable:'Mesa-redonda', course:'Minicurso', oral_presentation:'Apresentação oral', poster_presentation:'Apresentação pôster', breakfast:'Café da manhã', coffee_break:'Coffee Break', brunch:'Brunch', lunch:'Almoço', dinner:'Jantar', other:'Outra' };
      var interests = locals.interestActivities || [];
    %>
    <section class="card" style="margin-top:1.5rem">
      <span class="badge">Interesse</span>
      <h1>Atividades de meu interesse</h1>
      <% if (!interests.length) { %>
        <div class="empty">Você ainda não marcou atividades de interesse. <a style="color:var(--link)" href="/evento/<%= event.id %>">Marcar na página do evento</a>.</div>
      <% } else { %>
        <div class="activities">
          <% interests.forEach((activity) => { %>
            <% var roomText = activity.room_allocation ? activity.room_allocation.room_name : ((activity.session_room_names || []).length ? activity.session_room_names.join(' · ') : '—'); %>
            <div class="activity" style="cursor:default">
              <span>
                <strong><%= activity.name %></strong>
                <small><%= actTypeLabels[activity.activity_type] || 'Outra' %> · <%= activityDateRange(activity) || 'A definir' %><% if (activity.time_start || activity.time_end) { %> · <%= String(activity.time_start || '?').slice(0,5) %>–<%= String(activity.time_end || '?').slice(0,5) %><% } %> · <%= roomText %></small>
              </span>
            </div>
          <% }) %>
        </div>
        <p class="help">Para alterar, <a style="color:var(--link)" href="/evento/<%= event.id %>">marque na página do evento</a>.</p>
      <% } %>
    </section>
  </main>
</body>
</html>
