<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Verificar Certificado' %> - LIGEM.Redes</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: #0a0f1a; color: #e2e8f0; min-height: 100vh; }
    .topbar { background: rgba(15,23,42,0.8); border-bottom: 1px solid rgba(148,163,184,0.1); backdrop-filter: blur(20px); padding: 0 2rem; height: 64px; display: flex; align-items: center; position: sticky; top: 0; z-index: 100; }
    .topbar-inner { width: 100%; max-width: 1400px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
    .logo { font-size: 1.25rem; font-weight: 700; color: #e2e8f0; text-decoration: none; }
    .logo-icon { color: #60a5fa; }
    .main-content { max-width: 700px; margin: 0 auto; padding: 3rem 2rem; }
    .card { background: rgba(30,41,59,0.6); border: 1px solid rgba(148,163,184,0.1); border-radius: 12px; padding: 2rem; }
    .card h1 { font-size: 1.5rem; font-weight: 700; color: #f1f5f9; margin-bottom: 1.5rem; text-align: center; }
    .form-group { margin-bottom: 1.5rem; }
    .form-group label { display: block; font-size: 0.875rem; font-weight: 500; color: #cbd5e1; margin-bottom: 0.375rem; }
    .form-group input {
      width: 100%; padding: 0.625rem 0.75rem; background: rgba(15,23,42,0.6);
      border: 1px solid rgba(148,163,184,0.2); border-radius: 8px; color: #e2e8f0;
      font-family: 'Inter', sans-serif; font-size: 0.875rem;
    }
    .form-group input:focus {
      outline: none; border-color: #3b82f6; box-shadow: 0 0 0 2px rgba(59,130,246,0.25);
    }
    .btn { display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.625rem 1.25rem; border-radius: 8px; font-size: 0.875rem; font-weight: 500; text-decoration: none; border: none; cursor: pointer; }
    .btn-primary { background: #3b82f6; color: white; width: 100%; justify-content: center; }
    .btn-primary:hover { background: #2563eb; }
    .topbar-nav { display:flex; gap:0.4rem; align-items:center; flex-wrap:wrap; }
    .topbar-nav a { color: #94a3b8; padding: 0.5rem 0.75rem; border-radius: 6px; text-decoration: none; font-size: 0.875rem; font-weight: 500; }
    .topbar-nav a:hover { color: #e2e8f0; background: rgba(148,163,184,0.1); }
    .session-pill { padding: 0.42rem 0.78rem; border: 1px solid rgba(148,163,184,0.18); border-radius: 999px; color: #e2e8f0; font-size: 0.82rem; }
    .btn-logout { background: transparent; color: #f87171; border: 1px solid rgba(248,113,113,0.25); font-family: inherit; }
    .btn-secondary { background: rgba(148,163,184,0.1); color: #e2e8f0; border: 1px solid rgba(148,163,184,0.2); }
    .btn-secondary:hover { background: rgba(148,163,184,0.2); }
    .error { background: rgba(248,113,113,0.1); border: 1px solid rgba(248,113,113,0.3); border-radius: 8px; padding: 1rem; color: #fca5a5; text-align: center; margin-bottom: 1rem; }
    .success { background: rgba(34,197,94,0.1); border: 1px solid rgba(34,197,94,0.3); border-radius: 8px; padding: 1rem; color: #86efac; text-align: center; margin-bottom: 1rem; }
    .certificate-card { background: rgba(30,41,59,0.6); border: 1px solid rgba(148,163,184,0.1); border-radius: 12px; padding: 2rem; margin-top: 1.5rem; }
    .certificate-card h2 { font-size: 1.125rem; font-weight: 600; color: #f1f5f9; margin-bottom: 0.5rem; }
    .certificate-card .meta { color: #94a3b8; font-size: 0.875rem; margin-bottom: 1rem; line-height: 1.8; }
    .certificate-card .meta strong { color: #e2e8f0; }
    .certificate-card .info { font-size: 0.875rem; color: #cbd5e1; line-height: 1.8; }
    .role-badge { display: inline-block; background: rgba(99,102,241,.2); color: #c7d2fe; padding: 0.2rem 0.55rem; border-radius: 999px; font-size: 0.75rem; font-weight: 500; }
    .verified-badge { display: inline-flex; align-items: center; gap: 0.375rem; background: rgba(34,197,94,0.15); color: #4ade80; padding: 0.4rem 1rem; border-radius: 9999px; font-size: 0.8rem; font-weight: 600; margin-bottom: 1.25rem; }
    .actions { display: flex; gap: 1rem; margin-top: 1.5rem; }
    footer { text-align: center; padding: 3rem 2rem; color: #475569; font-size: 0.75rem; }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="logo"><span class="logo-icon">◆</span> Artigos LIGEM</a>
      <nav class="topbar-nav">
        <a href="/" class="btn btn-secondary">← Início</a>
        <% if (userEmail) { %>
          <a href="/author" class="btn btn-secondary">Área do Participante</a>
          <span class="session-pill"><%= userEmail %></span>
          <form method="POST" action="/login/logout" style="display:inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-logout">Sair</button>
          </form>
        <% } %>
      </nav>
    </div>
  </header>

  <main class="main-content">
    <div class="card">
      <h1>Verificar Certificado</h1>
      <p style="color: #94a3b8; text-align: center; margin-bottom: 1.5rem; font-size: 0.875rem;">Digite o código de verificação impresso no certificado para confirmar sua autenticidade.</p>

      <form action="/consultar-certificado" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label>Código do Certificado</label>
          <input type="text" name="certificate_code" placeholder="Ex: CERT-3-42-PARTICIPANT-V1-A3F2B9" required style="text-transform: uppercase; letter-spacing: 0.08em; font-family: monospace; text-align: center; font-size: 0.875rem;" value="<%= codePrefill || '' %>">
        </div>
        <button type="submit" class="btn btn-primary">Verificar</button>
      </form>
    </div>

    <% if (error) { %>
      <div class="error" style="margin-top: 1.5rem;">
        <%= error %>
      </div>
    <% } %>

    <% if (certificate) { %>
      <div class="certificate-card">
        <div style="text-align:center;">
          <span class="verified-badge">&#10003; Certificado Válido</span>
        </div>
        <div style="text-align:center;">
          <span class="role-badge"><%= certificate.role_label %></span>
        </div>
        <div class="meta" style="margin-top: 1.25rem;">
          <strong>Certificado:</strong> <%= certificate.certificate_title || certificate.event_name %><br>
          <strong>Nome:</strong> <%= certificate.participant_name %><br>
          <strong>Evento:</strong> <%= certificate.event_name %><br>
          <% if (certificate.event_date_start) { %>
            <strong>Período:</strong> <%= certificate.event_date_start %><% if (certificate.event_date_end && certificate.event_date_end !== certificate.event_date_start) { %> a <%= certificate.event_date_end %><% } %><br>
          <% } %>
          <strong>Versão:</strong> <%= certificate.version %><br>
          <strong>Emissão:</strong> <%= certificate.issued_at %><br>
          <strong>Código:</strong> <code style="font-size:0.78rem; background:rgba(15,23,42,0.5); padding:0.15rem 0.4rem; border-radius:4px; word-break:break-all;"><%= certificate.certificate_code %></code>
        </div>
        <% if (Number(certificate.total_workload_hours) > 0) { const workloadHours = Number(certificate.total_workload_hours); const formattedHours = Number.isInteger(workloadHours) ? String(workloadHours) : workloadHours.toLocaleString('pt-BR', { maximumFractionDigits: 2 }); %>
          <div class="meta">
            <strong>Carga horária:</strong> <span style="color:#fbbf24;"><%= formattedHours %> <%= workloadHours === 1 ? 'hora-aula' : 'horas-aula' %></span>
          </div>
        <% } %>
        <% if (certificate.activities_summary) { %>
          <div class="meta">
            <strong>Atividades:</strong> <%= certificate.activities_summary %>
          </div>
        <% } %>
        <div class="actions" style="margin-top: 1.5rem; justify-content: center;">
          <a href="/" class="btn btn-secondary">Voltar ao Início</a>
        </div>
      </div>
    <% } %>
  </main>

  <footer>&copy; <%= typeof year !== 'undefined' ? year : 2026 %> LIGEM.Redes • <%= typeof appVersion !== 'undefined' ? appVersion : 'V0.1' %></footer>
</body>
</html>
