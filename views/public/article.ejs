<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Artigo - LIGEM.Redes</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: #0a0f1a; color: #e2e8f0; min-height: 100vh; }
    .topbar { background: rgba(15,23,42,0.8); border-bottom: 1px solid rgba(148,163,184,0.1); backdrop-filter: blur(20px); padding: 0 2rem; height: 64px; display: flex; align-items: center; position: sticky; top: 0; z-index: 100; }
    .topbar-inner { width: 100%; max-width: 1400px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
    .logo { font-size: 1.25rem; font-weight: 700; color: #e2e8f0; text-decoration: none; }
    .logo-icon { color: #60a5fa; }
    .topbar-nav a { color: #94a3b8; padding: 0.5rem 0.75rem; border-radius: 6px; text-decoration: none; font-size: 0.875rem; font-weight: 500; }
    .topbar-nav a:hover { color: #e2e8f0; }
    .main-content { max-width: 800px; margin: 0 auto; padding: 2rem; }
    .article-header { margin-bottom: 2rem; padding-bottom: 2rem; border-bottom: 1px solid rgba(148,163,184,0.1); }
    .article-header .event-name { display: inline-block; background: rgba(96,165,250,0.15); color: #60a5fa; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; margin-bottom: 0.75rem; }
    .article-header .area { display: inline-block; background: rgba(167,139,250,0.15); color: #a78bfa; padding: 0.2rem 0.6rem; border-radius: 9999px; font-size: 0.7rem; font-weight: 600; margin-left: 0.5rem; }
    .article-header h1 { font-size: 1.5rem; font-weight: 700; color: #f1f5f9; margin-bottom: 0.5rem; line-height: 1.4; }
    .article-header h2 { font-size: 1.125rem; font-weight: 500; color: #94a3b8; margin-bottom: 1rem; }
    .article-meta { display: flex; flex-wrap: wrap; gap: 1rem; color: #94a3b8; font-size: 0.8125rem; margin-bottom: 0.75rem; }
    .article-meta span { display: flex; align-items: center; gap: 0.25rem; }
    .status-badge { display: inline-block; padding: 0.3rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; margin-top: 0.75rem; }
    .status-pending { background: rgba(251,191,36,0.15); color: #fbbf24; }
    .status-approved { background: rgba(52,211,153,0.15); color: #34d399; }
    .status-rejected { background: rgba(239,68,68,0.15); color: #f87171; }
    .status-under-review { background: rgba(96,165,250,0.15); color: #60a5fa; }
    .section { background: rgba(30,41,59,0.6); border: 1px solid rgba(148,163,184,0.1); border-radius: 12px; padding: 2rem; margin-bottom: 1.5rem; }
    .section h2 { font-size: 1.125rem; font-weight: 600; color: #f1f5f9; margin-bottom: 1rem; }
    .section h3 { font-size: 0.875rem; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem; margin-top: 1.5rem; }
    .section p { color: #cbd5e1; line-height: 1.8; font-size: 0.9375rem; }
    .section ul { list-style: none; margin-bottom: 1rem; }
    .section ul li { color: #cbd5e1; padding: 0.25rem 0; font-size: 0.9375rem; }
    .section ul li::before { content: "•"; color: #60a5fa; font-weight: bold; margin-right: 0.5rem; }
    .author-list { background: rgba(15,23,42,0.4); border: 1px solid rgba(148,163,184,0.1); border-radius: 8px; padding: 1rem; margin-bottom: 1rem; }
    .author-list p { color: #94a3b8; font-size: 0.875rem; margin-bottom: 0.25rem; }
    .keywords { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.5rem; }
    .keyword { background: rgba(96,165,250,0.1); color: #60a5fa; padding: 0.2rem 0.6rem; border-radius: 9999px; font-size: 0.75rem; }
    .pdf-link { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; background: rgba(239,68,68,0.15); border: 1px solid rgba(239,68,68,0.2); border-radius: 8px; color: #f87171; text-decoration: none; font-weight: 500; font-size: 0.875rem; margin-top: 1rem; }
    .pdf-link:hover { background: rgba(239,68,68,0.25); }
    .empty { color: #64748b; font-style: italic; }
    .alert-error { padding: 1rem; border-radius: 8px; background: rgba(239,68,68,0.15); color: #f87171; border: 1px solid rgba(239,68,68,0.2); text-align: center; }
    a { color: #60a5fa; }
    footer { text-align: center; padding: 2rem; color: #475569; font-size: 0.75rem; }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="logo"><span class="logo-icon">◆</span> Artigos LIGEM</a>
      <nav class="topbar-nav"><a href="/">← Voltar</a></nav>
    </div>
  </header>

  <main class="main-content">
    <% if (error) { %>
      <div class="alert-error"><%= error %></div>
    <% } else { %>
      <div class="article-header">
        <span class="event-name"><%= article.event_name %></span>
        <span class="area"><%= article.area %></span>
        <h1><%= article.title %></h1>
        <h2><%= article.title_en %></h2>
        <div class="article-meta">
          <span>📅 <%= new Date(article.event_date_start).toLocaleDateString('pt-BR') %></span>
          <span>👤 Submetido por: <%= article.contributor %></span>
          <span>📧 <%= article.email_submission %></span>
        </div>
        <span class="status-badge status-<%= article.status.replace(' ', '-') %>">
          <% if (article.status === 'pending') { %>Pendente
          <% } else if (article.status === 'approved') { %>Aprovado ✓
          <% } else if (article.status === 'rejected') { %>Rejeitado ✗
          <% } else { %><%= article.status %><% } %>
        </span>
      </div>

      <div class="section">
        <h2>Autores</h2>
        <div class="author-list">
          <% article.authors.split('\n').forEach(author => { %>
            <p><%= author.trim() %></p>
          <% }) %>
        </div>

        <h3>Resumo</h3>
        <p><%= article.abstract %></p>

        <h3>Palavras-chave</h3>
        <div class="keywords">
          <% article.keywords.split(',').forEach(kw => { %>
            <span class="keyword"><%= kw.trim() %></span>
          <% }) %>
        </div>
      </div>

      <div class="section">
        <h2>Arquivo</h2>
        <% if (article.pdf_path) { %>
          <a href="/download/<%= article.pdf_path %>" class="pdf-link">📄 Baixar PDF</a>
        <% } else { %>
          <p class="empty">PDF não disponível.</p>
        <% } %>
      </div>

      <% if (article.status === 'approved') { %>
        <div class="section">
          <h2>Artigo Final</h2>
          <% if (article.final_article_path) { %>
            <a href="/download/<%= article.final_article_path %>" class="pdf-link">📄 Baixar Artigo Final</a>
          <% } else { %>
            <p class="empty">Artigo final não disponível.</p>
          <% } %>
        </div>
      <% } %>

      <% if (article.status === 'rejected' && article.rejection_reason) { %>
        <div class="section">
          <h2>Motivo da Rejeição</h2>
          <p><%= article.rejection_reason %></p>
        </div>
      <% } %>

      <% if (article.reviewer_name) { %>
        <div class="section">
          <h2>Revisor Responsável</h2>
          <p><%= article.reviewer_name %> (<%= article.reviewer_area %>)</p>
        </div>
      <% } %>
    <% } %>
  </main>

  <footer>&copy; <%= year %> LIGEM.Redes</footer>
</body>
</html>