<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Painel do Revisor - LIGEM.Redes</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: #0a0f1a; color: #e2e8f0; min-height: 100vh; }
    .topbar { background: rgba(15,23,42,0.8); border-bottom: 1px solid rgba(148,163,184,0.1); backdrop-filter: blur(20px); padding: 0 2rem; height: 64px; display: flex; align-items: center; position: sticky; top: 0; z-index: 100; }
    .topbar-inner { width: 100%; max-width: 1400px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
    .logo { font-size: 1.25rem; font-weight: 700; color: #e2e8f0; text-decoration: none; }
    .logo-icon { color: #60a5fa; }
    .topbar-nav { display: flex; gap: 0.25rem; align-items: center; }
    .topbar-nav a { color: #94a3b8; padding: 0.5rem 0.75rem; border-radius: 6px; text-decoration: none; font-size: 0.875rem; font-weight: 500; }
    .topbar-nav a:hover, .topbar-nav a.active { color: #e2e8f0; background: rgba(148,163,184,0.1); }
    .topbar-nav form { display: inline; }
    .main-content { max-width: 1200px; margin: 0 auto; padding: 2rem; }
    .welcome { margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid rgba(148,163,184,0.1); }
    .welcome h1 { font-size: 1.75rem; font-weight: 700; color: #f1f5f9; margin-bottom: 0.375rem; }
    .welcome p { color: #94a3b8; font-size: 0.9375rem; }
    .welcome .area-badge { display: inline-block; background: rgba(167,139,250,0.15); color: #a78bfa; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; margin-top: 0.5rem; }
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
    .stat-card { background: rgba(30,41,59,0.6); border: 1px solid rgba(148,163,184,0.1); border-radius: 12px; padding: 1.5rem; text-align: center; }
    .stat-number { font-size: 2.5rem; font-weight: 700; }
    .stat-number.blue { color: #60a5fa; }
    .stat-number.yellow { color: #fbbf24; }
    .stat-number.green { color: #34d399; }
    .stat-number.gray { color: #94a3b8; }
    .stat-label { font-size: 0.75rem; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; margin-top: 0.25rem; }
    .section { background: rgba(30,41,59,0.6); border: 1px solid rgba(148,163,184,0.1); border-radius: 12px; overflow: hidden; margin-bottom: 1.5rem; }
    .section-header { padding: 1.25rem 1.5rem; border-bottom: 1px solid rgba(148,163,184,0.1); }
    .section-header h2 { font-size: 1.125rem; font-weight: 600; color: #f1f5f9; }
    .quick-actions { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
    .quick-action-card { display: block; padding: 1.2rem; border-radius: 12px; background: rgba(30,41,59,0.6); border: 1px solid rgba(148,163,184,0.1); text-decoration: none; transition: all 0.15s; }
    .quick-action-card:hover { border-color: rgba(96,165,250,0.3); transform: translateY(-2px); }
    .quick-action-label { font-size: 1rem; font-weight: 600; color: #f1f5f9; margin-bottom: 0.35rem; }
    .quick-action-text { color: #94a3b8; font-size: 0.85rem; line-height: 1.5; }
    table { width: 100%; border-collapse: collapse; }
    th { text-align: left; padding: 0.75rem 1.5rem; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; background: rgba(15,23,42,0.3); }
    td { padding: 0.75rem 1.5rem; font-size: 0.875rem; color: #cbd5e1; border-top: 1px solid rgba(148,163,184,0.05); }
    .badge { display: inline-block; padding: 0.2rem 0.6rem; border-radius: 9999px; font-size: 0.7rem; font-weight: 600; }
    .badge-area { background: rgba(167,139,250,0.15); color: #a78bfa; }
    .badge-pending { background: rgba(251,191,36,0.15); color: #fbbf24; }
    .badge-approved { background: rgba(52,211,153,0.15); color: #34d399; }
    .badge-rejected { background: rgba(239,68,68,0.15); color: #f87171; }
    .alert { padding: 0.875rem 1rem; border-radius: 8px; margin-bottom: 1.5rem; font-size: 0.875rem; }
    .alert-error { background: rgba(239,68,68,0.15); color: #f87171; border: 1px solid rgba(239,68,68,0.2); }
    .btn { display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.3rem 0.7rem; border-radius: 8px; font-size: 0.75rem; font-weight: 500; cursor: pointer; border: none; text-decoration: none; }
    .btn-ghost { background: transparent; color: #94a3b8; border: 1px solid rgba(148,163,184,0.2); }
    .btn-ghost:hover { background: rgba(148,163,184,0.1); color: #e2e8f0; }
    .btn-primary { background: #3b82f6; color: white; }
    .btn-primary:hover { background: #2563eb; }
    .btn-sm { padding: 0.25rem 0.5rem; font-size: 0.7rem; }
    .empty-state { text-align: center; padding: 3rem 2rem; color: #64748b; }
    .empty-state p { font-size: 0.9375rem; }
    footer { text-align: center; padding: 2rem; color: #475569; font-size: 0.75rem; }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/reviewer" class="logo"><span class="logo-icon">◆</span> Painel do Revisor</a>
      <nav class="topbar-nav">
        <a href="/reviewer" class="active">Artigos</a>
        <% if (isAdmin) { %>
          <a href="/admin/dashboard">Dashboard Admin</a>
        <% } %>
        <a href="/author">Área do Participante</a>
        <a href="/author/profile">Meus Dados</a>
        <a href="/">Eventos</a>
        <% if (userEmail) { %><span style="padding:0.3rem 0.65rem; color:#cbd5e1; font-size:0.8125rem; border:1px solid rgba(148,163,184,0.18); border-radius:9999px; background:rgba(15,23,42,0.35);"><%= userEmail %></span><% } %>
        <form method="POST" action="/reviewer/logout">
          <button type="submit" class="btn btn-ghost btn-sm">Sair</button>
        </form>
      </nav>
    </div>
  </header>

  <main class="main-content">
    <div class="welcome">
      <h1>Olá, <%= reviewer.name %>!</h1>
      <p>Este é o seu painel de revisão de artigos.</p>
    </div>

    <div class="quick-actions">
      <% if (isAdmin) { %>
        <a href="/admin/dashboard" class="quick-action-card">
          <div class="quick-action-label">Dashboard Admin</div>
          <div class="quick-action-text">Volte para a administração principal do sistema.</div>
        </a>
      <% } %>

      <a href="/author" class="quick-action-card">
        <div class="quick-action-label">Minha Área de Participante</div>
        <div class="quick-action-text">Acompanhe inscrições, submissões e eventos disponíveis.</div>
      </a>

      <a href="/author/profile" class="quick-action-card">
        <div class="quick-action-label">Meus Dados</div>
        <div class="quick-action-text">Atualize nome, e-mail, instituição e demais dados cadastrais.</div>
      </a>

      <a href="/" class="quick-action-card">
        <div class="quick-action-label">Eventos Publicados</div>
        <div class="quick-action-text">Consulte os eventos e cronogramas disponíveis no portal.</div>
      </a>

      <a href="/consultar" class="quick-action-card">
        <div class="quick-action-label">Consultar Artigo</div>
        <div class="quick-action-text">Busque um artigo pelo código de acesso.</div>
      </a>

      <a href="/reviewers" class="quick-action-card">
        <div class="quick-action-label">Corpo de Revisores</div>
        <div class="quick-action-text">Veja a listagem pública de revisores cadastrados.</div>
      </a>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-number blue"><%= stats.total %></div>
        <div class="stat-label">Total de Artigos</div>
      </div>
      <div class="stat-card">
        <div class="stat-number yellow"><%= stats.pending %></div>
        <div class="stat-label">Pendentes</div>
      </div>
      <div class="stat-card">
        <div class="stat-number green"><%= stats.approved %></div>
        <div class="stat-label">Aprovados</div>
      </div>
      <div class="stat-card">
        <div class="stat-number gray"><%= stats.rejected %></div>
        <div class="stat-label">Rejeitados</div>
      </div>
    </div>

    <div class="section">
      <div class="section-header">
        <h2>Artigos Pendentes de Revisão</h2>
      </div>
      <% if (pendingArticles.length > 0) { %>
        <table>
          <thead>
            <tr><th>Evento</th><th>Título</th><th>Autores</th><th>Data</th><th>Ações</th></tr>
          </thead>
          <tbody>
            <% pendingArticles.forEach(a => { %>
            <tr>
              <td><span class="badge badge-area"><%= a.event_name %></span></td>
              <td><%= a.title.length > 50 ? a.title.substring(0, 50) + '...' : a.title %></td>
              <td><%= a.contributor %></td>
              <td><%= new Date(a.date_submitted).toLocaleDateString('pt-BR') %></td>
              <td><a href="/reviewer/articles/<%= a.id %>" class="btn btn-primary btn-sm">Revisar</a></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <div class="empty-state">
          <p>Nenhum artigo pendente no momento.</p>
        </div>
      <% } %>
    </div>

    <div class="section">
      <div class="section-header">
        <h2>Artigos Já Revisados</h2>
      </div>
      <% if (reviewedArticles.length > 0) { %>
        <table>
          <thead>
            <tr><th>Evento</th><th>Título</th><th>Status</th><th>Data</th><th>Ações</th></tr>
          </thead>
          <tbody>
            <% reviewedArticles.forEach(a => { %>
            <tr>
              <td><span class="badge badge-area"><%= a.event_name %></span></td>
              <td><%= a.title.length > 50 ? a.title.substring(0, 50) + '...' : a.title %></td>
              <td><span class="badge badge-<%= a.recommendation %>"><%= a.recommendation === 'approved' ? 'Aprovado' : 'Rejeitado' %></span></td>
              <td><%= new Date(a.reviewed_at || a.date_submitted).toLocaleDateString('pt-BR') %></td>
              <td><a href="/reviewer/articles/<%= a.id %>" class="btn btn-ghost btn-sm">Ver</a></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <div class="empty-state">
          <p>Nenhum artigo revisado ainda.</p>
        </div>
      <% } %>
    </div>
  </main>

  <footer>&copy; <%= year %> LIGEM.Redes • <%= typeof appVersion !== 'undefined' ? appVersion : 'V0.1' %></footer>
</body>
</html>
